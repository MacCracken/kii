[package]
name = "kii"
version = "${file:VERSION}"
description = "kii (Hawaiian: image / picture / likeness) — image → ANSI/ASCII-art converter for terminal display. Renders PNG, baseline JPEG, BMP and GIF (first frame) via the chitra substrate as half-block, ASCII-glyph or Block Elements frames in 8, 16 or 256 colours or truecolour, optionally dithered, sized to the terminal."
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/kii"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "kii"

[deps]
# sankoch + thread: the linked inflate (chitra's PNG path resolves to this
# leaf) and tests/decode.tcyr's direct zlib_decompress calls — ADR 0006.
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "syscalls", "assert", "bench", "args", "sankoch", "thread"]

# Every dep is git + tag only: the tag is what local builds and CI compile.
# To build against a sibling checkout, add `path` locally and use --local.

# ANSI escapes, terminal size, and the stderr path-echo sanitizer.
[deps.darshana]
git = "https://github.com/MacCracken/darshana.git"
tag = "1.7.0"
modules = ["dist/darshana.cyr"]

# CLI argument parsing.
[deps.cmdit]
git = "https://github.com/MacCracken/cmdit.git"
tag = "1.5.0"
modules = ["dist/cmdit.cyr"]

# Image decode: PNG / baseline JPEG / BMP / GIF first frame → RGBA8.
[deps.chitra]
git = "https://github.com/MacCracken/chitra.git"
tag = "1.3.1"
modules = ["dist/chitra.cyr"]
