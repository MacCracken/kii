# _ascii_match — given a 6-byte region-luminance vector `v` (row-major:
# r0c0 r0c1 r1c0 r1c1 r2c0 r2c1, each 0..255), return the glyph byte whose
# coverage vector is nearest in squared-Euclidean distance. Ties resolve to
# the lower index (strict `<`), so glyph 0 (space) wins an all-dark cell.
# Max distance 6*255^2 ~= 390k — well within i64.
#
# P(-1) O-3 (v1.6.4): the 6 region values are loaded once per cell rather
# than once per glyph, the coverage table is walked by pointer, and a glyph
# stops being scored once its first three terms already reach best_d. That
# is exact: the remaining terms are >= 0 and a glyph needs d < best_d to
# win, so the pick never changes (checked on 20 M vectors against the old
# body). With O-1 it makes the ASCII lane's emit ~2x faster.
fn _ascii_match(v): i64 {
    if (_ascii_shape_inited == 0) { _ascii_shape_init(); }
    var v0 = load8(v);
    var v1 = load8(v + 1);
    var v2 = load8(v + 2);
    var v3 = load8(v + 3);
    var v4 = load8(v + 4);
    var v5 = load8(v + 5);
    # Seed with glyph 0 so the loop body needs no sentinel.
    var cp = &ASCII_SHAPE_COV;
    var e = v0 - load64(cp);
    var best_d = e * e;
    e = v1 - load64(cp + 8);  best_d = best_d + e * e;
    e = v2 - load64(cp + 16); best_d = best_d + e * e;
    e = v3 - load64(cp + 24); best_d = best_d + e * e;
    e = v4 - load64(cp + 32); best_d = best_d + e * e;
    e = v5 - load64(cp + 40); best_d = best_d + e * e;
    var best_g = 0;
    var g = 1;
    cp = cp + 48;
    while (g < ASCII_SHAPE_COUNT) {
        e = v0 - load64(cp);
        var d = e * e;
        e = v1 - load64(cp + 8);  d = d + e * e;
        e = v2 - load64(cp + 16); d = d + e * e;
        if (d < best_d) {
            e = v3 - load64(cp + 24); d = d + e * e;
            e = v4 - load64(cp + 32); d = d + e * e;
            e = v5 - load64(cp + 40); d = d + e * e;
            if (d < best_d) {
                best_d = d;
                best_g = g;
            }
        }
        g = g + 1;
        cp = cp + 48;
    }
    return load64(&ASCII_SHAPE_GLYPHS + best_g * 8);
}

# emit_ascii_shape_row_buf — render ONE character row (cell row `cy`) into
# `buf` at `pos`. `rgb` is the finer (sub_w x sub_h) downscaled RGB buffer
# where sub_w = cols*2; each cell pulls its 2x3 sub-samples, builds the
# 6-region luminance vector, matches a glyph, and colors it with the cell's
# mean quantized color. Returns the new pos, or -1. (Buffer-targeting so
# tests can assert the exact bytes — same split as emit_halfblock_row_buf.)
fn emit_ascii_shape_row_buf(rgb, sub_w, cy, cols, buf, pos): i64 {
    # The three sub-sample rows of this character row are fixed for the whole
    # row, so their base is computed once (O-3). The 6 samples are visited in
    # region order r0c0 r0c1 r1c0 r1c1 r2c0 r2c1: step right after an even k,
    # down-and-left after an odd one.
    var stride = sub_w * 3;
    var r0 = rgb + (cy * 3) * stride;
    var vec[6];
    var cx = 0;
    while (cx < cols) {
        var sumr = 0;
        var sumg = 0;
        var sumb = 0;
        var rp = r0 + cx * 6;
        var k = 0;
        while (k < 6) {
            var pr = load8(rp + 0);
            var pg = load8(rp + 1);
            var pb = load8(rp + 2);
            store8(&vec + k, _ascii_luma(pr, pg, pb));
            sumr = sumr + pr;
            sumg = sumg + pg;
            sumb = sumb + pb;
            if (k % 2 == 0) { rp = rp + 3; } else { rp = rp - 3 + stride; }
            k = k + 1;
        }
        var glyph = _ascii_match(&vec);
        var fg = quantize_nearest_rgb(sumr / 6, sumg / 6, sumb / 6);
        pos = tty_fg_256_buf(buf, pos, fg);
        if (pos < 0) { return 0 - 1; }
        store8(buf + pos, glyph);
        pos = pos + 1;
        cx = cx + 1;
    }
    return _kii_row_end(buf, pos);
}

# The row builder _kii_emit_frame calls for this lane: its (src, w, row, buf,
# pos) shape, with the cell count derived from the sub-sample width.
fn _ascii_frame_row(rgb, sub_w, cy, buf, pos): i64 {
    return emit_ascii_shape_row_buf(rgb, sub_w, cy, sub_w / 2, buf, pos);
}

# emit_ascii_shape — render the full frame to fd 1 (stdout). Reads
# STRUCT_DOWNSCALED_* (the finer (cols*2 x rows*3) RGB buffer main.cyr
# produces for ASCII mode). Returns 0, -1 if downscale wasn't run / dims
# invalid, or -2 if a write to stdout failed. The loop is the shared
# _kii_emit_frame (src/emit.cyr). Per-row heap buffer sized from cols (no
# fixed-stack overflow — the v1.2.1 lesson): each cell is <=11 B fg + 1
# glyph, + per-row reset/LF.
fn emit_ascii_shape(pstruct): i64 {
    var rgb = load64(pstruct + STRUCT_DOWNSCALED_BUF_OFFSET);
    var sub_w = load64(pstruct + STRUCT_DOWNSCALED_W_OFFSET);
    var sub_h = load64(pstruct + STRUCT_DOWNSCALED_H_OFFSET);
    if (rgb == 0) { return 0 - 1; }
    if (sub_w < 2 || sub_h < 3) { return 0 - 1; }
    return _kii_emit_frame(&_ascii_frame_row, rgb, sub_w, sub_h / 3, (sub_w / 2) * 14 + 16);
}
