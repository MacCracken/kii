# ascii.cyr — character-glyph ("ASCII art") rendering mode.
#
# v1.3.0 introduced this lane with a luminance density ramp; v1.3.1
# UPGRADES it to SHAPE-VECTOR glyph matching. Each output cell is sampled
# in a 2x3 sub-grid, and the glyph whose ink-coverage vector is nearest
# (squared-Euclidean over the 6 regions) is chosen — so the matcher tracks
# glyph ORIENTATION (/, \, |, -, _, ...), not just density.
#
# ATTRIBUTION: the shape-vector technique (per-cell N-region coverage
# vectors + nearest-glyph match) is from Alex Harri, "ASCII Art Rendering"
# — https://alexharri.com/blog/ascii-rendering. kii uses a 6-region (2x3)
# variant of his idea. The per-glyph coverage table (src/ascii_shape.cyr) is
# generated by scripts/gen-shape-table.sh from Liberation Mono and scaled to
# the 0..255 cell-luminance scale per row, after Harri's per-dimension
# normalization (v1.10.0; the v1.3.1 table's scratch generator was lost).
# The directional and global contrast enhancement before each match is also
# his (v1.10.0, _ascii_contrast below). His k-d-tree lookup was built and
# measured slower than the scan, so the scan stays (ADR 0007 § v1.10.0
# amendment). The Euclidean nearest-neighbour and the Rec.709 luma are
# standard (no attribution needed).
#
# Still a SECOND lane beside the half-block default (ADR 0007). One char =
# one cell, so main.cyr downscales to (cols*2)x(rows*3) for this mode — the
# 2x3 sub-samples per character cell. Foreground is the cell's mean color
# quantized to the 16-color palette.
#
# Stdlib (alloc/syscalls) + darshana (tty_*) auto-resolve; image.cyr gives
# the pstruct contract; quant.cyr gives quantize_nearest_rgb (per-cell fg).

include "src/image.cyr"
include "src/emit.cyr"   # _kii_write_all (shared stdout plumbing)
include "src/quant.cyr"

# Rec.709 relative luminance, integer-scaled 54/183/19 (sum 256, exact /256
# via >>8). Returns 0..255. W3C/Wikipedia standard coefficients.
fn _ascii_luma(r, g, b): i64 {
    return (54 * r + 183 * g + 19 * b) >> 8;
}

# The 27-glyph coverage table (ASCII_SHAPE_*, _ascii_shape_init), generated by
# scripts/gen-shape-table.sh (v1.10.0).
include "src/ascii_shape.cyr"

# ---- contrast enhancement (v1.10.0, ADR 0007 amendment) ---------------
# Before a cell's 6-region vector is matched, two passes from Alex Harri's
# write-up sharpen it. Both use the same step on a value x against a ceiling M:
#
#     x -> (x / M)^p * M
#
# Dividing by M first keeps x's own scale: the value equal to M is kept, and
# a value below it is pulled down, the further the darker. p is
# ASCII_CONTRAST_R / ASCII_CONTRAST_Q.
#
#   1. Directional: region i's ceiling is the largest of its own value and the
#      external samples beside it (Harri's AFFECTING_EXTERNAL_INDICES). A
#      region darker than a bright neighbour just outside the cell is pulled
#      down, so an edge that runs along the cell boundary stays on the side
#      where the ink is.
#   2. Global: the ceiling is the cell's largest value after step 1, so the
#      cell's brightest region is kept and the others pulled down relative to it.
#
# Everything is integer: ASCII_CONTRAST_POW[t] = round(255 * (t / 255)^p) is
# built exactly at init, and the step is POW[x * 255 / M] * M / 255, rounded.
# So every target computes the same bytes.
var ASCII_CONTRAST_R = 3;             # p = R / Q
var ASCII_CONTRAST_Q = 2;
var ASCII_CONTRAST_POW[256];
var ASCII_CONTRAST_RECIP[256];        # floor(2^24 / m) + 1, for m = 1..255
var _ascii_contrast_inited = 0;

# k^n for small non-negative k, n (callers keep the result inside an i64).
fn _ascii_ipow(k, n): i64 {
    var r = 1;
    var i = 0;
    while (i < n) { r = r * k; i = i + 1; }
    return r;
}

# Build ASCII_CONTRAST_POW. With p = R/Q (R >= Q), y = round(255 * (t/255)^p)
# (half up) is the number of k in 1..255 with k - 1/2 <= 255 * (t/255)^p.
# Raising both sides to the Q-th power and clearing the fractions, that is
# (2k - 1)^Q * 255^(R-Q) <= 2^Q * t^R, all integers. For R <= 7 and Q <= 4 both
# sides stay below 2^63.
fn _ascii_contrast_init(): i64 {
    if (_ascii_contrast_inited == 1) { return 0; }
    var r = ASCII_CONTRAST_R;
    var q = ASCII_CONTRAST_Q;
    var scale = _ascii_ipow(255, r - q);
    var two_q = _ascii_ipow(2, q);
    # The condition holds for k = 1..y and fails above, and y never falls as t
    # rises, so one sweep finds every y: at most 255 + 256 steps, not 256 * 255.
    var y = 0;
    var t = 0;
    while (t < 256) {
        var rhs = _ascii_ipow(t, r) * two_q;
        while (y < 255 && _ascii_ipow(2 * y + 1, q) * scale <= rhs) { y = y + 1; }
        store64(&ASCII_CONTRAST_POW + t * 8, y);
        t = t + 1;
    }
    # The step's one division by m, as a multiply: (n * RECIP[m]) >> 24 is
    # n / m exactly for every n the step forms (n <= 255 * 255 + 127, checked
    # over the whole domain in tests/ascii.tcyr).
    var d = 1;
    while (d < 256) {
        store64(&ASCII_CONTRAST_RECIP + d * 8, 16777216 / d + 1);
        d = d + 1;
    }
    _ascii_contrast_inited = 1;
    return 0;
}

# The step itself: x -> (x / m)^p * m, for 0 <= x <= m. x = m and x = 0 are
# fixed points (POW[255] = 255, POW[0] = 0), so they return at once; in a flat
# region that is most of them. Neither division is a divide instruction:
# t = (x * 255 + m / 2) / m goes through ASCII_CONTRAST_RECIP, and n / 255 for
# 0 <= n < 65535 is (n + 1 + (n >> 8)) >> 8 exactly, with n = POW * m + 127
# <= 65152. A 64-bit divide costs tens of cycles, and the pass takes up to 12.
fn _ascii_contrast_step(x, m): i64 {
    if (x == m || x == 0) { return x; }
    var t = ((x * 255 + (m >> 1)) * load64(&ASCII_CONTRAST_RECIP + m * 8)) >> 24;
    var n = load64(&ASCII_CONTRAST_POW + t * 8) * m + 127;
    return (n + 1 + (n >> 8)) >> 8;
}

# The frame's luminance plane: one byte per sub-sample, row-major sub_w x
# sub_h, 0 where the sample is transparent (no ink). Built once per frame, so a
# cell's six values and the ten samples around it are byte loads. Returns the
# plane, or 0 if it cannot be allocated.
#
# The luma is _ascii_luma's formula written out (a call per sample cost more
# than the rest of the loop); tests/ascii.tcyr checks the two agree.
fn _ascii_lum_plane(rgb, mask, sub_w, sub_h): i64 {
    var n = sub_w * sub_h;
    var lum = alloc(n);
    if (lum == 0) { return 0; }
    var i = 0;
    var p = rgb;
    if (mask == 0) {
        while (i < n) {
            store8(lum + i, (54 * load8(p) + 183 * load8(p + 1) + 19 * load8(p + 2)) >> 8);
            p = p + 3;
            i = i + 1;
        }
        return lum;
    }
    while (i < n) {
        if (load8(mask + i) != 0) { store8(lum + i, 0); }
        else { store8(lum + i, (54 * load8(p) + 183 * load8(p + 1) + 19 * load8(p + 2)) >> 8); }
        p = p + 3;
        i = i + 1;
    }
    return lum;
}

# Enhance cell (cx, cy)'s 6-byte vector `v` in place, directional then global.
# `lum` is the frame's luminance plane (_ascii_lum_plane). The ten external
# samples sit just outside the cell, relative to its top-left sample (2cx, 3cy):
#
#        e0 e1             e0 (0,-1)  e1 (1,-1)
#     e2 v0 v1 e3          e2 (-1,0)  e3 (2,0)
#     e4 v2 v3 e5          e4 (-1,1)  e5 (2,1)
#     e6 v4 v5 e7          e6 (-1,2)  e7 (2,2)
#        e8 e9             e8 (0,3)   e9 (1,3)
#
# A sample past the frame's edge is 0, as a transparent one is. Region i's
# ceiling takes these externals (Harri's mapping; the article gives the
# positions only as a figure, and these are the ones the mapping implies):
#   v0 <- e0 e1 e2 e4    v1 <- e0 e1 e3 e5
#   v2 <- e2 e4 e6       v3 <- e3 e5 e7
#   v4 <- e4 e6 e8 e9    v5 <- e5 e7 e8 e9
# Every ceiling is taken from the values before the pass.
fn _ascii_contrast(v, lum, sub_w, sub_h, cx, cy): i64 {
    if (_ascii_contrast_inited == 0) { _ascii_contrast_init(); }
    var x0 = cx * 2;
    var y0 = cy * 3;
    var c = lum + y0 * sub_w + x0;
    var top = 0;                          # max(e0, e1), shared by v0 and v1
    var bot = 0;                          # max(e8, e9), shared by v4 and v5
    var e2 = 0;
    var e3 = 0;
    var e4 = 0;
    var e5 = 0;
    var e6 = 0;
    var e7 = 0;
    if (y0 > 0) {
        top = load8(c - sub_w);
        var e1 = load8(c - sub_w + 1);
        if (e1 > top) { top = e1; }
    }
    if (y0 + 3 < sub_h) {
        bot = load8(c + 3 * sub_w);
        var e9 = load8(c + 3 * sub_w + 1);
        if (e9 > bot) { bot = e9; }
    }
    if (x0 > 0) {
        e2 = load8(c - 1);
        e4 = load8(c + sub_w - 1);
        e6 = load8(c + 2 * sub_w - 1);
    }
    if (x0 + 2 < sub_w) {
        e3 = load8(c + 2);
        e5 = load8(c + sub_w + 2);
        e7 = load8(c + 2 * sub_w + 2);
    }
    var v0 = load8(v);
    var v1 = load8(v + 1);
    var v2 = load8(v + 2);
    var v3 = load8(v + 3);
    var v4 = load8(v + 4);
    var v5 = load8(v + 5);
    # 1. Directional. The left and right columns each share a max of three.
    var lft = e4;                         # max(e2, e4, e6)
    if (e2 > lft) { lft = e2; }
    if (e6 > lft) { lft = e6; }
    var rgt = e5;                         # max(e3, e5, e7)
    if (e3 > rgt) { rgt = e3; }
    if (e7 > rgt) { rgt = e7; }
    var m = top;                          # v0 <- e0 e1 e2 e4
    if (e2 > m) { m = e2; }
    if (e4 > m) { m = e4; }
    if (v0 > m) { m = v0; }
    var d0 = v0;
    if (v0 != m && v0 != 0) { d0 = _ascii_contrast_step(v0, m); }
    m = top;                              # v1 <- e0 e1 e3 e5
    if (e3 > m) { m = e3; }
    if (e5 > m) { m = e5; }
    if (v1 > m) { m = v1; }
    var d1 = v1;
    if (v1 != m && v1 != 0) { d1 = _ascii_contrast_step(v1, m); }
    m = lft;                              # v2 <- e2 e4 e6
    if (v2 > m) { m = v2; }
    var d2 = v2;
    if (v2 != m && v2 != 0) { d2 = _ascii_contrast_step(v2, m); }
    m = rgt;                              # v3 <- e3 e5 e7
    if (v3 > m) { m = v3; }
    var d3 = v3;
    if (v3 != m && v3 != 0) { d3 = _ascii_contrast_step(v3, m); }
    m = bot;                              # v4 <- e4 e6 e8 e9
    if (e4 > m) { m = e4; }
    if (e6 > m) { m = e6; }
    if (v4 > m) { m = v4; }
    var d4 = v4;
    if (v4 != m && v4 != 0) { d4 = _ascii_contrast_step(v4, m); }
    m = bot;                              # v5 <- e5 e7 e8 e9
    if (e5 > m) { m = e5; }
    if (e7 > m) { m = e7; }
    if (v5 > m) { m = v5; }
    var d5 = v5;
    if (v5 != m && v5 != 0) { d5 = _ascii_contrast_step(v5, m); }
    # 2. Global, against the largest value step 1 left.
    m = d0;
    if (d1 > m) { m = d1; }
    if (d2 > m) { m = d2; }
    if (d3 > m) { m = d3; }
    if (d4 > m) { m = d4; }
    if (d5 > m) { m = d5; }
    if (d0 != m && d0 != 0) { d0 = _ascii_contrast_step(d0, m); }
    if (d1 != m && d1 != 0) { d1 = _ascii_contrast_step(d1, m); }
    if (d2 != m && d2 != 0) { d2 = _ascii_contrast_step(d2, m); }
    if (d3 != m && d3 != 0) { d3 = _ascii_contrast_step(d3, m); }
    if (d4 != m && d4 != 0) { d4 = _ascii_contrast_step(d4, m); }
    if (d5 != m && d5 != 0) { d5 = _ascii_contrast_step(d5, m); }
    store8(v,     d0);
    store8(v + 1, d1);
    store8(v + 2, d2);
    store8(v + 3, d3);
    store8(v + 4, d4);
    store8(v + 5, d5);
    return 0;
}

# _ascii_match — given a 6-byte region-luminance vector `v` (row-major:
# r0c0 r0c1 r1c0 r1c1 r2c0 r2c1, each 0..255), return the glyph byte whose
# coverage vector is nearest in squared-Euclidean distance. Ties resolve to
# the lower index (strict `<`), so glyph 0 (space) wins an all-dark cell.
# Max distance 6*255^2 ~= 390k — well within i64.
#
# P(-1) O-3 (v1.6.4): the 6 region values are loaded once per cell rather
# than once per glyph, the coverage table is walked by pointer, and a glyph
# stops being scored once its first three terms already reach best_d. That
# is exact: the remaining terms are >= 0 and a glyph needs d < best_d to
# win, so the pick never changes (checked on 20 M vectors against the old
# body). With O-1 it makes the ASCII lane's emit ~2x faster.
fn _ascii_match(v): i64 {
    if (_ascii_shape_inited == 0) { _ascii_shape_init(); }
    var v0 = load8(v);
    var v1 = load8(v + 1);
    var v2 = load8(v + 2);
    var v3 = load8(v + 3);
    var v4 = load8(v + 4);
    var v5 = load8(v + 5);
    # Seed with glyph 0 so the loop body needs no sentinel.
    var cp = &ASCII_SHAPE_COV;
    var e = v0 - load64(cp);
    var best_d = e * e;
    e = v1 - load64(cp + 8);  best_d = best_d + e * e;
    e = v2 - load64(cp + 16); best_d = best_d + e * e;
    e = v3 - load64(cp + 24); best_d = best_d + e * e;
    e = v4 - load64(cp + 32); best_d = best_d + e * e;
    e = v5 - load64(cp + 40); best_d = best_d + e * e;
    var best_g = 0;
    var g = 1;
    cp = cp + 48;
    while (g < ASCII_SHAPE_COUNT) {
        e = v0 - load64(cp);
        var d = e * e;
        e = v1 - load64(cp + 8);  d = d + e * e;
        e = v2 - load64(cp + 16); d = d + e * e;
        if (d < best_d) {
            e = v3 - load64(cp + 24); d = d + e * e;
            e = v4 - load64(cp + 32); d = d + e * e;
            e = v5 - load64(cp + 40); d = d + e * e;
            if (d < best_d) {
                best_d = d;
                best_g = g;
            }
        }
        g = g + 1;
        cp = cp + 48;
    }
    return load64(&ASCII_SHAPE_GLYPHS + best_g * 8);
}

# emit_ascii_shape_row_buf — render ONE character row (cell row `cy`) into
# `buf` at `pos`. `rgb` is the finer (sub_w x sub_h) downscaled RGB buffer
# where sub_w = cols*2; each cell pulls its 2x3 sub-samples, builds the
# 6-region luminance vector, matches a glyph, and colours it with the cell's
# mean colour at the active tier (kii_color_code_at). Returns the new pos, or
# -1. (Buffer-targeting so tests can assert the exact bytes — same split as
# emit_halfblock_row_buf.)
#
# v1.9.0: `codes` is the cell-colour buffer _ascii_cell_codes builds under
# --dither fs (one 32-bit code per cell, row-major, error-diffused across
# cells); 0 makes the row compute each cell's colour itself with
# kii_color_code_at, which applies the ordered offset under --dither ordered
# and is v1.8.0's kii_color_code under none.
#
# v1.8.0: `mask` is downscale's transparency mask (or 0 when nothing is
# transparent). A transparent sample counts as no ink (luminance 0) and is
# left out of the cell's mean colour, so a fully transparent cell is a space
# on the terminal's default background. A space takes no fg escape at all,
# and an fg that repeats the one this row last set is elided; the row state
# starts unknown, so every row is self-contained.
#
# v1.10.0: `lum` is the frame's luminance plane (_ascii_lum_plane), from which
# the row takes each cell's six values, and `sub_h` the sub-sample height, so the
# contrast pass (_ascii_contrast) can read the samples just outside the cell and
# treat those past the frame's edge as dark.
fn emit_ascii_shape_row_buf(rgb, mask, lum, codes, sub_w, sub_h, cy, cols, buf, pos): i64 {
    # The three sub-sample rows of this character row are fixed for the whole
    # row, so their base is computed once (O-3). The 6 samples are visited in
    # region order r0c0 r0c1 r1c0 r1c1 r2c0 r2c1: step right after an even k,
    # down-and-left after an odd one.
    var stride = sub_w * 3;
    var r0 = rgb + (cy * 3) * stride;
    var l0 = lum + (cy * 3) * sub_w;
    var m0 = 0;
    if (mask != 0) { m0 = mask + (cy * 3) * sub_w; }
    var vec[6];
    var cur_fg = 0 - 1;
    var cx = 0;
    while (cx < cols) {
        var sumr = 0;
        var sumg = 0;
        var sumb = 0;
        var opaque = 0;
        var rp = r0 + cx * 6;
        var lp = l0 + cx * 2;
        var mp = 0;
        if (m0 != 0) { mp = m0 + cx * 2; }
        var k = 0;
        while (k < 6) {
            # The plane already holds 0 for a transparent sample; only the
            # colour mean needs the mask.
            store8(&vec + k, load8(lp));
            if (mp == 0 || load8(mp) == 0) {
                sumr = sumr + load8(rp + 0);
                sumg = sumg + load8(rp + 1);
                sumb = sumb + load8(rp + 2);
                opaque = opaque + 1;
            }
            if (k % 2 == 0) {
                rp = rp + 3;
                lp = lp + 1;
                if (mp != 0) { mp = mp + 1; }
            } else {
                rp = rp - 3 + stride;
                lp = lp - 1 + sub_w;
                if (mp != 0) { mp = mp - 1 + sub_w; }
            }
            k = k + 1;
        }
        # An all-dark cell is a space without the contrast pass or the match:
        # contrast leaves zeros at zero, and the space (glyph 0, no ink) is at
        # distance 0 and wins every tie.
        var glyph = 32;
        if (opaque > 0 && (load8(&vec) | load8(&vec + 1) | load8(&vec + 2)
                | load8(&vec + 3) | load8(&vec + 4) | load8(&vec + 5)) != 0) {
            _ascii_contrast(&vec, lum, sub_w, sub_h, cx, cy);
            glyph = _ascii_match(&vec);
        }
        if (glyph != 32) {
            var fg = 0;
            if (codes != 0) { fg = load32(codes + (cy * cols + cx) * 4); }
            else { fg = kii_color_code_at(sumr / opaque, sumg / opaque, sumb / opaque, cx, cy); }
            if (fg != cur_fg) {
                pos = _kii_sgr_fg(buf, pos, fg);
                if (pos < 0) { return 0 - 1; }
                cur_fg = fg;
            }
        }
        store8(buf + pos, glyph);
        pos = pos + 1;
        cx = cx + 1;
    }
    return _kii_row_end(buf, pos);
}

# The row builder _kii_emit_frame calls for this lane, in its (src, w, row,
# buf, pos) shape: `src` is the pstruct, so the row can reach the RGB buffer,
# the transparency mask and, under --dither fs, the cell codes (kept in the
# QUANTIZED slot, which this lane does not otherwise use; 0 otherwise), and the cell count is derived
# from the sub-sample width.
fn _ascii_frame_row(pstruct, sub_w, cy, buf, pos): i64 {
    return emit_ascii_shape_row_buf(load64(pstruct + STRUCT_DOWNSCALED_BUF_OFFSET),
        load64(pstruct + STRUCT_ALPHA_MASK_OFFSET), load64(pstruct + STRUCT_LUMA_PLANE_OFFSET),
        load64(pstruct + STRUCT_QUANTIZED_BUF_OFFSET),
        sub_w, load64(pstruct + STRUCT_DOWNSCALED_H_OFFSET), cy, sub_w / 2, buf, pos);
}

# The colour of every cell, quantized together so Floyd-Steinberg can carry
# error from cell to cell (v1.9.0). A cell's colour is the mean of its opaque
# samples, exactly as the row computes it; a cell with no opaque sample is
# transparent. The cols × rows means then go through quantize_rgb_buf, which
# applies the active dither. Only --dither fs needs this pass: without it
# the row quantizes each cell itself (kii_color_code_at, which applies the
# ordered offset), so none and ordered skip the extra pass and allocations.
# Returns the code buffer (4 bytes a cell), or 0 on an allocation failure.
fn _ascii_cell_codes(rgb, mask, sub_w, cols, rows): i64 {
    var cells = cols * rows;
    var mean = alloc(cells * 3);
    var cmask = alloc(cells);
    var codes = alloc(cells * 4);
    if (mean == 0 || cmask == 0 || codes == 0) { return 0; }
    var any_t = 0;
    var stride = sub_w * 3;
    var cy = 0;
    while (cy < rows) {
        var cx = 0;
        while (cx < cols) {
            var sumr = 0;
            var sumg = 0;
            var sumb = 0;
            var opaque = 0;
            var rr = 0;
            while (rr < 3) {
                var cc = 0;
                while (cc < 2) {
                    var sx = cx * 2 + cc;
                    var sy = cy * 3 + rr;
                    if (mask == 0 || load8(mask + sy * sub_w + sx) == 0) {
                        var o = rgb + sy * stride + sx * 3;
                        sumr = sumr + load8(o);
                        sumg = sumg + load8(o + 1);
                        sumb = sumb + load8(o + 2);
                        opaque = opaque + 1;
                    }
                    cc = cc + 1;
                }
                rr = rr + 1;
            }
            var ci = cy * cols + cx;
            if (opaque == 0) {
                store8(mean + ci * 3, 0); store8(mean + ci * 3 + 1, 0); store8(mean + ci * 3 + 2, 0);
                store8(cmask + ci, 1);
                any_t = 1;
            } else {
                store8(mean + ci * 3,     sumr / opaque);
                store8(mean + ci * 3 + 1, sumg / opaque);
                store8(mean + ci * 3 + 2, sumb / opaque);
                store8(cmask + ci, 0);
            }
            cx = cx + 1;
        }
        cy = cy + 1;
    }
    if (any_t == 0) { cmask = 0; }
    if (quantize_rgb_buf(mean, cmask, cols, rows, codes) != 0) { return 0; }
    return codes;
}

# emit_ascii_shape — render the full frame to fd 1 (stdout). Reads
# STRUCT_DOWNSCALED_* (the finer (cols*2 x rows*3) RGB buffer main.cyr
# produces for ASCII mode) and the transparency mask; under --dither fs it
# first quantizes every cell's colour as one field (_ascii_cell_codes,
# v1.9.0). Returns 0, -1 if downscale wasn't run / dims invalid or the
# luminance plane (v1.10.0) or cell codes cannot be allocated, or -2 if a
# write to stdout failed.
# The loop is the shared _kii_emit_frame (src/emit.cyr). Per-row heap buffer
# sized from cols (no fixed-stack overflow — the v1.2.1 lesson): each cell
# is at most a 19-byte truecolour fg + 1 glyph, + the per-row reset/LF.
fn emit_ascii_shape(pstruct): i64 {
    var rgb = load64(pstruct + STRUCT_DOWNSCALED_BUF_OFFSET);
    var sub_w = load64(pstruct + STRUCT_DOWNSCALED_W_OFFSET);
    var sub_h = load64(pstruct + STRUCT_DOWNSCALED_H_OFFSET);
    if (rgb == 0) { return 0 - 1; }
    if (sub_w < 2 || sub_h < 3) { return 0 - 1; }
    var mask = load64(pstruct + STRUCT_ALPHA_MASK_OFFSET);
    var lum = _ascii_lum_plane(rgb, mask, sub_w, sub_h);
    if (lum == 0) { return 0 - 1; }
    store64(pstruct + STRUCT_LUMA_PLANE_OFFSET, lum);
    var codes = 0;
    if (quant_dither() == KII_DITHER_FS && quant_tier() != KII_TIER_TC) {
        codes = _ascii_cell_codes(rgb, mask, sub_w, sub_w / 2, sub_h / 3);
        if (codes == 0) { return 0 - 1; }
    }
    store64(pstruct + STRUCT_QUANTIZED_BUF_OFFSET, codes);
    return _kii_emit_frame(&_ascii_frame_row, pstruct, sub_w, sub_h / 3, (sub_w / 2) * 21 + 16);
}
