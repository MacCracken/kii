# emit.cyr — half-block (▀) ANSI emit layer.
#
# v0.6.0 / M5 — the first user-visible terminal output for kii. The
# quantize stage leaves one colour code per pixel at
# STRUCT_QUANTIZED_BUF_OFFSET; this module reads that buffer two
# source-rows at a time and emits half-block glyphs so each terminal
# character carries TWO source pixels stacked vertically:
#   - top half     → FG colour
#   - bottom half  → BG colour
#   - glyph        → U+2580 UPPER HALF BLOCK (▀)
# Since v2.1.0 the same two colours may be drawn the other way round, as ▄
# with the bottom in the fg, or a one-colour cell as a space or █, whichever
# needs fewer escapes (emit_halfblock_row_buf; ADR 0004 § v2.1.0). The four
# glyphs are all in CP437.
#
# Why half-block: doubles vertical resolution per character row with
# no extra width cost. This is the chafa / jp2a / viu canonical floor
# glyph and the BBS/MUD aesthetic kii was scoped to deliver.
#
# The emit rework (v1.8.0, ADR 0010) changed three things:
#   - Escapes per tier. Tier 8 uses SGR 30–37 / 40–47, tier 16 adds the
#     bright 90–97 / 100–107, tier 256 `38;5;N` / `48;5;N`, truecolour
#     `38;2;R;G;B` / `48;2;R;G;B`, and a transparent half SGR 39 / 49 (the
#     terminal's default colour). Through v1.7.0 tiers 8 and 16 sent
#     `38;5;N`, which a strict 16-colour terminal or BBS client — the tier-1
#     floor's audience — may not parse.
#   - Elision. Each row tracks the fg and bg it last set and skips an escape
#     that would repeat it (61–87 % less output in the v1.6.4 sweep's
#     measurement). The state starts unknown on every row, so each row is
#     still self-contained.
#   - Transparency. A transparent half takes the default colour, and the
#     glyph is chosen so the opaque half keeps its colour: ▀ (fg = top) when
#     the bottom is transparent, ▄ (fg = bottom) when the top is, a space
#     when both are.
#
# Output sizing: the frame is sized by main.cyr's geometry resolver —
# `--width N`, or the terminal's own size via `_kii_term_envelope` below,
# falling back to 80×24 off a TTY. Each character row covers 2 source rows,
# and downscale.cyr resamples to that size BEFORE quantization.
#
# darshana surface used (each returns the new pos, or -1 on a rejected
# input — a negative incoming pos or an out-of-range value — and writes
# nothing when it rejects, which is what lets a row chain them through
# one `pos`):
#   tty_sgr_buf(buf, pos, code)      — CSI <code>m (30–37, 39, 40–47, 49, 90–97, 100–107)
#   tty_fg_256_buf / tty_bg_256_buf  — CSI 38;5;Nm / 48;5;Nm
#   tty_fg_rgb_buf / tty_bg_rgb_buf  — CSI 38;2;R;G;Bm / 48;2;R;G;Bm
#   tty_sgr_reset_buf(buf, pos)      — CSI 0m
#
# v1.6.0: the 256-colour background composer is darshana's. kii carried a local
# `_emit_bg_256_buf` from v0.6.0 because darshana had no BG twin; kii was
# the first consumer of one, and darshana extracted it at 1.2.0 when a
# second consumer (thoth) arrived — the extract-on-2nd-consumer move the
# local helper's own comment named.

include "src/palette.cyr"
include "src/image.cyr"
include "src/quant.cyr"

# Half-block output geometry defaults. These are the floor used when
# both `--width` and tty detection fall through — chosen to match the
# original BBS / VT100 80×24 frame so non-TTY output stays useful
# without user intervention. M6 introduces tty_winsize-driven runtime
# geometry; the actual emit dimensions live in pstruct's
# STRUCT_DOWNSCALED_W/_H slots, computed by
# `_kii_compute_target_geometry` below.
var EMIT_DEFAULT_COLS = 80;
var EMIT_DEFAULT_ROWS = 24;

# UTF-8 byte sequence for U+2580 UPPER HALF BLOCK (▀). Hot path —
# emitted once per character (up to 80 × 24 = 1920 times per frame),
# so we keep it as raw bytes rather than walking a string literal.
var EMIT_HALFBLOCK_B0 = 0xE2;
var EMIT_HALFBLOCK_B1 = 0x96;
var EMIT_HALFBLOCK_B2 = 0x80;
# U+2584 LOWER HALF BLOCK (▄) and U+2588 FULL BLOCK (█) share the first two
# bytes. ▄ is drawn when a cell's top half is transparent (v1.8.0), or when
# swapping the colours saves an escape (v2.1.0); █ draws a one-colour cell
# whose colour is already the foreground (v2.1.0).
var EMIT_LOWERHALF_B2 = 0x84;
var EMIT_FULLBLOCK_B2 = 0x88;

# The most bytes one half-block cell can take: a 19-byte truecolour fg and
# bg escape plus the 3-byte glyph. Rows are sized from it (sw * 42 + 16).
var EMIT_CELL_MAX = 41;

# ---- tier-aware SGR (v1.8.0) ----------------------------------------
# Append the escape that sets the foreground to colour code `code` (see
# quant.cyr: a palette index, a packed truecolour 0xRRGGBB, or
# KII_COLOR_DEFAULT) at the active tier. Returns the new pos, or -1 if the
# code is not a colour of that tier (darshana's composers refuse it too).
# --color none (v2.2.0) has no colours, so it refuses every code, the
# default's 39 included: that tier sends no SGR at all.
fn _kii_sgr_fg(buf, pos, code): i64 {
    var tier = quant_tier();
    if (tier == KII_TIER_NONE) { return 0 - 1; }
    if (code == KII_COLOR_DEFAULT) { return tty_sgr_buf(buf, pos, 39); }
    if (tier == KII_TIER_TC) {
        return tty_fg_rgb_buf(buf, pos, (code >> 16) & 255, (code >> 8) & 255, code & 255);
    }
    if (tier == KII_TIER_256) { return tty_fg_256_buf(buf, pos, code); }
    if (code >= 0 && code < 8)  { return tty_sgr_buf(buf, pos, 30 + code); }
    # Bright 90–97 is tier 16 only: tier 8 promises SGR 30–37 and nothing else.
    if (tier == KII_TIER_16 && code >= 8 && code < 16) { return tty_sgr_buf(buf, pos, 82 + code); }
    return 0 - 1;
}

# The background twin of _kii_sgr_fg: SGR 49, 48;2, 48;5, 40–47 or 100–107.
fn _kii_sgr_bg(buf, pos, code): i64 {
    var tier = quant_tier();
    if (tier == KII_TIER_NONE) { return 0 - 1; }
    if (code == KII_COLOR_DEFAULT) { return tty_sgr_buf(buf, pos, 49); }
    if (tier == KII_TIER_TC) {
        return tty_bg_rgb_buf(buf, pos, (code >> 16) & 255, (code >> 8) & 255, code & 255);
    }
    if (tier == KII_TIER_256) { return tty_bg_256_buf(buf, pos, code); }
    if (code >= 0 && code < 8)  { return tty_sgr_buf(buf, pos, 40 + code); }
    if (tier == KII_TIER_16 && code >= 8 && code < 16) { return tty_sgr_buf(buf, pos, 92 + code); }   # 100–107
    return 0 - 1;
}

# Compute target output dimensions from source W/H + an optional
# --width flag. Writes the dst column count + dst source-row count
# (= dst terminal-row count × 2) into the caller-provided i64 slots.
# Returns 0 on success, -1 on invalid source dimensions or cell.
#
# **Aspect math** (half-block-aware):
# - A terminal "row" carries TWO source pixels stacked vertically
#   (top half = FG, bottom half = BG of one ▀ glyph).
# - A terminal "col" carries ONE source pixel horizontally.
# - The cell is `cw` × `ch` device pixels (v2.7.0, ADR 0015): measured
#   from the terminal, given by --cell-size, or 10 × 20. Preserving the
#   image's aspect ratio means a frame `dst_cols` cells wide is
#   dst_cols × cw pixels, and its rows ch pixels each:
#     dst_rows × ch / (dst_cols × cw) = src_h / src_w
#     dst_rows = (src_h × dst_cols × cw) / (src_w × ch)
#   A 1:2 cell (10 × 20, the only cell through v2.6.0) gives
#     dst_rows = (src_h × dst_cols) / (src_w × 2)
#   with the same rounding, so its frames are the v2.6.0 frames.
#
# **Width selection** (M6(a) — first cut):
# - `width_flag > 0` → that exact value (user override).
# - Otherwise → `EMIT_DEFAULT_COLS` (80). M6(b) replaces the fallback
#   with `tty_winsize`-driven detection on fd 1.
#
# **Minimum**: a 1-pixel source still produces a 1-row output, not 0.
# Useful for pathological tiny inputs (avoids zero-height frames the
# emit layer would reject as a bounds error).
fn _kii_compute_target_geometry(src_w, src_h, width_flag, cw, ch, out_dst_w, out_dst_src_rows): i64 {
    if (src_w <= 0 || src_h <= 0) { return 0 - 1; }
    if (cw <= 0 || ch <= 0) { return 0 - 1; }

    var dst_cols = EMIT_DEFAULT_COLS;
    if (width_flag > 0) { dst_cols = width_flag; }

    # Aspect-derived terminal rows. Integer division truncates toward
    # zero — clamp to ≥ 1 so single-row outputs are still well-formed.
    var dst_rows = (src_h * dst_cols * cw) / (src_w * ch);
    if (dst_rows < 1) { dst_rows = 1; }

    store64(out_dst_w,        dst_cols);
    store64(out_dst_src_rows, dst_rows * 2);
    return 0;
}

# Aspect-preserving FIT into a `max_cols × max_rows` envelope.
# Returns the largest dst (cols, src_rows) that:
#   (1) preserves the source aspect ratio (in source-pixel space)
#   (2) fits within max_cols columns AND max_rows terminal rows
# Either constraint can bind:
#   - Width-binding (image is "wider than the cell aspect of the
#     envelope"): dst_cols = max_cols; height derives from aspect.
#   - Row-binding (image is "taller than the cell aspect"): dst_term
#     rows = max_rows; width derives from aspect, will be < max_cols.
#
# Why this differs from `_kii_compute_target_geometry`:
# That M6(a) primitive does pure width-driven aspect derivation — used
# when the user explicitly says `--width N` and we honor it regardless
# of how tall the result becomes (useful for `kii img.png > big.ansi`
# captures). This fit primitive is the auto-detected path where we
# don't want to overflow the user's terminal in either direction.
#
# Defaults: a `max_cols <= 0` arg is treated as EMIT_DEFAULT_COLS;
# `max_rows <= 0` as EMIT_DEFAULT_ROWS. So passing both as 0 gives the
# classic 80×24 envelope — the non-TTY fallback main.cyr uses.
#
# The cell is `cw` × `ch` pixels, as in `_kii_compute_target_geometry`
# (v2.7.0); a 1:2 cell gives the v2.6.0 answer exactly.
fn _kii_compute_fit_geometry(src_w, src_h, max_cols, max_rows, cw, ch, out_dst_w, out_dst_src_rows): i64 {
    if (src_w <= 0 || src_h <= 0) { return 0 - 1; }
    if (cw <= 0 || ch <= 0) { return 0 - 1; }

    var cols = max_cols;
    var rows = max_rows;
    if (cols <= 0) { cols = EMIT_DEFAULT_COLS; }
    if (rows <= 0) { rows = EMIT_DEFAULT_ROWS; }

    # Width-binding candidate: use full `cols`, derive aspect-true
    # terminal rows. dst_rows_at_cols = (src_h × cols × cw) / (src_w × ch).
    var dst_rows_at_cols = (src_h * cols * cw) / (src_w * ch);

    var dst_w_final  = 0;
    var dst_sr_final = 0;
    if (dst_rows_at_cols <= rows) {
        # Width binds; height fits inside `rows`. Honor it.
        dst_w_final = cols;
        if (dst_rows_at_cols < 1) { dst_rows_at_cols = 1; }
        dst_sr_final = dst_rows_at_cols * 2;
    } else {
        # Row binds; derive aspect-true cols from `rows` and shrink.
        # dst_src_rows = rows × 2; dst_cols = (rows × ch × src_w) / (src_h × cw),
        # which a 1:2 cell makes (dst_src_rows × src_w) / src_h.
        var dst_src_rows_at_rows = rows * 2;
        var dst_cols_at_rows = (rows * ch * src_w) / (src_h * cw);
        if (dst_cols_at_rows < 1) { dst_cols_at_rows = 1; }
        dst_w_final  = dst_cols_at_rows;
        dst_sr_final = dst_src_rows_at_rows;
    }

    store64(out_dst_w,        dst_w_final);
    store64(out_dst_src_rows, dst_sr_final);
    return 0;
}

# Terminal envelope from a `tty_winsize` answer — the auto-detect half of
# the geometry resolver (main.cyr's `--width 0` path), split out at v1.6.0
# so the rule is testable without a pty. Writes the column and row limits
# to hand `_kii_compute_fit_geometry`, where 0 means "unknown, use
# EMIT_DEFAULT_*". Always returns 0.
#
#   - detect_rc != 0 (not a TTY, or the console is not up) → 0 x 0, i.e.
#     the 80 x 24 default envelope.
#   - Columns and rows are decided SEPARATELY (v1.5.1, audit A-8): a
#     dimension the terminal reports as > 0 is used, a 0 one falls back
#     on its own. A 1-row terminal keeps its single row; any taller one
#     gives up one row so the shell prompt lands below the frame.
#   - A TTY that reports 0 rows gets EMIT_DEFAULT_ROWS - 1, not the bare
#     default (P(-1), v1.6.4). 0 x 0 is how a serial line or a telnet
#     session without size negotiation looks, and the full 24 rows scrolled
#     the frame's top row off a real 24-row screen, where a measured 24-row
#     pty got 23. Off a TTY the envelope stays 0 x 0 (the 80 x 24 frame a
#     pipe has always received), since there is no prompt to make room for.
#
# Why not darshana's `tty_winsize_or` (1.2.0), which exists to replace
# hand-written zero guards like this one: it treats a 0 in EITHER
# dimension as "size unknown" and substitutes both defaults. kii keeps
# the per-dimension rule on purpose. A half-set winsize is how a serial
# or BBS-style line looks after `stty cols 40` with no `stty rows` (the
# kernel default is 0 x 0), and under the both-or-neither rule kii would
# draw an 80-column frame onto the 40-column line the kernel just
# reported — the A-8 failure (a frame wider than the measured terminal)
# reintroduced. `tty_winsize_or` is the right call for a consumer whose
# defaults are a terminal size; kii's are an envelope, and it also needs
# to know whether the size was measured, to reserve the prompt row.
fn _kii_term_envelope(detect_rc, term_rows, term_cols, out_fit_cols, out_fit_rows): i64 {
    var fit_cols = 0;
    var fit_rows = 0;
    if (detect_rc == 0) {
        if (term_cols > 0) { fit_cols = term_cols; }
        if (term_rows > 1) { fit_rows = term_rows - 1; }
        else {
            if (term_rows == 1) { fit_rows = 1; }
            else { fit_rows = EMIT_DEFAULT_ROWS - 1; }
        }
    }
    store64(out_fit_cols, fit_cols);
    store64(out_fit_rows, fit_rows);
    return 0;
}

# emit_halfblock_row_buf — render ONE terminal row of half-block
# glyphs into a caller-owned byte buffer. Returns the new pos (byte
# count appended), or -1 if a code is not a colour of the active tier.
#
# `row` is the terminal row (0 ≤ row < src_h / 2), so we read source
# rows (2*row) and (2*row+1). `qbuf` is the source-resolution colour-code
# buffer, 4 bytes per pixel (qbuf + (sy*sw + sx)*4; see quant.cyr).
#
# Per cell, the top colour shows in the top half and the bottom colour in
# the bottom half. An fg or bg escape is written only when it differs from
# the one this row last set; both start unknown, so the first cell of every
# row sets what it uses. Of the encodings that show the cell's two colours,
# the row takes the one needing fewest escapes (v2.1.0, ADR 0004 § v2.1.0;
# the blocks lane's rule, ADR 0012):
#   - A transparent half (KII_COLOR_DEFAULT) is the terminal's default
#     background, so it can only be drawn as one: ▀ with fg = top when only
#     the bottom is transparent, ▄ with fg = bottom when only the top is, a
#     space when both are (v1.8.0).
#   - Two different colours: ▀ (fg = top, bg = bottom) or ▄ (fg = bottom,
#     bg = top), whichever needs fewer escapes; a tie keeps ▀.
#   - One colour q: a space on bg q, or █ in fg q when the fg is already q and
#     the bg is not. Either needs one escape at most, against ▀'s two.
# At tier 16 a bright colour (8–15) is never put in the background when the
# foreground can take it: the Linux console draws 100–107 as 40–47, so a
# bright half in the bg would show dim there. A one-colour bright cell is
# █, and a cell with one bright half puts that half in the fg. Only a cell
# whose halves are two different brights still has a bright bg, as every
# 16-colour cell did before v2.1.0. On a terminal with 16 background colours
# every choice shows the same two colours.
#
# Buffer-targeting (not a fd-1 write) so tests can assert on the
# exact byte sequence without subprocessing. emit_halfblock below
# wraps this for the production fd-1 case.
fn emit_halfblock_row_buf(qbuf, sw, row, buf, pos): i64 {
    var cur_fg = 0 - 1;
    var cur_bg = 0 - 1;
    var t16 = 0;
    if (quant_tier() == KII_TIER_16) { t16 = 1; }
    var top_p = qbuf + (2 * row) * sw * 4;
    var bot_p = top_p + sw * 4;
    var col = 0;
    while (col < sw) {
        var top = load32(top_p + col * 4);
        var bot = load32(bot_p + col * 4);
        var fg = top;
        var bg = bot;
        var glyph_b2 = EMIT_HALFBLOCK_B2;                 # ▀
        if (top == KII_COLOR_DEFAULT) {
            if (bot == KII_COLOR_DEFAULT) {
                glyph_b2 = 0;                             # both transparent: a space
            } else {
                fg = bot;                                 # ▄ keeps the bottom's colour
                bg = KII_COLOR_DEFAULT;
                glyph_b2 = EMIT_LOWERHALF_B2;
            }
        } else {
            if (top == bot) {
                if (_kii_hb_bright(t16, top) == 1 || (cur_fg == top && cur_bg != top)) {
                    glyph_b2 = EMIT_FULLBLOCK_B2;         # █ in the fg
                } else {
                    glyph_b2 = 0;                         # a space on the bg
                }
            } else {
                if (bot != KII_COLOR_DEFAULT) {
                    var tb = _kii_hb_bright(t16, top);
                    var bb = _kii_hb_bright(t16, bot);
                    var flip = 0;
                    if (tb != bb) { flip = bb; }
                    else {
                        var up = 0;
                        var dn = 0;
                        if (top != cur_fg) { up = up + 1; }
                        if (bot != cur_bg) { up = up + 1; }
                        if (bot != cur_fg) { dn = dn + 1; }
                        if (top != cur_bg) { dn = dn + 1; }
                        if (dn < up) { flip = 1; }
                    }
                    if (flip == 1) {
                        fg = bot;
                        bg = top;
                        glyph_b2 = EMIT_LOWERHALF_B2;
                    }
                }
            }
        }
        if (glyph_b2 != 0 && fg != cur_fg) {
            pos = _kii_sgr_fg(buf, pos, fg);
            if (pos < 0) { return 0 - 1; }
            cur_fg = fg;
        }
        if (glyph_b2 != EMIT_FULLBLOCK_B2 && bg != cur_bg) {
            pos = _kii_sgr_bg(buf, pos, bg);
            if (pos < 0) { return 0 - 1; }
            cur_bg = bg;
        }
        if (glyph_b2 == 0) {
            store8(buf + pos, 32); pos = pos + 1;
        } else {
            store8(buf + pos, EMIT_HALFBLOCK_B0);
            store8(buf + pos + 1, EMIT_HALFBLOCK_B1);
            store8(buf + pos + 2, glyph_b2);
            pos = pos + 3;
        }
        col = col + 1;
    }
    return _kii_row_end(buf, pos);
}

# 1 if `code` is a bright palette index (8–15) and the row is at tier 16, the
# only tier whose codes 8–15 are the aixterm brights (at truecolour they are
# packed RGB values, and tier 256 never emits 0–15).
fn _kii_hb_bright(t16, code): i64 {
    if (t16 == 1 && code >= 8 && code < 16) { return 1; }
    return 0;
}

# The row ending both render lanes use: SGR reset + newline, so each row
# resets colour state before the next row's escapes. Without the reset an
# aborted write (e.g. SIGPIPE mid-frame) could leave the terminal stuck in a
# coloured state. Returns the new pos.
fn _kii_row_end(buf, pos): i64 {
    pos = tty_sgr_reset_buf(buf, pos);
    store8(buf + pos, 10);                       # '\n'
    return pos + 1;
}

# ---- short-write-safe stdout writer --------------------------------
# P-1 (v1.5.1). Both frame emitters used to call `syscall(1, 1, buf, n)`
# and DISCARD the result, so kii returned 0 after a wholly-failed frame:
# `kii img.png > out.ansi` on a full filesystem exited 0 having written
# nothing, and a shell `kii ... > out && use out` happily consumed the
# empty file. write(2) is also permitted to return a SHORT count on a
# pipe or a slow sink, which would silently truncate the ANSI stream
# mid-row.
#
# This loops until the buffer is drained, retries EINTR, and reports any
# real error to the caller, which propagates it to a non-zero exit.
# SIGPIPE keeps its default disposition on purpose — `kii img.png | head`
# should die by signal like any other Unix filter, so EPIPE is not
# something this function normally sees.
fn _kii_write_all(fd, buf, len): i64 {
    var off = 0;
    while (off < len) {
        var n = sys_write(fd, buf + off, len - off);
        if (n > 0) { off = off + n; }
        else {
            # EINTR (-4) is a retry, not a failure. Anything else — and a
            # nonsensical 0-byte return on a positive request — is fatal.
            if (n != 0 - 4) { return 0 - 1; }
        }
    }
    return 0;
}

# emit_halfblock — render the full quantized frame to fd 1 (stdout).
# Reads STRUCT_DOWNSCALED_W/H + STRUCT_QUANTIZED_BUF from pstruct.
# Per-row buffering: one write(2) per terminal row, ~2 KB each —
# 24 writes per frame vs. 1920+ if we wrote per-character.
#
# Returns 0 on success; -1 on:
#   - quantized buf not populated (quantize_downscaled wasn't called)
#   - dimensions invalid (W <= 0, H <= 0, or H not even — half-block
#     needs paired source rows so an odd source-height would dangle)
#   - the per-row scratch allocation failing
# and -2 when a write(2) to stdout fails (see `_kii_write_all`).
#
# There is no separate end-of-frame reset: every row already ends with
# CSI 0m (emit_halfblock_row_buf), so the terminal is left clean after
# the last row. (This comment used to promise a final reset the function
# has never emitted; corrected at v1.6.0.)
fn emit_halfblock(pstruct): i64 {
    var qbuf = load64(pstruct + STRUCT_QUANTIZED_BUF_OFFSET);
    var sw   = load64(pstruct + STRUCT_DOWNSCALED_W_OFFSET);
    var sh   = load64(pstruct + STRUCT_DOWNSCALED_H_OFFSET);
    if (qbuf == 0)        { return 0 - 1; }
    if (sw <= 0 || sh <= 0) { return 0 - 1; }
    if (sh % 2 != 0)      { return 0 - 1; }

    # Per-row scratch, sized from the ACTUAL width. Each cell is at most
    # EMIT_CELL_MAX = 41 bytes (a 19-byte truecolour fg and bg + the 3-byte
    # glyph; tier 1 needs at most 13, tier 256 25); the per-row tail is
    # tty_sgr_reset_buf (exactly 4) + LF (1). `sw * 42 + 16` bounds it
    # with margin. Heap-alloc (was a fixed `line_buf[2048]` stack buffer
    # — 2048 BYTES at function scope, sized for sw=80 — which
    # `emit_halfblock_row_buf` overflowed for sw ≳ 89, e.g.
    # `kii --width 200`). An absurd width fails the alloc and returns -1
    # cleanly rather than smashing the stack.
    return _kii_emit_frame(&emit_halfblock_row_buf, qbuf, sw, sh / 2, sw * (EMIT_CELL_MAX + 1) + 16);
}

# The frame loop both render lanes share (v1.7.0; R-8 of the v1.6.4 sweep —
# emit_halfblock and emit_ascii_shape each carried their own copy). One heap
# line buffer of `line_cap` bytes; for each of `rows` rows, `row_fn(src, w,
# row, buf, 0)` builds the row and _kii_write_all writes it. `row_fn` is a
# row builder taken by address and called with callptr. Returns 0, -1 if the
# buffer cannot be allocated or a row builder refuses, or -2 if a write to
# stdout fails (main reports that one distinctly).
fn _kii_emit_frame(row_fn, src, w, rows, line_cap): i64 {
    var line_buf = alloc(line_cap);
    if (line_buf == 0) { return 0 - 1; }
    var row = 0;
    while (row < rows) {
        var pos = callptr(row_fn, src, w, row, line_buf, 0);
        if (pos < 0) { return 0 - 1; }
        if (_kii_write_all(1, line_buf, pos) != 0) { return 0 - 2; }
        row = row + 1;
    }
    return 0;
}
