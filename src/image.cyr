# kii — image front-end (the chitra adapter): PNG + JPEG + BMP + GIF.
#
# THE FORMAT BROADENING (v1.5.0): re-pinning [deps.chitra] 0.3.0 -> 1.0.0
# brings BMP (chitra 0.4.0) and GIF first-frame (chitra 0.5.0) decode. The
# adapter needed NO decode change to gain them — it already called the
# format-sniffing chitra_image_decode unconditionally, so both formats
# normalized to canonical RGBA8 and rendered the moment the pin moved. What
# v1.5.0 adds here is DIAGNOSTICS, which do not come free: KII_FMT_BMP/GIF
# tags fed by chitra's bmp/gif signature predicates, kii_source_type_name
# learning chitra's 0x200|bpp and 0x300|min_code_size source sentinels (they
# printed as "?" under --verbose before), and _kii_map_chitra_err handling
# the eleven BMP/GIF/budget ChitraErr codes that previously all collapsed
# into the generic "malformed" fallback.
#
# THE JPEG WIRING (v1.4.0): the adapter calls chitra_image_decode, which
# sniffs the signature and routes to chitra's PNG or baseline-JPEG decoder,
# normalizing both to the same canonical RGBA8. kii renders .jpg/.jpeg with
# zero pipeline change — the adapter forwards JPEG's RGBA8 exactly as it does
# PNG's. Decode failures are phrased per detected format
# (STRUCT_FORMAT_OFFSET, set from the signature sniff before decode).
#
# THE RENAME (v1.7.0): this file was src/png.cyr, and its names predated
# JPEG — four releases after they started covering four formats. Now
# format-neutral, every numeric code unchanged: kii_decode_png →
# kii_decode_image, png_color_type_name → kii_source_type_name, PNG_OK →
# IMG_OK, and PNG_ERR_* → IMG_ERR_*, renamed for what each code means
# (HEADER → MALFORMED, CHUNK → TRUNCATED, NOT_PNG → UNRECOGNIZED,
# NO_IDAT → NO_IMAGE_DATA, INFLATE → DECOMPRESS, IDAT_TOO_LARGE → MEMORY;
# the reserved TRUNCATED (2) became SHORT_FILE to free the name).
#
# THE PNG RE-FOLD (v1.2.0): kii no longer carries its own PNG decoder.
# The 813-line native decoder (signature/IHDR/CRC32/chunk-walk/PLTE/
# sankoch-inflate/unfilter + the M7(c)/M8 security caps) was forked into
# the `chitra` distlib (`chitra` 0.1.0, 2026-06-19) so mabda could consume
# it; at chitra 0.2.0 that fork became a strict SUPERSET of kii's decoder
# (16-bit depth + every kii guard backported). kii now adopts it back —
# the same extract-on-2nd-consumer move kii made for CLI parsing with the
# `cmdit` distlib at v1.1.0. See [deps.chitra] in cyrius.cyml and
# docs/adr/0006-adopt-chitra-decoder.md.
#
# What stays in kii:
#   - the file I/O boundary (chitra takes in-memory bytes; kii owns the
#     read + a size cap the streaming decoder used to get for free),
#   - the pstruct contract + STRUCT_*_OFFSET layout that downscale.cyr /
#     quant.cyr / emit.cyr consume,
#   - the IMG_ERR_* code space and the text of each diagnostic
#     (kii_decode_error_text, below; chitra's ChitraErr codes map onto the
#     codes via _kii_map_chitra_err),
#   - kii_source_type_name (the --verbose source-format names),
#   - the ANSI-injection path sanitizer (cli.cyr/main.cyr — never decoder
#     code, untouched by the re-fold).
#
# The adapter writes chitra's canonical RGBA8 into the pstruct as a
# depth-8 color_type=6 image; downscale.cyr's color_type==6 (drop-alpha)
# branch consumes it verbatim, so the resampler / quantizer / emit layer
# are byte-for-byte unchanged. Output frames are identical to the native
# decoder for every valid depth-8 input, and 16-bit support is preserved
# (chitra reads the high byte, exactly as kii's old downscale/quant did).
#
# Stdlib (string/alloc/io/syscalls) + the chitra dist auto-resolve from
# cyrius.cyml — no includes here (manifest prepends them).

# ---- error codes ---------------------------------------------------
# kii-namespaced rather than leaking ChitraErr / IoError up to main.cyr.
# Main dispatch translates these into user-facing `<path>: <msg>`
# diagnostics; tests assert on the codes directly. The code space is the
# stable v1.0 surface; _kii_map_chitra_err (below) routes every ChitraErr
# onto one of these. Two codes are RESERVED — not produced via the chitra
# path but kept for the stable space + audit/ADR cross-refs:
#   - IMG_ERR_SHORT_FILE (2): chitra reports a <8-byte file as a signature
#     failure (-> IMG_ERR_UNRECOGNIZED), so the dedicated "shorter than 8
#     bytes" diagnostic is unreachable post-re-fold.
#   - IMG_ERR_RATIO_TOO_HIGH (14): chitra's ratio-bomb cap reports
#     CHITRA_ERR_DIMENSIONS (-> IMG_ERR_DIMENSIONS); the guard is intact,
#     only the distinct label collapses (documented in ADR 0006).
var IMG_OK            = 0;
var IMG_ERR_OPEN      = 1;  # File could not be opened (not found, perms, etc.)
var IMG_ERR_SHORT_FILE = 2;  # RESERVED (see header): <8-byte file now -> NOT_PNG
var IMG_ERR_UNRECOGNIZED   = 3;  # Signature did not match / empty file
var IMG_ERR_MALFORMED    = 4;  # Malformed chunk: length/type/order/IEND-len/palette (ChitraErr BAD_CHUNK)
var IMG_ERR_CRC       = 5;  # Chunk CRC32 mismatch
var IMG_ERR_TRUNCATED     = 6;  # Truncated chunk stream (ChitraErr TRUNCATED)
var IMG_ERR_INTERLACE = 7;  # Unrecognized interlace METHOD (the spec allows only
# 0 = none and 1 = Adam7). NOT "Adam7 unsupported" — this
# comment said that, and blamed chitra 0.2.1, for three
# releases after chitra 0.2.1 was the release that ADDED
# Adam7. kii has decoded interlaced PNG since v1.2.2 and
# tests/decode.tcyr asserts IMG_OK for it. (P-1, v1.5.1)
var IMG_ERR_BITDEPTH  = 8;  # A depth / colour-type pair PNG § 11.2.2 forbids (e.g. palette at 16)
var IMG_ERR_NO_IMAGE_DATA   = 9;  # Zero IDAT chunks (structurally valid but no pixel data)
var IMG_ERR_DECOMPRESS   = 10; # zlib_decompress failed or produced the wrong size
var IMG_ERR_FILTER    = 11; # Unknown filter byte (per-row filter ∈ {0,1,2,3,4} per spec § 9)
var IMG_ERR_DIMENSIONS= 12; # Dimensions/ratio exceed policy ceiling (lying-IHDR / bomb defense)
var IMG_ERR_MEMORY = 13; # OOM / IDAT-accumulator cap (ChitraErr OOM)
var IMG_ERR_RATIO_TOO_HIGH = 14; # RESERVED (see header): ratio bomb now -> DIMENSIONS
var IMG_ERR_FILE_TOO_LARGE = 15; # Input file exceeds KII_MAX_RAW_BYTES before any decode
# (DoS guard: the slurp holds the whole file in RAM, which
# the old streaming decoder avoided; cap it pre-read)
var IMG_ERR_UNSUPPORTED    = 16; # Valid image, but an unsupported feature. JPEG (chitra is
# baseline-only): progressive / arithmetic / 12-bit precision
# / non-baseline SOF mode / CMYK 4-component. BMP (v1.5.0):
# bpp outside {1,4,8,16,24,32} / BI_JPEG / BI_PNG / a bad
# BI_BITFIELDS mask. Kept distinct from IMG_ERR_BITDEPTH so
# the diagnostic doesn't cite the PNG §11.2.2 bit-depth
# table for a non-PNG input.
var IMG_ERR_INFLATE_LIMIT  = 17; # v1.6.0. A VALID PNG whose pixel data inflates past
# sankoch's DECOMPRESS_MAX_OUTPUT (16 MiB of inflated scanlines:
# ~5.6 MP of 8-bit RGB, ~4.2 MP of RGBA), so
# no linked decompressor can emit it. chitra 1.0.1 gave this its
# own ChitraErr (35, CHITRA_ERR_INFLATE_LIMIT) and refuses it
# before allocating; kii had no arm for it, so through v1.5.2 the
# file fell through to the generic fallback and was reported as
# "malformed PNG". Not a corruption code — the file is fine.
var IMG_ERR_IS_DIR         = 18; # v1.6.4. The path is a directory. The old lseek
# size probe reported an ext4 directory as "file exceeds size
# ceiling" (its htree EOF is ~2^63); the read now says EISDIR.

# ---- detected input format (for format-aware diagnostics) ----------
# The adapter sniffs the signature before decode and records the format in
# STRUCT_FORMAT_OFFSET, so main.cyr can phrase a decode failure per format
# ("malformed JPEG ..." vs "malformed PNG ...") even though the failed
# decode returned no image to read the format off. chitra owns the actual
# routing; this is kii's parallel tag that survives a 0-return.
var KII_FMT_UNKNOWN = 0;
var KII_FMT_PNG     = 1;
var KII_FMT_JPEG    = 2;
var KII_FMT_BMP     = 3;   # v1.5.0 — chitra 0.4.0 BMP
var KII_FMT_GIF     = 4;   # v1.5.0 — chitra 0.5.0 GIF (first frame only)

# Single-buffer ceiling for the file slurp. kii reads the whole file into
# memory (chitra decodes an in-memory (src,len) span, not a path), so a
# pathologically large input is an OOM-DoS vector the old streaming reader
# didn't have. The reader stops at this many bytes and reports EFBIG. It IS
# chitra's own ceiling, so kii never slurps a file chitra would refuse;
# tests/decode.tcyr pins it at 256 MB, the figure main's diagnostic quotes.
var KII_MAX_RAW_BYTES = CHITRA_MAX_RAW_BYTES;

# The three errno values the slurp distinguishes (file_read_whole_max returns
# them negated). Linux numbering; on a target that reports a bare -1 they
# fall through to IMG_ERR_OPEN, which is still a true statement.
var _KII_ENOMEM = 12;
var _KII_EISDIR = 21;
var _KII_EFBIG  = 27;

# ---- pstruct layout (the downstream contract) ----------------------
# downscale.cyr / quant.cyr / emit.cyr read these offsets. main.cyr
# stack-allocates `var pstruct[160]` (20 i64 slots). The adapter fills
# WIDTH/HEIGHT/BIT_DEPTH/COLOR_TYPE/PIXELS_*/SEEN_IEND/SRC_COLOR_TYPE/FORMAT;
# the rest are populated by the downscale → quantize → emit pipeline.
#
# The pixels are always chitra's canonical RGBA8, so BIT_DEPTH is always 8
# and COLOR_TYPE always 6: they state the pixel format, and downscale
# refuses anything else. SRC_COLOR_TYPE carries the real source format for
# --verbose.
#
# v1.7.0 (R-2 of the v1.6.4 sweep) retired the six slots the native decoder
# used and nothing has read since the v1.2.0 re-fold: IDAT count / total size
# / buffer (+32, +40, +64), interlace (+56) and the PLTE buffer / size (+88,
# +96). Those offsets are left unused rather than the struct repacked, so
# every live slot keeps the offset it has always had.
var STRUCT_WIDTH_OFFSET           = 0;
var STRUCT_HEIGHT_OFFSET          = 8;
var STRUCT_BIT_DEPTH_OFFSET       = 16;   # always 8 (RGBA8)
var STRUCT_COLOR_TYPE_OFFSET      = 24;   # always 6 (RGBA)
var STRUCT_SEEN_IEND_OFFSET       = 48;
var STRUCT_PIXELS_BUF_OFFSET      = 72;   # chitra's owned RGBA8 buffer
var STRUCT_PIXELS_SIZE_OFFSET     = 80;   # = width × height × 4
var STRUCT_QUANTIZED_BUF_OFFSET   = 104;  # populated by quantize_downscaled (1 byte/pixel)
var STRUCT_QUANTIZED_SIZE_OFFSET  = 112;
var STRUCT_DOWNSCALED_BUF_OFFSET  = 120;  # populated by downscale_to_rgb (packed RGB triples)
var STRUCT_DOWNSCALED_W_OFFSET    = 128;
var STRUCT_DOWNSCALED_H_OFFSET    = 136;
var STRUCT_SRC_COLOR_TYPE_OFFSET  = 144;  # source format sentinel (for --verbose)
var STRUCT_FORMAT_OFFSET          = 152;  # detected input format (KII_FMT_*); set by the
# adapter from the signature sniff BEFORE decode,
# so main phrases format-aware decode diagnostics.
# 20th / last slot of the 160-byte pstruct.

# ---- source-format names (used by main.cyr's --verbose summary) ------
# Color-type → human-readable name. Used by the --verbose summary, fed
# the SOURCE color_type (STRUCT_SRC_COLOR_TYPE_OFFSET) so a palette /
# greyscale input still reports its real format even though pixels are
# normalized to RGBA8. PNG names are the short forms from spec § 11.2.2; the
# three JPEG cases (257/259/275) decode chitra's source-color-type sentinel
# (0x100 + component_count, with 0x10 set for an Adobe transform-0 RGB file)
# so a JPEG --verbose line names its colour space instead of falling to "?".
fn kii_source_type_name(color_type): i64 {
    if (color_type == 0) { return "greyscale"; }
    if (color_type == 2) { return "RGB"; }
    if (color_type == 3) { return "palette"; }
    if (color_type == 4) { return "grey+alpha"; }
    if (color_type == 6) { return "RGBA"; }
    if (color_type == 257) { return "greyscale (JPEG)"; }   # 0x101: 1-component
    if (color_type == 259) { return "YCbCr (JPEG)"; }       # 0x103: 3-component
    if (color_type == 275) { return "RGB (JPEG)"; }         # 0x113: 3-component, Adobe transform=0
    # BMP — chitra sentinel 0x200 | bpp (0.4.0; 16 bpp + V4/V5 at 0.5.2).
    if (color_type == 513) { return "1bpp palette (BMP)"; }   # 0x201
    if (color_type == 516) { return "4bpp palette (BMP)"; }   # 0x204
    if (color_type == 520) { return "8bpp palette (BMP)"; }   # 0x208
    if (color_type == 528) { return "16bpp (BMP)"; }          # 0x210
    if (color_type == 536) { return "24bpp (BMP)"; }          # 0x218
    if (color_type == 544) { return "32bpp (BMP)"; }          # 0x220
    # GIF — chitra sentinel 0x300 | min_code_size (0.5.0). The LZW minimum
    # code size is 2..8 per the spec, so the live range is 770..776; accept
    # the whole 0x300 byte so a spec-legal edge value still names itself.
    if (color_type >= 769 && color_type <= 776) { return "palette (GIF)"; }
    return "?";
}

# ---- ChitraErr → IMG_ERR_* mapping ---------------------------------
# Preserves kii's per-error stderr diagnostics across the re-fold. The
# accepted collapses (documented in ADR 0006): SIGNATURE→NOT_PNG (the
# "<8 bytes" message is now unreachable), BAD_CHUNK→HEADER (covers
# palette-OOB / dup-PLTE / IEND-length / ordering), OOM→IDAT_TOO_LARGE
# (neutral wording, since OOM is also a genuine alloc failure), and the
# ratio-bomb arriving as DIMENSIONS rather than its own code. The guards
# themselves are all present in chitra (verified at 0.2.0) — only some
# diagnostic labels coalesce.
fn _kii_map_chitra_err(code): i64 {
    if (code == CHITRA_ERR_SIGNATURE)   { return IMG_ERR_UNRECOGNIZED; }
    if (code == CHITRA_ERR_TRUNCATED)   { return IMG_ERR_TRUNCATED; }
    if (code == CHITRA_ERR_BAD_CHUNK)   { return IMG_ERR_MALFORMED; }
    # P-1 (v1.5.1): was IMG_ERR_BITDEPTH, which made this the one path that
    # could tell a JPEG about the PNG § 11.2.2 bit-depth table — the exact
    # outcome IMG_ERR_UNSUPPORTED's own comment (above) says the split exists
    # to prevent. CHITRA_ERR_UNSUPPORTED spans formats by design (chitra ADR
    # 0010 § 3: an unrecognised PNG critical chunk, a non-zero PNG compression
    # or filter method, an unrecognised colour type, OR an Adobe APP14 colour
    # transform chitra declines) and its shared meaning is "the file is valid;
    # chitra declines it" — which is IMG_ERR_UNSUPPORTED's meaning exactly.
    if (code == CHITRA_ERR_UNSUPPORTED) { return IMG_ERR_UNSUPPORTED; }
    if (code == CHITRA_ERR_INFLATE)     { return IMG_ERR_DECOMPRESS; }
    if (code == CHITRA_ERR_OOM)         { return IMG_ERR_MEMORY; }
    if (code == CHITRA_ERR_CRC)         { return IMG_ERR_CRC; }
    if (code == CHITRA_ERR_INTERLACE)   { return IMG_ERR_INTERLACE; }
    if (code == CHITRA_ERR_BIT_DEPTH)   { return IMG_ERR_BITDEPTH; }
    if (code == CHITRA_ERR_DIMENSIONS)  { return IMG_ERR_DIMENSIONS; }
    if (code == CHITRA_ERR_FILTER)      { return IMG_ERR_FILTER; }
    if (code == CHITRA_ERR_NO_IDAT)     { return IMG_ERR_NO_IMAGE_DATA; }
    # ---- JPEG (chitra 0.3.0) -------------------------------------------
    # (BMP + GIF codes follow, added at kii v1.5.0 / chitra 1.0.0.)
    # Malformed / corrupt baseline-JPEG structure -> IMG_ERR_MALFORMED; main
    # branches the wording on STRUCT_FORMAT (-> "malformed JPEG ..."). These
    # never collide with a PNG input — chitra routes by signature first, so
    # a PNG only ever yields codes 1-12, plus 35 (INFLATE_LIMIT, below).
    if (code == CHITRA_ERR_JPEG_MARKER)  { return IMG_ERR_MALFORMED; }
    if (code == CHITRA_ERR_JPEG_SOF)     { return IMG_ERR_MALFORMED; }
    if (code == CHITRA_ERR_JPEG_DQT)     { return IMG_ERR_MALFORMED; }
    if (code == CHITRA_ERR_JPEG_DHT)     { return IMG_ERR_MALFORMED; }
    if (code == CHITRA_ERR_JPEG_SOS)     { return IMG_ERR_MALFORMED; }
    if (code == CHITRA_ERR_JPEG_ENTROPY) { return IMG_ERR_MALFORMED; }
    # Valid but unsupported JPEG features (chitra stays baseline-only) ->
    # a distinct code, so the message reads "unsupported JPEG feature ..."
    # rather than the PNG §11.2.2 bit-depth wording.
    if (code == CHITRA_ERR_JPEG_PROGRESSIVE) { return IMG_ERR_UNSUPPORTED; }
    if (code == CHITRA_ERR_JPEG_ARITHMETIC)  { return IMG_ERR_UNSUPPORTED; }
    if (code == CHITRA_ERR_JPEG_PRECISION)   { return IMG_ERR_UNSUPPORTED; }
    if (code == CHITRA_ERR_JPEG_MODE)        { return IMG_ERR_UNSUPPORTED; }
    if (code == CHITRA_ERR_JPEG_COMPONENTS)  { return IMG_ERR_UNSUPPORTED; }
    # ---- BMP (chitra 0.4.0 / 0.5.1 RLE / 0.5.2 BITFIELDS) --------------
    # Structural corruption -> IMG_ERR_MALFORMED; main branches the wording on
    # STRUCT_FORMAT (-> "malformed BMP ..."). A bpp outside {1,4,8,16,24,32},
    # a BI_JPEG/BI_PNG compression (refused permanently — a decoder
    # re-entering itself), and a bad BI_BITFIELDS mask are all "valid file,
    # chitra declines it" -> IMG_ERR_UNSUPPORTED.
    if (code == CHITRA_ERR_BMP_HEADER)      { return IMG_ERR_MALFORMED; }
    if (code == CHITRA_ERR_BMP_PALETTE)     { return IMG_ERR_MALFORMED; }
    if (code == CHITRA_ERR_BMP_RLE)         { return IMG_ERR_MALFORMED; }
    if (code == CHITRA_ERR_BMP_DEPTH)       { return IMG_ERR_UNSUPPORTED; }
    if (code == CHITRA_ERR_BMP_COMPRESSION) { return IMG_ERR_UNSUPPORTED; }
    if (code == CHITRA_ERR_BMP_MASK)        { return IMG_ERR_UNSUPPORTED; }
    # ---- GIF (chitra 0.5.0, first frame only) --------------------------
    # LZW is a compression-stream failure, so it reuses the INFLATE code
    # (main words it per format). A structurally valid GIF carrying no image
    # descriptor is the GIF analogue of a zero-IDAT PNG.
    if (code == CHITRA_ERR_GIF_HEADER)   { return IMG_ERR_MALFORMED; }
    if (code == CHITRA_ERR_GIF_PALETTE)  { return IMG_ERR_MALFORMED; }
    if (code == CHITRA_ERR_GIF_LZW)      { return IMG_ERR_DECOMPRESS; }
    if (code == CHITRA_ERR_GIF_NO_IMAGE) { return IMG_ERR_NO_IMAGE_DATA; }
    # ---- caller policy (chitra 0.6.1) ----------------------------------
    # Not a validity failure and not an OOM — but kii calls the unbudgeted
    # chitra_image_decode, so this is unreachable today. Mapped to the
    # resource-ceiling code rather than "malformed" in case that changes.
    if (code == CHITRA_ERR_BUDGET)       { return IMG_ERR_MEMORY; }
    # ---- decompressor ceiling (chitra 1.0.1) ---------------------------
    # A valid image too large for sankoch, refused by chitra before any
    # allocation. Its own kii code: the generic fallback below would call a
    # sound file "malformed", and IMG_ERR_DECOMPRESS would call it corrupt.
    if (code == CHITRA_ERR_INFLATE_LIMIT) { return IMG_ERR_INFLATE_LIMIT; }
    return IMG_ERR_MALFORMED;   # CHITRA_ERR_OTHER + any unknown -> generic malformed
}

# ---- the slurp's failure → IMG_ERR_* -------------------------------
# `n` is file_read_whole_max's negative errno. Through v1.6.3 kii sized the
# file with lseek(SEEK_END), then opened it a SECOND time to read it (P(-1),
# v1.6.4). That misreported everything that is not a regular file: a pipe or
# `/dev/stdin` (ESPIPE) said "cannot open file", an ext4 directory (htree EOF
# ~2^63) said "file exceeds size ceiling", and the double open let the path
# change between the size check and the read. The stdlib reader opens once,
# reads to EOF under the cap, and says why it stopped.
fn _kii_map_read_err(n): i64 {
    if (n == 0 - _KII_EFBIG)  { return IMG_ERR_FILE_TOO_LARGE; }
    if (n == 0 - _KII_EISDIR) { return IMG_ERR_IS_DIR; }
    if (n == 0 - _KII_ENOMEM) { return IMG_ERR_MEMORY; }
    return IMG_ERR_OPEN;
}

# ---- the decode front-end ------------------------------------------
# Slurp `path` (size-capped), sniff PNG / JPEG / BMP / GIF, decode via
# chitra_image_decode → canonical RGBA8, and adapt the result into
# `pstruct` as a depth-8 color_type=6 image so the existing downscale →
# quantize → emit pipeline consumes it unchanged (a JPEG renders with zero
# pipeline change — the adapter forwards its RGBA8 exactly as for PNG). The
# detected format is recorded in STRUCT_FORMAT_OFFSET for format-aware
# diagnostics. Returns IMG_OK (0) on success, or a IMG_ERR_* code (mapped
# from ChitraErr or raised by the file layer) on failure.
fn kii_decode_image(path, pstruct): i64 {
    # Zero every slot first (P(-1), v1.6.4). main's `var pstruct[160]` is an
    # uninitialized stack array, and the adapter writes only some slots, so the
    # "has this stage run yet?" checks in quantize / emit read whatever an
    # earlier call left on the stack. A zeroed struct makes them mean what
    # they say. This also defaults the format tag to KII_FMT_UNKNOWN (0) for
    # the early file-layer returns.
    var slot = 0;
    while (slot < 160) { store64(pstruct + slot, 0); slot = slot + 8; }

    # ---- slurp, capped: one open, read to EOF, at most KII_MAX_RAW_BYTES
    # (the old streaming reader never held the whole file; this one does, so
    # the cap is the OOM guard). Works on pipes and /dev/stdin too. ----
    var n = 0;
    var src = file_read_whole_max(path, KII_MAX_RAW_BYTES, &n);
    if (src == 0) { return _kii_map_read_err(n); }
    if (n == 0) { return IMG_ERR_UNRECOGNIZED; }        # an empty file is no image

    # ---- sniff the format from the signature so main can phrase a decode
    # failure per format. chitra_image_decode does the same routing
    # internally; this parallel tag survives a 0-return (no image to read
    # the format off of). Order is cheapest-discriminator-first and matches
    # chitra's own routing; the four predicates are mutually exclusive, so
    # the else-chain never mis-tags. ----
    var fmt = KII_FMT_UNKNOWN;
    if (chitra_png_check_signature(src, n) == 1) {
        fmt = KII_FMT_PNG;
    } else {
        if (chitra_jpeg_check_signature(src, n) == 1) {
            fmt = KII_FMT_JPEG;
        } else {
            if (chitra_bmp_check_signature(src, n) == 1) {
                fmt = KII_FMT_BMP;
            } else {
                if (chitra_gif_check_signature(src, n) == 1) { fmt = KII_FMT_GIF; }
            }
        }
    }
    store64(pstruct + STRUCT_FORMAT_OFFSET, fmt);

    # ---- decode (chitra_image_decode sniffs all four formats and owns
    # signature / IHDR / CRC / inflate / unfilter on the PNG path, markers /
    # Huffman / IDCT on the JPEG path, DIB header / RLE / BITFIELDS on the
    # BMP path and LZW on the GIF path + canonical RGBA8 + every security
    # guard) ----
    var err = 0;
    var img = chitra_image_decode(src, n, &err);
    if (img == 0) {
        # chitra's contract sets *err on every 0-return; guard the null
        # anyway so a hypothetical OOM that left it 0 can't NULL-deref in
        # chitra_err_code (it would map to an OOM-class code regardless).
        if (err == 0) { return IMG_ERR_MEMORY; }
        return _kii_map_chitra_err(chitra_err_code(err));
    }

    # ---- adapter: chitra's RGBA8 as a depth-8 ct6 image, which is the only
    # pixel format downscale.cyr accepts. The buffer is handed over, not
    # copied. ----
    var w = chitra_image_width(img);
    var h = chitra_image_height(img);
    store64(pstruct + STRUCT_WIDTH_OFFSET, w);
    store64(pstruct + STRUCT_HEIGHT_OFFSET, h);
    store64(pstruct + STRUCT_BIT_DEPTH_OFFSET, 8);
    store64(pstruct + STRUCT_COLOR_TYPE_OFFSET, 6);
    store64(pstruct + STRUCT_PIXELS_BUF_OFFSET, chitra_image_pixels(img));
    store64(pstruct + STRUCT_PIXELS_SIZE_OFFSET, w * h * 4);
    store64(pstruct + STRUCT_SEEN_IEND_OFFSET, chitra_image_seen_iend(img));
    store64(pstruct + STRUCT_SRC_COLOR_TYPE_OFFSET, chitra_image_source_color_type(img));
    return IMG_OK;
}

# ---- decode diagnostics (the `<path>: <text>` lines main prints) ----
# The text for each IMG_ERR_* code, phrased for the detected format `fmt`
# (KII_FMT_*). Through v1.6.3 these lived inline in main's entry point, where
# no test could reach them; tests/decode.tcyr now pins every line. P(-1),
# v1.6.4, also made four of them true for every format:
#   - INFLATE on a GIF is a corrupt LZW stream, not "DEFLATE … IDAT";
#   - NO_IDAT on a GIF is a file with no image descriptor, not "no IDAT";
#   - DIMENSIONS fires for a zero width or height as well as an oversized one;
#   - the BMP "unsupported" line names compression in general, since chitra
#     also refuses OS/2 Huffman 1D and BI_CMYK there, not just BI_JPEG/BI_PNG.
# The 256 MB and 16 MiB figures are pinned in tests/decode.tcyr against
# KII_MAX_RAW_BYTES and sankoch's DECOMPRESS_MAX_OUTPUT.
fn kii_decode_error_text(rc, fmt): i64 {
    if (rc == IMG_ERR_OPEN)           { return "cannot open file"; }
    if (rc == IMG_ERR_IS_DIR)         { return "is a directory, not an image file"; }
    if (rc == IMG_ERR_FILE_TOO_LARGE) { return "file exceeds size ceiling (max 256 MB)"; }
    if (rc == IMG_ERR_UNRECOGNIZED)        { return "unrecognized image format (expected PNG, JPEG, BMP, or GIF)"; }
    if (rc == IMG_ERR_MALFORMED) {
        if (fmt == KII_FMT_JPEG) { return "malformed JPEG (bad marker, segment, or entropy data)"; }
        if (fmt == KII_FMT_BMP)  { return "malformed BMP (bad DIB header, palette, or RLE stream)"; }
        if (fmt == KII_FMT_GIF)  { return "malformed GIF (bad descriptor or color table)"; }
        return "malformed PNG (bad chunk, ordering, or palette)";
    }
    if (rc == IMG_ERR_CRC)            { return "CRC check failed"; }
    if (rc == IMG_ERR_TRUNCATED) {
        # PNG names its truncation after the chunk stream; every other format
        # (and an unrecognized one) gets the generic wording.
        if (fmt == KII_FMT_PNG) { return "malformed PNG (truncated chunk stream)"; }
        return "truncated image (unexpected end of data)";
    }
    if (rc == IMG_ERR_INTERLACE)      { return "unsupported interlace method (only 0=none / 1=Adam7 are valid)"; }
    if (rc == IMG_ERR_BITDEPTH)       { return "unsupported bit depth for this color type (PNG § 11.2.2)"; }
    if (rc == IMG_ERR_UNSUPPORTED) {
        if (fmt == KII_FMT_BMP)  { return "unsupported BMP feature (bit depth, compression method, or channel mask)"; }
        if (fmt == KII_FMT_JPEG) { return "unsupported JPEG feature (progressive, arithmetic, 12-bit, non-baseline, CMYK/4-component, or an Adobe colour transform)"; }
        return "unsupported image feature (unrecognized critical chunk, compression method, or color type)";
    }
    if (rc == IMG_ERR_NO_IMAGE_DATA) {
        if (fmt == KII_FMT_GIF) { return "no image in GIF (no image descriptor)"; }
        return "no IDAT chunks (nothing to decode)";
    }
    if (rc == IMG_ERR_DECOMPRESS) {
        if (fmt == KII_FMT_GIF) { return "corrupt GIF image data (bad LZW stream)"; }
        return "DEFLATE decompression failed (corrupt IDAT)";
    }
    if (rc == IMG_ERR_FILTER)         { return "invalid PNG filter type (spec § 9 allows 0–4)"; }
    if (rc == IMG_ERR_DIMENSIONS)     { return "image dimensions are zero or past the policy ceiling (max 16.7M px / 65535 per side / 256 MB)"; }
    if (rc == IMG_ERR_MEMORY) { return "out of memory or image too large (possible decompression bomb)"; }
    if (rc == IMG_ERR_INFLATE_LIMIT)  { return "image too large to decode (pixel data inflates past the decompressor's 16 MiB ceiling)"; }
    return "image decode failed";
}

# The warning main prints when a frame decoded but its stream did not end the
# way its format says it should (STRUCT_SEEN_IEND == 0). chitra sets that flag
# from a real per-format decision: PNG had no IEND, a JPEG scan ran out or had
# no EOI, a GIF's codes ran out before the frame was full. BMP forces 1; the
# last line covers it and any future format. For GIF, chitra fills the missing
# pixels with palette entry 0 at full alpha, so the text says so (through
# v1.6.3 it claimed "zero-filled", which rendered as whatever colour entry 0 is).
fn kii_incomplete_warning_text(fmt): i64 {
    if (fmt == KII_FMT_PNG)  { return "warning: incomplete PNG (no IEND chunk seen)"; }
    if (fmt == KII_FMT_JPEG) { return "warning: incomplete JPEG (truncated scan or no EOI marker)"; }
    if (fmt == KII_FMT_GIF)  { return "warning: incomplete GIF (image data ran out; the rest is drawn in palette colour 0)"; }
    return "warning: incomplete image (stream did not close cleanly)";
}
