# quant.cyr — RGB → 16-color ANSI palette quantization.
#
# v1.0 tier-1 floor: nearest-neighbor in Euclidean RGB space.
# Skips the sqrt (monotonic for minimum-finding, saves a
# transcendental per pixel). Linear-scan all 16 palette entries.
#
# CIE Lab distance + perceptual color spaces + Floyd-Steinberg /
# ordered dither are explicit post-v1 scope per CLAUDE.md
# tier-1 color discipline. Higher-fidelity quantization can
# replace this module's internals without changing the public
# API (palette_idx in, palette_idx out).
#
# Multi-source convergent port: shape drawn from chafa's
# `chafa-canvas.c` glyph-selection (color-quantization micro-
# pattern), `libcaca`'s color picker, and the Wikipedia
# "Color quantization" article's vanilla algorithm. No
# single-source pin.

include "src/palette.cyr"
include "src/image.cyr"

# ---- active colour tier -------------------------------------------
# The `--color` tier: 8, 16 (the default), 256, or KII_TIER_TC (24-bit
# truecolour, v1.8.0). Tiers 8 and 16 choose from the Linux-console palette
# in palette.cyr; 256 from the xterm 6x6x6 cube and grey ramp; truecolour
# keeps the pixel's own RGB. See ADR 0010.
#
# Tier 8 / 16 history: quantize_nearest_rgb is allowed to choose
# from 16 (default) or 8 entries. P-1 (v1.5.1) — `--color 8` was parsed and
# validated by kii_validate_color since M1 and then never consumed, so
# `kii --color 8 img.png` emitted output BYTE-IDENTICAL to `--color 16`.
# The flag's own help text promised "color tier: 8 or 16", and CLAUDE.md
# scopes tier-1 as the "8/16-color ANSI palette", so the honest repair is
# to make the flag do what it says rather than to document a lie.
#
# A module-scope setting rather than a threaded parameter: the four
# functions between the flag and the inner loop (quantize_downscaled ->
# quantize_rgb_buf -> quantize_nearest_rgb, plus ascii.cyr's per-cell
# call) all have pinned arities that tests assert on, and this mirrors
# palette_init()'s existing lazy-module-state idiom in the same file.
#
# The low 8 entries ARE the normal-intensity ANSI colours and the high 8
# the bright ones, so restricting the ceiling to 8 selects exactly the
# 8-colour tier — no separate table needed.
var KII_TIER_8   = 8;
var KII_TIER_16  = 16;
var KII_TIER_256 = 256;
var KII_TIER_TC  = 24;     # truecolour: 24 bits per pixel
var _quant_tier = 16;

# Set the active tier. Accepts only 8, 16, 256 or KII_TIER_TC; anything
# else is ignored so a bad value can never widen the loop past the palette.
# Returns the tier actually in force.
fn quant_set_tier(n): i64 {
    if (n == KII_TIER_8)   { _quant_tier = n; }
    if (n == KII_TIER_16)  { _quant_tier = n; }
    if (n == KII_TIER_256) { _quant_tier = n; }
    if (n == KII_TIER_TC)  { _quant_tier = n; }
    return _quant_tier;
}

fn quant_tier(): i64 { return _quant_tier; }

# Map one RGB triple to the nearest-distance² palette index in
# [0, quant_tier()). Ties resolved by lowest index because
# the loop's `<` (not `<=`) rejects equal-distance challengers.
# Caller passes raw byte channel values (0..255).
#
# P(-1) O-1 (v1.6.4): the palette bytes are read straight off the packed
# table and the distance is computed inline. The old body made 65 calls per
# pixel (palette_init, 48 palette_r/g/b accessors that each re-checked
# initialisation, 16 _color_dist2), about 300 ns per pixel; this is ~4x
# faster. Same arithmetic, same strict-< tie-break: all 2^24 RGB values map
# to the same index at both tiers (checked exhaustively at the change).
fn quantize_nearest_rgb(r, g, b): i64 {
    if (_palette_inited == 0) { palette_init(); }
    # Seed best with entry 0 so the loop body has no sentinel.
    var q = &_ANSI_PALETTE_RGB;
    var dr = r - load8(q);
    var dg = g - load8(q + 1);
    var db = b - load8(q + 2);
    var best_idx = 0;
    var best_d2  = dr * dr + dg * dg + db * db;
    # Bounded by the active tier, never past the table itself (tier 8 → 8
    # entries; every other tier → the 16, since this function is the tier-1
    # quantizer and kii_color_code routes the higher tiers elsewhere).
    var ceiling = _quant_tier;
    if (ceiling > ANSI_PALETTE_SIZE) { ceiling = ANSI_PALETTE_SIZE; }
    var i = 1;
    q = q + 3;
    while (i < ceiling) {
        dr = r - load8(q);
        dg = g - load8(q + 1);
        db = b - load8(q + 2);
        var d2 = dr * dr + dg * dg + db * db;
        if (d2 < best_d2) {
            best_d2  = d2;
            best_idx = i;
        }
        i = i + 1;
        q = q + 3;
    }
    return best_idx;
}

# NOTE: the M4-era image-wide quantizer `quantize_nearest_image` was
# removed in the PNG re-fold (v1.2.0): post-flip every image arrives as
# RGBA8, so its per-colour-type extraction had no live inputs. The flow is
# downscale_to_rgb → quantize_downscaled. See ADR 0006.

# ---- tier 256: the xterm cube and grey ramp (v1.8.0) ---------------
# Indices 16-231 are a 6x6x6 cube over the levels 0, 95, 135, 175, 215,
# 255, and 232-255 a grey ramp 8, 18, ..., 238. Entries 0-15 are skipped:
# their RGB is whatever each terminal's theme says, so they cannot be matched
# reliably (tiers 8 and 16 use them by name instead).
#
# The nearest entry is exact without scanning all 240. Squared distance is a
# sum over channels, so the nearest cube point is the nearest level per
# channel; over the grey ramp it is 3·(v - mean)² + const, so the nearest grey
# is the level nearest the channel mean. The two candidates are then
# compared. Ties go to the lower index everywhere (lower level per channel,
# lower grey, the cube before the ramp) — the strict-< rule of a full scan in
# index order, which tests/quant.tcyr checks against one.

# The cube level index (0-5) nearest channel value `c`. The thresholds are
# the midpoints between levels; a value exactly on one (115, 155, 195, 235)
# is equidistant and takes the lower level.
fn _quant_cube_level(c): i64 {
    if (c <= 47)  { return 0; }
    if (c <= 115) { return 1; }
    if (c <= 155) { return 2; }
    if (c <= 195) { return 3; }
    if (c <= 235) { return 4; }
    return 5;
}

# The channel value of cube level `i`: 0, 95, 135, 175, 215, 255.
fn _quant_cube_value(i): i64 {
    if (i == 0) { return 0; }
    return 55 + 40 * i;
}

# Nearest xterm-256 index (16-255) to (r, g, b).
fn quantize_256(r, g, b): i64 {
    var ri = _quant_cube_level(r);
    var gi = _quant_cube_level(g);
    var bi = _quant_cube_level(b);
    var e = r - _quant_cube_value(ri);
    var cube_d = e * e;
    e = g - _quant_cube_value(gi);
    cube_d = cube_d + e * e;
    e = b - _quant_cube_value(bi);
    cube_d = cube_d + e * e;
    # Grey: the level nearest the mean, (r+g+b)/3 ≈ 8 + 10k. Rounding the
    # integer estimate can miss by one either way, so score k-1, k, k+1.
    var kc = ((r + g + b) - 24 + 15) / 30;
    if (kc < 0)  { kc = 0; }
    if (kc > 23) { kc = 23; }     # white's estimate is 25: clamp, or no k is scored
    var best_k = 0 - 1;
    var grey_d = 0;
    var k = kc - 1;
    while (k <= kc + 1) {
        if (k >= 0 && k <= 23) {
            var v = 8 + 10 * k;
            var d = (r - v) * (r - v) + (g - v) * (g - v) + (b - v) * (b - v);
            if (best_k < 0 || d < grey_d) { grey_d = d; best_k = k; }
        }
        k = k + 1;
    }
    if (grey_d < cube_d) { return 232 + best_k; }
    return 16 + 36 * ri + 6 * gi + bi;
}

# ---- colour codes (v1.8.0) ----------------------------------------
# What the quantize stage hands the emit layer, one 32-bit code per pixel:
# a palette index (tiers 8 / 16 / 256), a packed 0xRRGGBB (truecolour), or
# KII_COLOR_DEFAULT for a transparent pixel, which emit draws in the
# terminal's own default colour. 1 << 24 is outside every tier's range, so
# the sentinel never collides with a real colour.
var KII_COLOR_DEFAULT = 16777216;

# The code for one opaque pixel at the active tier.
fn kii_color_code(r, g, b): i64 {
    if (_quant_tier == KII_TIER_TC)  { return (r << 16) | (g << 8) | b; }
    if (_quant_tier == KII_TIER_256) { return quantize_256(r, g, b); }
    return quantize_nearest_rgb(r, g, b);
}

# Quantize a packed RGB-triple source buffer into colour codes: one 32-bit
# code per pixel into out_buf (caller-owned, 4 × n_pixels bytes). `mask` is
# downscale's transparency mask (one byte per pixel, 1 = transparent → code
# KII_COLOR_DEFAULT), or 0 when no pixel is transparent. Returns 0; never
# fails (no allocation). Used by quantize_downscaled below — exposes the
# inner loop with no pstruct knowledge.
fn quantize_rgb_buf(rgb_buf, mask, n_pixels, out_buf): i64 {
    palette_init();
    var i = 0;
    while (i < n_pixels) {
        if (mask != 0 && load8(mask + i) != 0) {
            store32(out_buf + i * 4, KII_COLOR_DEFAULT);
        } else {
            var p = rgb_buf + i * 3;
            store32(out_buf + i * 4, kii_color_code(load8(p), load8(p + 1), load8(p + 2)));
        }
        i = i + 1;
    }
    return 0;
}

# Struct-aware wrapper: read pstruct's DOWNSCALED_BUF / W / H and its
# transparency mask, alloc a (w × h × 4)-byte code buffer, quantize, and
# store ptr + pixel count into the QUANTIZED slots. Returns 0 on success,
# -1 on:
#   - downscale_to_rgb not yet run (DOWNSCALED_BUF == 0; kii_decode_image
#     zeroes the pstruct, so this check means what it says)
#   - bad dimensions (w or h <= 0)
#   - alloc failure
fn quantize_downscaled(pstruct): i64 {
    palette_init();
    var dbuf = load64(pstruct + STRUCT_DOWNSCALED_BUF_OFFSET);
    var dw   = load64(pstruct + STRUCT_DOWNSCALED_W_OFFSET);
    var dh   = load64(pstruct + STRUCT_DOWNSCALED_H_OFFSET);
    if (dbuf == 0)        { return 0 - 1; }
    if (dw <= 0 || dh <= 0) { return 0 - 1; }

    var n_pixels = dw * dh;
    var out_buf = alloc(n_pixels * 4);
    if (out_buf == 0) { return 0 - 1; }

    quantize_rgb_buf(dbuf, load64(pstruct + STRUCT_ALPHA_MASK_OFFSET), n_pixels, out_buf);
    store64(pstruct + STRUCT_QUANTIZED_BUF_OFFSET,  out_buf);
    store64(pstruct + STRUCT_QUANTIZED_SIZE_OFFSET, n_pixels);
    return 0;
}
