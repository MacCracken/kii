fn main() {
    alloc_init();
    crc32_init_table();

    # ---- M3(a) — sankoch zlib round-trip ---------------------------
    # Kept verbatim from the monolith: confirms the sankoch dep wires
    # up cleanly and the exact API kii consumes (zlib_compress +
    # zlib_decompress) round-trips byte-identical. PNG IDAT uses the
    # zlib wrapper (not raw DEFLATE) per spec § 10.3.
    test_group("M3(a) — sankoch zlib round-trip");

    # Deterministic 16-byte input: ASCII 'A'..'P'.
    var rt_in[16];
    var rt_i = 0;
    while (rt_i < 16) {
        store8(&rt_in + rt_i, 0x41 + rt_i);
        rt_i = rt_i + 1;
    }

    var rt_compressed[64];
    var rt_clen = zlib_compress(&rt_in, 16, &rt_compressed, 64);
    assert(rt_clen > 0,  "zlib_compress returns positive length");
    assert(rt_clen < 64, "compressed fits in 64-byte buffer");

    var rt_decompressed[32];
    var rt_dlen = zlib_decompress(&rt_compressed, rt_clen, &rt_decompressed, 32);
    assert_eq(rt_dlen, 16, "zlib_decompress recovers original length");

    var rt_match = 1;
    var rt_j = 0;
    while (rt_j < 16) {
        if (load8(&rt_in + rt_j) != load8(&rt_decompressed + rt_j)) { rt_match = 0; }
        rt_j = rt_j + 1;
    }
    assert_eq(rt_match, 1, "decompressed bytes byte-identical to input");

    var rt_dec_small[8];
    var rt_dlen_neg = zlib_decompress(&rt_compressed, rt_clen, &rt_dec_small, 8);
    assert(rt_dlen_neg < 0, "dst_cap too small → negative return");

    # ---- _kii_map_chitra_err: every ChitraErr → its IMG_ERR_* code --
    # The adapter preserves kii's per-error stderr diagnostics across
    # the re-fold. Documented collapses (ADR 0006): SIGNATURE→NOT_PNG,
    # TRUNCATED→CHUNK, BAD_CHUNK→HEADER, OOM→IDAT_TOO_LARGE, OTHER→HEADER.
    # UNSUPPORTED keeps its own code since v1.5.1 (below).
    test_group("re-fold — _kii_map_chitra_err mapping");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_SIGNATURE),   IMG_ERR_UNRECOGNIZED,        "SIGNATURE → NOT_PNG");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_TRUNCATED),   IMG_ERR_TRUNCATED,          "TRUNCATED → CHUNK");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_BAD_CHUNK),   IMG_ERR_MALFORMED,         "BAD_CHUNK → HEADER");
    # P-1 (v1.5.1): was IMG_ERR_BITDEPTH. CHITRA_ERR_UNSUPPORTED spans formats
    # (unrecognised PNG critical chunk / non-zero compression or filter method /
    # unrecognised colour type / an Adobe APP14 transform chitra declines), so
    # routing it to BITDEPTH was the one path that could tell a JPEG about the
    # PNG § 11.2.2 bit-depth table — the exact outcome image.cyr says the split
    # between these two codes exists to prevent.
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_UNSUPPORTED), IMG_ERR_UNSUPPORTED,    "UNSUPPORTED → UNSUPPORTED (not BITDEPTH)");
    # The genuine bit-depth code still maps to BITDEPTH — the split is the point.
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_BIT_DEPTH),   IMG_ERR_BITDEPTH,       "BIT_DEPTH → BITDEPTH (unchanged)");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_INFLATE),     IMG_ERR_DECOMPRESS,        "INFLATE → INFLATE");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_OOM),         IMG_ERR_MEMORY, "OOM → IDAT_TOO_LARGE");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_CRC),         IMG_ERR_CRC,            "CRC → CRC");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_INTERLACE),   IMG_ERR_INTERLACE,      "INTERLACE → INTERLACE");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_DIMENSIONS),  IMG_ERR_DIMENSIONS,     "DIMENSIONS → DIMENSIONS");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_FILTER),      IMG_ERR_FILTER,         "FILTER → FILTER");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_NO_IDAT),     IMG_ERR_NO_IMAGE_DATA,        "NO_IDAT → NO_IDAT");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_OTHER),       IMG_ERR_MALFORMED,         "OTHER → HEADER (generic malformed)");

    # ---- JPEG mapping (chitra 0.3.0, v1.4.0 wiring) ----------------
    # Malformed/corrupt baseline-JPEG codes collapse to IMG_ERR_MALFORMED
    # (main phrases them per format → "malformed JPEG ..."); the five
    # valid-but-unsupported deferred modes get the distinct
    # IMG_ERR_UNSUPPORTED so the message doesn't cite PNG §11.2.2.
    test_group("jpeg — _kii_map_chitra_err JPEG codes");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_JPEG_MARKER),      IMG_ERR_MALFORMED,      "JPEG_MARKER → HEADER");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_JPEG_SOF),         IMG_ERR_MALFORMED,      "JPEG_SOF → HEADER");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_JPEG_DQT),         IMG_ERR_MALFORMED,      "JPEG_DQT → HEADER");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_JPEG_DHT),         IMG_ERR_MALFORMED,      "JPEG_DHT → HEADER");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_JPEG_SOS),         IMG_ERR_MALFORMED,      "JPEG_SOS → HEADER");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_JPEG_ENTROPY),     IMG_ERR_MALFORMED,      "JPEG_ENTROPY → HEADER");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_JPEG_PROGRESSIVE), IMG_ERR_UNSUPPORTED, "JPEG_PROGRESSIVE → UNSUPPORTED");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_JPEG_ARITHMETIC),  IMG_ERR_UNSUPPORTED, "JPEG_ARITHMETIC → UNSUPPORTED");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_JPEG_PRECISION),   IMG_ERR_UNSUPPORTED, "JPEG_PRECISION → UNSUPPORTED");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_JPEG_MODE),        IMG_ERR_UNSUPPORTED, "JPEG_MODE → UNSUPPORTED");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_JPEG_COMPONENTS),  IMG_ERR_UNSUPPORTED, "JPEG_COMPONENTS → UNSUPPORTED");

    # ---- kii_source_type_name: JPEG source sentinels (--verbose) ----
    # chitra_image_source_color_type returns 256+ncomp for a JPEG; the
    # helper must name them rather than fall through to "?".
    test_group("jpeg — kii_source_type_name sentinels");
    assert_streq(kii_source_type_name(257), "greyscale (JPEG)", "257 (0x101) → greyscale (JPEG)");
    assert_streq(kii_source_type_name(259), "YCbCr (JPEG)",     "259 (0x103) → YCbCr (JPEG)");
    assert_streq(kii_source_type_name(6),   "RGBA",             "PNG ct6 still → RGBA");
    assert_streq(kii_source_type_name(99),  "?",                "true-unknown still → ?");

    # ---- kii_decode_image end-to-end on the real RAMGON.png fixture ---
    # The adapter normalizes to depth-8 ct6; SRC_COLOR_TYPE carries the
    # real pre-normalization color_type (RAMGON is RGBA → 6).
    test_group("re-fold — kii_decode_image e2e (RAMGON.png)");
    var pstr_ram[160];
    assert_eq(kii_decode_image("tests/fixtures/RAMGON.png", &pstr_ram), IMG_OK,
      "RAMGON.png → IMG_OK");
    assert_eq(load64(&pstr_ram + STRUCT_WIDTH_OFFSET),       1152, "RAMGON width = 1152");
    assert_eq(load64(&pstr_ram + STRUCT_HEIGHT_OFFSET),      925,  "RAMGON height = 925");
    assert_eq(load64(&pstr_ram + STRUCT_COLOR_TYPE_OFFSET),  6,    "adapter forces ct6");
    assert_eq(load64(&pstr_ram + STRUCT_SRC_COLOR_TYPE_OFFSET), 6, "RAMGON src color_type = 6 (RGBA)");
    assert_eq(load64(&pstr_ram + STRUCT_BIT_DEPTH_OFFSET),   8,    "bit_depth = 8");
    assert_eq(load64(&pstr_ram + STRUCT_PIXELS_SIZE_OFFSET), 1152 * 925 * 4,
      "pixels size = 1152 × 925 × 4");
    assert_eq(load64(&pstr_ram + STRUCT_SEEN_IEND_OFFSET),   1,    "saw IEND");
    assert(load64(&pstr_ram + STRUCT_PIXELS_BUF_OFFSET) != 0, "pixels_buf non-null");

    # ---- kii_decode_image adapter + error paths via tmp files --------
    # (a) a valid 2x2 RGB PNG (built in-memory, real zlib IDAT) → IMG_OK,
    #     COLOR_TYPE forced to 6, SRC_COLOR_TYPE preserved as 2 (RGB).
    test_group("re-fold — kii_decode_image (valid 2x2 RGB → ct6 / src ct2)");
    # Raw scanline stream: filter byte 0 + 2 px × 3 bytes per row.
    var raw_stream[14];
    store8(&raw_stream + 0,  0);    # filter byte (None) row 0
    store8(&raw_stream + 1,  100); store8(&raw_stream + 2,  101); store8(&raw_stream + 3,  102);
    store8(&raw_stream + 4,  103); store8(&raw_stream + 5,  104); store8(&raw_stream + 6,  105);
    store8(&raw_stream + 7,  0);    # filter byte (None) row 1
    store8(&raw_stream + 8,  110); store8(&raw_stream + 9,  111); store8(&raw_stream + 10, 112);
    store8(&raw_stream + 11, 113); store8(&raw_stream + 12, 114); store8(&raw_stream + 13, 115);
    var idat_payload[64];
    var idat_clen = zlib_compress(&raw_stream, 14, &idat_payload, 64);
    assert(idat_clen > 0, "2x2 row-stream compresses cleanly");
    var pbuf_ok[128];
    var ok_len = _ut_build_png_with_idat(&pbuf_ok, 2, 2, 8, 2, 0, &idat_payload, idat_clen);
    var path_ok[256];
    _scratch_path(&path_ok, "kii-decode-ok.png");
    file_write_all(&path_ok, &pbuf_ok, ok_len);
    var pstr_ok[160];
    assert_eq(kii_decode_image(&path_ok, &pstr_ok), IMG_OK, "valid 2x2 RGB → IMG_OK");
    assert_eq(load64(&pstr_ok + STRUCT_WIDTH_OFFSET),  2, "2x2 width = 2");
    assert_eq(load64(&pstr_ok + STRUCT_HEIGHT_OFFSET), 2, "2x2 height = 2");
    assert_eq(load64(&pstr_ok + STRUCT_COLOR_TYPE_OFFSET), 6, "adapter forces ct6");
    assert_eq(load64(&pstr_ok + STRUCT_SRC_COLOR_TYPE_OFFSET), 2, "src color_type = 2 (RGB)");
    assert_eq(load64(&pstr_ok + STRUCT_PIXELS_SIZE_OFFSET), 2 * 2 * 4, "pixels size = 2×2×4");
    assert_eq(load64(&pstr_ok + STRUCT_SEEN_IEND_OFFSET), 1, "valid PNG saw IEND");

    # (b) IEND-less but otherwise valid → IMG_OK + SEEN_IEND = 0.
    #     Truncate the valid PNG before its trailing 12-byte IEND chunk
    #     (spec § 5.3 tolerance — chitra still decodes, flags seen_iend=0).
    test_group("re-fold — kii_decode_image (IEND-less → IMG_OK, seen_iend=0)");
    var path_ni[256];
    _scratch_path(&path_ni, "kii-decode-noiend.png");
    file_write_all(&path_ni, &pbuf_ok, ok_len - 12);
    var pstr_ni[160];
    assert_eq(kii_decode_image(&path_ni, &pstr_ni), IMG_OK, "IEND-less → IMG_OK");
    assert_eq(load64(&pstr_ni + STRUCT_SEEN_IEND_OFFSET), 0, "IEND-less → seen_iend = 0");

    # (c) a non-PNG text file (≥ 8 bytes, wrong signature) → NOT_PNG.
    test_group("re-fold — kii_decode_image (non-PNG text → NOT_PNG)");
    var path_tx[256];
    _scratch_path(&path_tx, "kii-decode-notpng.txt");
    file_write_all(&path_tx, "this is plainly not a png\n", 26);
    var pstr_tx[160];
    assert_eq(kii_decode_image(&path_tx, &pstr_tx), IMG_ERR_UNRECOGNIZED,
      "non-PNG text file → IMG_ERR_UNRECOGNIZED");

    # (d) an empty file → NOT_PNG (kii_decode_image's sz==0 guard).
    test_group("re-fold — kii_decode_image (empty file → NOT_PNG)");
    var path_em[256];
    _scratch_path(&path_em, "kii-decode-empty.bin");
    file_write_all(&path_em, "", 0);
    var pstr_em[160];
    assert_eq(kii_decode_image(&path_em, &pstr_em), IMG_ERR_UNRECOGNIZED,
      "empty file → IMG_ERR_UNRECOGNIZED");

    # (d2) a sub-8-byte non-empty file (1..7 bytes) → NOT_PNG. chitra's
    # signature check guards len<8 before any memeq, so the adapter must
    # not OOB-read the short slurp and must surface NOT_PNG.
    test_group("re-fold — kii_decode_image (sub-8-byte file → NOT_PNG)");
    var path_sh[256];
    _scratch_path(&path_sh, "kii-decode-short.bin");
    file_write_all(&path_sh, "\x89PNG", 4);          # 4 bytes: valid prefix, too short
    var pstr_sh[160];
    assert_eq(kii_decode_image(&path_sh, &pstr_sh), IMG_ERR_UNRECOGNIZED,
      "4-byte file → IMG_ERR_UNRECOGNIZED (no OOB read)");

    # (e) a structurally-valid PNG with a bad-zlib IDAT → INFLATE.
    #     CRC over the IDAT data is correct (so we pass the CRC gate),
    #     but the bytes are not a valid zlib stream → chitra reports
    #     INFLATE → IMG_ERR_DECOMPRESS.
    test_group("re-fold — kii_decode_image (bad-zlib IDAT → INFLATE)");
    var bad_idat[4];
    store8(&bad_idat + 0, 0x78); store8(&bad_idat + 1, 0x9C);  # plausible zlib header
    store8(&bad_idat + 2, 0xAA); store8(&bad_idat + 3, 0xBB);  # garbage deflate body
    var pbuf_bz[128];
    var bz_len = _ut_build_png_with_idat(&pbuf_bz, 2, 2, 8, 2, 0, &bad_idat, 4);
    var path_bz[256];
    _scratch_path(&path_bz, "kii-decode-badzlib.png");
    file_write_all(&path_bz, &pbuf_bz, bz_len);
    var pstr_bz[160];
    assert_eq(kii_decode_image(&path_bz, &pstr_bz), IMG_ERR_DECOMPRESS,
      "bad-zlib IDAT → IMG_ERR_DECOMPRESS");

    # (e2) v1.9.1 — a VALID PNG past 16 MiB of scanlines decodes.
    #     tests/fixtures/oversize.png is a 2370x2370 8-bit RGB PNG of black
    #     (16,853,070 bytes inflated, 16,447 on disk), just past sankoch's 16 MiB
    #     DECOMPRESS_MAX_OUTPUT. From v1.6.0 to v1.9.0 chitra refused it from the
    #     header as CHITRA_ERR_INFLATE_LIMIT (35) and kii printed "image too
    #     large to decode". chitra 1.3.0 inflates to the exact size IHDR implies
    #     instead, so the file decodes; code 35 stays defined (chitra's enum is
    #     frozen) but is unreachable, and kii keeps its arm so the map stays total.
    test_group("v1.9.1 — a valid PNG past 16 MiB of scanlines decodes (chitra 1.3.0)");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_INFLATE_LIMIT), IMG_ERR_INFLATE_LIMIT,
      "INFLATE_LIMIT → INFLATE_LIMIT (unreachable, still not the generic fallback)");
    var pstr_ol[160];
    assert_eq(kii_decode_image("tests/fixtures/oversize.png", &pstr_ol), IMG_OK,
      "oversize.png (2370x2370 RGB) → IMG_OK");
    assert_eq(load64(&pstr_ol + STRUCT_FORMAT_OFFSET), KII_FMT_PNG, "oversize.png is tagged PNG");
    assert_eq(load64(&pstr_ol + STRUCT_WIDTH_OFFSET),  2370, "oversize width = 2370");
    assert_eq(load64(&pstr_ol + STRUCT_HEIGHT_OFFSET), 2370, "oversize height = 2370");
    assert_eq(load64(&pstr_ol + STRUCT_SRC_COLOR_TYPE_OFFSET), 2, "oversize src color_type = 2 (RGB)");
    assert_eq(load64(&pstr_ol + STRUCT_PIXELS_SIZE_OFFSET), 2370 * 2370 * 4, "pixels size = 2370×2370×4");
    assert_eq(load64(&pstr_ol + STRUCT_SEEN_IEND_OFFSET), 1, "oversize.png saw IEND");
    # Every pixel, not a sample: the fixture is solid black, so each RGBA8
    # word must read 0xFF000000 (R = G = B = 0, A = 255).
    var olpx = load64(&pstr_ol + STRUCT_PIXELS_BUF_OFFSET);
    var ol_bad = 0;
    var ol_i = 0;
    while (ol_i < 2370 * 2370) {
        if (load32(olpx + ol_i * 4) != 0xFF000000) { ol_bad = ol_bad + 1; }
        ol_i = ol_i + 1;
    }
    assert_eq(ol_bad, 0, "all 5,616,900 oversize pixels are opaque black");

    # (f) a missing path → OPEN.
    test_group("re-fold — kii_decode_image (missing path → OPEN)");
    var path_mi[256];
    _scratch_path(&path_mi, "kii-decode-missing-zzy42.png");
    var pstr_mi[160];
    assert_eq(kii_decode_image(&path_mi, &pstr_mi), IMG_ERR_OPEN,
      "nonexistent path → IMG_ERR_OPEN");

    # ---- v1.6.4 (P(-1)) — the slurp and the pstruct ------------------
    # The slurp is now one open read to EOF under the cap (file_read_whole_max).
    # The old lseek size probe called an ext4 directory "file exceeds size
    # ceiling" (its htree EOF is ~2^63) and a pipe "cannot open file".
    test_group("v1.6.4 — a directory → IS_DIR, not 'exceeds size ceiling'");
    var pstr_dir[160];
    assert_eq(kii_decode_image("tests/fixtures", &pstr_dir), IMG_ERR_IS_DIR,
      "tests/fixtures (a directory) → IMG_ERR_IS_DIR");
    assert_streq(kii_decode_error_text(IMG_ERR_IS_DIR, KII_FMT_UNKNOWN),
      "is a directory, not an image file", "IS_DIR line");

    # main's `var pstruct[160]` is uninitialized stack, and the adapter used
    # to write only some slots, so the "has this stage run?" checks in
    # quantize / emit could read a stale pointer. kii_decode_image zeroes the
    # whole struct first; this fills it with garbage and checks that even an
    # early-failing decode leaves all 20 slots 0.
    test_group("v1.6.4 — kii_decode_image zeroes every pstruct slot");
    var pstr_z[160];
    var zs = 0;
    while (zs < 160) { store64(&pstr_z + zs, 0 - 559038737); zs = zs + 8; }
    kii_decode_image(&path_mi, &pstr_z);
    var nonzero = 0;
    zs = 0;
    while (zs < 160) { if (load64(&pstr_z + zs) != 0) { nonzero = nonzero + 1; } zs = zs + 8; }
    assert_eq(nonzero, 0, "all 20 slots zero after a failed decode");
    var pstr_z2[160];
    zs = 0;
    while (zs < 160) { store64(&pstr_z2 + zs, 0 - 559038737); zs = zs + 8; }
    assert_eq(kii_decode_image("tests/fixtures/color.gif", &pstr_z2), IMG_OK, "color.gif → IMG_OK");
    assert_eq(load64(&pstr_z2 + STRUCT_DOWNSCALED_BUF_OFFSET), 0,
      "a successful decode leaves the downscale slot 0 until downscale runs");
    assert_eq(load64(&pstr_z2 + STRUCT_QUANTIZED_BUF_OFFSET), 0,
      "… and the quantize slot 0 until quantize runs");

    # The size-cap message quotes "256 MB". KII_MAX_RAW_BYTES is chitra's
    # own CHITRA_MAX_RAW_BYTES; pin both so a chitra that moves its ceiling
    # fails here instead of leaving the message wrong.
    test_group("v1.6.4 — the slurp cap is chitra's 256 MB, as the message says");
    assert_eq(KII_MAX_RAW_BYTES, CHITRA_MAX_RAW_BYTES, "kii's cap is chitra's");
    assert_eq(KII_MAX_RAW_BYTES, 268435456, "256 MB, the figure the message quotes");

    # ---- v1.6.4 (P(-1)) — the exact decode diagnostics ---------------
    # Through v1.6.3 these lines lived inline in main's entry point, untested.
    test_group("v1.6.4 — kii_decode_error_text: format-blind lines");
    assert_streq(kii_decode_error_text(IMG_ERR_OPEN, KII_FMT_UNKNOWN), "cannot open file", "OPEN");
    assert_streq(kii_decode_error_text(IMG_ERR_FILE_TOO_LARGE, KII_FMT_UNKNOWN),
      "file exceeds size ceiling (max 256 MB)", "FILE_TOO_LARGE");
    assert_streq(kii_decode_error_text(IMG_ERR_UNRECOGNIZED, KII_FMT_UNKNOWN),
      "unrecognized image format (expected PNG, JPEG, BMP, or GIF)", "NOT_PNG");
    assert_streq(kii_decode_error_text(IMG_ERR_CRC, KII_FMT_PNG), "CRC check failed", "CRC");
    assert_streq(kii_decode_error_text(IMG_ERR_INTERLACE, KII_FMT_PNG),
      "unsupported interlace method (only 0=none / 1=Adam7 are valid)", "INTERLACE");
    assert_streq(kii_decode_error_text(IMG_ERR_BITDEPTH, KII_FMT_PNG),
      "unsupported bit depth for this color type (PNG § 11.2.2)", "BITDEPTH");
    assert_streq(kii_decode_error_text(IMG_ERR_FILTER, KII_FMT_PNG),
      "invalid PNG filter type (spec § 9 allows 0–4)", "FILTER");
    assert_streq(kii_decode_error_text(IMG_ERR_MEMORY, KII_FMT_PNG),
      "out of memory or image too large (possible decompression bomb)", "IDAT_TOO_LARGE");
    assert_streq(kii_decode_error_text(IMG_ERR_INFLATE_LIMIT, KII_FMT_PNG),
      "image too large to decode (pixel data inflates past the decompressor's 16 MiB ceiling)", "INFLATE_LIMIT");
    # C-4: chitra raises DIMENSIONS for a 0 width or height in every format,
    # and the line used to say only "exceed policy ceiling".
    assert_streq(kii_decode_error_text(IMG_ERR_DIMENSIONS, KII_FMT_GIF),
      "image dimensions are zero or past the policy ceiling (max 16.7M px / 65535 per side / 256 MB)", "DIMENSIONS");
    assert_streq(kii_decode_error_text(99, KII_FMT_PNG), "image decode failed", "an unknown code");

    test_group("v1.6.4 — kii_decode_error_text: per-format lines");
    assert_streq(kii_decode_error_text(IMG_ERR_MALFORMED, KII_FMT_PNG),
      "malformed PNG (bad chunk, ordering, or palette)", "HEADER / PNG");
    assert_streq(kii_decode_error_text(IMG_ERR_MALFORMED, KII_FMT_JPEG),
      "malformed JPEG (bad marker, segment, or entropy data)", "HEADER / JPEG");
    assert_streq(kii_decode_error_text(IMG_ERR_MALFORMED, KII_FMT_BMP),
      "malformed BMP (bad DIB header, palette, or RLE stream)", "HEADER / BMP");
    assert_streq(kii_decode_error_text(IMG_ERR_MALFORMED, KII_FMT_GIF),
      "malformed GIF (bad descriptor or color table)", "HEADER / GIF");
    assert_streq(kii_decode_error_text(IMG_ERR_TRUNCATED, KII_FMT_PNG),
      "malformed PNG (truncated chunk stream)", "CHUNK / PNG");
    assert_streq(kii_decode_error_text(IMG_ERR_TRUNCATED, KII_FMT_JPEG),
      "truncated image (unexpected end of data)", "CHUNK / other");
    assert_streq(kii_decode_error_text(IMG_ERR_UNSUPPORTED, KII_FMT_PNG),
      "unsupported image feature (unrecognized critical chunk, compression method, or color type)", "UNSUPPORTED / PNG");
    assert_streq(kii_decode_error_text(IMG_ERR_UNSUPPORTED, KII_FMT_JPEG),
      "unsupported JPEG feature (progressive, arithmetic, 12-bit, non-baseline, CMYK/4-component, or an Adobe colour transform)",
      "UNSUPPORTED / JPEG");
    # C-5: chitra also refuses OS/2 Huffman 1D and BI_CMYK as BMP_COMPRESSION,
    # which the old "BI_JPEG/BI_PNG compression" text did not cover.
    assert_streq(kii_decode_error_text(IMG_ERR_UNSUPPORTED, KII_FMT_BMP),
      "unsupported BMP feature (bit depth, compression method, or channel mask)", "UNSUPPORTED / BMP");
    # C-5: a GIF LZW failure maps to IMG_ERR_DECOMPRESS and an image-less GIF to
    # IMG_ERR_NO_IMAGE_DATA; both used to print the PNG wording.
    assert_streq(kii_decode_error_text(IMG_ERR_DECOMPRESS, KII_FMT_PNG),
      "DEFLATE decompression failed (corrupt IDAT)", "INFLATE / PNG");
    assert_streq(kii_decode_error_text(IMG_ERR_DECOMPRESS, KII_FMT_GIF),
      "corrupt GIF image data (bad LZW stream)", "INFLATE / GIF");
    assert_streq(kii_decode_error_text(IMG_ERR_NO_IMAGE_DATA, KII_FMT_PNG),
      "no IDAT chunks (nothing to decode)", "NO_IDAT / PNG");
    assert_streq(kii_decode_error_text(IMG_ERR_NO_IMAGE_DATA, KII_FMT_GIF),
      "no image in GIF (no image descriptor)", "NO_IDAT / GIF");

    test_group("v1.6.4 — kii_incomplete_warning_text");
    assert_streq(kii_incomplete_warning_text(KII_FMT_PNG),
      "warning: incomplete PNG (no IEND chunk seen)", "PNG");
    assert_streq(kii_incomplete_warning_text(KII_FMT_JPEG),
      "warning: incomplete JPEG (truncated scan or no EOI marker)", "JPEG");
    # C-5: chitra fills a short GIF frame with palette entry 0 at full alpha;
    # the line used to say "zero-filled".
    assert_streq(kii_incomplete_warning_text(KII_FMT_GIF),
      "warning: incomplete GIF (image data ran out; the rest is drawn in palette colour 0)", "GIF");
    assert_streq(kii_incomplete_warning_text(KII_FMT_BMP),
      "warning: incomplete image (stream did not close cleanly)", "other");

    # R-10: _kii_map_chitra_err falls back to IMG_ERR_MALFORMED for a code it does
    # not know, which is how INFLATE_LIMIT (35) read as "malformed PNG" through
    # v1.5.2. Pin chitra's code space: 1-35 are named, 36-98 are not. A chitra
    # that adds code 36 fails here, so its mapping gets written.
    test_group("v1.6.4 — chitra's error codes stop at 35 (a new one fails here)");
    var named = 0;
    var cc = 1;
    while (cc <= 35) {
        if (streq(chitra_err_name(cc), "unknown error") == 0) { named = named + 1; }
        cc = cc + 1;
    }
    assert_eq(named, 35, "codes 1-35 are all named");
    var unnamed = 0;
    cc = 36;
    while (cc <= 98) {
        if (streq(chitra_err_name(cc), "unknown error") == 1) { unnamed = unnamed + 1; }
        cc = cc + 1;
    }
    assert_eq(unnamed, 63, "codes 36-98 are all unnamed");

    # ---- JPEG e2e via chitra_image_decode (chitra 0.3.0, v1.4.0) ----
    # (a) the 16x16 grayscale baseline gradient (chitra's reference fixture,
    #     decoded byte-identical to ImageMagick). The adapter normalizes JPEG
    #     to depth-8 ct6 exactly like PNG; SRC_COLOR_TYPE carries the JPEG
    #     sentinel 257 (0x101 = 1 component), FORMAT = KII_FMT_JPEG, and the
    #     end-of-stream flag is 1: chitra decides it from the scan (a real
    #     EOI after the last scan), and this fixture ends cleanly.
    test_group("jpeg — decode e2e (gradient.jpg, 16x16 grayscale)");
    var pstr_jpg[160];
    assert_eq(kii_decode_image("tests/fixtures/gradient.jpg", &pstr_jpg), IMG_OK,
      "gradient.jpg → IMG_OK");
    assert_eq(load64(&pstr_jpg + STRUCT_WIDTH_OFFSET),        16, "gradient width = 16");
    assert_eq(load64(&pstr_jpg + STRUCT_HEIGHT_OFFSET),       16, "gradient height = 16");
    assert_eq(load64(&pstr_jpg + STRUCT_COLOR_TYPE_OFFSET),    6, "adapter forces ct6");
    assert_eq(load64(&pstr_jpg + STRUCT_BIT_DEPTH_OFFSET),     8, "bit_depth = 8");
    assert_eq(load64(&pstr_jpg + STRUCT_SRC_COLOR_TYPE_OFFSET), 257, "src ctype 257 (JPEG gray)");
    assert_eq(load64(&pstr_jpg + STRUCT_FORMAT_OFFSET), KII_FMT_JPEG, "format = JPEG");
    assert_eq(load64(&pstr_jpg + STRUCT_SEEN_IEND_OFFSET),     1, "JPEG ending in a real EOI → seen_iend 1");
    assert_eq(load64(&pstr_jpg + STRUCT_PIXELS_SIZE_OFFSET), 16 * 16 * 4, "pixels size = 16×16×4");
    assert(load64(&pstr_jpg + STRUCT_PIXELS_BUF_OFFSET) != 0, "pixels_buf non-null");
    # Decoded-pixel correctness through kii (row-0 horizontal ramp; R==G==B
    # for grayscale, A==255). Locks the e2e against the ImageMagick reference.
    var jpx = load64(&pstr_jpg + STRUCT_PIXELS_BUF_OFFSET);
    assert_eq(load8(jpx + 0 * 4),  255, "gradient px0  R = 255 (bright edge)");
    assert_eq(load8(jpx + 1 * 4),  240, "gradient px1  R = 240");
    assert_eq(load8(jpx + 7 * 4),  136, "gradient px7  R = 136");
    assert_eq(load8(jpx + 15 * 4),   0, "gradient px15 R = 0 (dark edge)");
    assert_eq(load8(jpx + 3),      255, "gradient px0  A = 255 (opaque)");
    # Grayscale invariant: a 1-component JPEG decodes to R==G==B per pixel.
    assert_eq(load8(jpx + 0 * 4 + 1), load8(jpx + 0 * 4 + 0), "gradient px0 G == R (grayscale)");
    assert_eq(load8(jpx + 0 * 4 + 2), load8(jpx + 0 * 4 + 0), "gradient px0 B == R (grayscale)");
    assert_eq(load8(jpx + 7 * 4 + 1), load8(jpx + 7 * 4 + 0), "gradient px7 G == R (grayscale)");
    assert_eq(load8(jpx + 7 * 4 + 2), load8(jpx + 7 * 4 + 0), "gradient px7 B == R (grayscale)");
    # Pure horizontal gradient: row 8 must equal row 0 at EVERY column (no
    # vertical variation), not just one pixel — actually compare the rows.
    var grad_row_eq = 1;
    var grad_c = 0;
    while (grad_c < 16) {
        if (load8(jpx + (0 * 16 + grad_c) * 4) != load8(jpx + (8 * 16 + grad_c) * 4)) { grad_row_eq = 0; }
        grad_c = grad_c + 1;
    }
    assert_eq(grad_row_eq, 1, "row 8 == row 0 across all 16 columns (pure horizontal gradient)");

    # (b) a 3-component baseline JPEG (YCbCr 4:4:4) → SRC_COLOR_TYPE 259
    #     (0x103) exercises the chroma path through the adapter.
    test_group("jpeg — decode e2e (color.jpg, 8x8 YCbCr)");
    var pstr_clr[160];
    assert_eq(kii_decode_image("tests/fixtures/color.jpg", &pstr_clr), IMG_OK,
      "color.jpg → IMG_OK");
    assert_eq(load64(&pstr_clr + STRUCT_WIDTH_OFFSET),         8, "color width = 8");
    assert_eq(load64(&pstr_clr + STRUCT_HEIGHT_OFFSET),        8, "color height = 8");
    assert_eq(load64(&pstr_clr + STRUCT_SRC_COLOR_TYPE_OFFSET), 259, "src ctype 259 (JPEG YCbCr)");
    assert_eq(load64(&pstr_clr + STRUCT_FORMAT_OFFSET), KII_FMT_JPEG, "format = JPEG");
    assert_eq(load64(&pstr_clr + STRUCT_PIXELS_SIZE_OFFSET), 8 * 8 * 4, "pixels size = 8×8×4");
    # Chroma correctness through the adapter: color.jpg is a vertical red→blue
    # gradient, so the top-left pixel decodes red-dominant and the bottom-right
    # blue-dominant. A swapped/zeroed Cb/Cr would fail these. Ranges, not exact
    # bytes (JPEG is lossy: the red edge decodes ~254, the blue ~253).
    var cpx = load64(&pstr_clr + STRUCT_PIXELS_BUF_OFFSET);
    assert(cpx != 0, "color pixels_buf non-null");
    assert(load8(cpx + 0) > 200,           "color px0 R high (red top-left)");
    assert(load8(cpx + 1) < 60,            "color px0 G low (red top-left)");
    assert(load8(cpx + 2) < 60,            "color px0 B low (red top-left)");
    assert_eq(load8(cpx + 3), 255,         "color px0 A = 255 (opaque)");
    assert(load8(cpx + 63 * 4 + 2) > 200,  "color px63 B high (blue bottom-right)");
    assert(load8(cpx + 63 * 4 + 0) < 60,   "color px63 R low (blue bottom-right)");

    # (c) the format tag for a PNG is KII_FMT_PNG (RAMGON, re-decoded).
    test_group("jpeg — format tag distinguishes PNG from JPEG");
    var pstr_fmt[160];
    assert_eq(kii_decode_image("tests/fixtures/RAMGON.png", &pstr_fmt), IMG_OK, "RAMGON → IMG_OK");
    assert_eq(load64(&pstr_fmt + STRUCT_FORMAT_OFFSET), KII_FMT_PNG, "PNG input → format = PNG");

    # (d) a progressive-JPEG stub (SOI + SOF2) is a VALID but unsupported
    #     JPEG → IMG_ERR_UNSUPPORTED (not 'malformed'), and FORMAT = JPEG so
    #     main can phrase the unsupported-feature diagnostic.
    test_group("jpeg — progressive stub → IMG_ERR_UNSUPPORTED");
    var path_pg[256];
    _scratch_path(&path_pg, "kii-decode-prog.jpg");
    file_write_all(&path_pg, "\xFF\xD8\xFF\xC2", 4);          # SOI + SOF2 (progressive)
    var pstr_pg[160];
    assert_eq(kii_decode_image(&path_pg, &pstr_pg), IMG_ERR_UNSUPPORTED,
      "progressive JPEG → IMG_ERR_UNSUPPORTED");
    assert_eq(load64(&pstr_pg + STRUCT_FORMAT_OFFSET), KII_FMT_JPEG, "stub tagged JPEG before decode");

    # (e) a JPEG with SOI then a non-marker byte → malformed → IMG_ERR_MALFORMED
    #     (main prints "malformed JPEG ..." because FORMAT = JPEG).
    test_group("jpeg — malformed marker stream → IMG_ERR_MALFORMED");
    var path_mj[256];
    _scratch_path(&path_mj, "kii-decode-badjpeg.jpg");
    file_write_all(&path_mj, "\xFF\xD8\x00\x00\x00\x00", 6);  # SOI then garbage (no FF marker)
    var pstr_mj[160];
    assert_eq(kii_decode_image(&path_mj, &pstr_mj), IMG_ERR_MALFORMED,
      "malformed JPEG marker stream → IMG_ERR_MALFORMED");
    assert_eq(load64(&pstr_mj + STRUCT_FORMAT_OFFSET), KII_FMT_JPEG, "tagged JPEG (SOI matched)");

    # ---- BMP + GIF e2e via chitra_image_decode (chitra 1.0.0, v1.5.0) ----
    # kii gained both formats without a decode change: the adapter already
    # called the format-sniffing chitra_image_decode unconditionally, so
    # re-pinning chitra 0.3.0 -> 1.0.0 (BMP at 0.4.0, GIF at 0.5.0) made them
    # render. These pin the DIAGNOSTIC half that did not come free: the
    # KII_FMT_* tag and the source-sentinel decode.
    #
    # (a) 16x16 24-bpp BI_RGB BMP — a horizontal white->black ramp, so the
    #     decoded rows are a known ImageMagick-verified sequence (px0 = 0,
    #     px1 = 17, px2 = 34, stepping by 17). BMP scanlines are stored
    #     bottom-up; chitra normalizes to top-down RGBA8, so row 0 here is the
    #     image's TOP row and the ramp reads left-to-right like the oracle.
    test_group("bmp — decode e2e (gradient.bmp, 16x16 24bpp BI_RGB)");
    var pstr_bmp[160];
    assert_eq(kii_decode_image("tests/fixtures/gradient.bmp", &pstr_bmp), IMG_OK,
      "gradient.bmp → IMG_OK");
    assert_eq(load64(&pstr_bmp + STRUCT_WIDTH_OFFSET),         16, "bmp width = 16");
    assert_eq(load64(&pstr_bmp + STRUCT_HEIGHT_OFFSET),        16, "bmp height = 16");
    assert_eq(load64(&pstr_bmp + STRUCT_COLOR_TYPE_OFFSET),     6, "adapter forces ct6");
    assert_eq(load64(&pstr_bmp + STRUCT_BIT_DEPTH_OFFSET),      8, "bit_depth = 8");
    assert_eq(load64(&pstr_bmp + STRUCT_SRC_COLOR_TYPE_OFFSET), 536, "src ctype 536 (0x218 = BMP 24bpp)");
    assert_eq(load64(&pstr_bmp + STRUCT_FORMAT_OFFSET), KII_FMT_BMP, "format = BMP");
    assert_eq(load64(&pstr_bmp + STRUCT_PIXELS_SIZE_OFFSET), 16 * 16 * 4, "bmp pixels size = 16×16×4");
    assert(load64(&pstr_bmp + STRUCT_PIXELS_BUF_OFFSET) != 0, "bmp pixels_buf non-null");
    # Decoded-pixel correctness against the ImageMagick oracle.
    var bpx = load64(&pstr_bmp + STRUCT_PIXELS_BUF_OFFSET);
    assert_eq(load8(bpx + 0 * 4),   0, "bmp px0 R = 0 (black edge)");
    assert_eq(load8(bpx + 1 * 4),  17, "bmp px1 R = 17");
    assert_eq(load8(bpx + 2 * 4),  34, "bmp px2 R = 34");
    assert_eq(load8(bpx + 3 * 4),  51, "bmp px3 R = 51");
    assert_eq(load8(bpx + 3),     255, "bmp px0 A = 255 (opaque)");
    # Greyscale ramp: R == G == B at every sampled pixel.
    assert_eq(load8(bpx + 1 * 4 + 1), load8(bpx + 1 * 4 + 0), "bmp px1 G == R");
    assert_eq(load8(bpx + 1 * 4 + 2), load8(bpx + 1 * 4 + 0), "bmp px1 B == R");
    # Pure horizontal ramp: row 8 equals row 0 at every column.
    var bmp_row_eq = 1;
    var bmp_c = 0;
    while (bmp_c < 16) {
        if (load8(bpx + (0 * 16 + bmp_c) * 4) != load8(bpx + (8 * 16 + bmp_c) * 4)) { bmp_row_eq = 0; }
        bmp_c = bmp_c + 1;
    }
    assert_eq(bmp_row_eq, 1, "bmp row 8 == row 0 at every column (no vertical variation)");

    # (b) 16x16 GIF89a, four flat quadrants (red / lime / blue / white). Pins
    #     the palette path and the 0x300 | min_code_size sentinel. GIF is
    #     FIRST FRAME ONLY by chitra's ADR 0005 — this fixture is single-frame,
    #     so that limit is not what is under test here.
    test_group("gif — decode e2e (color.gif, 16x16 GIF89a palette)");
    var pstr_gif[160];
    assert_eq(kii_decode_image("tests/fixtures/color.gif", &pstr_gif), IMG_OK,
      "color.gif → IMG_OK");
    assert_eq(load64(&pstr_gif + STRUCT_WIDTH_OFFSET),      16, "gif width = 16");
    assert_eq(load64(&pstr_gif + STRUCT_HEIGHT_OFFSET),     16, "gif height = 16");
    assert_eq(load64(&pstr_gif + STRUCT_COLOR_TYPE_OFFSET),  6, "adapter forces ct6");
    assert_eq(load64(&pstr_gif + STRUCT_FORMAT_OFFSET), KII_FMT_GIF, "format = GIF");
    assert_eq(load64(&pstr_gif + STRUCT_PIXELS_SIZE_OFFSET), 16 * 16 * 4, "gif pixels size = 16×16×4");
    assert(load64(&pstr_gif + STRUCT_PIXELS_BUF_OFFSET) != 0, "gif pixels_buf non-null");
    # The sentinel is 0x300 | min_code_size; the encoder picks the code size,
    # so pin the FORMAT byte rather than an exact value the encoder may vary.
    var gsent = load64(&pstr_gif + STRUCT_SRC_COLOR_TYPE_OFFSET);
    assert(gsent >= 769 && gsent <= 776, "gif src ctype in 0x300|min_code_size range");
    # Quadrant colors against the ImageMagick oracle (top-left red, top-right
    # lime, bottom-left blue, bottom-right white).
    var gpx = load64(&pstr_gif + STRUCT_PIXELS_BUF_OFFSET);
    assert_eq(load8(gpx + (0 * 16 + 0) * 4 + 0), 255, "gif (0,0) R = 255 (red)");
    assert_eq(load8(gpx + (0 * 16 + 0) * 4 + 1),   0, "gif (0,0) G = 0");
    assert_eq(load8(gpx + (0 * 16 + 0) * 4 + 2),   0, "gif (0,0) B = 0");
    assert_eq(load8(gpx + (0 * 16 + 15) * 4 + 0),   0, "gif (15,0) R = 0 (lime)");
    assert_eq(load8(gpx + (0 * 16 + 15) * 4 + 1), 255, "gif (15,0) G = 255");
    assert_eq(load8(gpx + (15 * 16 + 0) * 4 + 2), 255, "gif (0,15) B = 255 (blue)");
    assert_eq(load8(gpx + (15 * 16 + 15) * 4 + 0), 255, "gif (15,15) R = 255 (white)");
    assert_eq(load8(gpx + (15 * 16 + 15) * 4 + 1), 255, "gif (15,15) G = 255 (white)");
    assert_eq(load8(gpx + (15 * 16 + 15) * 4 + 2), 255, "gif (15,15) B = 255 (white)");
    assert_eq(load8(gpx + 3), 255, "gif px0 A = 255 (opaque)");

    # (c) the BMP/GIF ChitraErr codes chitra 1.0.0 added (24-34). Before
    #     v1.5.0 every one of them fell through _kii_map_chitra_err's default,
    #     so a corrupt BMP reported the PNG chunk/ordering wording.
    test_group("bmp/gif — _kii_map_chitra_err covers ChitraErr 24-34");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_BMP_HEADER),      IMG_ERR_MALFORMED,      "BMP_HEADER → HEADER");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_BMP_PALETTE),     IMG_ERR_MALFORMED,      "BMP_PALETTE → HEADER");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_BMP_RLE),         IMG_ERR_MALFORMED,      "BMP_RLE → HEADER");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_BMP_DEPTH),       IMG_ERR_UNSUPPORTED, "BMP_DEPTH → UNSUPPORTED");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_BMP_COMPRESSION), IMG_ERR_UNSUPPORTED, "BMP_COMPRESSION → UNSUPPORTED");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_BMP_MASK),        IMG_ERR_UNSUPPORTED, "BMP_MASK → UNSUPPORTED");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_GIF_HEADER),      IMG_ERR_MALFORMED,      "GIF_HEADER → HEADER");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_GIF_PALETTE),     IMG_ERR_MALFORMED,      "GIF_PALETTE → HEADER");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_GIF_LZW),         IMG_ERR_DECOMPRESS,     "GIF_LZW → INFLATE");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_GIF_NO_IMAGE),    IMG_ERR_NO_IMAGE_DATA,     "GIF_NO_IMAGE → NO_IDAT");
    assert_eq(_kii_map_chitra_err(CHITRA_ERR_BUDGET),          IMG_ERR_MEMORY, "BUDGET → IDAT_TOO_LARGE");

    # (d) the source-sentinel names --verbose prints. Before v1.5.0 every
    #     non-PNG/non-JPEG sentinel rendered as "?".
    test_group("bmp/gif — kii_source_type_name knows the new sentinels");
    assert_streq(kii_source_type_name(275), "RGB (JPEG)",         "275 (0x113) → RGB (JPEG)");
    assert_streq(kii_source_type_name(513), "1bpp palette (BMP)",  "513 (0x201) → 1bpp palette (BMP)");
    assert_streq(kii_source_type_name(516), "4bpp palette (BMP)",  "516 (0x204) → 4bpp palette (BMP)");
    assert_streq(kii_source_type_name(520), "8bpp palette (BMP)",  "520 (0x208) → 8bpp palette (BMP)");
    assert_streq(kii_source_type_name(528), "16bpp (BMP)",         "528 (0x210) → 16bpp (BMP)");
    assert_streq(kii_source_type_name(536), "24bpp (BMP)",         "536 (0x218) → 24bpp (BMP)");
    assert_streq(kii_source_type_name(544), "32bpp (BMP)",         "544 (0x220) → 32bpp (BMP)");
    assert_streq(kii_source_type_name(770), "palette (GIF)",       "770 (0x302) → palette (GIF)");
    assert_streq(kii_source_type_name(776), "palette (GIF)",       "776 (0x308) → palette (GIF)");
    # The sentinel ranges must not swallow a neighbour: 512 (0x200, bpp=0) and
    # 768 (0x300, min_code_size=0) are both structurally impossible, and 545 /
    # 777 sit one past each block. All four stay unknown.
    assert_streq(kii_source_type_name(512), "?", "512 (0x200, bpp=0) → ?");
    assert_streq(kii_source_type_name(545), "?", "545 (one past BMP 32bpp) → ?");
    assert_streq(kii_source_type_name(768), "?", "768 (0x300, mcs=0) → ?");
    assert_streq(kii_source_type_name(777), "?", "777 (one past GIF range) → ?");

    # (e) a non-image file is now refused as "not any of the four", and the
    #     format tag stays UNKNOWN so main phrases it generically.
    test_group("bmp/gif — a non-image file tags UNKNOWN");
    var path_nx[256];
    _scratch_path(&path_nx, "kii-decode-notimage.txt");
    file_write_all(&path_nx, "not an image at all, just text\n", 31);
    var pstr_nx[160];
    assert_eq(kii_decode_image(&path_nx, &pstr_nx), IMG_ERR_UNRECOGNIZED,
      "plain text → IMG_ERR_UNRECOGNIZED");
    assert_eq(load64(&pstr_nx + STRUCT_FORMAT_OFFSET), KII_FMT_UNKNOWN, "format stays UNKNOWN");

    test_subbyte_now_renders();
    test_interlace_now_renders();
    return assert_summary();
}

var exit_code = main();
syscall(SYS_EXIT, exit_code);
