# kii fuzz harness — two crash-safety surfaces in one binary.
#
# 1. Arg parser (M1 sub-bite (d)): drives kii's flag set via
#    kii_register_flags with deterministic LCG-generated random
#    argv arrays. Contract: cmdit_parse_argv never crashes on malformed
#    input, only returns CMDIT_* codes cleanly.
#
# 2. PNG decode adapter (M2 sub-bite (d), re-aimed at the PNG re-fold):
#    writes random byte sequences to /tmp/kii-fuzz-png.bin + drives
#    kii_decode_image (the chitra adapter) over them. 50% of iterations
#    prepend a valid signature + IHDR so chitra's post-IHDR chunk walker
#    gets exercised. Contract: kii_decode_image never crashes; returns
#    IMG_OK or any IMG_ERR_* cleanly.
#
# 3b. BMP + GIF decode adapters (v1.5.0, chitra 1.0.0): the same shape as
#    the JPEG surface below — prepend the format signature ("BM" / "GIF89a")
#    so the sniff routes the random payload into chitra's BMP or GIF decoder,
#    and rewind the bump allocator each iteration. The GIF surface is the
#    highest-value one of the four: LZW builds a dictionary from
#    attacker-controlled codes, which is the classic GIF-decoder CVE class.
#
# 3. JPEG decode adapter (v1.4.0, chitra 0.3.0): writes SOI (0xFFD8) +
#    random bytes to /tmp/kii-fuzz-jpeg.bin + drives the same kii_decode_image
#    adapter, which now routes JPEG-signature input to chitra's JPEG decoder
#    via chitra_image_decode. Exercises the format sniff + marker/segment
#    parser over arbitrary bytes. Crash-safety only. NOTE: a present SOI makes
#    chitra allocate its frame/quant/huff scratch (~22 KB) before the marker
#    walk fails, so each PNG/JPEG decode iter calls alloc_reset() to rewind
#    the never-free bump allocator — without that the heap would grow
#    unboundedly (~22 GB over 10⁶ JPEG iters). Every alloc_reset() is paired
#    with `crc32_table = 0` — see fuzz_png_iter; without it the reset
#    invalidates sankoch's cached CRC table and voids the surface.
#    Deep entropy/IDCT decode
#    fuzzing is chitra's own suite's job (the decoder's owner), matching the
#    re-fold's division of labor.
#
# Determinism: fixed seed (1) + Numerical Recipes LCG. Same byte
# sequences every CI run; failures bisect cleanly.
#
# Stdlib and the cmdit / darshana / chitra bundles auto-resolve from
# cyrius.cyml; the project modules come from the includes below.

include "src/cli.cyr"
include "src/image.cyr"
include "src/palette.cyr"
include "src/quant.cyr"
include "src/downscale.cyr"
include "src/emit.cyr"
include "src/ascii.cyr"
include "src/blocks.cyr"
include "src/braille.cyr"

# Iteration counts.
#
# Arg-parser fuzz (FUZZ_ITERS): 10k baseline (no I/O, runs in <50 ms).
# PNG-decoder fuzz (PNG_FUZZ_ITERS): scaled 2k → 10⁶ at M7(b) per the
#   v1.0 acceptance criterion (docs/development/roadmap.md § M7). Each
#   iter does a /tmp file_write_all + open + read on tmpfs; 10⁶ iters
#   lands around ~35s on the dev box.
# Path-sanitizer fuzz (PATH_FUZZ_ITERS): pure-memory; 10⁶ at full
#   M7(b) scale, runs in <1 s.
# Geometry fuzz (GEOM_FUZZ_ITERS): pure-memory; 10⁶ at full M7(b)
#   scale, runs in <1 s.
# Emit-pipeline fuzz (EMIT_FUZZ_ITERS): decodes RAMGON.png once,
#   then varies (dst_cols, dst_rows) randomly per iter through
#   downscale → quantize → emit. 1k iters at ~1ms each (the
#   end-to-end bench at ~770ms/iter is mostly PNG decode, which
#   we skip here by reusing the decoded pstruct).
var FUZZ_ITERS        = 10000;
var PNG_FUZZ_ITERS    = 1000000;
var JPEG_FUZZ_ITERS   = 1000000;
var BMP_FUZZ_ITERS    = 1000000;   # v1.5.0 — chitra 1.0.0 BMP path
var GIF_FUZZ_ITERS    = 1000000;   # v1.5.0 — chitra 1.0.0 GIF/LZW path
var PATH_FUZZ_ITERS   = 1000000;
var GEOM_FUZZ_ITERS   = 1000000;
var EMIT_FUZZ_ITERS   = 1000;
var PATH_DIFF_FUZZ_ITERS = 1000000;   # v1.6.0 — tty_has_ctl vs the v1.5.2 walk
var ENV_FUZZ_ITERS       = 1000000;   # v1.6.0 — _kii_term_envelope + fit geometry
var ASCII_FUZZ_ITERS     = 40000;     # v1.10.0 — the ASCII lane's contrast pass + match
var AREA_FUZZ_ITERS      = 100000;    # v1.11.0 — the ASCII lane's area sampler
var BLK_CELL_FUZZ_ITERS   = 200000;    # v2.0.0 — the blocks lane's shape choice vs brute force
var BLK_FRAME_FUZZ_ITERS  = 20000;     # v2.0.0 — whole blocks frames, pad differential
var HB_FUZZ_ITERS         = 200000;    # v2.1.0 — half-block rows decoded back to their colours
var INV_FUZZ_ITERS        = 50000;     # v2.2.0 — --invert against the negative, --color none against the escapes
var BRL_FUZZ_ITERS        = 30000;     # v2.3.0 — the Braille lane: sampler, ink rules, negative, escapes

# Per-iter argv shape. argc ∈ [1, FUZZ_MAX_ARGC]; each arg's body
# is ≤ FUZZ_MAX_ARG_LEN bytes plus an optional "-"/"--" prefix.
var FUZZ_MAX_ARGC    = 8;
var FUZZ_MAX_ARG_LEN = 24;

# Per-iter PNG fuzz shape. Random byte payload length ∈ [0,
# PNG_FUZZ_MAX_LEN]; optionally prepended with a 33-byte valid
# signature + IHDR prefix (50% of iters) so the chunk walker is
# reached. Scratch buf accommodates prefix + payload.
var PNG_FUZZ_MAX_LEN = 1024;

# ---- deterministic LCG ----------------------------------------------
# Numerical Recipes constants. Seed is mutable module state so each
# rand call advances it. Masked to 32 bits after multiply to keep
# the modulus operand positive (avoids sign weirdness with `%`).
var _fuzz_seed = 1;

fn _fuzz_rand(): i64 {
    _fuzz_seed = _fuzz_seed * 1664525 + 1013904223;
    _fuzz_seed = _fuzz_seed & 0xFFFFFFFF;
    return _fuzz_seed;
}

fn _fuzz_rand_range(n): i64 {
    return _fuzz_rand() % n;
}

# Pick a printable-ASCII byte (0x21–0x7E). NUL is excluded because
# argv entries are null-terminated cstrs; multi-byte UTF-8 leaders
# are excluded so we focus pressure on the parser's flag-recognition
# path (which is ASCII-only) rather than on string-handling
# robustness (separate concern, separate fuzz at M2+).
fn _fuzz_printable_byte(): i64 {
    var span = 0x7E - 0x21 + 1;              # 94 printable bytes
    return 0x21 + (_fuzz_rand() % span);
}

# Build one random arg in `buf`, null-terminated. Returns the
# byte length excluding the terminator. The first 1–2 bytes are
# biased to "-" / "--" 50% of the time so the parser actually
# exercises its flag-recognition path (a uniform random byte
# starts with '-' only ~1% of the time, far too rare to find
# parser bugs in 10k iters).
fn _fuzz_build_arg(buf, max_len): i64 {
    var mode = _fuzz_rand_range(4);
    var off  = 0;
    if (mode == 0) {
        # "--foo" / "--foo=bar" shape
        store8(buf + 0, 0x2D);
        store8(buf + 1, 0x2D);
        off = 2;
    } else { if (mode == 1) {
            # "-x" / "-xy" shape (bundled rejection path is reachable)
            store8(buf + 0, 0x2D);
            off = 1;
        } else {
            # bare positional / weird bytes
            off = 0;
        } }
    var body_len = 1 + _fuzz_rand_range(max_len - off - 1);
    var i = 0;
    while (i < body_len) {
        store8(buf + off + i, _fuzz_printable_byte());
        i = i + 1;
    }
    store8(buf + off + body_len, 0);
    return off + body_len;
}

# ---- PNG fuzz support ----------------------------------------------
# Pre-built 33-byte "valid prefix" (signature + IHDR for a 4x2 RGB
# image with computed IHDR CRC) — prepended to random-byte fuzz
# inputs 50% of the time so the chunk walker post-IHDR sees random
# chunks. Module-scope `var arr[33]` = 33 × u64 slots = 264 bytes
# (we use the first 33 bytes; rest is wasted but cheap). Caller
# must call _png_fuzz_init_prefix() once before the first PNG fuzz
# iter so the IHDR CRC is computed and stored.
var _png_fuzz_prefix[33];
var _png_fuzz_prefix_inited = 0;

fn _png_fuzz_init_prefix(): i64 {
    if (_png_fuzz_prefix_inited == 1) { return 0; }
    crc32_init_table();
    var b = &_png_fuzz_prefix;
    # signature (inlined; PNG_MAGIC removed in the PNG re-fold)
    store8(b + 0, 0x89); store8(b + 1, 0x50); store8(b + 2, 0x4E); store8(b + 3, 0x47);
    store8(b + 4, 0x0D); store8(b + 5, 0x0A); store8(b + 6, 0x1A); store8(b + 7, 0x0A);
    # IHDR length = 13
    store8(b + 8, 0);  store8(b + 9, 0);  store8(b + 10, 0); store8(b + 11, 13);
    # IHDR type "IHDR"
    store8(b + 12, 0x49); store8(b + 13, 0x48); store8(b + 14, 0x44); store8(b + 15, 0x52);
    # IHDR data: 4×2, depth=8, RGB, comp=0, filter=0, interlace=0
    store8(b + 16, 0); store8(b + 17, 0); store8(b + 18, 0); store8(b + 19, 4);
    store8(b + 20, 0); store8(b + 21, 0); store8(b + 22, 0); store8(b + 23, 2);
    store8(b + 24, 8); store8(b + 25, 2);
    store8(b + 26, 0); store8(b + 27, 0); store8(b + 28, 0);
    # IHDR CRC32 over type + data (17 bytes at offset 12..28)
    var crc = crc32(b + 12, 17);
    store8(b + 29, (crc >> 24) & 0xFF);
    store8(b + 30, (crc >> 16) & 0xFF);
    store8(b + 31, (crc >> 8)  & 0xFF);
    store8(b + 32, crc & 0xFF);
    _png_fuzz_prefix_inited = 1;
    return 0;
}

# ---- M7(b) path-sanitizer fuzz surface -----------------------------
# Random-byte path buffers driven through kii_path_has_control_bytes
# (src/cli.cyr) to confirm the predicate never crashes and always
# returns 0 or 1, regardless of byte content. Each iter generates a
# null-terminated byte string in `buf` with each non-NUL byte chosen
# uniformly from 0x01..0xFF (NUL would terminate prematurely).
# Contract: predicate returns exactly 0 or 1; total call count
# matches PATH_FUZZ_ITERS.
fn fuzz_path_iter(buf, max_len): i64 {
    var n = 1 + _fuzz_rand_range(max_len - 1);
    var i = 0;
    while (i < n) {
        # 0x01..0xFF — exclude NUL (we add it as terminator)
        store8(buf + i, 1 + (_fuzz_rand() % 255));
        i = i + 1;
    }
    store8(buf + n, 0);
    var rc = kii_path_has_control_bytes(buf);
    # Defensive cross-check: return MUST be 0 or 1. If the predicate
    # somehow returns something else, count it as a failure (the
    # main loop tallies the bad-return count).
    if (rc == 0 || rc == 1) { return 0; }
    return 0 - 1;
}

# ---- v1.6.0 path-sanitizer DIFFERENTIAL surface -------------------
# kii_path_has_control_bytes became a wrapper over darshana's tty_has_ctl
# at v1.6.0. The intended difference from the walk kii shipped through
# v1.5.2 is exactly one class: sequences that are structurally UTF-8 but
# forbidden by RFC 3629 (overlong E0 80-9F / F0 80-8F, surrogates
# ED A0-BF, past U+10FFFF F4 90-BF). This surface proves that is the ONLY
# difference: on every input, the new verdict must equal
#   1                      if the v1.5.2 walk rejected it, else
#   strict_only(input)     (1 iff it holds one of those four forms).
# The generator builds strings from UTF-8-shaped tokens (valid sequences of
# every length, the four strict-only forms, C0/DEL, stray high bytes,
# truncated sequences) so a large share of inputs is valid text — random
# bytes alone almost never are, and would leave the "both accept" and
# "strict-only" cells empty. The report tallies both.
fn _ref_path_walk_v152(path): i64 {
    var len = strlen(path);
    var i = 0;
    while (i < len) {
        var b = load8(path + i);
        if ((b < 0x20 && b != 0x09 && b != 0x0A) || b == 0x7F) {
            return 1;
        }
        if (b < 0x80) { i = i + 1; }
        else {
            var seq = 0;
            if (b >= 0xC2 && b <= 0xDF) { seq = 2; }
            if (b >= 0xE0 && b <= 0xEF) { seq = 3; }
            if (b >= 0xF0 && b <= 0xF4) { seq = 4; }
            if (seq == 0)       { return 1; }
            if (i + seq > len)  { return 1; }
            var k = 1;
            while (k < seq) {
                var c = load8(path + i + k);
                if (c < 0x80 || c > 0xBF) { return 1; }
                k = k + 1;
            }
            if (seq == 2 && b == 0xC2) {
                var c1 = load8(path + i + 1);
                if (c1 >= 0x80 && c1 <= 0x9F) { return 1; }
            }
            i = i + seq;
        }
    }
    return 0;
}

# For a string the v1.5.2 walk accepted: 1 iff some sequence in it is one
# of the four RFC 3629 second-byte violations, else 0.
fn _ref_strict_only(path): i64 {
    var len = strlen(path);
    var i = 0;
    while (i < len) {
        var b = load8(path + i);
        if (b < 0x80) { i = i + 1; }
        else {
            var c1 = load8(path + i + 1);
            if (b == 0xE0 && c1 < 0xA0) { return 1; }
            if (b == 0xED && c1 > 0x9F) { return 1; }
            if (b == 0xF0 && c1 < 0x90) { return 1; }
            if (b == 0xF4 && c1 > 0x8F) { return 1; }
            var seq = 2;
            if (b >= 0xE0) { seq = 3; }
            if (b >= 0xF0) { seq = 4; }
            i = i + seq;
        }
    }
    return 0;
}

fn _fz_cont(): i64 { return 0x80 + (_fuzz_rand() % 64); }

# Append one token at buf + n; returns the new length.
fn _fz_token(buf, n): i64 {
    var r = _fuzz_rand() % 100;
    if (r < 40) { store8(buf + n, 0x20 + (_fuzz_rand() % 95)); return n + 1; }
    if (r < 50) {                                   # 2-byte (incl. C2 80-9F)
        store8(buf + n, 0xC2 + (_fuzz_rand() % 30)); store8(buf + n + 1, _fz_cont());
        return n + 2;
    }
    var lead = 0;
    var lo = 0x80;
    var span = 64;
    var len = 3;
    if (r < 60)      { lead = 0xE1 + (_fuzz_rand() % 14); if (lead >= 0xED) { lead = lead + 1; } }
    else { if (r < 65) { lead = 0xE0; lo = 0xA0; span = 32; }
    else { if (r < 68) { lead = 0xE0; lo = 0x80; span = 32; }          # strict-only
    else { if (r < 71) { lead = 0xED; lo = 0x80; span = 32; }
    else { if (r < 74) { lead = 0xED; lo = 0xA0; span = 32; }          # strict-only
    else { if (r < 79) { lead = 0xF1 + (_fuzz_rand() % 3); len = 4; }
    else { if (r < 81) { lead = 0xF0; lo = 0x90; span = 48; len = 4; }
    else { if (r < 83) { lead = 0xF0; lo = 0x80; span = 16; len = 4; } # strict-only
    else { if (r < 85) { lead = 0xF4; lo = 0x80; span = 16; len = 4; }
    else { if (r < 87) { lead = 0xF4; lo = 0x90; span = 48; len = 4; } # strict-only
    else { if (r < 91) {                            # C0 control or DEL
        var cb = 1 + (_fuzz_rand() % 32);
        if (cb == 32) { cb = 0x7F; }
        store8(buf + n, cb); return n + 1;
    }
    else { if (r < 94) { store8(buf + n, 0x80 + (_fuzz_rand() % 128)); return n + 1; }
    else { if (r < 97) {                            # truncated: lead + 1 cont
        store8(buf + n, 0xE0 + (_fuzz_rand() % 21)); store8(buf + n + 1, _fz_cont());
        return n + 2;
    }
    else { store8(buf + n, 1 + (_fuzz_rand() % 255)); return n + 1; } } } } } } } } } } } } }
    store8(buf + n, lead);
    store8(buf + n + 1, lo + (_fuzz_rand() % span));
    var k = 2;
    while (k < len) { store8(buf + n + k, _fz_cont()); k = k + 1; }
    return n + len;
}

var _fz_diff_valid  = 0;   # both walks accept
var _fz_diff_strict = 0;   # v1.5.2 accepted, v1.6.0 refuses (the intended change)

fn fuzz_path_diff_iter(buf, cap): i64 {
    var tokens = 1 + (_fuzz_rand() % 12);
    var n = 0;
    var t = 0;
    while (t < tokens && n + 4 < cap) {
        n = _fz_token(buf, n);
        t = t + 1;
    }
    store8(buf + n, 0);
    var old = _ref_path_walk_v152(buf);
    var now = kii_path_has_control_bytes(buf);
    var want = 1;
    if (old == 0) { want = _ref_strict_only(buf); }
    if (old == 0 && now == 0) { _fz_diff_valid = _fz_diff_valid + 1; }
    if (old == 0 && now == 1) { _fz_diff_strict = _fz_diff_strict + 1; }
    if (now != want) { return 0 - 1; }
    return 0;
}

# ---- v1.6.0 terminal-envelope surface ------------------------------
# _kii_term_envelope (src/emit.cyr) feeding _kii_compute_fit_geometry, over
# random winsize answers — many of them 0, 1 or half-set, which is where the
# v1.5.1 A-8 defect lived. Invariants: a failed detection is 0 x 0; each
# dimension is used iff it is > 0, rows less the prompt row (a 1-row
# terminal keeps 1); a measured TTY reporting 0 rows gets the default less
# the prompt row (v1.6.4, C-8 — this surface failed 83,256 of 1M iterations
# against the new rule until its reference was updated, which is the
# surface doing its job); and the resulting frame is never wider than a
# measured column count or taller than the envelope's rows.
fn _fz_dim(): i64 {
    if (_fuzz_rand() % 3 == 0) { return _fuzz_rand() % 4; }
    return _fuzz_rand() % 65536;
}

fn fuzz_envelope_iter(): i64 {
    var rc = 0;
    if (_fuzz_rand() % 4 == 0) { rc = 0 - 1; }
    var rows = _fz_dim();
    var cols = _fz_dim();
    var src_w = 1 + (_fuzz_rand() % 65535);
    var src_h = 1 + (_fuzz_rand() % 65535);
    var fc = 0 - 9;
    var fr = 0 - 9;
    if (_kii_term_envelope(rc, rows, cols, &fc, &fr) != 0) { return 0 - 1; }
    var want_c = 0;
    var want_r = 0;
    if (rc == 0) {
        if (cols > 0) { want_c = cols; }
        if (rows > 1) { want_r = rows - 1; }
        if (rows == 1) { want_r = 1; }
        if (rows == 0) { want_r = EMIT_DEFAULT_ROWS - 1; }
    }
    if (fc != want_c || fr != want_r) { return 0 - 1; }
    var dw = 0;
    var dsr = 0;
    if (_kii_compute_fit_geometry(src_w, src_h, fc, fr, &dw, &dsr) != 0) { return 0 - 1; }
    var cap_c = fc;
    if (cap_c == 0) { cap_c = EMIT_DEFAULT_COLS; }
    var cap_r = fr;
    if (cap_r == 0) { cap_r = EMIT_DEFAULT_ROWS; }
    if (dw < 1 || dw > cap_c) { return 0 - 1; }
    if (dsr < 2 || dsr % 2 != 0 || dsr / 2 > cap_r) { return 0 - 1; }
    return 0;
}

# ---- M7(b) geometry fuzz surface -----------------------------------
# Random (src_w, src_h, max_cols, max_rows) inputs to the M6 geometry
# helpers. Drive both _kii_compute_target_geometry (--width N path)
# and _kii_compute_fit_geometry (terminal-fit path), plus the v1.6.4
# frame-size predicate main applies to their output. The fuzz inputs
# are bounded to [0, 65535] for each field — large enough to exercise
# overflow paths, small enough to fit in the i64 multiplications
# without wrapping.
#
# P(-1) (v1.6.4): through v1.6.3 this checked only that each helper
# returned 0 or -1, which are the only values either can return, so the
# surface could fail only by crashing. It now checks the contract:
#   - each helper succeeds exactly when the source has both dimensions;
#   - the --width path is exactly `width` columns (80 when 0) and
#     max(1, src_h * cols / (src_w * 2)) character rows, as an even
#     source-row count;
#   - the fit path stays inside its envelope (0 = the 80 x 24 default);
#   - kii_frame_cells_ok agrees with the plain product against KII_MAX_CELLS.
# It draws the same five random numbers per iteration as before, so the
# surfaces after it see the random stream they always did.
fn fuzz_geom_iter(): i64 {
    var src_w    = _fuzz_rand() % 65536;
    var src_h    = _fuzz_rand() % 65536;
    var max_cols = _fuzz_rand() % 65536;
    var max_rows = _fuzz_rand() % 65536;
    var width_n  = _fuzz_rand() % 65536;
    var has_src = 0;
    if (src_w > 0 && src_h > 0) { has_src = 1; }

    var out_w  = 0;
    var out_sr = 0;
    var rc1 = _kii_compute_target_geometry(src_w, src_h, width_n, &out_w, &out_sr);
    if (has_src == 0) { if (rc1 != 0 - 1) { return 0 - 1; } }
    else {
        if (rc1 != 0) { return 0 - 1; }
        var want_c = width_n;
        if (want_c == 0) { want_c = EMIT_DEFAULT_COLS; }
        var want_r = (src_h * want_c) / (src_w * 2);
        if (want_r < 1) { want_r = 1; }
        if (out_w != want_c) { return 0 - 1; }
        if (out_sr != want_r * 2) { return 0 - 1; }
        var cells_ok = 0;
        if (out_w * want_r <= KII_MAX_CELLS) { cells_ok = 1; }
        if (kii_frame_cells_ok(out_w, out_sr / 2) != cells_ok) { return 0 - 1; }
    }

    var rc2 = _kii_compute_fit_geometry(src_w, src_h, max_cols, max_rows, &out_w, &out_sr);
    if (has_src == 0) { if (rc2 != 0 - 1) { return 0 - 1; } }
    else {
        if (rc2 != 0) { return 0 - 1; }
        var cap_c = max_cols;
        if (cap_c == 0) { cap_c = EMIT_DEFAULT_COLS; }
        var cap_r = max_rows;
        if (cap_r == 0) { cap_r = EMIT_DEFAULT_ROWS; }
        if (out_w < 1 || out_w > cap_c) { return 0 - 1; }
        if (out_sr < 2 || out_sr % 2 != 0 || out_sr / 2 > cap_r) { return 0 - 1; }
    }
    return 0;
}

# ---- M7(b) emit-pipeline fuzz surface ------------------------------
# Drive downscale → quantize → emit_halfblock_row_buf on a valid
# decoded PNG (RAMGON.png from the repo root) with randomized target
# dimensions per iter. Decoding the source PNG is expensive
# (~700 ms per the bench harness) so we do it once at startup;
# per-iter cost is just the M5 pipeline (~1 ms each on tmpfs).
#
# Contract: downscale_to_rgb / quantize_downscaled / emit_halfblock_row_buf
# return 0 on success or -1 on rejection (e.g. dst dims = 0); never
# crash. The fuzz exercises:
#   - dst_w / dst_h boundary cases (0, 1, near-source-size, larger-than-source)
#   - the per-row emit_halfblock_row_buf walk with random row index
# v1.8.0: the colour tier rotates 8 → 16 → 256 → truecolour by call count
# (no extra random draw, so the surfaces after this one see the random
# stream they always did), and every row must now succeed: quantize only
# produces codes of the active tier, so emit refusing one is a contract
# violation. The caller's line buffer holds 200 truecolour cells (41 bytes
# each) plus the row tail.
# v1.9.0: the dither mode rotates none → ordered → fs every four calls, the
# same way, so twelve calls cover every tier × dither pair.
var _fz_emit_calls = 0;

fn fuzz_emit_iter(pstruct, line_buf): i64 {
    var tier = KII_TIER_8;
    var t4 = _fz_emit_calls % 4;
    if (t4 == 1) { tier = KII_TIER_16; }
    if (t4 == 2) { tier = KII_TIER_256; }
    if (t4 == 3) { tier = KII_TIER_TC; }
    quant_set_tier(tier);
    quant_set_dither((_fz_emit_calls / 4) % 3);
    _fz_emit_calls = _fz_emit_calls + 1;
    # Random target dims in [1, 200]. Cap at source-w / source-h
    # constraint inside downscale_to_rgb if it has one — but
    # contract is "never crash", so we don't pre-validate.
    var dst_w = 1 + (_fuzz_rand() % 200);
    var dst_h = 1 + (_fuzz_rand() % 200);
    var dr = downscale_to_rgb(pstruct, dst_w, dst_h);
    if (dr != 0 && dr != (0 - 1)) { return 0 - 1; }
    if (dr != 0) { return 0; }                  # rejection; nothing else to do
    var qr = quantize_downscaled(pstruct);
    if (qr != 0 && qr != (0 - 1)) { return 0 - 1; }
    if (qr != 0) { return 0; }
    # Pick a random row to emit. dst_h pairs of source rows produce
    # dst_h/2 terminal rows; safe to walk [0, dst_h/2).
    var term_rows = dst_h / 2;
    if (term_rows < 1) { return 0; }
    var row = _fuzz_rand() % term_rows;
    var qbuf = load64(pstruct + STRUCT_QUANTIZED_BUF_OFFSET);
    var dw   = load64(pstruct + STRUCT_DOWNSCALED_W_OFFSET);
    var epos = emit_halfblock_row_buf(qbuf, dw, row, line_buf, 0);
    quant_set_tier(KII_TIER_16);
    quant_set_dither(KII_DITHER_NONE);
    if (epos <= 0) { return 0 - 1; }
    if (epos > dw * (EMIT_CELL_MAX + 1) + 16) { return 0 - 1; }
    return 0;
}

# ---- v1.10.0 ASCII-lane fuzz surface ------------------------------
# The contrast pass reads the samples around each cell, so it is the lane's
# one bounds-sensitive step. Each iteration builds a random frame (2..64 x
# 3..60 sub-samples, random RGB, and a random transparency mask half the
# time) and renders every row with emit_ascii_shape_row_buf, twice: once with
# the luminance plane between pads of 0 and once between pads of 255. The
# guards keep every read inside the plane, so the two renders must be byte for
# byte the same; a read past the plane's top or bottom edge would see a
# different pad and change a glyph. Every row must also end in the reset and
# LF, and every glyph must be in the table. The tier rotates as on the emit
# surface. It runs after every older surface, so they see the random stream
# they always did.
var _fz_ascii_calls = 0;

# The plane for `rgb` / `mask` copied between two pads of `pad` bytes, each
# set to `val`. Returns a pointer to the plane itself.
fn _fz_padded_plane(rgb, mask, w, h, pad, val): i64 {
    var plane = _ascii_lum_plane(rgb, mask, w, h);
    if (plane == 0) { return 0; }
    var buf = alloc(w * h + 2 * pad);
    if (buf == 0) { return 0; }
    var i = 0;
    while (i < pad) { store8(buf + i, val); store8(buf + pad + w * h + i, val); i = i + 1; }
    memcpy(buf + pad, plane, w * h);
    return buf + pad;
}

# 1 if byte b is one of the table's glyphs.
fn _fz_is_glyph(b): i64 {
    var g = 0;
    while (g < ASCII_SHAPE_COUNT) {
        if (load64(&ASCII_SHAPE_GLYPHS + g * 8) == b) { return 1; }
        g = g + 1;
    }
    return 0;
}

# 1 if the row of `n` bytes ends in the reset + LF, and every byte outside an
# escape is a glyph.
fn _fz_ascii_row_ok(buf, n): i64 {
    if (n < 5) { return 0; }
    if (memeq(buf + n - 5, "\x1b[0m\n", 5) == 0) { return 0; }
    var i = 0;
    while (i < n - 5) {
        var b = load8(buf + i);
        if (b == 27) {
            while (i < n - 5 && load8(buf + i) != 109) { i = i + 1; }   # to the 'm'
        } else {
            if (_fz_is_glyph(b) == 0) { return 0; }
        }
        i = i + 1;
    }
    return 1;
}

fn fuzz_ascii_iter(rgb, mask, out_a, out_b): i64 {
    var tier = KII_TIER_8;
    var t4 = _fz_ascii_calls % 4;
    if (t4 == 1) { tier = KII_TIER_16; }
    if (t4 == 2) { tier = KII_TIER_256; }
    if (t4 == 3) { tier = KII_TIER_TC; }
    quant_set_tier(tier);
    _fz_ascii_calls = _fz_ascii_calls + 1;
    var cols = 1 + _fuzz_rand() % 32;
    var rows = 1 + _fuzz_rand() % 20;
    var w = cols * 2;
    var h = rows * 3;
    var i = 0;
    while (i < w * h * 3) { store8(rgb + i, _fuzz_rand() & 255); i = i + 1; }
    var m = 0;
    if (_fuzz_rand() % 2 == 1) {
        i = 0;
        while (i < w * h) { store8(mask + i, (_fuzz_rand() % 4) == 0); i = i + 1; }
        m = mask;
    }
    var pad = w * 4 + 8;
    var lum0 = _fz_padded_plane(rgb, m, w, h, pad, 0);
    var lum1 = _fz_padded_plane(rgb, m, w, h, pad, 255);
    if (lum0 == 0 || lum1 == 0) { return 0 - 1; }
    var bad = 0;
    var cy = 0;
    while (cy < rows) {
        var na = emit_ascii_shape_row_buf(rgb, m, lum0, 0, w, h, cy, cols, out_a, 0);
        var nb = emit_ascii_shape_row_buf(rgb, m, lum1, 0, w, h, cy, cols, out_b, 0);
        if (na <= 0 || na != nb) { bad = 1; }
        else {
            if (memeq(out_a, out_b, na) == 0) { bad = 1; }
            if (_fz_ascii_row_ok(out_a, na) == 0) { bad = 1; }
        }
        cy = cy + 1;
    }
    quant_set_tier(KII_TIER_16);
    alloc_reset();                     # the planes are per-iteration scratch
    crc32_table = 0;                   # as the decoder surfaces do after a reset
    if (bad != 0) { return 0 - 1; }
    return 0;
}

# ---- v1.11.0 area-sampling fuzz surface ----------------------------
# downscale_area_to_rgb reads up to KII_AREA_TAPS^2 source pixels per output
# sample from offset tables it builds, so a wrong bound reads outside the
# image. Each iteration builds a random RGBA8 image (1..48 a side; alpha all
# opaque, drawn from the threshold's neighbourhood, or any byte) and downscales
# it to a random 1..96 x 1..64, which covers upscales, mixed axes, exact spans
# and tapped ones. Two checks:
#   - pad differential: the image is copied between pads of 0 and of 255, and
#     both copies must give the same samples, mask and plane;
#   - reference: every sample must equal what the definition gives, worked out
#     here by testing each source pixel's centre against the span
#     (2iw <= (2s+1)n < 2(i+1)w) rather than through _area_bound.
# A delegated frame (no reduction on either axis) leaves no plane, so its plane
# is built with _ascii_lum_plane, as emit_ascii_shape would. It runs after
# every older surface.

# Destination position i of n on an axis of w source pixels: the source
# indices to read, into `out` (at most KII_AREA_TAPS i64s). Returns the count.
fn _fz_area_axis(i, n, w, out): i64 {
    return _fz_area_axis_k(i, n, w, KII_AREA_TAPS, out);
}

# The same with `k` taps (v2.3.0: the Braille lane samples at 16 x 8).
fn _fz_area_axis_k(i, n, w, k, out): i64 {
    var c = 0;
    var first = 0 - 1;
    var s = 0;
    while (s < w) {
        var p = (2 * s + 1) * n;
        if (p >= 2 * i * w && p < 2 * (i + 1) * w) {
            if (first < 0) { first = s; }
            c = c + 1;
        }
        s = s + 1;
    }
    var j = 0;
    if (c == 0) { store64(out, ((2 * i + 1) * w) / (2 * n)); return 1; }
    if (c <= k) {
        while (j < c) { store64(out + j * 8, first + j); j = j + 1; }
        return c;
    }
    while (j < k) { store64(out + j * 8, ((2 * (i * k + j) + 1) * w) / (2 * n * k)); j = j + 1; }
    return k;
}

# 0 if pstruct's samples, mask and plane are what the definition gives for the
# w x h image at `pix`, else -1.
fn _fz_area_ref(pstruct, pix, w, h, dw, dh): i64 {
    return _fz_area_ref_k(pstruct, pix, w, h, dw, dh, KII_AREA_TAPS, KII_AREA_TAPS);
}

# The same with kx taps across and ky down (v2.3.0), ky at most 16.
fn _fz_area_ref_k(pstruct, pix, w, h, dw, dh, kx, ky): i64 {
    var k = kx;
    var rgb = load64(pstruct + STRUCT_DOWNSCALED_BUF_OFFSET);
    var mask = load64(pstruct + STRUCT_ALPHA_MASK_OFFSET);
    var lum = load64(pstruct + STRUCT_LUMA_PLANE_OFFSET);
    if (lum == 0) { lum = _ascii_lum_plane(rgb, mask, dw, dh); }
    if (rgb == 0 || lum == 0) { return 0 - 1; }
    var xt = alloc(dw * (k + 1) * 8);
    if (xt == 0) { return 0 - 1; }
    var dx = 0;
    while (dx < dw) { store64(xt + dx * (k + 1) * 8, _fz_area_axis_k(dx, dw, w, kx, xt + dx * (k + 1) * 8 + 8)); dx = dx + 1; }
    var ys[128];                       # up to 16 i64s: 128 bytes at function scope
    var any_t = 0;
    var dy = 0;
    while (dy < dh) {
        var ny = _fz_area_axis_k(dy, dh, h, ky, &ys);
        dx = 0;
        while (dx < dw) {
            var xe = xt + dx * (k + 1) * 8;
            var nx = load64(xe);
            var sr = 0;
            var sg = 0;
            var sb = 0;
            var nop = 0;
            var yi = 0;
            while (yi < ny) {
                var xi = 0;
                while (xi < nx) {
                    var p = pix + (load64(&ys + yi * 8) * w + load64(xe + 8 + xi * 8)) * 4;
                    var a = load8(p + 3);
                    if (a >= KII_ALPHA_THRESHOLD) {
                        sr = sr + _over_black(load8(p), a);
                        sg = sg + _over_black(load8(p + 1), a);
                        sb = sb + _over_black(load8(p + 2), a);
                        nop = nop + 1;
                    }
                    xi = xi + 1;
                }
                yi = yi + 1;
            }
            var o = dy * dw + dx;
            var er = 0;
            var eg = 0;
            var eb = 0;
            var em = 1;
            var el = 0;
            if (nop > 0) {
                er = (sr + nop / 2) / nop;
                eg = (sg + nop / 2) / nop;
                eb = (sb + nop / 2) / nop;
                em = 0;
                el = (54 * sr + 183 * sg + 19 * sb) / (256 * nx * ny);
            }
            if (em == 1) { any_t = 1; }
            var gm = 0;
            if (mask != 0) { gm = load8(mask + o); }
            if (load8(rgb + o * 3) != er || load8(rgb + o * 3 + 1) != eg
                    || load8(rgb + o * 3 + 2) != eb) { return 0 - 1; }
            if (gm != em || load8(lum + o) != el) { return 0 - 1; }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
    # The mask is left out exactly when no sample is transparent.
    if ((mask == 0) != (any_t == 0)) { return 0 - 1; }
    return 0;
}

# The image at `src`, between two pads of `pad` bytes set to `val`, as a
# pstruct in `ps`. Returns 0.
fn _fz_area_image(ps, src, pix, n, pad, val, w, h): i64 {
    var i = 0;
    while (i < pad) { store8(src + i, val); store8(src + pad + n + i, val); i = i + 1; }
    memcpy(src + pad, pix, n);
    i = 0;
    while (i < 160) { store64(ps + i, 0); i = i + 8; }
    store64(ps + STRUCT_WIDTH_OFFSET, w);
    store64(ps + STRUCT_HEIGHT_OFFSET, h);
    store64(ps + STRUCT_BIT_DEPTH_OFFSET, 8);
    store64(ps + STRUCT_COLOR_TYPE_OFFSET, 6);
    store64(ps + STRUCT_PIXELS_BUF_OFFSET, src + pad);
    store64(ps + STRUCT_PIXELS_SIZE_OFFSET, n);
    return 0;
}

# 1 if the two pstructs' samples, masks and planes are the same.
fn _fz_area_same(a, b, dw, dh): i64 {
    var n = dw * dh;
    if (memeq(load64(a + STRUCT_DOWNSCALED_BUF_OFFSET), load64(b + STRUCT_DOWNSCALED_BUF_OFFSET), n * 3) == 0) { return 0; }
    var ma = load64(a + STRUCT_ALPHA_MASK_OFFSET);
    var mb = load64(b + STRUCT_ALPHA_MASK_OFFSET);
    if ((ma == 0) != (mb == 0)) { return 0; }
    if (ma != 0 && memeq(ma, mb, n) == 0) { return 0; }
    var la = load64(a + STRUCT_LUMA_PLANE_OFFSET);
    var lb = load64(b + STRUCT_LUMA_PLANE_OFFSET);
    if ((la == 0) != (lb == 0)) { return 0; }
    if (la != 0 && memeq(la, lb, n) == 0) { return 0; }
    return 1;
}

# `pix` holds the image (48 x 48 x 4 bytes at most); `src_a` / `src_b` hold a
# padded copy each (the image + 2 x AREA_FUZZ_PAD).
var AREA_FUZZ_PAD = 512;
fn fuzz_area_iter(pix, src_a, src_b): i64 {
    var w = 1 + _fuzz_rand() % 48;
    var h = 1 + _fuzz_rand() % 48;
    var dw = 1 + _fuzz_rand() % 96;
    var dh = 1 + _fuzz_rand() % 64;
    var amode = _fuzz_rand() % 3;
    var n = w * h * 4;
    var i = 0;
    while (i < n) {
        store8(pix + i, _fuzz_rand() & 255);
        if (i % 4 == 3) {
            if (amode == 0) { store8(pix + i, 255); }
            if (amode == 1) {
                var pick = _fuzz_rand() % 6;
                var av = 255;
                if (pick == 0) { av = 0; }
                if (pick == 1) { av = KII_ALPHA_THRESHOLD - 1; }
                if (pick == 2) { av = KII_ALPHA_THRESHOLD; }
                if (pick == 3) { av = 200; }
                store8(pix + i, av);
            }
        }
        i = i + 1;
    }
    var ps_a[160];
    var ps_b[160];
    _fz_area_image(&ps_a, src_a, pix, n, AREA_FUZZ_PAD, 0, w, h);
    _fz_area_image(&ps_b, src_b, pix, n, AREA_FUZZ_PAD, 255, w, h);
    var bad = 0;
    if (downscale_area_to_rgb(&ps_a, dw, dh) != 0) { bad = 1; }
    if (downscale_area_to_rgb(&ps_b, dw, dh) != 0) { bad = 1; }
    if (bad == 0) {
        if (_fz_area_same(&ps_a, &ps_b, dw, dh) == 0) { bad = 1; }
        if (_fz_area_ref(&ps_a, pix, w, h, dw, dh) != 0) { bad = 1; }
    }
    alloc_reset();                     # the samples, mask, plane and tables are scratch
    crc32_table = 0;                   # as the decoder surfaces do after a reset
    if (bad != 0) { return 0 - 1; }
    return 0;
}

# ---- v2.0.0 blocks-lane fuzz surfaces ------------------------------
# 1. The shape choice. _blk_choose_opaque scores the 19 splits from row,
#    column and quadrant sums; the reference here scores each split from its
#    own 64-bit mask over the samples, in the same tie order, and must agree
#    on the glyph and both colours. Cells are random noise, a random split
#    with noise, a random mask in two colours, or one colour.
# 2. Whole frames. A random RGBA8 image (1..32 a side, three alpha mixes) is
#    rendered at a random 1..24 x 1..12 cells, tier and dither, from two
#    copies between pads of 0 and of 255; the rows must be byte-identical, end
#    in the reset and LF, and hold exactly `cols` glyphs, each a space or a
#    Block Element (E2 96 80..9F), with ░ ▒ ▓ only when shades are on.
# Both run after every older surface.

# The reference choice for an opaque cell in _blk_smp: the split (or one
# colour) with the first largest between-region term, and its ink and other
# colours as rounded means. Returns the id; the colours go to _fz_bk_fg/_bg.
var _fz_bk_fg[3];
var _fz_bk_bg[3];
fn _fz_bk_ref(): i64 {
    var t0 = 0;
    var t1 = 0;
    var t2 = 0;
    var i = 0;
    while (i < 64) {
        t0 = t0 + load64(&_blk_smp + i * 24);
        t1 = t1 + load64(&_blk_smp + i * 24 + 8);
        t2 = t2 + load64(&_blk_smp + i * 24 + 16);
        i = i + 1;
    }
    var best = BLK_SPACE;
    var bnum = t0 * t0 + t1 * t1 + t2 * t2;
    var bden = 64;
    var b0 = t0;
    var b1 = t1;
    var b2 = t2;
    var bn = 64;
    var s = 0;
    while (s < BLK_SPLIT_COUNT) {
        var id = blk_split_id(s);
        var m = blk_glyph_mask(id);
        var a0 = 0;
        var a1 = 0;
        var a2 = 0;
        var n = 0;
        i = 0;
        while (i < 64) {
            if (((m >> i) & 1) == 1) {
                a0 = a0 + load64(&_blk_smp + i * 24);
                a1 = a1 + load64(&_blk_smp + i * 24 + 8);
                a2 = a2 + load64(&_blk_smp + i * 24 + 16);
                n = n + 1;
            }
            i = i + 1;
        }
        var u0 = t0 - a0;
        var u1 = t1 - a1;
        var u2 = t2 - a2;
        var num = (a0 * a0 + a1 * a1 + a2 * a2) * (64 - n) + (u0 * u0 + u1 * u1 + u2 * u2) * n;
        var den = n * (64 - n);
        if (num * bden > bnum * den) { best = id; bnum = num; bden = den; b0 = a0; b1 = a1; b2 = a2; bn = n; }
        s = s + 1;
    }
    store64(&_fz_bk_fg,      (2 * b0 + bn) / (2 * bn));
    store64(&_fz_bk_fg + 8,  (2 * b1 + bn) / (2 * bn));
    store64(&_fz_bk_fg + 16, (2 * b2 + bn) / (2 * bn));
    if (best == BLK_SPACE) {
        store64(&_fz_bk_bg, load64(&_fz_bk_fg));
        store64(&_fz_bk_bg + 8, load64(&_fz_bk_fg + 8));
        store64(&_fz_bk_bg + 16, load64(&_fz_bk_fg + 16));
    } else {
        var rn = 64 - bn;
        store64(&_fz_bk_bg,      (2 * (t0 - b0) + rn) / (2 * rn));
        store64(&_fz_bk_bg + 8,  (2 * (t1 - b1) + rn) / (2 * rn));
        store64(&_fz_bk_bg + 16, (2 * (t2 - b2) + rn) / (2 * rn));
    }
    return best;
}

fn fuzz_blocks_cell_iter(): i64 {
    var mode = _fuzz_rand() % 4;
    var c0 = _fuzz_rand() & 255;
    var c1 = _fuzz_rand() & 255;
    var c2 = _fuzz_rand() & 255;
    var d0 = _fuzz_rand() & 255;
    var d1 = _fuzz_rand() & 255;
    var d2 = _fuzz_rand() & 255;
    var m = 0;
    if (mode == 1) { m = blk_glyph_mask(blk_split_id(_fuzz_rand() % BLK_SPLIT_COUNT)); }
    if (mode == 2) { m = (_fuzz_rand() << 40) ^ (_fuzz_rand() << 20) ^ _fuzz_rand(); }
    var i = 0;
    while (i < 64) {
        if (mode == 0) { blk_set_sample(i, _fuzz_rand() & 255, _fuzz_rand() & 255, _fuzz_rand() & 255); }
        else {
            if (((m >> i) & 1) == 1) { blk_set_sample(i, d0, d1, d2); }
            else { blk_set_sample(i, c0, c1, c2); }
            if (mode == 1 && _fuzz_rand() % 6 == 0) {
                blk_set_sample(i, _fuzz_rand() & 255, _fuzz_rand() & 255, _fuzz_rand() & 255);
            }
        }
        i = i + 1;
    }
    blk_set_opaque(0 - 1);
    if (blk_choose() != BLK_KIND_OPAQUE) { return 0 - 1; }
    var got = _blk_res_id;
    if (got != _fz_bk_ref()) { return 0 - 1; }
    var c = 0;
    while (c < 3) {
        if (load64(&_blk_res_fg + c * 8) != load64(&_fz_bk_fg + c * 8)) { return 0 - 1; }
        if (load64(&_blk_res_bg + c * 8) != load64(&_fz_bk_bg + c * 8)) { return 0 - 1; }
        c = c + 1;
    }
    return 0;
}

# 1 if the `n` bytes at `buf` are one well-formed blocks row of `cols` cells:
# escapes, then a space or E2 96 80..9F per cell, then the reset and LF. Shades
# (0x91..0x93) are allowed only when `shades` is 1.
fn _fz_blocks_row_ok(buf, n, cols, shades): i64 {
    if (n < 5) { return 0; }
    if (memeq(buf + n - 5, "\x1b[0m\n", 5) == 0) { return 0; }
    var cells = 0;
    var i = 0;
    while (i < n - 5) {
        var b = load8(buf + i);
        if (b == 27) {
            while (i < n - 5 && load8(buf + i) != 109) { i = i + 1; }
            i = i + 1;
        } else {
            if (b == 32) { i = i + 1; }
            else {
                if (b != 0xE2 || i + 2 >= n - 5) { return 0; }
                if (load8(buf + i + 1) != 0x96) { return 0; }
                var b2 = load8(buf + i + 2);
                if (b2 < 0x80 || b2 > 0x9F) { return 0; }
                if (shades == 0 && b2 >= 0x91 && b2 <= 0x93) { return 0; }
                i = i + 3;
            }
            cells = cells + 1;
        }
    }
    return cells == cols;
}

var _fz_blk_calls = 0;
# `pix` holds the image (32 x 32 x 4 bytes at most); `src_a` / `src_b` a padded
# copy each; `out_a` / `out_b` one row each (24 cells x 42 + 16 bytes).
fn fuzz_blocks_frame_iter(pix, src_a, src_b, out_a, out_b): i64 {
    var tier = KII_TIER_8;
    var t4 = _fz_blk_calls % 4;
    if (t4 == 1) { tier = KII_TIER_16; }
    if (t4 == 2) { tier = KII_TIER_256; }
    if (t4 == 3) { tier = KII_TIER_TC; }
    quant_set_tier(tier);
    var dith = (_fz_blk_calls / 4) % 3;
    quant_set_dither(dith);
    _fz_blk_calls = _fz_blk_calls + 1;
    var w = 1 + _fuzz_rand() % 32;
    var h = 1 + _fuzz_rand() % 32;
    var cols = 1 + _fuzz_rand() % 24;
    var rows = 1 + _fuzz_rand() % 12;
    var amode = _fuzz_rand() % 3;
    var n = w * h * 4;
    var i = 0;
    while (i < n) {
        store8(pix + i, _fuzz_rand() & 255);
        if (i % 4 == 3) {
            if (amode == 0) { store8(pix + i, 255); }
            if (amode == 1) {
                var av = 255;
                if (_fuzz_rand() % 3 == 0) { av = 0; }
                store8(pix + i, av);
            }
        }
        i = i + 1;
    }
    var ps_a[160];
    var ps_b[160];
    _fz_area_image(&ps_a, src_a, pix, n, AREA_FUZZ_PAD, 0, w, h);
    _fz_area_image(&ps_b, src_b, pix, n, AREA_FUZZ_PAD, 255, w, h);
    var bad = 0;
    var st_a = blk_prepare(&ps_a, cols, rows);
    var st_b = blk_prepare(&ps_b, cols, rows);
    if (st_a == 0 || st_b == 0) { bad = 1; }
    var cy = 0;
    while (bad == 0 && cy < rows) {
        var na = emit_blocks_row_buf(st_a, cols, cy, out_a, 0);
        var nb = emit_blocks_row_buf(st_b, cols, cy, out_b, 0);
        if (na <= 0 || na != nb) { bad = 1; }
        else {
            if (memeq(out_a, out_b, na) == 0) { bad = 1; }
            if (_fz_blocks_row_ok(out_a, na, cols, blk_shades_on()) == 0) { bad = 1; }
        }
        cy = cy + 1;
    }
    quant_set_tier(KII_TIER_16);
    quant_set_dither(KII_DITHER_NONE);
    alloc_reset();
    crc32_table = 0;
    if (bad != 0) { return 0 - 1; }
    return 0;
}

# ---- v2.1.0 half-block row surface ------------------------------------------
# Since v2.1.0 a half-block cell may be ▀, ▄, a space or █, chosen by the colour
# state the row is in. Each iteration fills a random two-row strip (1..48 cells)
# from a few colours of the tier, transparent pixels on half the iterations, and
# at truecolour codes 8..15 a third of the time (RGB there, not brights), emits it
# with emit_halfblock_row_buf, and reads the bytes back as a terminal would:
#   - every escape is one kii writes at that tier, and changes the colour it sets;
#   - every cell shows the input's top colour on top and bottom colour below,
#     with a transparent half only ever in the bg (the default bg, SGR 49);
#   - the glyph is the one the rule picks from the state before the cell (see
#     emit_halfblock_row_buf), and it has no escape it does not use;
#   - the row is `w` cells, then the reset and LF.
# The tier rotates by call count. It runs after every older surface.
var _fz_hb_calls = 0;
var _fz_hb_par[8];

# _fuzz_rand returns the whole LCG state, whose low bits repeat (bit 0 every 2
# draws, bits 0–1 every 4), so `_fuzz_rand() % 4` taken every other draw is the
# same every time. This surface draws from bits 16 and up (period 2^17 or more).
fn _fz_hb_rand(n): i64 { return (_fuzz_rand() >> 16) % n; }
var _fz_hb_npar = 0;

# Parse the escape at `buf + i` (ESC [ digits/semicolons m) into _fz_hb_par.
# Returns the index after the 'm', or -1.
fn _fz_hb_esc(buf, i, n): i64 {
    if (i + 2 >= n || load8(buf + i) != 27 || load8(buf + i + 1) != 91) { return 0 - 1; }
    i = i + 2;
    _fz_hb_npar = 0;
    var v = 0;
    var digits = 0;
    while (i < n) {
        var c = load8(buf + i);
        if (c >= 48 && c <= 57) { v = v * 10 + c - 48; digits = digits + 1; if (digits > 3) { return 0 - 1; } }
        else {
            if (digits == 0 || _fz_hb_npar >= 5) { return 0 - 1; }
            store64(&_fz_hb_par + _fz_hb_npar * 8, v);
            _fz_hb_npar = _fz_hb_npar + 1;
            v = 0;
            digits = 0;
            if (c == 109) { return i + 1; }
            if (c != 59) { return 0 - 1; }
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn _fz_hb_p(k): i64 { return load64(&_fz_hb_par + k * 8); }

# The colour an escape sets, as a kii colour code, with `*kind` = 1 for fg and 2
# for bg; -1 if the escape is not one kii writes at `tier`.
fn _fz_hb_code(tier, kind_out): i64 {
    var p0 = _fz_hb_p(0);
    if (_fz_hb_npar == 1) {
        if (p0 == 39 || p0 == 49) { store64(kind_out, 1 + (p0 == 49)); return KII_COLOR_DEFAULT; }
        if (tier == KII_TIER_8 || tier == KII_TIER_16) {
            if (p0 >= 30 && p0 <= 37) { store64(kind_out, 1); return p0 - 30; }
            if (p0 >= 40 && p0 <= 47) { store64(kind_out, 2); return p0 - 40; }
        }
        if (tier == KII_TIER_16) {
            if (p0 >= 90 && p0 <= 97)   { store64(kind_out, 1); return p0 - 82; }
            if (p0 >= 100 && p0 <= 107) { store64(kind_out, 2); return p0 - 92; }
        }
        return 0 - 1;
    }
    if (p0 != 38 && p0 != 48) { return 0 - 1; }
    store64(kind_out, 1 + (p0 == 48));
    if (tier == KII_TIER_256 && _fz_hb_npar == 3 && _fz_hb_p(1) == 5 && _fz_hb_p(2) <= 255) { return _fz_hb_p(2); }
    if (tier == KII_TIER_TC && _fz_hb_npar == 5 && _fz_hb_p(1) == 2) {
        if (_fz_hb_p(2) > 255 || _fz_hb_p(3) > 255 || _fz_hb_p(4) > 255) { return 0 - 1; }
        return (_fz_hb_p(2) << 16) | (_fz_hb_p(3) << 8) | _fz_hb_p(4);
    }
    return 0 - 1;
}

fn _fz_hb_bright(tier, c): i64 {
    if (tier == KII_TIER_16 && c >= 8 && c < 16) { return 1; }
    return 0;
}

# The glyph the rule draws (top t, bottom b) with fg `fg` and bg `bg` already
# set: 0x80 ▀, 0x84 ▄, 0x88 █, or 32 for a space.
fn _fz_hb_expect(tier, t, b, fg, bg): i64 {
    var D = KII_COLOR_DEFAULT;
    if (t == D) {
        if (b == D) { return 32; }
        return 0x84;
    }
    if (b == D) { return 0x80; }
    if (t == b) {
        if (_fz_hb_bright(tier, t) == 1) { return 0x88; }
        if (fg == t && bg != t) { return 0x88; }
        return 32;
    }
    var tb = _fz_hb_bright(tier, t);
    var bb = _fz_hb_bright(tier, b);
    if (tb != bb) {
        if (bb == 1) { return 0x84; }
        return 0x80;
    }
    var up = (t != fg) + (b != bg);
    var dn = (b != fg) + (t != bg);
    if (dn < up) { return 0x84; }
    return 0x80;
}

# 0 if the `n` bytes at `out` are a correct half-block row for the w x 2 strip
# at `q` (top row, then bottom row, 4 bytes a code).
fn _fz_hb_check(q, w, out, n, tier): i64 {
    if (n < 5 || memeq(out + n - 5, "\x1b[0m\n", 5) == 0) { return 1; }
    var end = n - 5;
    var fg = 0 - 1;
    var bg = 0 - 1;
    var i = 0;
    var col = 0;
    var kind = 0;
    while (col < w) {
        var t = load32(q + col * 4);
        var b = load32(q + (w + col) * 4);
        var want = _fz_hb_expect(tier, t, b, fg, bg);
        var nfg = 0;
        var nbg = 0;
        while (i < end && load8(out + i) == 27) {
            i = _fz_hb_esc(out, i, end);
            if (i < 0) { return 2; }
            var c = _fz_hb_code(tier, &kind);
            if (c < 0) { return 3; }
            if (kind == 1) {
                if (c == fg || nfg > 0 || nbg > 0) { return 4; }    # a repeat, a second fg, or fg after bg
                fg = c;
                nfg = nfg + 1;
            } else {
                if (c == bg || nbg > 0) { return 4; }
                bg = c;
                nbg = nbg + 1;
            }
        }
        if (i >= end) { return 5; }
        var g = 32;
        if (load8(out + i) == 32) { i = i + 1; }
        else {
            if (i + 3 > end || load8(out + i) != 0xE2 || load8(out + i + 1) != 0x96) { return 6; }
            g = load8(out + i + 2);
            i = i + 3;
        }
        if (g != want) { return 7; }
        # What the cell shows, top then bottom; an fg-drawn half is never the default.
        var st = bg;
        var sb = bg;
        if (g == 0x80) { st = fg; sb = bg; }
        if (g == 0x84) { st = bg; sb = fg; }
        if (g == 0x88) { st = fg; sb = fg; }
        if (g == 32 && nfg > 0) { return 8; }                    # a space never needs the fg
        if (g == 0x88 && nbg > 0) { return 8; }                  # nor █ the bg
        if (g != 32 && fg == KII_COLOR_DEFAULT) { return 9; }
        if (st != t || sb != b) { return 10; }
        col = col + 1;
    }
    if (i != end) { return 11; }
    return 0;
}

# `q` holds 2 x 48 codes (384 bytes); `out` one row (48 x 42 + 16 bytes).
fn fuzz_halfblock_iter(q, out): i64 {
    var tier = KII_TIER_8;
    var t4 = _fz_hb_calls % 4;
    if (t4 == 1) { tier = KII_TIER_16; }
    if (t4 == 2) { tier = KII_TIER_256; }
    if (t4 == 3) { tier = KII_TIER_TC; }
    quant_set_tier(tier);
    _fz_hb_calls = _fz_hb_calls + 1;
    var w = 1 + _fz_hb_rand(48);
    var k = 1 + _fz_hb_rand(4);
    var clear = _fz_hb_rand(2);
    var pal[32];
    var j = 0;
    while (j < k) {
        var c = _fz_hb_rand(8);
        if (tier == KII_TIER_16) { c = _fz_hb_rand(16); }
        if (tier == KII_TIER_256) { c = 16 + _fz_hb_rand(240); }
        if (tier == KII_TIER_TC) {
            c = (_fuzz_rand() >> 8) & 16777215;
            if (_fz_hb_rand(3) == 0) { c = _fz_hb_rand(16); }
        }
        store64(&pal + j * 8, c);
        j = j + 1;
    }
    j = 0;
    while (j < 2 * w) {
        var code = load64(&pal + _fz_hb_rand(k) * 8);
        if (clear == 1 && _fz_hb_rand(4) == 0) { code = KII_COLOR_DEFAULT; }
        store32(q + j * 4, code);
        j = j + 1;
    }
    var n = emit_halfblock_row_buf(q, w, 0, out, 0);
    var bad = 0;
    if (n <= 0 || n > w * (EMIT_CELL_MAX + 1) + 16) { bad = 1; }
    else {
        if (_fz_hb_check(q, w, out, n, tier) != 0) { bad = 1; }
    }
    quant_set_tier(KII_TIER_16);
    if (bad != 0) { return 0 - 1; }
    return 0;
}

# ---- v2.2.0 --invert / --color none fuzz surface --------------------
# Each iteration builds a random RGBA8 image X (1..48 a side; alpha all
# opaque, drawn from the threshold's neighbourhood, or any byte) and its
# negative N (each channel 255 - c, alpha kept), and samples both for a random
# 1..24 x 1..8 cells (2 x 3 sub-samples a cell, so upscales, delegated frames
# and tapped spans all occur). The checks:
#   - X's plane with --invert on is N's plane with it off, byte for byte, and
#     the masks agree, through both builders (the area loop, and
#     _ascii_lum_plane for a delegated frame);
#   - an opaque X keeps its samples under --invert;
#   - at --color none, X's inverted rows are N's plain rows exactly, and each
#     is `cols` printable glyphs and a LF, with no ESC;
#   - at a random tier and dither, each coloured row with its escapes removed
#     is the colourless row (under fs the codes come from _ascii_cell_codes).
# Draws use bits 16 and up of _fuzz_rand, as the half-block surface's do. It
# runs after every older surface.

# The image at `pix` as a pstruct in `ps`. Returns 0.
fn _fz_inv_ps(ps, pix, w, h): i64 {
    var i = 0;
    while (i < 160) { store64(ps + i, 0); i = i + 8; }
    store64(ps + STRUCT_WIDTH_OFFSET, w);
    store64(ps + STRUCT_HEIGHT_OFFSET, h);
    store64(ps + STRUCT_BIT_DEPTH_OFFSET, 8);
    store64(ps + STRUCT_COLOR_TYPE_OFFSET, 6);
    store64(ps + STRUCT_PIXELS_BUF_OFFSET, pix);
    store64(ps + STRUCT_PIXELS_SIZE_OFFSET, w * h * 4);
    return 0;
}

# Sample `ps` for cols x rows cells with --invert set to `inv`, and leave its
# plane in the pstruct as emit_ascii_shape would. Returns 0, or -1.
fn _fz_inv_sample(ps, cols, rows, inv): i64 {
    downscale_set_invert(inv);
    if (downscale_area_to_rgb(ps, cols * 2, rows * 3) != 0) { return 0 - 1; }
    if (load64(ps + STRUCT_LUMA_PLANE_OFFSET) == 0) {
        var lum = _ascii_lum_plane(load64(ps + STRUCT_DOWNSCALED_BUF_OFFSET),
            load64(ps + STRUCT_ALPHA_MASK_OFFSET), cols * 2, rows * 3);
        if (lum == 0) { return 0 - 1; }
        store64(ps + STRUCT_LUMA_PLANE_OFFSET, lum);
    }
    return 0;
}

# Row cy of the frame sampled into `ps`, into `out`, with cell codes `codes`
# (or 0). Returns its length, or -1.
fn _fz_inv_row(ps, codes, cols, rows, cy, out): i64 {
    return emit_ascii_shape_row_buf(load64(ps + STRUCT_DOWNSCALED_BUF_OFFSET),
        load64(ps + STRUCT_ALPHA_MASK_OFFSET), load64(ps + STRUCT_LUMA_PLANE_OFFSET),
        codes, cols * 2, rows * 3, cy, cols, out, 0);
}

# The n bytes at `buf` with every ESC [ ... m removed, written back in place.
# Returns the new length, or -1 if an escape is not closed.
fn _fz_inv_strip(buf, n): i64 {
    var i = 0;
    var o = 0;
    while (i < n) {
        if (load8(buf + i) == 27) {
            while (i < n && load8(buf + i) != 109) { i = i + 1; }
            if (i >= n) { return 0 - 1; }
            i = i + 1;
        } else {
            store8(buf + o, load8(buf + i));
            o = o + 1;
            i = i + 1;
        }
    }
    return o;
}

fn fuzz_invert_iter(pix, neg, out_a, out_b): i64 {
    var w = 1 + _fz_hb_rand(48);
    var h = 1 + _fz_hb_rand(48);
    var cols = 1 + _fz_hb_rand(24);
    var rows = 1 + _fz_hb_rand(8);
    var amode = _fz_hb_rand(3);
    var n = w * h * 4;
    var i = 0;
    while (i < n) {
        var v = _fz_hb_rand(256);
        if (i % 4 == 3) {
            if (amode == 0) { v = 255; }
            if (amode == 1) {
                var pick = _fz_hb_rand(6);
                v = 255;
                if (pick == 0) { v = 0; }
                if (pick == 1) { v = KII_ALPHA_THRESHOLD - 1; }
                if (pick == 2) { v = KII_ALPHA_THRESHOLD; }
                if (pick == 3) { v = 200; }
            }
            store8(pix + i, v);
            store8(neg + i, v);
        } else {
            store8(pix + i, v);
            store8(neg + i, 255 - v);
        }
        i = i + 1;
    }
    var ps_x[160];
    var ps_n[160];
    var ps_o[160];
    _fz_inv_ps(&ps_x, pix, w, h);
    _fz_inv_ps(&ps_n, neg, w, h);
    _fz_inv_ps(&ps_o, pix, w, h);
    var bad = 0;
    if (_fz_inv_sample(&ps_x, cols, rows, 1) != 0) { bad = 1; }
    if (_fz_inv_sample(&ps_n, cols, rows, 0) != 0) { bad = 1; }
    if (_fz_inv_sample(&ps_o, cols, rows, 0) != 0) { bad = 1; }
    var ns = cols * 2 * rows * 3;
    if (bad == 0) {
        if (memeq(load64(&ps_x + STRUCT_LUMA_PLANE_OFFSET), load64(&ps_n + STRUCT_LUMA_PLANE_OFFSET), ns) == 0) { bad = 1; }
        var mx = load64(&ps_x + STRUCT_ALPHA_MASK_OFFSET);
        var mn = load64(&ps_n + STRUCT_ALPHA_MASK_OFFSET);
        if ((mx == 0) != (mn == 0)) { bad = 1; }
        if (mx != 0 && mn != 0 && memeq(mx, mn, ns) == 0) { bad = 1; }
        if (amode == 0 && memeq(load64(&ps_x + STRUCT_DOWNSCALED_BUF_OFFSET),
                load64(&ps_o + STRUCT_DOWNSCALED_BUF_OFFSET), ns * 3) == 0) { bad = 1; }
    }
    var tier = KII_TIER_8;
    var tp = _fz_hb_rand(4);
    if (tp == 1) { tier = KII_TIER_16; }
    if (tp == 2) { tier = KII_TIER_256; }
    if (tp == 3) { tier = KII_TIER_TC; }
    var dither = _fz_hb_rand(3);       # KII_DITHER_NONE, _ORDERED, _FS
    var codes = 0;
    if (bad == 0 && dither == KII_DITHER_FS && tier != KII_TIER_TC) {
        quant_set_tier(tier);
        quant_set_dither(dither);
        codes = _ascii_cell_codes(load64(&ps_x + STRUCT_DOWNSCALED_BUF_OFFSET),
            load64(&ps_x + STRUCT_ALPHA_MASK_OFFSET), cols * 2, cols, rows);
        if (codes == 0) { bad = 1; }
    }
    var cy = 0;
    while (bad == 0 && cy < rows) {
        quant_set_tier(KII_TIER_NONE);
        var la = _fz_inv_row(&ps_x, 0, cols, rows, cy, out_a);
        var lb = _fz_inv_row(&ps_n, 0, cols, rows, cy, out_b);
        if (la != cols + 1 || lb != la || memeq(out_a, out_b, la) == 0) { bad = 1; }
        if (bad == 0 && load8(out_a + cols) != 10) { bad = 1; }
        var k = 0;
        while (bad == 0 && k < cols) {
            if (_fz_is_glyph(load8(out_a + k)) == 0) { bad = 1; }
            k = k + 1;
        }
        quant_set_tier(tier);
        quant_set_dither(dither);
        var lc = 0;
        if (bad == 0) { lc = _fz_inv_row(&ps_x, codes, cols, rows, cy, out_b); }
        if (bad == 0 && lc < 0) { bad = 1; }
        if (bad == 0) { lc = _fz_inv_strip(out_b, lc); }
        if (bad == 0 && (lc != la || memeq(out_a, out_b, la) == 0)) { bad = 1; }
        quant_set_dither(KII_DITHER_NONE);
        cy = cy + 1;
    }
    quant_set_tier(KII_TIER_16);
    quant_set_dither(KII_DITHER_NONE);
    downscale_set_invert(0);
    alloc_reset();                     # the samples, masks, planes and codes are scratch
    crc32_table = 0;                   # as the decoder surfaces do after a reset
    if (bad != 0) { return 0 - 1; }
    return 0;
}

# ---- v2.3.0 Braille-lane fuzz surface ------------------------------
# Each iteration builds a random RGBA8 image X (1..48 a side, the three alpha
# mixes) and its negative N, picks 1..24 x 1..8 cells, a tier (8, 16, 256, tc
# or none) and a dither, and samples the dot grid (2 x 4 dots a cell, 16 x 8
# taps a dot) three times: X with --invert, N without, and X without. The
# checks:
#   - X's plain samples, mask and plane are the area sampler's definition at
#     16 x 8 taps (_fz_area_ref_k);
#   - X's inked dots under --invert are N's plain ones, under every rule;
#   - X's plain inked dots are the rule's, worked out here: Otsu's level by
#     direct division (the dot counts are small enough), the Bayer threshold,
#     and Floyd-Steinberg over a whole error plane rather than two rows;
#   - no dot without an opaque tap is inked;
#   - every row is `cols` cells, each a space or a Braille Pattern, then the
#     reset and LF (LF alone at none); X's inverted rows at none are N's; and
#     each coloured row with its escapes removed is the row at none.
# Draws use bits 16 and up of _fuzz_rand. It runs after every older surface.

# Otsu's level for the dots of plane `lum` with mask `mask` (or 0), n dots,
# computed directly: n is at most 1,536, so (S w0 - N s0)^2 fits.
fn _fz_brl_otsu(lum, mask, n): i64 {
    var hist[2048];                    # 256 i64 bins: function-scope arrays are in bytes
    var k = 0;
    while (k < 256) { store64(&hist + k * 8, 0); k = k + 1; }
    var cnt = 0;
    var sum = 0;
    var i = 0;
    while (i < n) {
        if (mask == 0 || load8(mask + i) == 0) {
            var v = load8(lum + i);
            store64(&hist + v * 8, load64(&hist + v * 8) + 1);
            cnt = cnt + 1;
            sum = sum + v;
        }
        i = i + 1;
    }
    if (cnt == 0) { return 256; }
    var best = 0 - 1;
    var bt = 1;
    var w0 = 0;
    var s0 = 0;
    var t = 1;
    while (t < 256) {
        w0 = w0 + load64(&hist + (t - 1) * 8);
        s0 = s0 + (t - 1) * load64(&hist + (t - 1) * 8);
        if (w0 > 0 && w0 < cnt) {
            var d = sum * w0 - cnt * s0;
            var f = (d * d) / (w0 * (cnt - w0));
            if (f > best) { best = f; bt = t; }
        }
        t = t + 1;
    }
    return bt;
}

# The reference ink of dot (x, y): 1 or 0, by the active rule; `fsp` is the
# Floyd-Steinberg plane _fz_brl_fs filled (or 0 for the other rules).
fn _fz_brl_ink(lum, mask, dw, x, y, level, fsp): i64 {
    var i = y * dw + x;
    if (mask != 0 && load8(mask + i) != 0) { return 0; }
    var mode = quant_dither();
    if (mode == KII_DITHER_FS) { return load8(fsp + i); }
    var t = level;
    if (mode == KII_DITHER_ORDERED) {
        var m = (_QUANT_BAYER4 >> (4 * ((y & 3) * 4 + (x & 3)))) & 15;
        t = 16 * m + 8;
    }
    if (load8(lum + i) >= t) { return 1; }
    return 0;
}

# Floyd-Steinberg over the whole dw x dh plane at once: `err` holds every
# dot's carried error (x16). Writes 1 / 0 per dot into `on`. Returns 0.
fn _fz_brl_fs(lum, mask, dw, dh, on, err): i64 {
    var i = 0;
    while (i < dw * dh) { store64(err + i * 8, 0); store8(on + i, 0); i = i + 1; }
    var y = 0;
    while (y < dh) {
        var x = 0;
        while (x < dw) {
            i = y * dw + x;
            if (mask == 0 || load8(mask + i) == 0) {
                var v = load8(lum + i) + load64(err + i * 8) / 16;
                if (v < 0) { v = 0; }
                if (v > 255) { v = 255; }
                var e = v;
                if (v >= 128) { store8(on + i, 1); e = v - 255; }
                if (x + 1 < dw) { store64(err + (i + 1) * 8, load64(err + (i + 1) * 8) + 7 * e); }
                if (y + 1 < dh) {
                    if (x > 0) { store64(err + (i + dw - 1) * 8, load64(err + (i + dw - 1) * 8) + 3 * e); }
                    store64(err + (i + dw) * 8, load64(err + (i + dw) * 8) + 5 * e);
                    if (x + 1 < dw) { store64(err + (i + dw + 1) * 8, load64(err + (i + dw + 1) * 8) + e); }
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}

# 1 if the row of n bytes is `cols` cells, each a space or E2 A0..A3 80..BF,
# with escapes only when `colour`, ending in the reset and LF (LF alone if not).
fn _fz_brl_row_ok(buf, n, cols, colour): i64 {
    var tail = 5;
    if (colour == 0) { tail = 1; }
    if (n < tail) { return 0; }
    if (load8(buf + n - 1) != 10) { return 0; }
    if (colour == 1 && memeq(buf + n - 5, "\x1b[0m", 4) == 0) { return 0; }
    var i = 0;
    var cells = 0;
    while (i < n - tail) {
        var b = load8(buf + i);
        if (b == 27) {
            if (colour == 0) { return 0; }
            while (i < n - tail && load8(buf + i) != 109) { i = i + 1; }
            i = i + 1;
        } else {
            if (b == 32) { i = i + 1; }
            else {
                if (b != 0xE2) { return 0; }
                var b1 = load8(buf + i + 1);
                var b2 = load8(buf + i + 2);
                if (b1 < 0xA0 || b1 > 0xA3 || b2 < 0x80 || b2 > 0xBF) { return 0; }
                i = i + 3;
            }
            cells = cells + 1;
        }
    }
    if (cells != cols) { return 0; }
    return 1;
}

fn _fz_brl_sample(ps, cols, rows, inv): i64 {
    downscale_set_invert(inv);
    if (downscale_area_taps(ps, cols * 2, rows * 4, BRL_TAPS_X, BRL_TAPS_Y) != 0) { return 0 - 1; }
    return 0;
}

fn fuzz_braille_iter(pix, neg, out_a, out_b): i64 {
    var w = 1 + _fz_hb_rand(48);
    var h = 1 + _fz_hb_rand(48);
    var cols = 1 + _fz_hb_rand(24);
    var rows = 1 + _fz_hb_rand(8);
    var amode = _fz_hb_rand(3);
    var tp = _fz_hb_rand(5);
    var dither = _fz_hb_rand(3);
    var n = w * h * 4;
    var i = 0;
    while (i < n) {
        var v = _fz_hb_rand(256);
        if (i % 4 == 3) {
            if (amode == 0) { v = 255; }
            if (amode == 1) {
                var pick = _fz_hb_rand(6);
                v = 255;
                if (pick == 0) { v = 0; }
                if (pick == 1) { v = KII_ALPHA_THRESHOLD - 1; }
                if (pick == 2) { v = KII_ALPHA_THRESHOLD; }
                if (pick == 3) { v = 200; }
            }
            store8(pix + i, v);
            store8(neg + i, v);
        } else {
            store8(pix + i, v);
            store8(neg + i, 255 - v);
        }
        i = i + 1;
    }
    var tier = KII_TIER_8;
    if (tp == 1) { tier = KII_TIER_16; }
    if (tp == 2) { tier = KII_TIER_256; }
    if (tp == 3) { tier = KII_TIER_TC; }
    if (tp == 4) { tier = KII_TIER_NONE; }
    quant_set_dither(dither);
    var ps_x[160];
    var ps_n[160];
    var ps_o[160];
    _fz_inv_ps(&ps_x, pix, w, h);
    _fz_inv_ps(&ps_n, neg, w, h);
    _fz_inv_ps(&ps_o, pix, w, h);
    var dw = cols * 2;
    var dh = rows * 4;
    var bad = 0;
    var st_x = 0;
    var st_n = 0;
    var st_o = 0;
    quant_set_tier(KII_TIER_NONE);
    if (_fz_brl_sample(&ps_x, cols, rows, 1) != 0) { bad = 1; }
    if (bad == 0) { st_x = brl_prepare(&ps_x); }
    if (_fz_brl_sample(&ps_n, cols, rows, 0) != 0) { bad = 1; }
    if (bad == 0) { st_n = brl_prepare(&ps_n); }
    if (_fz_brl_sample(&ps_o, cols, rows, 0) != 0) { bad = 1; }
    if (bad == 0) { st_o = brl_prepare(&ps_o); }
    if (st_x == 0 || st_n == 0 || st_o == 0) { bad = 1; }
    var cells = cols * rows;
    if (bad == 0 && _fz_area_ref_k(&ps_o, pix, w, h, dw, dh, BRL_TAPS_X, BRL_TAPS_Y) != 0) { bad = 1; }
    if (bad == 0 && memeq(load64(st_x + BRL_ST_BITS), load64(st_n + BRL_ST_BITS), cells) == 0) { bad = 1; }
    if (bad == 0) {
        var lum = load64(&ps_o + STRUCT_LUMA_PLANE_OFFSET);
        var mask = load64(&ps_o + STRUCT_ALPHA_MASK_OFFSET);
        var level = _fz_brl_otsu(lum, mask, dw * dh);
        var fsp = 0;
        if (dither == KII_DITHER_FS) {
            fsp = alloc(dw * dh);
            var err = alloc(dw * dh * 8);
            if (fsp == 0 || err == 0) { bad = 1; }
            else { _fz_brl_fs(lum, mask, dw, dh, fsp, err); }
        }
        var bits = load64(st_o + BRL_ST_BITS);
        var y = 0;
        while (bad == 0 && y < dh) {
            var x = 0;
            while (x < dw) {
                var got = 0;
                if ((load8(bits + (y / 4) * cols + x / 2) & brl_dot_bit(x & 1, y & 3)) != 0) { got = 1; }
                if (got != _fz_brl_ink(lum, mask, dw, x, y, level, fsp)) { bad = 1; }
                x = x + 1;
            }
            y = y + 1;
        }
    }
    var cy = 0;
    var st_c = 0;
    if (bad == 0) {
        quant_set_tier(tier);
        st_c = brl_prepare(&ps_x);
        if (st_c == 0) { bad = 1; }
    }
    var colour = 1;
    if (tier == KII_TIER_NONE) { colour = 0; }
    while (bad == 0 && cy < rows) {
        quant_set_tier(KII_TIER_NONE);
        var la = emit_braille_row_buf(st_x, cols, cy, out_a, 0);
        var lb = emit_braille_row_buf(st_n, cols, cy, out_b, 0);
        if (la < 0 || la != lb || memeq(out_a, out_b, la) == 0) { bad = 1; }
        if (bad == 0 && _fz_brl_row_ok(out_a, la, cols, 0) == 0) { bad = 1; }
        quant_set_tier(tier);
        var lc = 0;
        if (bad == 0) { lc = emit_braille_row_buf(st_c, cols, cy, out_b, 0); }
        if (bad == 0 && (lc < 0 || _fz_brl_row_ok(out_b, lc, cols, colour) == 0)) { bad = 1; }
        if (bad == 0) { lc = _fz_inv_strip(out_b, lc); }
        if (bad == 0 && (lc != la || memeq(out_a, out_b, la) == 0)) { bad = 1; }
        cy = cy + 1;
    }
    quant_set_tier(KII_TIER_16);
    quant_set_dither(KII_DITHER_NONE);
    downscale_set_invert(0);
    alloc_reset();                     # the samples, planes, bits and codes are scratch
    crc32_table = 0;                   # as the decoder surfaces do after a reset
    if (bad != 0) { return 0 - 1; }
    return 0;
}

# One PNG-fuzz iteration. Builds a random byte buffer (optionally
# prefixed with a valid sig + IHDR), writes it to /tmp, drives
# kii_decode_image. Whatever the function returns is fine —
# the contract is "never crash". `scratch_buf` is caller-owned;
# `scratch_cap` is the buffer's capacity so we don't overflow.
fn fuzz_png_iter(scratch_buf, scratch_cap): i64 {
    # 50% of iters get the valid prefix; the rest are pure random.
    var off = 0;
    if (_fuzz_rand_range(2) == 0) {
        memcpy(scratch_buf, &_png_fuzz_prefix, 33);
        off = 33;
    }

    # Random payload length in [0, PNG_FUZZ_MAX_LEN].
    var payload = _fuzz_rand_range(PNG_FUZZ_MAX_LEN + 1);
    var max_fill = scratch_cap - off;
    if (payload > max_fill) { payload = max_fill; }
    var i = 0;
    while (i < payload) {
        store8(scratch_buf + off + i, _fuzz_rand() & 0xFF);
        i = i + 1;
    }
    var total = off + payload;

    # file_write_all uses O_TRUNC, so the file is fresh every iter.
    file_write_all("/tmp/kii-fuzz-png.bin", scratch_buf, total);

    # Drive the decode adapter. Result discarded — we only care about
    # not-crashing; any IMG_ERR_* return is fine. The adapter writes
    # PIXELS_BUF@72 and SRC_COLOR_TYPE@144, so pstruct must be ≥160 B.
    var pstruct[160];
    kii_decode_image("/tmp/kii-fuzz-png.bin", &pstruct);
    # Rewind the bump allocator: kii_decode_image slurps the file (and chitra
    # allocates per-decode), none of which crosses iterations. Without this
    # the never-free allocator grows ~1 KB/iter → ~1 GB over 10⁶ iters. Safe
    # here: the emit loop (the only cross-iter pstruct) has already finished
    # before the decode loops run, and the per-iter scratch is stack-local.
    # P-1 (v1.5.1): alloc_reset() alone SILENTLY VOIDED this surface.
    # sankoch caches its CRC-32 table as a lazy-init singleton holding a HEAP
    # pointer (`var crc32_table` in lib/sankoch.cyr, filled by
    # `crc32_init_table` when it is 0).
    # alloc_reset() rewinds the bump allocator underneath that pointer, so from
    # iteration 2 onward the cached table ALIASED live decode memory and the
    # decoder mis-parsed everything: a return-code tally showed 2999 of 3000
    # iterations dying at the signature check (IMG_ERR_UNRECOGNIZED) instead of
    # reaching the chunk walker, inflate, unfilter or the PLTE bounds. Clearing
    # the cache forces a re-init into the fresh heap and restores full coverage
    # — the tally with this line is byte-for-byte the same as with no reset at
    # all (1515 NOT_PNG from the 50%-random half / 1387 HEADER / 97 CHUNK /
    # 1 NO_IDAT), while the heap stays bounded.
    alloc_reset();
    crc32_table = 0;   # see above — MUST accompany every alloc_reset()
    return 0;
}

# One JPEG-fuzz iteration. Always prepends SOI (0xFFD8) so the byte stream
# sniffs as JPEG and routes through chitra's JPEG decoder, then appends a
# random payload. Random bytes after SOI fail in the marker/segment parser,
# but chitra's marker scan (`_chitra_jpeg_scan_markers` since chitra 1.2.0) can
# allocate its frame/quant/huff tables (up to ~22 KB) BEFORE that failure — so,
# like the PNG iter, this MUST rewind the never-free bump allocator each
# iteration or it grows ~22 KB/iter (~22 GB over 10⁶ iters → OOM).
# alloc_reset() below does that. Contract: kii_decode_image
# never crashes; returns IMG_OK or any IMG_ERR_* cleanly.
fn fuzz_jpeg_iter(scratch_buf, scratch_cap): i64 {
    store8(scratch_buf + 0, 0xFF);            # SOI marker high byte
    store8(scratch_buf + 1, 0xD8);            # SOI marker low byte
    var payload = _fuzz_rand_range(PNG_FUZZ_MAX_LEN + 1);
    var max_fill = scratch_cap - 2;
    if (payload > max_fill) { payload = max_fill; }
    var i = 0;
    while (i < payload) {
        store8(scratch_buf + 2 + i, _fuzz_rand() & 0xFF);
        i = i + 1;
    }
    file_write_all("/tmp/kii-fuzz-jpeg.bin", scratch_buf, 2 + payload);
    var pstruct[160];
    kii_decode_image("/tmp/kii-fuzz-jpeg.bin", &pstruct);
    alloc_reset();                            # bound the never-free heap (see above)
    crc32_table = 0;   # see above — MUST accompany every alloc_reset()
    return 0;
}

# One BMP-fuzz iteration (v1.5.0, chitra 1.0.0). Always prepends the "BM"
# signature so the byte stream sniffs as BMP and routes through chitra's BMP
# decoder, then appends a random payload — so the DIB-header parser, the
# palette bounds, the RLE walker and the BI_BITFIELDS mask validator all see
# arbitrary bytes. Same allocator discipline as the PNG/JPEG surfaces: a
# matched signature makes chitra allocate header/palette scratch before the
# parse fails, so rewind the bump allocator each iteration.
# Contract: kii_decode_image never crashes; returns IMG_OK or any IMG_ERR_*.
fn fuzz_bmp_iter(scratch_buf, scratch_cap): i64 {
    store8(scratch_buf + 0, 0x42);            # 'B'
    store8(scratch_buf + 1, 0x4D);            # 'M'
    var payload = _fuzz_rand_range(PNG_FUZZ_MAX_LEN + 1);
    var max_fill = scratch_cap - 2;
    if (payload > max_fill) { payload = max_fill; }
    var i = 0;
    while (i < payload) {
        store8(scratch_buf + 2 + i, _fuzz_rand() & 0xFF);
        i = i + 1;
    }
    file_write_all("/tmp/kii-fuzz-bmp.bin", scratch_buf, 2 + payload);
    var pstruct[160];
    kii_decode_image("/tmp/kii-fuzz-bmp.bin", &pstruct);
    alloc_reset();                            # bound the never-free heap
    crc32_table = 0;   # see above — MUST accompany every alloc_reset()
    return 0;
}

# One GIF-fuzz iteration (v1.5.0, chitra 1.0.0). Prepends the 6-byte
# "GIF89a" signature, then a random payload — so the logical-screen and
# image descriptors, the color-table bounds and the LZW dictionary chain all
# see arbitrary bytes. The LZW path is the interesting one: it builds a
# dictionary from attacker-controlled codes, which is the classic GIF
# decoder CVE surface. Same allocator rewind as the other decode surfaces.
# Contract: kii_decode_image never crashes; returns IMG_OK or any IMG_ERR_*.
fn fuzz_gif_iter(scratch_buf, scratch_cap): i64 {
    store8(scratch_buf + 0, 0x47);            # 'G'
    store8(scratch_buf + 1, 0x49);            # 'I'
    store8(scratch_buf + 2, 0x46);            # 'F'
    store8(scratch_buf + 3, 0x38);            # '8'
    store8(scratch_buf + 4, 0x39);            # '9'
    store8(scratch_buf + 5, 0x61);            # 'a'
    var payload = _fuzz_rand_range(PNG_FUZZ_MAX_LEN + 1);
    var max_fill = scratch_cap - 6;
    if (payload > max_fill) { payload = max_fill; }
    var i = 0;
    while (i < payload) {
        store8(scratch_buf + 6 + i, _fuzz_rand() & 0xFF);
        i = i + 1;
    }
    file_write_all("/tmp/kii-fuzz-gif.bin", scratch_buf, 6 + payload);
    var pstruct[160];
    kii_decode_image("/tmp/kii-fuzz-gif.bin", &pstruct);
    alloc_reset();                            # bound the never-free heap
    crc32_table = 0;   # see above — MUST accompany every alloc_reset()
    return 0;
}

# One fuzz iteration. `scratch` holds the raw bytes of all args
# packed back-to-back (each null-terminated). `argv_arr` holds
# pointers into `scratch`, one per arg. argv[0] is always "kii"
# — programs always have an argv[0] and the parser stores it as
# prog_name; absent argv[0] would test a never-real path.
fn fuzz_iter(scratch, argv_arr): i64 {
    # Reset argv[0] = "kii"
    store8(scratch + 0, 0x6B);               # 'k'
    store8(scratch + 1, 0x69);               # 'i'
    store8(scratch + 2, 0x69);               # 'i'
    store8(scratch + 3, 0);
    store64(argv_arr + 0, scratch + 0);
    var off = 4;
    var argc_val = 1 + _fuzz_rand_range(FUZZ_MAX_ARGC - 1);
    var i = 1;
    while (i < argc_val) {
        var arg_len = _fuzz_build_arg(scratch + off, FUZZ_MAX_ARG_LEN);
        store64(argv_arr + i * 8, scratch + off);
        off = off + arg_len + 1;             # +1 for the null
        i = i + 1;
    }

    # Drive kii's actual flag set. cmdit_new allocates from the
    # bump allocator per iter; that's fine — 10k × ~few KB stays
    # under 100 MB worst-case, well below the heap layout's brk
    # ceiling (~77 MB final per the cyrius README, but the bump
    # allocator grows on demand). The contract: return value is
    # CMDIT_OK / CMDIT_HELP / CMDIT_VERSION / CMDIT_RESULT_ERR; never crash.
    var fs = cmdit_new("kii");
    kii_register_flags(fs);
    cmdit_parse_argv(fs, argc_val, argv_arr);
    return 0;
}

fn main(): i64 {
    alloc_init();
    _png_fuzz_init_prefix();

    # ---- arg-parser fuzz loop --------------------------------------
    # Function-scope `var buf[N]` = N bytes. 1 KB scratch is well
    # over FUZZ_MAX_ARGC × (FUZZ_MAX_ARG_LEN + 1) = 8 × 25 = 200
    # bytes. argv_arr at 80 bytes = 10 slots, one more than
    # FUZZ_MAX_ARGC for header alignment.
    var scratch[1024];
    var argv_arr[80];

    var iter = 0;
    while (iter < FUZZ_ITERS) {
        fuzz_iter(&scratch, &argv_arr);
        iter = iter + 1;
    }

    # ---- M7(b) path-sanitizer fuzz loop ----------------------------
    # Pure-memory; fast. 10⁶ iters runs in ~1 s.
    var path_buf[256];
    var path_iter = 0;
    var path_bad  = 0;
    while (path_iter < PATH_FUZZ_ITERS) {
        if (fuzz_path_iter(&path_buf, 256) != 0) { path_bad = path_bad + 1; }
        path_iter = path_iter + 1;
    }

    # ---- M7(b) geometry fuzz loop ----------------------------------
    # Pure-memory; fast. 10⁶ iters runs in ~1 s. Exercises both M6
    # geometry helpers.
    var geom_iter = 0;
    var geom_bad  = 0;
    while (geom_iter < GEOM_FUZZ_ITERS) {
        if (fuzz_geom_iter() != 0) { geom_bad = geom_bad + 1; }
        geom_iter = geom_iter + 1;
    }

    # ---- M7(b) emit-pipeline fuzz loop -----------------------------
    # Decode RAMGON.png once (the repo-root fixture), then run the
    # M5 pipeline at randomized target dims per iter. If RAMGON is
    # missing, skip the loop with emit_iter = 0 — fuzz infra still
    # runs cleanly on a CI checkout that doesn't bundle the fixture.
    var emit_iter = 0;
    var emit_bad  = 0;
    var emit_pstr[160];
    if (kii_decode_image("tests/fixtures/RAMGON.png", &emit_pstr) == IMG_OK) {
        # ANSI escape can produce up to ~25 bytes per cell at
        # 200 cols; 8 KB scratch is well above worst-case.
        var emit_line[16384];
        while (emit_iter < EMIT_FUZZ_ITERS) {
            if (fuzz_emit_iter(&emit_pstr, &emit_line) != 0) {
                emit_bad = emit_bad + 1;
            }
            emit_iter = emit_iter + 1;
        }
    }

    # ---- png-decoder fuzz loop -------------------------------------
    # Scaled 2k → 10⁶ at M7(b). Larger scratch: prefix (33) + max
    # payload (1024) = 1057 bytes. 2 KB stack buf has plenty of
    # headroom.
    var png_scratch[2048];
    var png_iter = 0;
    while (png_iter < PNG_FUZZ_ITERS) {
        fuzz_png_iter(&png_scratch, 2048);
        png_iter = png_iter + 1;
    }

    # ---- jpeg-decoder fuzz loop ------------------------------------
    # SOI + random payload (2 + ≤1024 bytes) through the same adapter,
    # now routed to chitra's JPEG decoder by the format sniff. Reuses a
    # 2 KB scratch (SOI prefix is only 2 bytes vs PNG's 33).
    var jpeg_scratch[2048];
    var jpeg_iter = 0;
    while (jpeg_iter < JPEG_FUZZ_ITERS) {
        fuzz_jpeg_iter(&jpeg_scratch, 2048);
        jpeg_iter = jpeg_iter + 1;
    }

    # ---- bmp-decoder fuzz loop -------------------------------------
    # "BM" + random payload through the same adapter, routed to chitra's
    # BMP decoder by the format sniff (v1.5.0).
    var bmp_scratch[2048];
    var bmp_iter = 0;
    while (bmp_iter < BMP_FUZZ_ITERS) {
        fuzz_bmp_iter(&bmp_scratch, 2048);
        bmp_iter = bmp_iter + 1;
    }

    # ---- gif-decoder fuzz loop -------------------------------------
    # "GIF89a" + random payload, routed to chitra's GIF/LZW decoder
    # by the format sniff (v1.5.0).
    var gif_scratch[2048];
    var gif_iter = 0;
    while (gif_iter < GIF_FUZZ_ITERS) {
        fuzz_gif_iter(&gif_scratch, 2048);
        gif_iter = gif_iter + 1;
    }

    # ---- v1.6.0 surfaces --------------------------------------------
    # Run LAST so every surface above consumes exactly the random stream it
    # did through v1.5.2 (one shared LCG seed).
    var diff_buf[128];
    var diff_iter = 0;
    var diff_bad  = 0;
    while (diff_iter < PATH_DIFF_FUZZ_ITERS) {
        if (fuzz_path_diff_iter(&diff_buf, 120) != 0) { diff_bad = diff_bad + 1; }
        diff_iter = diff_iter + 1;
    }
    var env_iter = 0;
    var env_bad  = 0;
    while (env_iter < ENV_FUZZ_ITERS) {
        if (fuzz_envelope_iter() != 0) { env_bad = env_bad + 1; }
        env_iter = env_iter + 1;
    }
    # v1.10.0: the ASCII lane. Frames are at most 64 x 60 samples, so the
    # buffers hold 11,520 RGB bytes, 3,840 mask bytes, and a 32-cell row of
    # truecolour (20 bytes a cell + the row tail).
    var ascii_rgb[11520];
    var ascii_mask[3840];
    var ascii_out_a[1024];
    var ascii_out_b[1024];
    var ascii_iter = 0;
    var ascii_bad  = 0;
    while (ascii_iter < ASCII_FUZZ_ITERS) {
        if (fuzz_ascii_iter(&ascii_rgb, &ascii_mask, &ascii_out_a, &ascii_out_b) != 0) { ascii_bad = ascii_bad + 1; }
        ascii_iter = ascii_iter + 1;
    }
    # v1.11.0: the ASCII lane's area sampler. Images are at most 48 x 48, so
    # 9,216 pixel bytes, and each padded copy adds 2 x AREA_FUZZ_PAD.
    var area_pix[9216];
    var area_src_a[10240];
    var area_src_b[10240];
    var area_iter = 0;
    var area_bad  = 0;
    while (area_iter < AREA_FUZZ_ITERS) {
        if (fuzz_area_iter(&area_pix, &area_src_a, &area_src_b) != 0) { area_bad = area_bad + 1; }
        area_iter = area_iter + 1;
    }
    # v2.0.0: the blocks lane. Images are at most 32 x 32 (4,096 bytes), so the
    # area surface's buffers hold them; a row is at most 24 cells x 42 + 16.
    var blk_cell_iter = 0;
    var blk_cell_bad  = 0;
    while (blk_cell_iter < BLK_CELL_FUZZ_ITERS) {
        if (fuzz_blocks_cell_iter() != 0) { blk_cell_bad = blk_cell_bad + 1; }
        blk_cell_iter = blk_cell_iter + 1;
    }
    var blk_out_a[1024];
    var blk_out_b[1024];
    var blk_frame_iter = 0;
    var blk_frame_bad  = 0;
    while (blk_frame_iter < BLK_FRAME_FUZZ_ITERS) {
        if (fuzz_blocks_frame_iter(&area_pix, &area_src_a, &area_src_b, &blk_out_a, &blk_out_b) != 0) { blk_frame_bad = blk_frame_bad + 1; }
        blk_frame_iter = blk_frame_iter + 1;
    }
    # v2.1.0: half-block rows, read back. A strip is at most 2 x 48 codes; a row
    # at most 48 cells x 42 + 16 bytes.
    var hb_q[384];
    var hb_out[2048];
    var hb_iter = 0;
    var hb_bad  = 0;
    while (hb_iter < HB_FUZZ_ITERS) {
        if (fuzz_halfblock_iter(&hb_q, &hb_out) != 0) { hb_bad = hb_bad + 1; }
        hb_iter = hb_iter + 1;
    }
    # v2.2.0: --invert and --color none. An image is at most 48 x 48 (9,216
    # bytes, as the area surface's); a row at most 24 cells x 20 + 5 bytes.
    var inv_neg[9216];
    var inv_out_a[1024];
    var inv_out_b[1024];
    var inv_iter = 0;
    var inv_bad  = 0;
    while (inv_iter < INV_FUZZ_ITERS) {
        if (fuzz_invert_iter(&area_pix, &inv_neg, &inv_out_a, &inv_out_b) != 0) { inv_bad = inv_bad + 1; }
        inv_iter = inv_iter + 1;
    }
    # v2.3.0: the Braille lane, on the same buffers (a row is at most 24 cells
    # x 22 + 5 bytes).
    var brl_iter = 0;
    var brl_bad  = 0;
    while (brl_iter < BRL_FUZZ_ITERS) {
        if (fuzz_braille_iter(&area_pix, &inv_neg, &inv_out_a, &inv_out_b) != 0) { brl_bad = brl_bad + 1; }
        brl_iter = brl_iter + 1;
    }

    # ---- report ----------------------------------------------------
    # fmt_printf takes a vec for varargs (per lib/fmt.cyr — vec_get
    # walks args by index). One line per fuzz surface; "fuzz: ok"
    # closes the human-readable log so CI greps see a clear sentinel.
    var args_arg = vec_new();
    vec_push(args_arg, iter);
    fmt_printf("fuzz: %d iterations passed (arg-parser crash-safety)\n", args_arg);

    var args_path = vec_new();
    vec_push(args_path, path_iter);
    vec_push(args_path, path_bad);
    fmt_printf("fuzz: %d iterations passed (path-sanitizer; bad=%d)\n", args_path);

    var args_geom = vec_new();
    vec_push(args_geom, geom_iter);
    vec_push(args_geom, geom_bad);
    fmt_printf("fuzz: %d iterations passed (geometry; bad=%d)\n", args_geom);

    var args_emit = vec_new();
    vec_push(args_emit, emit_iter);
    vec_push(args_emit, emit_bad);
    fmt_printf("fuzz: %d iterations passed (emit-pipeline; bad=%d)\n", args_emit);

    var args_png = vec_new();
    vec_push(args_png, png_iter);
    fmt_printf("fuzz: %d iterations passed (png-decoder crash-safety)\n", args_png);

    var args_jpeg = vec_new();
    vec_push(args_jpeg, jpeg_iter);
    fmt_printf("fuzz: %d iterations passed (jpeg-decoder crash-safety)\n", args_jpeg);

    var args_bmp = vec_new();
    vec_push(args_bmp, bmp_iter);
    fmt_printf("fuzz: %d iterations passed (bmp-decoder crash-safety)\n", args_bmp);

    var args_gif = vec_new();
    vec_push(args_gif, gif_iter);
    fmt_printf("fuzz: %d iterations passed (gif-decoder crash-safety)\n", args_gif);

    var args_diff = vec_new();
    vec_push(args_diff, diff_iter);
    vec_push(args_diff, diff_bad);
    vec_push(args_diff, _fz_diff_valid);
    vec_push(args_diff, _fz_diff_strict);
    fmt_printf("fuzz: %d iterations passed (path-sanitizer differential vs v1.5.2; bad=%d, both-accept=%d, strict-only=%d)\n", args_diff);

    var args_env = vec_new();
    vec_push(args_env, env_iter);
    vec_push(args_env, env_bad);
    fmt_printf("fuzz: %d iterations passed (terminal envelope; bad=%d)\n", args_env);

    var args_ascii = vec_new();
    vec_push(args_ascii, ascii_iter);
    vec_push(args_ascii, ascii_bad);
    fmt_printf("fuzz: %d iterations passed (ascii lane, pad differential; bad=%d)\n", args_ascii);

    var args_area = vec_new();
    vec_push(args_area, area_iter);
    vec_push(args_area, area_bad);
    fmt_printf("fuzz: %d iterations passed (area sampler, pad differential + reference; bad=%d)\n", args_area);

    var args_bcell = vec_new();
    vec_push(args_bcell, blk_cell_iter);
    vec_push(args_bcell, blk_cell_bad);
    fmt_printf("fuzz: %d iterations passed (blocks shape choice vs brute force; bad=%d)\n", args_bcell);

    var args_bframe = vec_new();
    vec_push(args_bframe, blk_frame_iter);
    vec_push(args_bframe, blk_frame_bad);
    fmt_printf("fuzz: %d iterations passed (blocks frames, pad differential; bad=%d)\n", args_bframe);

    var args_hb = vec_new();
    vec_push(args_hb, hb_iter);
    vec_push(args_hb, hb_bad);
    fmt_printf("fuzz: %d iterations passed (half-block rows, decoded to their colours; bad=%d)\n", args_hb);

    var args_inv = vec_new();
    vec_push(args_inv, inv_iter);
    vec_push(args_inv, inv_bad);
    fmt_printf("fuzz: %d iterations passed (--invert vs the negative, --color none vs the escapes; bad=%d)\n", args_inv);

    var args_brl = vec_new();
    vec_push(args_brl, brl_iter);
    vec_push(args_brl, brl_bad);
    fmt_printf("fuzz: %d iterations passed (braille lane: sampler, ink rules, negative, escapes; bad=%d)\n", args_brl);

    # v1.6.0: a non-zero bad count FAILS the run. Through v1.5.2 the bad
    # tallies were printed and the harness still said "fuzz: ok" and exited
    # 0, so CI's `./build/kii-fuzz` step could not go red on a contract
    # violation — only on a crash.
    if (path_bad + geom_bad + emit_bad + diff_bad + env_bad + ascii_bad + area_bad + blk_cell_bad + blk_frame_bad + hb_bad + inv_bad + brl_bad != 0) {
        println("fuzz: FAIL");
        return 1;
    }
    println("fuzz: ok");
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
