# kii fuzz harness — two crash-safety surfaces in one binary.
#
# 1. Arg parser (M1 sub-bite (d)): drives kii's flag set via
#    kii_register_flags with deterministic LCG-generated random
#    argv arrays. Contract: cmdit_parse_argv never crashes on malformed
#    input, only returns CMDIT_* codes cleanly.
#
# 2. PNG decode adapter (M2 sub-bite (d), re-aimed at the PNG re-fold):
#    writes random byte sequences to /tmp/kii-fuzz-png.bin + drives
#    kii_decode_image (the chitra adapter) over them. 50% of iterations
#    prepend a valid signature + IHDR so chitra's post-IHDR chunk walker
#    gets exercised. Contract: kii_decode_image never crashes; returns
#    IMG_OK or any IMG_ERR_* cleanly.
#
# 3b. BMP + GIF decode adapters (v1.5.0, chitra 1.0.0): the same shape as
#    the JPEG surface below — prepend the format signature ("BM" / "GIF89a")
#    so the sniff routes the random payload into chitra's BMP or GIF decoder,
#    and rewind the bump allocator each iteration. The GIF surface is the
#    highest-value one of the four: LZW builds a dictionary from
#    attacker-controlled codes, which is the classic GIF-decoder CVE class.
#
# 3. JPEG decode adapter (v1.4.0, chitra 0.3.0): writes SOI (0xFFD8) +
#    random bytes to /tmp/kii-fuzz-jpeg.bin + drives the same kii_decode_image
#    adapter, which now routes JPEG-signature input to chitra's JPEG decoder
#    via chitra_image_decode. Exercises the format sniff + marker/segment
#    parser over arbitrary bytes. Crash-safety only. NOTE: a present SOI makes
#    chitra allocate its frame/quant/huff scratch (~22 KB) before the marker
#    walk fails, so each PNG/JPEG decode iter calls alloc_reset() to rewind
#    the never-free bump allocator — without that the heap would grow
#    unboundedly (~22 GB over 10⁶ JPEG iters). Every alloc_reset() is paired
#    with `crc32_table = 0` — see fuzz_png_iter; without it the reset
#    invalidates sankoch's cached CRC table and voids the surface.
#    Deep entropy/IDCT decode
#    fuzzing is chitra's own suite's job (the decoder's owner), matching the
#    re-fold's division of labor.
#
# Determinism: fixed seed (1) + Numerical Recipes LCG. Same byte
# sequences every CI run; failures bisect cleanly.
#
# Stdlib and the cmdit / darshana / chitra bundles auto-resolve from
# cyrius.cyml; the project modules come from the includes below.

include "src/cli.cyr"
include "src/image.cyr"
include "src/palette.cyr"
include "src/quant.cyr"
include "src/downscale.cyr"
include "src/emit.cyr"
include "src/ascii.cyr"

# Iteration counts.
#
# Arg-parser fuzz (FUZZ_ITERS): 10k baseline (no I/O, runs in <50 ms).
# PNG-decoder fuzz (PNG_FUZZ_ITERS): scaled 2k → 10⁶ at M7(b) per the
#   v1.0 acceptance criterion (docs/development/roadmap.md § M7). Each
#   iter does a /tmp file_write_all + open + read on tmpfs; 10⁶ iters
#   lands around ~35s on the dev box.
# Path-sanitizer fuzz (PATH_FUZZ_ITERS): pure-memory; 10⁶ at full
#   M7(b) scale, runs in <1 s.
# Geometry fuzz (GEOM_FUZZ_ITERS): pure-memory; 10⁶ at full M7(b)
#   scale, runs in <1 s.
# Emit-pipeline fuzz (EMIT_FUZZ_ITERS): decodes RAMGON.png once,
#   then varies (dst_cols, dst_rows) randomly per iter through
#   downscale → quantize → emit. 1k iters at ~1ms each (the
#   end-to-end bench at ~770ms/iter is mostly PNG decode, which
#   we skip here by reusing the decoded pstruct).
var FUZZ_ITERS        = 10000;
var PNG_FUZZ_ITERS    = 1000000;
var JPEG_FUZZ_ITERS   = 1000000;
var BMP_FUZZ_ITERS    = 1000000;   # v1.5.0 — chitra 1.0.0 BMP path
var GIF_FUZZ_ITERS    = 1000000;   # v1.5.0 — chitra 1.0.0 GIF/LZW path
var PATH_FUZZ_ITERS   = 1000000;
var GEOM_FUZZ_ITERS   = 1000000;
var EMIT_FUZZ_ITERS   = 1000;
var PATH_DIFF_FUZZ_ITERS = 1000000;   # v1.6.0 — tty_has_ctl vs the v1.5.2 walk
var ENV_FUZZ_ITERS       = 1000000;   # v1.6.0 — _kii_term_envelope + fit geometry
var ASCII_FUZZ_ITERS     = 40000;     # v1.10.0 — the ASCII lane's contrast pass + match

# Per-iter argv shape. argc ∈ [1, FUZZ_MAX_ARGC]; each arg's body
# is ≤ FUZZ_MAX_ARG_LEN bytes plus an optional "-"/"--" prefix.
var FUZZ_MAX_ARGC    = 8;
var FUZZ_MAX_ARG_LEN = 24;

# Per-iter PNG fuzz shape. Random byte payload length ∈ [0,
# PNG_FUZZ_MAX_LEN]; optionally prepended with a 33-byte valid
# signature + IHDR prefix (50% of iters) so the chunk walker is
# reached. Scratch buf accommodates prefix + payload.
var PNG_FUZZ_MAX_LEN = 1024;

# ---- deterministic LCG ----------------------------------------------
# Numerical Recipes constants. Seed is mutable module state so each
# rand call advances it. Masked to 32 bits after multiply to keep
# the modulus operand positive (avoids sign weirdness with `%`).
var _fuzz_seed = 1;

fn _fuzz_rand(): i64 {
    _fuzz_seed = _fuzz_seed * 1664525 + 1013904223;
    _fuzz_seed = _fuzz_seed & 0xFFFFFFFF;
    return _fuzz_seed;
}

fn _fuzz_rand_range(n): i64 {
    return _fuzz_rand() % n;
}

# Pick a printable-ASCII byte (0x21–0x7E). NUL is excluded because
# argv entries are null-terminated cstrs; multi-byte UTF-8 leaders
# are excluded so we focus pressure on the parser's flag-recognition
# path (which is ASCII-only) rather than on string-handling
# robustness (separate concern, separate fuzz at M2+).
fn _fuzz_printable_byte(): i64 {
    var span = 0x7E - 0x21 + 1;              # 94 printable bytes
    return 0x21 + (_fuzz_rand() % span);
}

# Build one random arg in `buf`, null-terminated. Returns the
# byte length excluding the terminator. The first 1–2 bytes are
# biased to "-" / "--" 50% of the time so the parser actually
# exercises its flag-recognition path (a uniform random byte
# starts with '-' only ~1% of the time, far too rare to find
# parser bugs in 10k iters).
fn _fuzz_build_arg(buf, max_len): i64 {
    var mode = _fuzz_rand_range(4);
    var off  = 0;
    if (mode == 0) {
        # "--foo" / "--foo=bar" shape
        store8(buf + 0, 0x2D);
        store8(buf + 1, 0x2D);
        off = 2;
    } else { if (mode == 1) {
            # "-x" / "-xy" shape (bundled rejection path is reachable)
            store8(buf + 0, 0x2D);
            off = 1;
        } else {
            # bare positional / weird bytes
            off = 0;
        } }
    var body_len = 1 + _fuzz_rand_range(max_len - off - 1);
    var i = 0;
    while (i < body_len) {
        store8(buf + off + i, _fuzz_printable_byte());
        i = i + 1;
    }
    store8(buf + off + body_len, 0);
    return off + body_len;
}

# ---- PNG fuzz support ----------------------------------------------
# Pre-built 33-byte "valid prefix" (signature + IHDR for a 4x2 RGB
# image with computed IHDR CRC) — prepended to random-byte fuzz
# inputs 50% of the time so the chunk walker post-IHDR sees random
# chunks. Module-scope `var arr[33]` = 33 × u64 slots = 264 bytes
# (we use the first 33 bytes; rest is wasted but cheap). Caller
# must call _png_fuzz_init_prefix() once before the first PNG fuzz
# iter so the IHDR CRC is computed and stored.
var _png_fuzz_prefix[33];
var _png_fuzz_prefix_inited = 0;

fn _png_fuzz_init_prefix(): i64 {
    if (_png_fuzz_prefix_inited == 1) { return 0; }
    crc32_init_table();
    var b = &_png_fuzz_prefix;
    # signature (inlined; PNG_MAGIC removed in the PNG re-fold)
    store8(b + 0, 0x89); store8(b + 1, 0x50); store8(b + 2, 0x4E); store8(b + 3, 0x47);
    store8(b + 4, 0x0D); store8(b + 5, 0x0A); store8(b + 6, 0x1A); store8(b + 7, 0x0A);
    # IHDR length = 13
    store8(b + 8, 0);  store8(b + 9, 0);  store8(b + 10, 0); store8(b + 11, 13);
    # IHDR type "IHDR"
    store8(b + 12, 0x49); store8(b + 13, 0x48); store8(b + 14, 0x44); store8(b + 15, 0x52);
    # IHDR data: 4×2, depth=8, RGB, comp=0, filter=0, interlace=0
    store8(b + 16, 0); store8(b + 17, 0); store8(b + 18, 0); store8(b + 19, 4);
    store8(b + 20, 0); store8(b + 21, 0); store8(b + 22, 0); store8(b + 23, 2);
    store8(b + 24, 8); store8(b + 25, 2);
    store8(b + 26, 0); store8(b + 27, 0); store8(b + 28, 0);
    # IHDR CRC32 over type + data (17 bytes at offset 12..28)
    var crc = crc32(b + 12, 17);
    store8(b + 29, (crc >> 24) & 0xFF);
    store8(b + 30, (crc >> 16) & 0xFF);
    store8(b + 31, (crc >> 8)  & 0xFF);
    store8(b + 32, crc & 0xFF);
    _png_fuzz_prefix_inited = 1;
    return 0;
}

# ---- M7(b) path-sanitizer fuzz surface -----------------------------
# Random-byte path buffers driven through kii_path_has_control_bytes
# (src/cli.cyr) to confirm the predicate never crashes and always
# returns 0 or 1, regardless of byte content. Each iter generates a
# null-terminated byte string in `buf` with each non-NUL byte chosen
# uniformly from 0x01..0xFF (NUL would terminate prematurely).
# Contract: predicate returns exactly 0 or 1; total call count
# matches PATH_FUZZ_ITERS.
fn fuzz_path_iter(buf, max_len): i64 {
    var n = 1 + _fuzz_rand_range(max_len - 1);
    var i = 0;
    while (i < n) {
        # 0x01..0xFF — exclude NUL (we add it as terminator)
        store8(buf + i, 1 + (_fuzz_rand() % 255));
        i = i + 1;
    }
    store8(buf + n, 0);
    var rc = kii_path_has_control_bytes(buf);
    # Defensive cross-check: return MUST be 0 or 1. If the predicate
    # somehow returns something else, count it as a failure (the
    # main loop tallies the bad-return count).
    if (rc == 0 || rc == 1) { return 0; }
    return 0 - 1;
}

# ---- v1.6.0 path-sanitizer DIFFERENTIAL surface -------------------
# kii_path_has_control_bytes became a wrapper over darshana's tty_has_ctl
# at v1.6.0. The intended difference from the walk kii shipped through
# v1.5.2 is exactly one class: sequences that are structurally UTF-8 but
# forbidden by RFC 3629 (overlong E0 80-9F / F0 80-8F, surrogates
# ED A0-BF, past U+10FFFF F4 90-BF). This surface proves that is the ONLY
# difference: on every input, the new verdict must equal
#   1                      if the v1.5.2 walk rejected it, else
#   strict_only(input)     (1 iff it holds one of those four forms).
# The generator builds strings from UTF-8-shaped tokens (valid sequences of
# every length, the four strict-only forms, C0/DEL, stray high bytes,
# truncated sequences) so a large share of inputs is valid text — random
# bytes alone almost never are, and would leave the "both accept" and
# "strict-only" cells empty. The report tallies both.
fn _ref_path_walk_v152(path): i64 {
    var len = strlen(path);
    var i = 0;
    while (i < len) {
        var b = load8(path + i);
        if ((b < 0x20 && b != 0x09 && b != 0x0A) || b == 0x7F) {
            return 1;
        }
        if (b < 0x80) { i = i + 1; }
        else {
            var seq = 0;
            if (b >= 0xC2 && b <= 0xDF) { seq = 2; }
            if (b >= 0xE0 && b <= 0xEF) { seq = 3; }
            if (b >= 0xF0 && b <= 0xF4) { seq = 4; }
            if (seq == 0)       { return 1; }
            if (i + seq > len)  { return 1; }
            var k = 1;
            while (k < seq) {
                var c = load8(path + i + k);
                if (c < 0x80 || c > 0xBF) { return 1; }
                k = k + 1;
            }
            if (seq == 2 && b == 0xC2) {
                var c1 = load8(path + i + 1);
                if (c1 >= 0x80 && c1 <= 0x9F) { return 1; }
            }
            i = i + seq;
        }
    }
    return 0;
}

# For a string the v1.5.2 walk accepted: 1 iff some sequence in it is one
# of the four RFC 3629 second-byte violations, else 0.
fn _ref_strict_only(path): i64 {
    var len = strlen(path);
    var i = 0;
    while (i < len) {
        var b = load8(path + i);
        if (b < 0x80) { i = i + 1; }
        else {
            var c1 = load8(path + i + 1);
            if (b == 0xE0 && c1 < 0xA0) { return 1; }
            if (b == 0xED && c1 > 0x9F) { return 1; }
            if (b == 0xF0 && c1 < 0x90) { return 1; }
            if (b == 0xF4 && c1 > 0x8F) { return 1; }
            var seq = 2;
            if (b >= 0xE0) { seq = 3; }
            if (b >= 0xF0) { seq = 4; }
            i = i + seq;
        }
    }
    return 0;
}

fn _fz_cont(): i64 { return 0x80 + (_fuzz_rand() % 64); }

# Append one token at buf + n; returns the new length.
fn _fz_token(buf, n): i64 {
    var r = _fuzz_rand() % 100;
    if (r < 40) { store8(buf + n, 0x20 + (_fuzz_rand() % 95)); return n + 1; }
    if (r < 50) {                                   # 2-byte (incl. C2 80-9F)
        store8(buf + n, 0xC2 + (_fuzz_rand() % 30)); store8(buf + n + 1, _fz_cont());
        return n + 2;
    }
    var lead = 0;
    var lo = 0x80;
    var span = 64;
    var len = 3;
    if (r < 60)      { lead = 0xE1 + (_fuzz_rand() % 14); if (lead >= 0xED) { lead = lead + 1; } }
    else { if (r < 65) { lead = 0xE0; lo = 0xA0; span = 32; }
    else { if (r < 68) { lead = 0xE0; lo = 0x80; span = 32; }          # strict-only
    else { if (r < 71) { lead = 0xED; lo = 0x80; span = 32; }
    else { if (r < 74) { lead = 0xED; lo = 0xA0; span = 32; }          # strict-only
    else { if (r < 79) { lead = 0xF1 + (_fuzz_rand() % 3); len = 4; }
    else { if (r < 81) { lead = 0xF0; lo = 0x90; span = 48; len = 4; }
    else { if (r < 83) { lead = 0xF0; lo = 0x80; span = 16; len = 4; } # strict-only
    else { if (r < 85) { lead = 0xF4; lo = 0x80; span = 16; len = 4; }
    else { if (r < 87) { lead = 0xF4; lo = 0x90; span = 48; len = 4; } # strict-only
    else { if (r < 91) {                            # C0 control or DEL
        var cb = 1 + (_fuzz_rand() % 32);
        if (cb == 32) { cb = 0x7F; }
        store8(buf + n, cb); return n + 1;
    }
    else { if (r < 94) { store8(buf + n, 0x80 + (_fuzz_rand() % 128)); return n + 1; }
    else { if (r < 97) {                            # truncated: lead + 1 cont
        store8(buf + n, 0xE0 + (_fuzz_rand() % 21)); store8(buf + n + 1, _fz_cont());
        return n + 2;
    }
    else { store8(buf + n, 1 + (_fuzz_rand() % 255)); return n + 1; } } } } } } } } } } } } }
    store8(buf + n, lead);
    store8(buf + n + 1, lo + (_fuzz_rand() % span));
    var k = 2;
    while (k < len) { store8(buf + n + k, _fz_cont()); k = k + 1; }
    return n + len;
}

var _fz_diff_valid  = 0;   # both walks accept
var _fz_diff_strict = 0;   # v1.5.2 accepted, v1.6.0 refuses (the intended change)

fn fuzz_path_diff_iter(buf, cap): i64 {
    var tokens = 1 + (_fuzz_rand() % 12);
    var n = 0;
    var t = 0;
    while (t < tokens && n + 4 < cap) {
        n = _fz_token(buf, n);
        t = t + 1;
    }
    store8(buf + n, 0);
    var old = _ref_path_walk_v152(buf);
    var now = kii_path_has_control_bytes(buf);
    var want = 1;
    if (old == 0) { want = _ref_strict_only(buf); }
    if (old == 0 && now == 0) { _fz_diff_valid = _fz_diff_valid + 1; }
    if (old == 0 && now == 1) { _fz_diff_strict = _fz_diff_strict + 1; }
    if (now != want) { return 0 - 1; }
    return 0;
}

# ---- v1.6.0 terminal-envelope surface ------------------------------
# _kii_term_envelope (src/emit.cyr) feeding _kii_compute_fit_geometry, over
# random winsize answers — many of them 0, 1 or half-set, which is where the
# v1.5.1 A-8 defect lived. Invariants: a failed detection is 0 x 0; each
# dimension is used iff it is > 0, rows less the prompt row (a 1-row
# terminal keeps 1); a measured TTY reporting 0 rows gets the default less
# the prompt row (v1.6.4, C-8 — this surface failed 83,256 of 1M iterations
# against the new rule until its reference was updated, which is the
# surface doing its job); and the resulting frame is never wider than a
# measured column count or taller than the envelope's rows.
fn _fz_dim(): i64 {
    if (_fuzz_rand() % 3 == 0) { return _fuzz_rand() % 4; }
    return _fuzz_rand() % 65536;
}

fn fuzz_envelope_iter(): i64 {
    var rc = 0;
    if (_fuzz_rand() % 4 == 0) { rc = 0 - 1; }
    var rows = _fz_dim();
    var cols = _fz_dim();
    var src_w = 1 + (_fuzz_rand() % 65535);
    var src_h = 1 + (_fuzz_rand() % 65535);
    var fc = 0 - 9;
    var fr = 0 - 9;
    if (_kii_term_envelope(rc, rows, cols, &fc, &fr) != 0) { return 0 - 1; }
    var want_c = 0;
    var want_r = 0;
    if (rc == 0) {
        if (cols > 0) { want_c = cols; }
        if (rows > 1) { want_r = rows - 1; }
        if (rows == 1) { want_r = 1; }
        if (rows == 0) { want_r = EMIT_DEFAULT_ROWS - 1; }
    }
    if (fc != want_c || fr != want_r) { return 0 - 1; }
    var dw = 0;
    var dsr = 0;
    if (_kii_compute_fit_geometry(src_w, src_h, fc, fr, &dw, &dsr) != 0) { return 0 - 1; }
    var cap_c = fc;
    if (cap_c == 0) { cap_c = EMIT_DEFAULT_COLS; }
    var cap_r = fr;
    if (cap_r == 0) { cap_r = EMIT_DEFAULT_ROWS; }
    if (dw < 1 || dw > cap_c) { return 0 - 1; }
    if (dsr < 2 || dsr % 2 != 0 || dsr / 2 > cap_r) { return 0 - 1; }
    return 0;
}

# ---- M7(b) geometry fuzz surface -----------------------------------
# Random (src_w, src_h, max_cols, max_rows) inputs to the M6 geometry
# helpers. Drive both _kii_compute_target_geometry (--width N path)
# and _kii_compute_fit_geometry (terminal-fit path), plus the v1.6.4
# frame-size predicate main applies to their output. The fuzz inputs
# are bounded to [0, 65535] for each field — large enough to exercise
# overflow paths, small enough to fit in the i64 multiplications
# without wrapping.
#
# P(-1) (v1.6.4): through v1.6.3 this checked only that each helper
# returned 0 or -1, which are the only values either can return, so the
# surface could fail only by crashing. It now checks the contract:
#   - each helper succeeds exactly when the source has both dimensions;
#   - the --width path is exactly `width` columns (80 when 0) and
#     max(1, src_h * cols / (src_w * 2)) character rows, as an even
#     source-row count;
#   - the fit path stays inside its envelope (0 = the 80 x 24 default);
#   - kii_frame_cells_ok agrees with the plain product against KII_MAX_CELLS.
# It draws the same five random numbers per iteration as before, so the
# surfaces after it see the random stream they always did.
fn fuzz_geom_iter(): i64 {
    var src_w    = _fuzz_rand() % 65536;
    var src_h    = _fuzz_rand() % 65536;
    var max_cols = _fuzz_rand() % 65536;
    var max_rows = _fuzz_rand() % 65536;
    var width_n  = _fuzz_rand() % 65536;
    var has_src = 0;
    if (src_w > 0 && src_h > 0) { has_src = 1; }

    var out_w  = 0;
    var out_sr = 0;
    var rc1 = _kii_compute_target_geometry(src_w, src_h, width_n, &out_w, &out_sr);
    if (has_src == 0) { if (rc1 != 0 - 1) { return 0 - 1; } }
    else {
        if (rc1 != 0) { return 0 - 1; }
        var want_c = width_n;
        if (want_c == 0) { want_c = EMIT_DEFAULT_COLS; }
        var want_r = (src_h * want_c) / (src_w * 2);
        if (want_r < 1) { want_r = 1; }
        if (out_w != want_c) { return 0 - 1; }
        if (out_sr != want_r * 2) { return 0 - 1; }
        var cells_ok = 0;
        if (out_w * want_r <= KII_MAX_CELLS) { cells_ok = 1; }
        if (kii_frame_cells_ok(out_w, out_sr / 2) != cells_ok) { return 0 - 1; }
    }

    var rc2 = _kii_compute_fit_geometry(src_w, src_h, max_cols, max_rows, &out_w, &out_sr);
    if (has_src == 0) { if (rc2 != 0 - 1) { return 0 - 1; } }
    else {
        if (rc2 != 0) { return 0 - 1; }
        var cap_c = max_cols;
        if (cap_c == 0) { cap_c = EMIT_DEFAULT_COLS; }
        var cap_r = max_rows;
        if (cap_r == 0) { cap_r = EMIT_DEFAULT_ROWS; }
        if (out_w < 1 || out_w > cap_c) { return 0 - 1; }
        if (out_sr < 2 || out_sr % 2 != 0 || out_sr / 2 > cap_r) { return 0 - 1; }
    }
    return 0;
}

# ---- M7(b) emit-pipeline fuzz surface ------------------------------
# Drive downscale → quantize → emit_halfblock_row_buf on a valid
# decoded PNG (RAMGON.png from the repo root) with randomized target
# dimensions per iter. Decoding the source PNG is expensive
# (~700 ms per the bench harness) so we do it once at startup;
# per-iter cost is just the M5 pipeline (~1 ms each on tmpfs).
#
# Contract: downscale_to_rgb / quantize_downscaled / emit_halfblock_row_buf
# return 0 on success or -1 on rejection (e.g. dst dims = 0); never
# crash. The fuzz exercises:
#   - dst_w / dst_h boundary cases (0, 1, near-source-size, larger-than-source)
#   - the per-row emit_halfblock_row_buf walk with random row index
# v1.8.0: the colour tier rotates 8 → 16 → 256 → truecolour by call count
# (no extra random draw, so the surfaces after this one see the random
# stream they always did), and every row must now succeed: quantize only
# produces codes of the active tier, so emit refusing one is a contract
# violation. The caller's line buffer holds 200 truecolour cells (41 bytes
# each) plus the row tail.
# v1.9.0: the dither mode rotates none → ordered → fs every four calls, the
# same way, so twelve calls cover every tier × dither pair.
var _fz_emit_calls = 0;

fn fuzz_emit_iter(pstruct, line_buf): i64 {
    var tier = KII_TIER_8;
    var t4 = _fz_emit_calls % 4;
    if (t4 == 1) { tier = KII_TIER_16; }
    if (t4 == 2) { tier = KII_TIER_256; }
    if (t4 == 3) { tier = KII_TIER_TC; }
    quant_set_tier(tier);
    quant_set_dither((_fz_emit_calls / 4) % 3);
    _fz_emit_calls = _fz_emit_calls + 1;
    # Random target dims in [1, 200]. Cap at source-w / source-h
    # constraint inside downscale_to_rgb if it has one — but
    # contract is "never crash", so we don't pre-validate.
    var dst_w = 1 + (_fuzz_rand() % 200);
    var dst_h = 1 + (_fuzz_rand() % 200);
    var dr = downscale_to_rgb(pstruct, dst_w, dst_h);
    if (dr != 0 && dr != (0 - 1)) { return 0 - 1; }
    if (dr != 0) { return 0; }                  # rejection; nothing else to do
    var qr = quantize_downscaled(pstruct);
    if (qr != 0 && qr != (0 - 1)) { return 0 - 1; }
    if (qr != 0) { return 0; }
    # Pick a random row to emit. dst_h pairs of source rows produce
    # dst_h/2 terminal rows; safe to walk [0, dst_h/2).
    var term_rows = dst_h / 2;
    if (term_rows < 1) { return 0; }
    var row = _fuzz_rand() % term_rows;
    var qbuf = load64(pstruct + STRUCT_QUANTIZED_BUF_OFFSET);
    var dw   = load64(pstruct + STRUCT_DOWNSCALED_W_OFFSET);
    var epos = emit_halfblock_row_buf(qbuf, dw, row, line_buf, 0);
    quant_set_tier(KII_TIER_16);
    quant_set_dither(KII_DITHER_NONE);
    if (epos <= 0) { return 0 - 1; }
    if (epos > dw * (EMIT_CELL_MAX + 1) + 16) { return 0 - 1; }
    return 0;
}

# ---- v1.10.0 ASCII-lane fuzz surface ------------------------------
# The contrast pass reads the samples around each cell, so it is the lane's
# one bounds-sensitive step. Each iteration builds a random frame (2..64 x
# 3..60 sub-samples, random RGB, and a random transparency mask half the
# time) and renders every row with emit_ascii_shape_row_buf, twice: once with
# the luminance plane between pads of 0 and once between pads of 255. The
# guards keep every read inside the plane, so the two renders must be byte for
# byte the same; a read past the plane's top or bottom edge would see a
# different pad and change a glyph. Every row must also end in the reset and
# LF, and every glyph must be in the table. The tier rotates as on the emit
# surface. It runs after every older surface, so they see the random stream
# they always did.
var _fz_ascii_calls = 0;

# The plane for `rgb` / `mask` copied between two pads of `pad` bytes, each
# set to `val`. Returns a pointer to the plane itself.
fn _fz_padded_plane(rgb, mask, w, h, pad, val): i64 {
    var plane = _ascii_lum_plane(rgb, mask, w, h);
    if (plane == 0) { return 0; }
    var buf = alloc(w * h + 2 * pad);
    if (buf == 0) { return 0; }
    var i = 0;
    while (i < pad) { store8(buf + i, val); store8(buf + pad + w * h + i, val); i = i + 1; }
    memcpy(buf + pad, plane, w * h);
    return buf + pad;
}

# 1 if byte b is one of the table's glyphs.
fn _fz_is_glyph(b): i64 {
    var g = 0;
    while (g < ASCII_SHAPE_COUNT) {
        if (load64(&ASCII_SHAPE_GLYPHS + g * 8) == b) { return 1; }
        g = g + 1;
    }
    return 0;
}

# 1 if the row of `n` bytes ends in the reset + LF, and every byte outside an
# escape is a glyph.
fn _fz_ascii_row_ok(buf, n): i64 {
    if (n < 5) { return 0; }
    if (memeq(buf + n - 5, "\x1b[0m\n", 5) == 0) { return 0; }
    var i = 0;
    while (i < n - 5) {
        var b = load8(buf + i);
        if (b == 27) {
            while (i < n - 5 && load8(buf + i) != 109) { i = i + 1; }   # to the 'm'
        } else {
            if (_fz_is_glyph(b) == 0) { return 0; }
        }
        i = i + 1;
    }
    return 1;
}

fn fuzz_ascii_iter(rgb, mask, out_a, out_b): i64 {
    var tier = KII_TIER_8;
    var t4 = _fz_ascii_calls % 4;
    if (t4 == 1) { tier = KII_TIER_16; }
    if (t4 == 2) { tier = KII_TIER_256; }
    if (t4 == 3) { tier = KII_TIER_TC; }
    quant_set_tier(tier);
    _fz_ascii_calls = _fz_ascii_calls + 1;
    var cols = 1 + _fuzz_rand() % 32;
    var rows = 1 + _fuzz_rand() % 20;
    var w = cols * 2;
    var h = rows * 3;
    var i = 0;
    while (i < w * h * 3) { store8(rgb + i, _fuzz_rand() & 255); i = i + 1; }
    var m = 0;
    if (_fuzz_rand() % 2 == 1) {
        i = 0;
        while (i < w * h) { store8(mask + i, (_fuzz_rand() % 4) == 0); i = i + 1; }
        m = mask;
    }
    var pad = w * 4 + 8;
    var lum0 = _fz_padded_plane(rgb, m, w, h, pad, 0);
    var lum1 = _fz_padded_plane(rgb, m, w, h, pad, 255);
    if (lum0 == 0 || lum1 == 0) { return 0 - 1; }
    var bad = 0;
    var cy = 0;
    while (cy < rows) {
        var na = emit_ascii_shape_row_buf(rgb, m, lum0, 0, w, h, cy, cols, out_a, 0);
        var nb = emit_ascii_shape_row_buf(rgb, m, lum1, 0, w, h, cy, cols, out_b, 0);
        if (na <= 0 || na != nb) { bad = 1; }
        else {
            if (memeq(out_a, out_b, na) == 0) { bad = 1; }
            if (_fz_ascii_row_ok(out_a, na) == 0) { bad = 1; }
        }
        cy = cy + 1;
    }
    quant_set_tier(KII_TIER_16);
    alloc_reset();                     # the planes are per-iteration scratch
    crc32_table = 0;                   # as the decoder surfaces do after a reset
    if (bad != 0) { return 0 - 1; }
    return 0;
}

# One PNG-fuzz iteration. Builds a random byte buffer (optionally
# prefixed with a valid sig + IHDR), writes it to /tmp, drives
# kii_decode_image. Whatever the function returns is fine —
# the contract is "never crash". `scratch_buf` is caller-owned;
# `scratch_cap` is the buffer's capacity so we don't overflow.
fn fuzz_png_iter(scratch_buf, scratch_cap): i64 {
    # 50% of iters get the valid prefix; the rest are pure random.
    var off = 0;
    if (_fuzz_rand_range(2) == 0) {
        memcpy(scratch_buf, &_png_fuzz_prefix, 33);
        off = 33;
    }

    # Random payload length in [0, PNG_FUZZ_MAX_LEN].
    var payload = _fuzz_rand_range(PNG_FUZZ_MAX_LEN + 1);
    var max_fill = scratch_cap - off;
    if (payload > max_fill) { payload = max_fill; }
    var i = 0;
    while (i < payload) {
        store8(scratch_buf + off + i, _fuzz_rand() & 0xFF);
        i = i + 1;
    }
    var total = off + payload;

    # file_write_all uses O_TRUNC, so the file is fresh every iter.
    file_write_all("/tmp/kii-fuzz-png.bin", scratch_buf, total);

    # Drive the decode adapter. Result discarded — we only care about
    # not-crashing; any IMG_ERR_* return is fine. The adapter writes
    # PIXELS_BUF@72 and SRC_COLOR_TYPE@144, so pstruct must be ≥160 B.
    var pstruct[160];
    kii_decode_image("/tmp/kii-fuzz-png.bin", &pstruct);
    # Rewind the bump allocator: kii_decode_image slurps the file (and chitra
    # allocates per-decode), none of which crosses iterations. Without this
    # the never-free allocator grows ~1 KB/iter → ~1 GB over 10⁶ iters. Safe
    # here: the emit loop (the only cross-iter pstruct) has already finished
    # before the decode loops run, and the per-iter scratch is stack-local.
    # P-1 (v1.5.1): alloc_reset() alone SILENTLY VOIDED this surface.
    # sankoch caches its CRC-32 table as a lazy-init singleton holding a HEAP
    # pointer (`var crc32_table` in lib/sankoch.cyr, filled by
    # `crc32_init_table` when it is 0).
    # alloc_reset() rewinds the bump allocator underneath that pointer, so from
    # iteration 2 onward the cached table ALIASED live decode memory and the
    # decoder mis-parsed everything: a return-code tally showed 2999 of 3000
    # iterations dying at the signature check (IMG_ERR_UNRECOGNIZED) instead of
    # reaching the chunk walker, inflate, unfilter or the PLTE bounds. Clearing
    # the cache forces a re-init into the fresh heap and restores full coverage
    # — the tally with this line is byte-for-byte the same as with no reset at
    # all (1515 NOT_PNG from the 50%-random half / 1387 HEADER / 97 CHUNK /
    # 1 NO_IDAT), while the heap stays bounded.
    alloc_reset();
    crc32_table = 0;   # see above — MUST accompany every alloc_reset()
    return 0;
}

# One JPEG-fuzz iteration. Always prepends SOI (0xFFD8) so the byte stream
# sniffs as JPEG and routes through chitra's JPEG decoder, then appends a
# random payload. Random bytes after SOI fail in the marker/segment parser,
# but chitra's marker scan (`_chitra_jpeg_scan_markers` since chitra 1.2.0) can
# allocate its frame/quant/huff tables (up to ~22 KB) BEFORE that failure — so,
# like the PNG iter, this MUST rewind the never-free bump allocator each
# iteration or it grows ~22 KB/iter (~22 GB over 10⁶ iters → OOM).
# alloc_reset() below does that. Contract: kii_decode_image
# never crashes; returns IMG_OK or any IMG_ERR_* cleanly.
fn fuzz_jpeg_iter(scratch_buf, scratch_cap): i64 {
    store8(scratch_buf + 0, 0xFF);            # SOI marker high byte
    store8(scratch_buf + 1, 0xD8);            # SOI marker low byte
    var payload = _fuzz_rand_range(PNG_FUZZ_MAX_LEN + 1);
    var max_fill = scratch_cap - 2;
    if (payload > max_fill) { payload = max_fill; }
    var i = 0;
    while (i < payload) {
        store8(scratch_buf + 2 + i, _fuzz_rand() & 0xFF);
        i = i + 1;
    }
    file_write_all("/tmp/kii-fuzz-jpeg.bin", scratch_buf, 2 + payload);
    var pstruct[160];
    kii_decode_image("/tmp/kii-fuzz-jpeg.bin", &pstruct);
    alloc_reset();                            # bound the never-free heap (see above)
    crc32_table = 0;   # see above — MUST accompany every alloc_reset()
    return 0;
}

# One BMP-fuzz iteration (v1.5.0, chitra 1.0.0). Always prepends the "BM"
# signature so the byte stream sniffs as BMP and routes through chitra's BMP
# decoder, then appends a random payload — so the DIB-header parser, the
# palette bounds, the RLE walker and the BI_BITFIELDS mask validator all see
# arbitrary bytes. Same allocator discipline as the PNG/JPEG surfaces: a
# matched signature makes chitra allocate header/palette scratch before the
# parse fails, so rewind the bump allocator each iteration.
# Contract: kii_decode_image never crashes; returns IMG_OK or any IMG_ERR_*.
fn fuzz_bmp_iter(scratch_buf, scratch_cap): i64 {
    store8(scratch_buf + 0, 0x42);            # 'B'
    store8(scratch_buf + 1, 0x4D);            # 'M'
    var payload = _fuzz_rand_range(PNG_FUZZ_MAX_LEN + 1);
    var max_fill = scratch_cap - 2;
    if (payload > max_fill) { payload = max_fill; }
    var i = 0;
    while (i < payload) {
        store8(scratch_buf + 2 + i, _fuzz_rand() & 0xFF);
        i = i + 1;
    }
    file_write_all("/tmp/kii-fuzz-bmp.bin", scratch_buf, 2 + payload);
    var pstruct[160];
    kii_decode_image("/tmp/kii-fuzz-bmp.bin", &pstruct);
    alloc_reset();                            # bound the never-free heap
    crc32_table = 0;   # see above — MUST accompany every alloc_reset()
    return 0;
}

# One GIF-fuzz iteration (v1.5.0, chitra 1.0.0). Prepends the 6-byte
# "GIF89a" signature, then a random payload — so the logical-screen and
# image descriptors, the color-table bounds and the LZW dictionary chain all
# see arbitrary bytes. The LZW path is the interesting one: it builds a
# dictionary from attacker-controlled codes, which is the classic GIF
# decoder CVE surface. Same allocator rewind as the other decode surfaces.
# Contract: kii_decode_image never crashes; returns IMG_OK or any IMG_ERR_*.
fn fuzz_gif_iter(scratch_buf, scratch_cap): i64 {
    store8(scratch_buf + 0, 0x47);            # 'G'
    store8(scratch_buf + 1, 0x49);            # 'I'
    store8(scratch_buf + 2, 0x46);            # 'F'
    store8(scratch_buf + 3, 0x38);            # '8'
    store8(scratch_buf + 4, 0x39);            # '9'
    store8(scratch_buf + 5, 0x61);            # 'a'
    var payload = _fuzz_rand_range(PNG_FUZZ_MAX_LEN + 1);
    var max_fill = scratch_cap - 6;
    if (payload > max_fill) { payload = max_fill; }
    var i = 0;
    while (i < payload) {
        store8(scratch_buf + 6 + i, _fuzz_rand() & 0xFF);
        i = i + 1;
    }
    file_write_all("/tmp/kii-fuzz-gif.bin", scratch_buf, 6 + payload);
    var pstruct[160];
    kii_decode_image("/tmp/kii-fuzz-gif.bin", &pstruct);
    alloc_reset();                            # bound the never-free heap
    crc32_table = 0;   # see above — MUST accompany every alloc_reset()
    return 0;
}

# One fuzz iteration. `scratch` holds the raw bytes of all args
# packed back-to-back (each null-terminated). `argv_arr` holds
# pointers into `scratch`, one per arg. argv[0] is always "kii"
# — programs always have an argv[0] and the parser stores it as
# prog_name; absent argv[0] would test a never-real path.
fn fuzz_iter(scratch, argv_arr): i64 {
    # Reset argv[0] = "kii"
    store8(scratch + 0, 0x6B);               # 'k'
    store8(scratch + 1, 0x69);               # 'i'
    store8(scratch + 2, 0x69);               # 'i'
    store8(scratch + 3, 0);
    store64(argv_arr + 0, scratch + 0);
    var off = 4;
    var argc_val = 1 + _fuzz_rand_range(FUZZ_MAX_ARGC - 1);
    var i = 1;
    while (i < argc_val) {
        var arg_len = _fuzz_build_arg(scratch + off, FUZZ_MAX_ARG_LEN);
        store64(argv_arr + i * 8, scratch + off);
        off = off + arg_len + 1;             # +1 for the null
        i = i + 1;
    }

    # Drive kii's actual flag set. cmdit_new allocates from the
    # bump allocator per iter; that's fine — 10k × ~few KB stays
    # under 100 MB worst-case, well below the heap layout's brk
    # ceiling (~77 MB final per the cyrius README, but the bump
    # allocator grows on demand). The contract: return value is
    # CMDIT_OK / CMDIT_HELP / CMDIT_VERSION / CMDIT_RESULT_ERR; never crash.
    var fs = cmdit_new("kii");
    kii_register_flags(fs);
    cmdit_parse_argv(fs, argc_val, argv_arr);
    return 0;
}

fn main(): i64 {
    alloc_init();
    _png_fuzz_init_prefix();

    # ---- arg-parser fuzz loop --------------------------------------
    # Function-scope `var buf[N]` = N bytes. 1 KB scratch is well
    # over FUZZ_MAX_ARGC × (FUZZ_MAX_ARG_LEN + 1) = 8 × 25 = 200
    # bytes. argv_arr at 80 bytes = 10 slots, one more than
    # FUZZ_MAX_ARGC for header alignment.
    var scratch[1024];
    var argv_arr[80];

    var iter = 0;
    while (iter < FUZZ_ITERS) {
        fuzz_iter(&scratch, &argv_arr);
        iter = iter + 1;
    }

    # ---- M7(b) path-sanitizer fuzz loop ----------------------------
    # Pure-memory; fast. 10⁶ iters runs in ~1 s.
    var path_buf[256];
    var path_iter = 0;
    var path_bad  = 0;
    while (path_iter < PATH_FUZZ_ITERS) {
        if (fuzz_path_iter(&path_buf, 256) != 0) { path_bad = path_bad + 1; }
        path_iter = path_iter + 1;
    }

    # ---- M7(b) geometry fuzz loop ----------------------------------
    # Pure-memory; fast. 10⁶ iters runs in ~1 s. Exercises both M6
    # geometry helpers.
    var geom_iter = 0;
    var geom_bad  = 0;
    while (geom_iter < GEOM_FUZZ_ITERS) {
        if (fuzz_geom_iter() != 0) { geom_bad = geom_bad + 1; }
        geom_iter = geom_iter + 1;
    }

    # ---- M7(b) emit-pipeline fuzz loop -----------------------------
    # Decode RAMGON.png once (the repo-root fixture), then run the
    # M5 pipeline at randomized target dims per iter. If RAMGON is
    # missing, skip the loop with emit_iter = 0 — fuzz infra still
    # runs cleanly on a CI checkout that doesn't bundle the fixture.
    var emit_iter = 0;
    var emit_bad  = 0;
    var emit_pstr[160];
    if (kii_decode_image("tests/fixtures/RAMGON.png", &emit_pstr) == IMG_OK) {
        # ANSI escape can produce up to ~25 bytes per cell at
        # 200 cols; 8 KB scratch is well above worst-case.
        var emit_line[16384];
        while (emit_iter < EMIT_FUZZ_ITERS) {
            if (fuzz_emit_iter(&emit_pstr, &emit_line) != 0) {
                emit_bad = emit_bad + 1;
            }
            emit_iter = emit_iter + 1;
        }
    }

    # ---- png-decoder fuzz loop -------------------------------------
    # Scaled 2k → 10⁶ at M7(b). Larger scratch: prefix (33) + max
    # payload (1024) = 1057 bytes. 2 KB stack buf has plenty of
    # headroom.
    var png_scratch[2048];
    var png_iter = 0;
    while (png_iter < PNG_FUZZ_ITERS) {
        fuzz_png_iter(&png_scratch, 2048);
        png_iter = png_iter + 1;
    }

    # ---- jpeg-decoder fuzz loop ------------------------------------
    # SOI + random payload (2 + ≤1024 bytes) through the same adapter,
    # now routed to chitra's JPEG decoder by the format sniff. Reuses a
    # 2 KB scratch (SOI prefix is only 2 bytes vs PNG's 33).
    var jpeg_scratch[2048];
    var jpeg_iter = 0;
    while (jpeg_iter < JPEG_FUZZ_ITERS) {
        fuzz_jpeg_iter(&jpeg_scratch, 2048);
        jpeg_iter = jpeg_iter + 1;
    }

    # ---- bmp-decoder fuzz loop -------------------------------------
    # "BM" + random payload through the same adapter, routed to chitra's
    # BMP decoder by the format sniff (v1.5.0).
    var bmp_scratch[2048];
    var bmp_iter = 0;
    while (bmp_iter < BMP_FUZZ_ITERS) {
        fuzz_bmp_iter(&bmp_scratch, 2048);
        bmp_iter = bmp_iter + 1;
    }

    # ---- gif-decoder fuzz loop -------------------------------------
    # "GIF89a" + random payload, routed to chitra's GIF/LZW decoder
    # by the format sniff (v1.5.0).
    var gif_scratch[2048];
    var gif_iter = 0;
    while (gif_iter < GIF_FUZZ_ITERS) {
        fuzz_gif_iter(&gif_scratch, 2048);
        gif_iter = gif_iter + 1;
    }

    # ---- v1.6.0 surfaces --------------------------------------------
    # Run LAST so every surface above consumes exactly the random stream it
    # did through v1.5.2 (one shared LCG seed).
    var diff_buf[128];
    var diff_iter = 0;
    var diff_bad  = 0;
    while (diff_iter < PATH_DIFF_FUZZ_ITERS) {
        if (fuzz_path_diff_iter(&diff_buf, 120) != 0) { diff_bad = diff_bad + 1; }
        diff_iter = diff_iter + 1;
    }
    var env_iter = 0;
    var env_bad  = 0;
    while (env_iter < ENV_FUZZ_ITERS) {
        if (fuzz_envelope_iter() != 0) { env_bad = env_bad + 1; }
        env_iter = env_iter + 1;
    }
    # v1.10.0: the ASCII lane. Frames are at most 64 x 60 samples, so the
    # buffers hold 11,520 RGB bytes, 3,840 mask bytes, and a 32-cell row of
    # truecolour (20 bytes a cell + the row tail).
    var ascii_rgb[11520];
    var ascii_mask[3840];
    var ascii_out_a[1024];
    var ascii_out_b[1024];
    var ascii_iter = 0;
    var ascii_bad  = 0;
    while (ascii_iter < ASCII_FUZZ_ITERS) {
        if (fuzz_ascii_iter(&ascii_rgb, &ascii_mask, &ascii_out_a, &ascii_out_b) != 0) { ascii_bad = ascii_bad + 1; }
        ascii_iter = ascii_iter + 1;
    }

    # ---- report ----------------------------------------------------
    # fmt_printf takes a vec for varargs (per lib/fmt.cyr — vec_get
    # walks args by index). One line per fuzz surface; "fuzz: ok"
    # closes the human-readable log so CI greps see a clear sentinel.
    var args_arg = vec_new();
    vec_push(args_arg, iter);
    fmt_printf("fuzz: %d iterations passed (arg-parser crash-safety)\n", args_arg);

    var args_path = vec_new();
    vec_push(args_path, path_iter);
    vec_push(args_path, path_bad);
    fmt_printf("fuzz: %d iterations passed (path-sanitizer; bad=%d)\n", args_path);

    var args_geom = vec_new();
    vec_push(args_geom, geom_iter);
    vec_push(args_geom, geom_bad);
    fmt_printf("fuzz: %d iterations passed (geometry; bad=%d)\n", args_geom);

    var args_emit = vec_new();
    vec_push(args_emit, emit_iter);
    vec_push(args_emit, emit_bad);
    fmt_printf("fuzz: %d iterations passed (emit-pipeline; bad=%d)\n", args_emit);

    var args_png = vec_new();
    vec_push(args_png, png_iter);
    fmt_printf("fuzz: %d iterations passed (png-decoder crash-safety)\n", args_png);

    var args_jpeg = vec_new();
    vec_push(args_jpeg, jpeg_iter);
    fmt_printf("fuzz: %d iterations passed (jpeg-decoder crash-safety)\n", args_jpeg);

    var args_bmp = vec_new();
    vec_push(args_bmp, bmp_iter);
    fmt_printf("fuzz: %d iterations passed (bmp-decoder crash-safety)\n", args_bmp);

    var args_gif = vec_new();
    vec_push(args_gif, gif_iter);
    fmt_printf("fuzz: %d iterations passed (gif-decoder crash-safety)\n", args_gif);

    var args_diff = vec_new();
    vec_push(args_diff, diff_iter);
    vec_push(args_diff, diff_bad);
    vec_push(args_diff, _fz_diff_valid);
    vec_push(args_diff, _fz_diff_strict);
    fmt_printf("fuzz: %d iterations passed (path-sanitizer differential vs v1.5.2; bad=%d, both-accept=%d, strict-only=%d)\n", args_diff);

    var args_env = vec_new();
    vec_push(args_env, env_iter);
    vec_push(args_env, env_bad);
    fmt_printf("fuzz: %d iterations passed (terminal envelope; bad=%d)\n", args_env);

    var args_ascii = vec_new();
    vec_push(args_ascii, ascii_iter);
    vec_push(args_ascii, ascii_bad);
    fmt_printf("fuzz: %d iterations passed (ascii lane, pad differential; bad=%d)\n", args_ascii);

    # v1.6.0: a non-zero bad count FAILS the run. Through v1.5.2 the bad
    # tallies were printed and the harness still said "fuzz: ok" and exited
    # 0, so CI's `./build/kii-fuzz` step could not go red on a contract
    # violation — only on a crash.
    if (path_bad + geom_bad + emit_bad + diff_bad + env_bad + ascii_bad != 0) {
        println("fuzz: FAIL");
        return 1;
    }
    println("fuzz: ok");
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
