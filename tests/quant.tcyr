# kii — palette + quantization tests (standalone).
#
# Post-PNG-re-fold split of the old monolithic tests/kii.tcyr. Covers
# M4(a) the 16-color ANSI palette, M4(b) the scalar nearest-RGB
# quantizer, and M5(c) the decoupled quantize_rgb_buf / quantize_downscaled
# surface. No PNG decode here — the downscaled-buffer cases are wired
# with hand-built RGB buffers so this file stays off the chitra path.
#
# Stdlib auto-resolves from cyrius.cyml; only project modules + the
# assert harness are included explicitly.

include "src/palette.cyr"
include "src/quant.cyr"
include "src/image.cyr"
include "lib/assert.cyr"

# The pre-v1.6.4 quantize_nearest_rgb body, kept here as the reference the
# optimized one is checked against.
fn _ref_nearest(r, g, b, tier): i64 {
    var best_idx = 0;
    var dr = r - palette_r(0);
    var dg = g - palette_g(0);
    var db = b - palette_b(0);
    var best_d2 = dr * dr + dg * dg + db * db;
    var i = 1;
    while (i < tier) {
        dr = r - palette_r(i);
        dg = g - palette_g(i);
        db = b - palette_b(i);
        var d2 = dr * dr + dg * dg + db * db;
        if (d2 < best_d2) { best_d2 = d2; best_idx = i; }
        i = i + 1;
    }
    return best_idx;
}

# A full scan of xterm-256 indices 16-255 in index order, strict-<: the
# reference quantize_256 must match.
fn _ref_256_rgb(i, which): i64 {
    if (i >= 232) { return 8 + 10 * (i - 232); }
    var c = i - 16;
    var lv = 0;
    if (which == 0) { lv = c / 36; }
    if (which == 1) { lv = (c / 6) % 6; }
    if (which == 2) { lv = c % 6; }
    if (lv == 0) { return 0; }
    return 55 + 40 * lv;
}

fn _ref_256(r, g, b): i64 {
    var best = 16;
    var best_d = 0 - 1;
    var i = 16;
    while (i <= 255) {
        var dr = r - _ref_256_rgb(i, 0);
        var dg = g - _ref_256_rgb(i, 1);
        var db = b - _ref_256_rgb(i, 2);
        var d = dr * dr + dg * dg + db * db;
        if (best_d < 0 || d < best_d) { best_d = d; best = i; }
        i = i + 1;
    }
    return best;
}

fn main() {
    alloc_init();

    # ---- M4(a) — 16-color ANSI palette ----------------------------
    # Canonical Linux-console table. Each entry's RGB triple is
    # pinned here so any drift (typo in palette_init, off-by-one
    # in indexing) regresses against the well-known constants.
    # Source values: https://en.wikipedia.org/wiki/ANSI_escape_code#3-bit_and_4-bit
    test_group("M4(a) — palette size + lazy init");
    assert_eq(ANSI_PALETTE_SIZE, 16, "16-color palette");
    # Lazy-init: read a color before any explicit palette_init().
    # palette_r/g/b should still return the correct values.
    assert_eq(palette_r(0), 0, "entry 0 (black) R = 0 (lazy-init works)");

    test_group("M4(a) — palette entries 0–7 (normal)");
    # 0: black (0, 0, 0)
    assert_eq(palette_r(0), 0, "entry 0 (black) R = 0");
    assert_eq(palette_g(0), 0, "entry 0 (black) G = 0");
    assert_eq(palette_b(0), 0, "entry 0 (black) B = 0");
    # 1: red (170, 0, 0)
    assert_eq(palette_r(1), 170, "entry 1 (red) R = 170");
    assert_eq(palette_g(1),   0, "entry 1 (red) G = 0");
    assert_eq(palette_b(1),   0, "entry 1 (red) B = 0");
    # 2: green (0, 170, 0)
    assert_eq(palette_r(2),   0, "entry 2 (green) R = 0");
    assert_eq(palette_g(2), 170, "entry 2 (green) G = 170");
    assert_eq(palette_b(2),   0, "entry 2 (green) B = 0");
    # 3: yellow/brown (170, 85, 0)
    assert_eq(palette_r(3), 170, "entry 3 (yellow/brown) R = 170");
    assert_eq(palette_g(3),  85, "entry 3 (yellow/brown) G = 85");
    assert_eq(palette_b(3),   0, "entry 3 (yellow/brown) B = 0");
    # 4: blue (0, 0, 170)
    assert_eq(palette_r(4),   0, "entry 4 (blue) R = 0");
    assert_eq(palette_g(4),   0, "entry 4 (blue) G = 0");
    assert_eq(palette_b(4), 170, "entry 4 (blue) B = 170");
    # 5: magenta (170, 0, 170)
    assert_eq(palette_r(5), 170, "entry 5 (magenta) R = 170");
    assert_eq(palette_g(5),   0, "entry 5 (magenta) G = 0");
    assert_eq(palette_b(5), 170, "entry 5 (magenta) B = 170");
    # 6: cyan (0, 170, 170)
    assert_eq(palette_r(6),   0, "entry 6 (cyan) R = 0");
    assert_eq(palette_g(6), 170, "entry 6 (cyan) G = 170");
    assert_eq(palette_b(6), 170, "entry 6 (cyan) B = 170");
    # 7: white / light gray (170, 170, 170)
    assert_eq(palette_r(7), 170, "entry 7 (white / light gray) R = 170");
    assert_eq(palette_g(7), 170, "entry 7 (white / light gray) G = 170");
    assert_eq(palette_b(7), 170, "entry 7 (white / light gray) B = 170");

    test_group("M4(a) — palette entries 8–15 (bright)");
    # 8: bright black / dark gray (85, 85, 85)
    assert_eq(palette_r(8), 85, "entry 8 (bright black / dark gray) R = 85");
    assert_eq(palette_g(8), 85, "entry 8 (bright black / dark gray) G = 85");
    assert_eq(palette_b(8), 85, "entry 8 (bright black / dark gray) B = 85");
    # 9: bright red (255, 85, 85)
    assert_eq(palette_r(9), 255, "entry 9 (bright red) R = 255");
    assert_eq(palette_g(9),  85, "entry 9 (bright red) G = 85");
    assert_eq(palette_b(9),  85, "entry 9 (bright red) B = 85");
    # 10: bright green (85, 255, 85)
    assert_eq(palette_r(10),  85, "entry 10 (bright green) R = 85");
    assert_eq(palette_g(10), 255, "entry 10 (bright green) G = 255");
    assert_eq(palette_b(10),  85, "entry 10 (bright green) B = 85");
    # 11: bright yellow (255, 255, 85)
    assert_eq(palette_r(11), 255, "entry 11 (bright yellow) R = 255");
    assert_eq(palette_g(11), 255, "entry 11 (bright yellow) G = 255");
    assert_eq(palette_b(11),  85, "entry 11 (bright yellow) B = 85");
    # 12: bright blue (85, 85, 255)
    assert_eq(palette_r(12),  85, "entry 12 (bright blue) R = 85");
    assert_eq(palette_g(12),  85, "entry 12 (bright blue) G = 85");
    assert_eq(palette_b(12), 255, "entry 12 (bright blue) B = 255");
    # 13: bright magenta (255, 85, 255)
    assert_eq(palette_r(13), 255, "entry 13 (bright magenta) R = 255");
    assert_eq(palette_g(13),  85, "entry 13 (bright magenta) G = 85");
    assert_eq(palette_b(13), 255, "entry 13 (bright magenta) B = 255");
    # 14: bright cyan (85, 255, 255)
    assert_eq(palette_r(14),  85, "entry 14 (bright cyan) R = 85");
    assert_eq(palette_g(14), 255, "entry 14 (bright cyan) G = 255");
    assert_eq(palette_b(14), 255, "entry 14 (bright cyan) B = 255");
    # 15: bright white (255, 255, 255)
    assert_eq(palette_r(15), 255, "entry 15 (bright white) R = 255");
    assert_eq(palette_g(15), 255, "entry 15 (bright white) G = 255");
    assert_eq(palette_b(15), 255, "entry 15 (bright white) B = 255");

    test_group("M4(a) — palette bounds (every byte ≤ 255)");
    # Defensive — guard against accidentally writing > 0xFF
    # (Cyrius store8 truncates, but a typo like 1700 would still
    # be wrong even after truncation).
    var pi = 0;
    var all_bounded = 1;
    while (pi < 16) {
        if (palette_r(pi) < 0 || palette_r(pi) > 255) { all_bounded = 0; }
        if (palette_g(pi) < 0 || palette_g(pi) > 255) { all_bounded = 0; }
        if (palette_b(pi) < 0 || palette_b(pi) > 255) { all_bounded = 0; }
        pi = pi + 1;
    }
    assert_eq(all_bounded, 1, "every palette byte ∈ [0, 255]");

    # ---- M4(b) — quantize_nearest_rgb (scalar) --------------------
    # Acceptance criteria per docs/development/roadmap.md M4:
    #   pure-red → 1, pure-blue → 4, white → 15, black → 0.
    # Plus the natural extensions to green / yellow / cyan / magenta.
    # Arithmetic sanity (for the curious): pure-red (255,0,0) vs
    # entry 1 (170,0,0) gives dist² = 85² = 7225; vs entry 9
    # (255,85,85) gives 0 + 85² + 85² = 14450. Entry 1 wins.
    test_group("M4(b) — quantize_nearest_rgb canonical pixels");
    assert_eq(quantize_nearest_rgb(255, 0,   0  ), 1,  "pure red → 1 (red)");
    assert_eq(quantize_nearest_rgb(0,   0,   255), 4,  "pure blue → 4 (blue)");
    assert_eq(quantize_nearest_rgb(255, 255, 255), 15, "pure white → 15 (bright white)");
    assert_eq(quantize_nearest_rgb(0,   0,   0  ), 0,  "pure black → 0 (black)");
    assert_eq(quantize_nearest_rgb(0,   255, 0  ), 2,  "pure green → 2 (green)");
    assert_eq(quantize_nearest_rgb(255, 255, 0  ), 11, "pure yellow → 11 (bright yellow)");
    assert_eq(quantize_nearest_rgb(0,   255, 255), 14, "pure cyan → 14 (bright cyan)");
    assert_eq(quantize_nearest_rgb(255, 0,   255), 13, "pure magenta → 13 (bright magenta)");

    test_group("M4(b) — each palette entry round-trips to its own index");
    # Every palette entry's exact RGB should map back to its own
    # index. Ties broken by lowest index, so identical entries
    # would map to the first occurrence — but we know the table
    # has 16 distinct colors so this is a clean round-trip.
    var qi = 0;
    while (qi < 16) {
        var rt = quantize_nearest_rgb(palette_r(qi), palette_g(qi), palette_b(qi));
        assert_eq(rt, qi, "palette entry round-trips");
        qi = qi + 1;
    }

    test_group("M4(b) — brightness gradient maps to monotonic luminance");
    # The 16-color palette isn't sorted by luminance (entry 8 is
    # dark gray, entry 7 is light gray — bigger index doesn't
    # mean brighter). So the gradient acceptance criterion is
    # phrased at the LUMINANCE level: as input brightness rises
    # the quantized entry's brightness rises (non-decreasing).
    var idx_black = quantize_nearest_rgb(0,   0,   0  );
    var idx_dark  = quantize_nearest_rgb(50,  50,  50 );
    var idx_mid   = quantize_nearest_rgb(128, 128, 128);
    var idx_light = quantize_nearest_rgb(200, 200, 200);
    var idx_white = quantize_nearest_rgb(255, 255, 255);
    assert_eq(idx_black, 0,  "(0,0,0) → 0 (black)");
    assert_eq(idx_dark,  8,  "(50,50,50) → 8 (dark gray)");
    assert_eq(idx_mid,   7,  "(128,128,128) → 7 (light gray)");
    assert_eq(idx_light, 7,  "(200,200,200) → 7 (light gray)");
    assert_eq(idx_white, 15, "(255,255,255) → 15 (bright white)");
    # Luminance check: sum of RGB for each chosen entry must
    # be non-decreasing across the gradient. This is the actual
    # "monotone-vary" property the acceptance criterion calls for.
    var lum_black = palette_r(idx_black) + palette_g(idx_black) + palette_b(idx_black);
    var lum_dark  = palette_r(idx_dark)  + palette_g(idx_dark)  + palette_b(idx_dark);
    var lum_mid   = palette_r(idx_mid)   + palette_g(idx_mid)   + palette_b(idx_mid);
    var lum_light = palette_r(idx_light) + palette_g(idx_light) + palette_b(idx_light);
    var lum_white = palette_r(idx_white) + palette_g(idx_white) + palette_b(idx_white);
    assert(lum_black <= lum_dark,  "luminance non-decreasing: black ≤ dark");
    assert(lum_dark  <= lum_mid,   "luminance non-decreasing: dark ≤ mid");
    assert(lum_mid   <= lum_light, "luminance non-decreasing: mid ≤ light");
    assert(lum_light <= lum_white, "luminance non-decreasing: light ≤ white");

    # v1.6.4 (P(-1) O-1): quantize_nearest_rgb reads the packed palette
    # directly and inlines the distance. It must pick exactly what the old
    # accessor-based body picked, at both tiers. The reference below IS that
    # old body (palette_r/g/b + squared distance + strict-< tie-break); the
    # grid steps 17 per channel, so it covers 0 and 255 and every palette
    # level (0, 85, 170, 255) plus the midpoints between them.
    test_group("v1.6.4 — quantize_nearest_rgb matches the reference body");
    var tier = 8;
    while (tier <= 16) {
        quant_set_tier(tier);
        var mism = 0;
        var gr = 0;
        while (gr <= 255) {
            var gg = 0;
            while (gg <= 255) {
                var gb = 0;
                while (gb <= 255) {
                    if (quantize_nearest_rgb(gr, gg, gb) != _ref_nearest(gr, gg, gb, tier)) { mism = mism + 1; }
                    gb = gb + 17;
                }
                gg = gg + 17;
            }
            gr = gr + 17;
        }
        assert_eq(mism, 0, "4,096 grid colours: no mismatch against the reference body");
        tier = tier + 8;
    }
    quant_set_tier(16);

    # ---- M5(c) — quantize_rgb_buf (pure RGB → palette idx) --------
    # The new lower-level quantizer, decoupled from PNG / pstruct.
    # Same canonical color → index expectations as M4(b)'s scalar
    # surface: red→1, blue→4, white→15, black→0.
    test_group("M5(c) — quantize_rgb_buf (pure RGB → palette idx)");
    var rgb_4[12];
    store8(&rgb_4 + 0, 255); store8(&rgb_4 + 1, 0);   store8(&rgb_4 + 2, 0);    # red
    store8(&rgb_4 + 3, 0);   store8(&rgb_4 + 4, 0);   store8(&rgb_4 + 5, 255);  # blue
    store8(&rgb_4 + 6, 0);   store8(&rgb_4 + 7, 0);   store8(&rgb_4 + 8, 0);    # black
    store8(&rgb_4 + 9, 255); store8(&rgb_4 + 10, 255); store8(&rgb_4 + 11, 255); # white
    var idx_4[16];        # 4 codes × 4 bytes (v1.8.0: 32-bit colour codes)
    assert_eq(quantize_rgb_buf(&rgb_4, 0, 4, &idx_4), 0,  "quantize_rgb_buf → 0");
    assert_eq(load32(&idx_4 + 0),  1,  "rgb_buf[0] red → idx 1");
    assert_eq(load32(&idx_4 + 4),  4,  "rgb_buf[1] blue → idx 4");
    assert_eq(load32(&idx_4 + 8),  0,  "rgb_buf[2] black → idx 0");
    assert_eq(load32(&idx_4 + 12), 15, "rgb_buf[3] white → idx 15");
    # v1.8.0: a mask byte of 1 makes that pixel KII_COLOR_DEFAULT.
    var mask_4[4];
    store8(&mask_4 + 0, 0); store8(&mask_4 + 1, 1); store8(&mask_4 + 2, 0); store8(&mask_4 + 3, 1);
    quantize_rgb_buf(&rgb_4, &mask_4, 4, &idx_4);
    assert_eq(load32(&idx_4 + 0),  1, "unmasked red stays idx 1");
    assert_eq(load32(&idx_4 + 4),  KII_COLOR_DEFAULT, "masked blue → KII_COLOR_DEFAULT");
    assert_eq(load32(&idx_4 + 12), KII_COLOR_DEFAULT, "masked white → KII_COLOR_DEFAULT");

    # ---- M5(c) — quantize_downscaled wraps quantize_rgb_buf --------
    # Post-re-fold rewire: the original drove this through a decoded
    # PNG + downscale_to_rgb. quantize_downscaled only reads the
    # STRUCT_DOWNSCALED_* slots, so we populate them directly with a
    # hand-built 2x2 packed-RGB buffer (red / blue / black / white) —
    # no decoder and no downscale dependency. Indices are verified to
    # keep the canonical-color coverage the original relied on.
    test_group("M5(c) — quantize_downscaled wraps quantize_rgb_buf");
    var pstr_qd[160];
    var dbuf_qd[12];
    store8(&dbuf_qd + 0, 255); store8(&dbuf_qd + 1, 0);   store8(&dbuf_qd + 2, 0);    # red
    store8(&dbuf_qd + 3, 0);   store8(&dbuf_qd + 4, 0);   store8(&dbuf_qd + 5, 255);  # blue
    store8(&dbuf_qd + 6, 0);   store8(&dbuf_qd + 7, 0);   store8(&dbuf_qd + 8, 0);    # black
    store8(&dbuf_qd + 9, 255); store8(&dbuf_qd + 10, 255); store8(&dbuf_qd + 11, 255); # white
    store64(&pstr_qd + STRUCT_DOWNSCALED_BUF_OFFSET, &dbuf_qd);
    store64(&pstr_qd + STRUCT_DOWNSCALED_W_OFFSET, 2);
    store64(&pstr_qd + STRUCT_DOWNSCALED_H_OFFSET, 2);
    assert_eq(quantize_downscaled(&pstr_qd), 0, "quantize_downscaled → 0");
    assert_eq(load64(&pstr_qd + STRUCT_QUANTIZED_SIZE_OFFSET), 4, "quantized size = 4 (2 × 2)");
    var qd_out = load64(&pstr_qd + STRUCT_QUANTIZED_BUF_OFFSET);
    assert(qd_out != 0, "quantized buffer non-null");
    assert_eq(load32(qd_out + 0),  1,  "qd[0] red → 1");
    assert_eq(load32(qd_out + 4),  4,  "qd[1] blue → 4");
    assert_eq(load32(qd_out + 8),  0,  "qd[2] black → 0");
    assert_eq(load32(qd_out + 12), 15, "qd[3] white → 15");
    # Reject ungated calls (downscale not yet run).
    var pstr_qun[160];
    store64(&pstr_qun + STRUCT_DOWNSCALED_BUF_OFFSET, 0);
    assert_eq(quantize_downscaled(&pstr_qun), 0 - 1,
      "quantize_downscaled rejects DOWNSCALED_BUF == 0");

    # ---- P-1 (v1.5.1): the --color tier is actually consumed --------
    # Until 1.5.1 `--color 8` was parsed, range-validated, then dropped —
    # `kii --color 8` emitted output byte-identical to `--color 16`.
    test_group("P-1 (v1.5.1) — quant tier: setter contract");
    assert_eq(quant_tier(), 16, "default tier is 16");
    assert_eq(quant_set_tier(8),  8,  "set 8 → 8");
    assert_eq(quant_tier(),       8,  "tier now 8");
    assert_eq(quant_set_tier(16), 16, "set 16 → 16");
    assert_eq(quant_tier(),       16, "tier back to 16");
    # v1.8.0: 256 and KII_TIER_TC (24) are tiers too.
    assert_eq(quant_set_tier(256), 256, "set 256 → 256");
    assert_eq(quant_set_tier(KII_TIER_TC), 24, "set truecolour → 24");
    assert_eq(quant_set_tier(16), 16, "back to 16");
    # Any other value must be IGNORED, never widen the loop past the
    # palette table — the guard that keeps a bad tier from reading OOB.
    assert_eq(quant_set_tier(0),    16, "0 ignored → stays 16");
    assert_eq(quant_set_tier(9999), 16, "9999 ignored → stays 16");
    assert_eq(quant_set_tier(0 - 1),16, "negative ignored → stays 16");
    assert_eq(quant_tier(),         16, "tier unchanged after bad sets");

    test_group("P-1 (v1.5.1) — quant tier: 8 restricts to the low half");
    # The bright entries (8..15) must be unreachable at tier 8. Bright white
    # (255,255,255) is entry 15 at tier 16 and must fall back to entry 7
    # (170,170,170), the nearest normal-intensity colour.
    assert_eq(quantize_nearest_rgb(255, 255, 255), 15, "tier 16: pure white → 15");
    quant_set_tier(8);
    assert_eq(quantize_nearest_rgb(255, 255, 255),  7, "tier 8: pure white → 7 (bright half excluded)");
    # These two land on entry 3 (yellow/brown, 170,85,0), not on the
    # "obvious" hue — worth pinning precisely because it is counter-intuitive.
    # Bright red (255,85,85): vs entry 1 (170,0,0) = 85²+85²+85² = 21675, but
    # vs entry 3 (170,85,0) = 85²+0+85² = 14450, because entry 3 already
    # carries the G=85 the colour has. Entry 3 wins.
    assert_eq(quantize_nearest_rgb(255,  85,  85),  3, "tier 8: bright red → 3 (yellow/brown is nearer than red)");
    # Bright green (85,255,85): entry 2 (0,170,0) and entry 6 (0,170,170) tie
    # at 21675; the loop's strict `<` keeps the lower index.
    assert_eq(quantize_nearest_rgb( 85, 255,  85),  2, "tier 8: bright green → 2 (ties resolve to lowest index)");
    # Dark grey (85,85,85): vs entry 0 (0,0,0) = 21675, vs entry 3 = 14450.
    assert_eq(quantize_nearest_rgb( 85,  85,  85),  3, "tier 8: dark grey → 3 (not black)");
    # Every tier-8 result must be in [0,7] across the whole RGB cube corners.
    var tier8_ok = 1;
    var tc = 0;
    while (tc < 8) {
        var cr = 0; if (tc & 1 != 0) { cr = 255; }
        var cg = 0; if (tc & 2 != 0) { cg = 255; }
        var cb = 0; if (tc & 4 != 0) { cb = 255; }
        var qi = quantize_nearest_rgb(cr, cg, cb);
        if (qi < 0 || qi > 7) { tier8_ok = 0; }
        tc = tc + 1;
    }
    assert_eq(tier8_ok, 1, "tier 8: every cube corner quantizes into [0,7]");
    # Restore the default so later groups (and any future additions) see 16.
    quant_set_tier(16);
    assert_eq(quantize_nearest_rgb(255, 255, 255), 15, "tier restored: white → 15 again");

    # ---- v1.8.0 — tier 256: the xterm cube and grey ramp ----------
    # quantize_256 finds the nearest of indices 16-255 without scanning them.
    # The reference below scans all 240 in index order with strict-<, the
    # rule the fast form claims to match, on a grid that steps 15 per channel
    # (18^3 = 5,832 colours, covering 0, 255 and every cube level's
    # neighbourhood) plus every grey 0-255.
    test_group("v1.8.0 — quantize_256 matches a full scan of indices 16-255");
    var m256 = 0;
    var tr = 0;
    while (tr <= 255) {
        var tg = 0;
        while (tg <= 255) {
            var tb = 0;
            while (tb <= 255) {
                if (quantize_256(tr, tg, tb) != _ref_256(tr, tg, tb)) { m256 = m256 + 1; }
                tb = tb + 15;
            }
            tg = tg + 15;
        }
        tr = tr + 15;
    }
    assert_eq(m256, 0, "5,832 grid colours: no mismatch against the full scan");
    var mg = 0;
    var gv = 0;
    while (gv <= 255) {
        if (quantize_256(gv, gv, gv) != _ref_256(gv, gv, gv)) { mg = mg + 1; }
        gv = gv + 1;
    }
    assert_eq(mg, 0, "all 256 greys: no mismatch against the full scan");
    assert_eq(quantize_256(255, 0, 0), 196, "pure red → 196");
    assert_eq(quantize_256(0, 0, 0), 16, "black → 16 (the cube's 0,0,0 before grey 232)");
    assert_eq(quantize_256(255, 255, 255), 231, "white → 231 (cube 255,255,255)");
    assert_eq(quantize_256(128, 128, 128), 244, "mid grey → 244 (grey 128)");
    assert_eq(quantize_256(115, 115, 115), 243, "115 grey → 243 (grey 118, nearer than cube 95 or 135)");

    test_group("v1.8.0 — kii_color_code at each tier");
    quant_set_tier(16);
    assert_eq(kii_color_code(255, 0, 0), 1, "tier 16: red → 1");
    quant_set_tier(256);
    assert_eq(kii_color_code(255, 0, 0), 196, "tier 256: red → 196");
    quant_set_tier(KII_TIER_TC);
    assert_eq(kii_color_code(255, 128, 1), 16744449, "tc: (255,128,1) → 0xFF8001");
    assert_eq(kii_color_code(0, 0, 0), 0, "tc: black → 0");
    assert(KII_COLOR_DEFAULT > 16777215, "the transparent sentinel is outside every tier's codes");
    quant_set_tier(16);

    return assert_summary();
}

var exit_code = main();
syscall(SYS_EXIT, exit_code);
