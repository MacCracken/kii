# kii — render-pipeline tests (standalone).
#
# Post-PNG-re-fold split of the old monolithic tests/kii.tcyr. Covers
# M5(b) the nearest-neighbor downscaler, M5(c) the half-block ANSI
# emit, and M6(a)/M6(b) the aspect-preserving geometry math.
#
# The downscale cases that the old suite populated via the native
# decoder are rewired here: post-flip every decoded image is a depth-8
# color_type=6 (RGBA8) buffer, so each pstruct is built MANUALLY as a
# ct6 image whose RGB samples match the original fixture's pixels. The
# asserted RGB outputs are therefore identical (downscale's ct6
# drop-alpha branch reads exactly R/G/B). The single real-decode case
# (RAMGON) goes through the chitra adapter via kii_decode_image.
#
# Stdlib + the darshana dist auto-resolve from cyrius.cyml.

include "src/image.cyr"
include "src/downscale.cyr"
include "src/quant.cyr"
include "src/emit.cyr"
include "lib/assert.cyr"

# 1 if the `n` bytes at `buf` are exactly the cstring `expect` — a whole
# emitted row checked in one assertion (v1.8.0).
fn _row_is(buf, n, expect): i64 {
    if (n != strlen(expect)) { return 0; }
    return memeq(buf, expect, n);
}

# The number of cells in one emitted half-block row of `n` bytes: each space
# and each 3-byte Block Element (E2 96 xx) outside an escape is a cell, up to
# the LF. -1 on any other byte. (v2.1.0: a row's cells are ▀ ▄ █ or spaces.)
fn _hb_cells(buf, n): i64 {
    var i = 0;
    var cells = 0;
    while (i < n) {
        var b = load8(buf + i);
        if (b == 10) { return cells; }
        if (b == 27) {
            i = i + 1;
            while (i < n && load8(buf + i) != 109) { i = i + 1; }    # to the 'm'
            i = i + 1;
        } else {
            if (b == 32) { cells = cells + 1; i = i + 1; }
            else {
                if (b != 0xE2 || i + 2 >= n || load8(buf + i + 1) != 0x96) { return 0 - 1; }
                cells = cells + 1;
                i = i + 3;
            }
        }
    }
    return 0 - 1;
}

# Emit a one-row frame of two cells, (t0 over b0) and (t1 over b1), into
# `line`; returns the length (v2.1.0 tests).
fn _hb_row2(q, line, t0, t1, b0, b1): i64 {
    store32(q + 0, t0); store32(q + 4, t1); store32(q + 8, b0); store32(q + 12, b1);
    return emit_halfblock_row_buf(q, 2, 0, line, 0);
}

# Store `n` 32-bit colour codes from the i64 array `codes` into `q`.
fn _put_codes(q, codes, n): i64 {
    var i = 0;
    while (i < n) { store32(q + i * 4, load64(codes + i * 8)); i = i + 1; }
    return 0;
}

# Build a 2x2 depth-8 color_type=6 (RGBA8) image into `pstruct`,
# matching the RGB pixels of the old /tmp/kii-test-decode-2x2.png
# fixture (alpha = 255). downscale's ct6 drop-alpha branch yields the
# same RGB the original M5(b) tests asserted, so expected outputs are
# unchanged. Returns 0.
fn _r_make_2x2(pstruct): i64 {
    var buf = alloc(16);   # 2 × 2 × 4 RGBA8
    # (0,0) = (100,101,102), (1,0) = (103,104,105)
    store8(buf + 0,  100); store8(buf + 1,  101); store8(buf + 2,  102); store8(buf + 3,  255);
    store8(buf + 4,  103); store8(buf + 5,  104); store8(buf + 6,  105); store8(buf + 7,  255);
    # (0,1) = (110,111,112), (1,1) = (113,114,115)
    store8(buf + 8,  110); store8(buf + 9,  111); store8(buf + 10, 112); store8(buf + 11, 255);
    store8(buf + 12, 113); store8(buf + 13, 114); store8(buf + 14, 115); store8(buf + 15, 255);
    store64(pstruct + STRUCT_WIDTH_OFFSET,       2);
    store64(pstruct + STRUCT_HEIGHT_OFFSET,      2);
    store64(pstruct + STRUCT_BIT_DEPTH_OFFSET,   8);
    store64(pstruct + STRUCT_COLOR_TYPE_OFFSET,  6);
    store64(pstruct + STRUCT_PIXELS_BUF_OFFSET,  buf);
    store64(pstruct + STRUCT_PIXELS_SIZE_OFFSET, 2 * 2 * 4);
    return 0;
}

# A 10x1 RGBA8 row into `buf` (40 bytes): black, but white at x = `hot`.
fn _ar_row(buf, hot): i64 {
    var x = 0;
    while (x < 10) {
        var v = 0;
        if (x == hot) { v = 255; }
        store8(buf + x * 4, v); store8(buf + x * 4 + 1, v);
        store8(buf + x * 4 + 2, v); store8(buf + x * 4 + 3, 255);
        x = x + 1;
    }
    return 0;
}

# The background composer kii carried from v0.6.0 to v1.5.2, kept here
# VERBATIM (minus its comments) as the reference for the v1.6.0 swap to
# darshana's `tty_bg_256_buf`. Test-only: nothing in src/ calls it.
fn _ref_bg_256_buf_v152(buf, pos, n) {
    if (n < 0 || n > 255) { return 0 - 1; }
    if (pos < 0) { return 0 - 1; }
    store8(buf + pos, 27);  pos = pos + 1;
    store8(buf + pos, 91);  pos = pos + 1;
    store8(buf + pos, 52);  pos = pos + 1;
    store8(buf + pos, 56);  pos = pos + 1;
    store8(buf + pos, 59);  pos = pos + 1;
    store8(buf + pos, 53);  pos = pos + 1;
    store8(buf + pos, 59);  pos = pos + 1;
    if (n >= 100) {
        store8(buf + pos, 48 + n / 100);          pos = pos + 1;
        store8(buf + pos, 48 + (n / 10) % 10);    pos = pos + 1;
        store8(buf + pos, 48 + n % 10);           pos = pos + 1;
    } else { if (n >= 10) {
            store8(buf + pos, 48 + n / 10);           pos = pos + 1;
            store8(buf + pos, 48 + n % 10);           pos = pos + 1;
        } else {
            store8(buf + pos, 48 + n);                pos = pos + 1;
        } }
    store8(buf + pos, 109); pos = pos + 1;
    return pos;
}

fn main() {
    alloc_init();

    # ============================================================
    # ----------------- M5(b) downscale_to_rgb -------------------
    # ============================================================
    test_group("M5(b) — downscale identity (2x2 → 2x2 RGB)");
    # Manual ct6 source matching the old 2x2 RGB fixture. Identity
    # downscale must be byte-identical to the RGB of STRUCT_PIXELS_BUF.
    var pstr_d_id[160];
    _r_make_2x2(&pstr_d_id);
    assert_eq(downscale_to_rgb(&pstr_d_id, 2, 2), 0, "2x2 → 2x2 downscale_to_rgb → 0");
    assert_eq(load64(&pstr_d_id + STRUCT_DOWNSCALED_W_OFFSET), 2, "identity dst_w = 2");
    assert_eq(load64(&pstr_d_id + STRUCT_DOWNSCALED_H_OFFSET), 2, "identity dst_h = 2");
    var d_id_buf = load64(&pstr_d_id + STRUCT_DOWNSCALED_BUF_OFFSET);
    assert(d_id_buf != 0, "identity dst buf non-null");
    assert_eq(load8(d_id_buf + 0),  100, "identity pixel 0 R = 100");
    assert_eq(load8(d_id_buf + 1),  101, "identity pixel 0 G = 101");
    assert_eq(load8(d_id_buf + 2),  102, "identity pixel 0 B = 102");
    assert_eq(load8(d_id_buf + 3),  103, "identity pixel 1 R = 103");
    assert_eq(load8(d_id_buf + 11), 115, "identity pixel 3 B = 115");

    test_group("M5(b) — downscale upscale (2x2 → 4x4, nearest replicates)");
    # Nearest-neighbor upscale: each source pixel covers a 2x2 dst
    # block. dx in [0,2) → sx=0, dx in [2,4) → sx=1. Same for dy.
    var pstr_d_up[160];
    _r_make_2x2(&pstr_d_up);
    assert_eq(downscale_to_rgb(&pstr_d_up, 4, 4), 0, "2x2 → 4x4 upscale → 0");
    assert_eq(load64(&pstr_d_up + STRUCT_DOWNSCALED_W_OFFSET), 4, "upscale dst_w = 4");
    assert_eq(load64(&pstr_d_up + STRUCT_DOWNSCALED_H_OFFSET), 4, "upscale dst_h = 4");
    var d_up_buf = load64(&pstr_d_up + STRUCT_DOWNSCALED_BUF_OFFSET);
    assert(d_up_buf != 0, "upscale dst buf non-null");
    # dst (0,0) → src (0,0) = (100,101,102).
    assert_eq(load8(d_up_buf + (0 * 4 + 0) * 3 + 0), 100, "upscale (0,0) R = src (0,0).R = 100");
    # dst (1,0) → sx = (1*2)/4 = 0; src (0,0).
    assert_eq(load8(d_up_buf + (0 * 4 + 1) * 3 + 0), 100, "upscale (1,0) R = src (0,0).R = 100");
    # dst (2,0) → sx = (2*2)/4 = 1; src (1,0) = (103,104,105).
    assert_eq(load8(d_up_buf + (0 * 4 + 2) * 3 + 0), 103, "upscale (2,0) R = src (1,0).R = 103");
    # dst (3,0) → sx = (3*2)/4 = 1; src (1,0).
    assert_eq(load8(d_up_buf + (0 * 4 + 3) * 3 + 0), 103, "upscale (3,0) R = src (1,0).R = 103");
    # dst (0,2) → sy = (2*2)/4 = 1; src (0,1) = (110,111,112).
    assert_eq(load8(d_up_buf + (2 * 4 + 0) * 3 + 0), 110, "upscale (0,2) R = src (0,1).R = 110");
    # dst (3,3) → src (1,1) = (113,114,115).
    assert_eq(load8(d_up_buf + (3 * 4 + 3) * 3 + 2), 115, "upscale (3,3) B = src (1,1).B = 115");

    test_group("v1.9.0 — downscale shrink (2x2 → 1x1) samples the span's centre");
    # Pixel-centre sampling: sx = ((2·0 + 1)·2) / (2·1) = 1, sy = 1, so the
    # 1x1 output is src (1,1) = (113, 114, 115). Through v1.8.0 the formula
    # took the span's start and this was src (0,0) = (100, 101, 102).
    var pstr_d_sh[160];
    _r_make_2x2(&pstr_d_sh);
    assert_eq(downscale_to_rgb(&pstr_d_sh, 1, 1), 0, "2x2 → 1x1 shrink → 0");
    var d_sh_buf = load64(&pstr_d_sh + STRUCT_DOWNSCALED_BUF_OFFSET);
    assert_eq(load8(d_sh_buf + 0), 113, "shrink 1x1 R = src (1,1).R = 113");
    assert_eq(load8(d_sh_buf + 1), 114, "shrink 1x1 G = src (1,1).G = 114");
    assert_eq(load8(d_sh_buf + 2), 115, "shrink 1x1 B = src (1,1).B = 115");

    test_group("v1.9.0 — pixel-centre sampling across a row (C-7)");
    # A 10-pixel row whose pixel i has R = i, downscaled to widths 1, 2, 5 and
    # 10: each output pixel takes the source pixel at its span's centre.
    var pstr_c[160];
    var cbuf[40];
    var cx = 0;
    while (cx < 10) {
        store8(&cbuf + cx * 4, cx); store8(&cbuf + cx * 4 + 1, 0);
        store8(&cbuf + cx * 4 + 2, 0); store8(&cbuf + cx * 4 + 3, 255);
        cx = cx + 1;
    }
    var cz = 0;
    while (cz < 160) { store64(&pstr_c + cz, 0); cz = cz + 8; }
    store64(&pstr_c + STRUCT_WIDTH_OFFSET, 10);
    store64(&pstr_c + STRUCT_HEIGHT_OFFSET, 1);
    store64(&pstr_c + STRUCT_BIT_DEPTH_OFFSET, 8);
    store64(&pstr_c + STRUCT_COLOR_TYPE_OFFSET, 6);
    store64(&pstr_c + STRUCT_PIXELS_BUF_OFFSET, &cbuf);
    store64(&pstr_c + STRUCT_PIXELS_SIZE_OFFSET, 40);
    downscale_to_rgb(&pstr_c, 1, 1);
    var cd = load64(&pstr_c + STRUCT_DOWNSCALED_BUF_OFFSET);
    assert_eq(load8(cd), 5, "10 → 1: the centre pixel 5 (was pixel 0)");
    downscale_to_rgb(&pstr_c, 2, 1);
    cd = load64(&pstr_c + STRUCT_DOWNSCALED_BUF_OFFSET);
    assert_eq(load8(cd) * 10 + load8(cd + 3), 27, "10 → 2: pixels 2 and 7 (was 0 and 5)");
    downscale_to_rgb(&pstr_c, 5, 1);
    cd = load64(&pstr_c + STRUCT_DOWNSCALED_BUF_OFFSET);
    var picks = 0;
    cx = 0;
    while (cx < 5) { picks = picks * 10 + load8(cd + cx * 3); cx = cx + 1; }
    assert_eq(picks, 13579, "10 → 5: pixels 1 3 5 7 9 — the last column is reached (was 0 2 4 6 8)");
    downscale_to_rgb(&pstr_c, 10, 1);
    cd = load64(&pstr_c + STRUCT_DOWNSCALED_BUF_OFFSET);
    var ident = 1;
    cx = 0;
    while (cx < 10) { if (load8(cd + cx * 3) != cx) { ident = 0; } cx = cx + 1; }
    assert_eq(ident, 1, "10 → 10: the identity is unchanged");

    test_group("M5(b) — downscale ct6 drops alpha (RGBA → RGB extraction)");
    # Post-flip the live decode path is always ct6; the per-color_type
    # normalization the old suite checked against a palette PNG is now
    # purely the ct6 drop-alpha extraction. Pin it: a 1x1 RGBA pixel
    # with a non-trivial alpha must yield exactly R/G/B, never alpha.
    var pstr_d_a[160];
    var abuf[4];
    store8(&abuf + 0, 12); store8(&abuf + 1, 34); store8(&abuf + 2, 56); store8(&abuf + 3, 200);
    store64(&pstr_d_a + STRUCT_WIDTH_OFFSET,       1);
    store64(&pstr_d_a + STRUCT_HEIGHT_OFFSET,      1);
    store64(&pstr_d_a + STRUCT_BIT_DEPTH_OFFSET,   8);
    store64(&pstr_d_a + STRUCT_COLOR_TYPE_OFFSET,  6);
    store64(&pstr_d_a + STRUCT_PIXELS_BUF_OFFSET,  &abuf);
    store64(&pstr_d_a + STRUCT_PIXELS_SIZE_OFFSET, 4);
    assert_eq(downscale_to_rgb(&pstr_d_a, 1, 1), 0, "1x1 ct6 downscale → 0");
    var d_a_buf = load64(&pstr_d_a + STRUCT_DOWNSCALED_BUF_OFFSET);
    # P(-1) (v1.6.4): alpha is composited over black, (c * a + 127) / 255,
    # where it used to be dropped (12/34/56 came through at alpha 200).
    assert_eq(load8(d_a_buf + 0),  9, "ct6 R composited over black (12 at alpha 200 → 9)");
    assert_eq(load8(d_a_buf + 1), 27, "ct6 G composited over black (34 → 27)");
    assert_eq(load8(d_a_buf + 2), 44, "ct6 B composited over black (56 → 44)");

    test_group("v1.6.4 — alpha composites over black; opaque pixels are untouched");
    # The C-2 repair. A fully transparent pixel used to render its hidden RGB:
    # a GIF's transparent index is alpha 0 with its palette colour kept, so a
    # magenta transparent entry drew magenta. Now alpha 0 is black, alpha 255
    # is exactly the stored colour (so opaque images stay byte-identical).
    var pstr_d_t[160];
    var tbuf[16];
    store8(&tbuf + 0, 255); store8(&tbuf + 1, 0);   store8(&tbuf + 2, 255); store8(&tbuf + 3, 0);
    store8(&tbuf + 4, 255); store8(&tbuf + 5, 255); store8(&tbuf + 6, 255); store8(&tbuf + 7, 0);
    store8(&tbuf + 8, 200); store8(&tbuf + 9, 100); store8(&tbuf + 10, 7);  store8(&tbuf + 11, 255);
    store8(&tbuf + 12, 255); store8(&tbuf + 13, 255); store8(&tbuf + 14, 255); store8(&tbuf + 15, 128);
    var ts = 0;
    while (ts < 160) { store64(&pstr_d_t + ts, 0); ts = ts + 8; }
    store64(&pstr_d_t + STRUCT_WIDTH_OFFSET,       4);
    store64(&pstr_d_t + STRUCT_HEIGHT_OFFSET,      1);
    store64(&pstr_d_t + STRUCT_BIT_DEPTH_OFFSET,   8);
    store64(&pstr_d_t + STRUCT_COLOR_TYPE_OFFSET,  6);
    store64(&pstr_d_t + STRUCT_PIXELS_BUF_OFFSET,  &tbuf);
    store64(&pstr_d_t + STRUCT_PIXELS_SIZE_OFFSET, 16);
    assert_eq(downscale_to_rgb(&pstr_d_t, 4, 1), 0, "1x4 ct6 downscale → 0");
    var d_t = load64(&pstr_d_t + STRUCT_DOWNSCALED_BUF_OFFSET);
    assert_eq(load8(d_t + 0) + load8(d_t + 1) + load8(d_t + 2), 0, "magenta at alpha 0 → black");
    assert_eq(load8(d_t + 3) + load8(d_t + 4) + load8(d_t + 5), 0, "white at alpha 0 → black");
    assert_eq(load8(d_t + 6), 200, "opaque R untouched");
    assert_eq(load8(d_t + 7), 100, "opaque G untouched");
    assert_eq(load8(d_t + 8),   7, "opaque B untouched");
    assert_eq(load8(d_t + 9), 128, "white at alpha 128 → 128 (rounded)");
    # v1.8.0: alpha below KII_ALPHA_THRESHOLD (128) is transparent, and the
    # mask says which pixels; alpha 128 and up is opaque (partial alpha is
    # still composited over black, as above).
    var d_m = load64(&pstr_d_t + STRUCT_ALPHA_MASK_OFFSET);
    assert(d_m != 0, "a transparent pixel sets the mask slot");
    assert_eq(load8(d_m + 0), 1, "alpha 0 → mask 1");
    assert_eq(load8(d_m + 1), 1, "alpha 0 → mask 1 (second)");
    assert_eq(load8(d_m + 2), 0, "alpha 255 → mask 0");
    assert_eq(load8(d_m + 3), 0, "alpha 128 → mask 0 (at the threshold is opaque)");
    store8(&tbuf + 15, 127);
    assert_eq(downscale_to_rgb(&pstr_d_t, 4, 1), 0, "re-downscale with alpha 127 → 0");
    d_m = load64(&pstr_d_t + STRUCT_ALPHA_MASK_OFFSET);
    assert_eq(load8(d_m + 3), 1, "alpha 127 → mask 1 (below the threshold)");
    store8(&tbuf + 15, 128);
    var pstr_d_o[160];
    _r_make_2x2(&pstr_d_o);
    store64(&pstr_d_o + STRUCT_ALPHA_MASK_OFFSET, 0 - 1);
    assert_eq(downscale_to_rgb(&pstr_d_o, 2, 2), 0, "opaque 2x2 downscale → 0");
    assert_eq(load64(&pstr_d_o + STRUCT_ALPHA_MASK_OFFSET), 0, "an opaque image leaves the mask slot 0");

    # v1.7.0 (R-2): downscale accepts only chitra's RGBA8. The colour-type
    # dispatch it used to carry handled formats nothing has produced since
    # the v1.2.0 re-fold; it is gone, and anything but RGBA8 is refused.
    test_group("v1.7.0 — downscale accepts RGBA8 only");
    store64(&pstr_d_t + STRUCT_COLOR_TYPE_OFFSET, 2);
    assert_eq(downscale_to_rgb(&pstr_d_t, 4, 1), 0 - 1, "colour type 2 (RGB) → -1");
    store64(&pstr_d_t + STRUCT_COLOR_TYPE_OFFSET, 6);
    store64(&pstr_d_t + STRUCT_BIT_DEPTH_OFFSET, 16);
    assert_eq(downscale_to_rgb(&pstr_d_t, 4, 1), 0 - 1, "bit depth 16 → -1");
    store64(&pstr_d_t + STRUCT_BIT_DEPTH_OFFSET, 8);
    store64(&pstr_d_t + STRUCT_PIXELS_SIZE_OFFSET, 15);
    assert_eq(downscale_to_rgb(&pstr_d_t, 4, 1), 0 - 1, "a buffer one byte short of 4x1x4 → -1");
    store64(&pstr_d_t + STRUCT_PIXELS_SIZE_OFFSET, 16);
    assert_eq(downscale_to_rgb(&pstr_d_t, 4, 1), 0, "restored to RGBA8 4x1 → 0");

    test_group("M5(b) — downscale rejects ungated calls + bad dims");
    # Ungated: pixels_buf == 0 (no decode run) → -1.
    var pstr_d_un[160];
    store64(&pstr_d_un + STRUCT_WIDTH_OFFSET,       2);
    store64(&pstr_d_un + STRUCT_HEIGHT_OFFSET,      2);
    store64(&pstr_d_un + STRUCT_BIT_DEPTH_OFFSET,   8);
    store64(&pstr_d_un + STRUCT_COLOR_TYPE_OFFSET,  6);
    store64(&pstr_d_un + STRUCT_PIXELS_BUF_OFFSET,  0);
    assert_eq(downscale_to_rgb(&pstr_d_un, 4, 4), 0 - 1,
      "pixels_buf == 0 → -1 (ungated call)");
    # Bad dims are rejected before pstruct is even read; a populated
    # ct6 source confirms the dim guard, not a decode failure.
    var pstr_d_bd[160];
    _r_make_2x2(&pstr_d_bd);
    assert_eq(downscale_to_rgb(&pstr_d_bd, 0, 4), 0 - 1, "dst_w = 0 → -1");
    assert_eq(downscale_to_rgb(&pstr_d_bd, 4, 0), 0 - 1, "dst_h = 0 → -1");
    assert_eq(downscale_to_rgb(&pstr_d_bd, 0 - 1, 4), 0 - 1, "dst_w < 0 → -1");

    test_group("M5(b) — downscale to M5 emit size (80x48) — RAMGON.png");
    # The natural M5 target: a real-world RGBA → 80x48 packed RGB
    # buffer through the chitra adapter. Asserts non-null buf, correct
    # dimensions, expected byte count (80 × 48 × 3 = 11,520).
    var pstr_d_ram[160];
    assert_eq(kii_decode_image("tests/fixtures/RAMGON.png", &pstr_d_ram), IMG_OK,
      "RAMGON.png → IMG_OK (kii_decode_image)");
    assert_eq(downscale_to_rgb(&pstr_d_ram, 80, 48), 0,
      "RAMGON 1152x925 → 80x48 downscale → 0");
    assert_eq(load64(&pstr_d_ram + STRUCT_DOWNSCALED_W_OFFSET), 80,  "RAMGON dst_w = 80");
    assert_eq(load64(&pstr_d_ram + STRUCT_DOWNSCALED_H_OFFSET), 48,  "RAMGON dst_h = 48");
    var d_ram_buf = load64(&pstr_d_ram + STRUCT_DOWNSCALED_BUF_OFFSET);
    assert(d_ram_buf != 0, "RAMGON 80x48 buf non-null");
    # Sanity: at least one of the 11,520 bytes is non-zero (RAMGON
    # is a richly-colored fixture, not all-black).
    var d_ram_nonzero = 0;
    var ram_i = 0;
    while (ram_i < 11520) {
        if (load8(d_ram_buf + ram_i) != 0) {
            d_ram_nonzero = 1;
            ram_i = 11520;       # short-circuit
        } else {
            ram_i = ram_i + 1;
        }
    }
    assert_eq(d_ram_nonzero, 1, "RAMGON 80x48 downscaled buf has non-zero pixels");

    # ----------------- v1.4.0 JPEG render e2e -------------------
    # Proves a JPEG (not just PNG) flows through the WHOLE shared back of the
    # pipeline — decode → downscale → quantize → emit — and produces real ANSI
    # bytes, not just a populated pstruct. The emit layer is format-blind
    # (operates on the quantized index buffer), so the JPEG-specific risk is in
    # feeding chitra's JPEG RGBA8 through downscale+quantize; this exercises it.
    # gradient.jpg is the 16x16 grayscale horizontal ramp (white left → black
    # right), so the first char-row's first cell quantizes light, last dark.
    test_group("v1.4.0 — JPEG render e2e (gradient.jpg → downscale → quantize → emit)");
    var pstr_jr[160];
    assert_eq(kii_decode_image("tests/fixtures/gradient.jpg", &pstr_jr), IMG_OK,
      "gradient.jpg → IMG_OK");
    assert_eq(downscale_to_rgb(&pstr_jr, 16, 8), 0, "JPEG 16x16 → 16x8 downscale → 0");
    assert_eq(load64(&pstr_jr + STRUCT_DOWNSCALED_W_OFFSET), 16, "JPEG dst_w = 16");
    assert_eq(quantize_downscaled(&pstr_jr), 0, "JPEG quantize_downscaled → 0");
    var jr_qbuf = load64(&pstr_jr + STRUCT_QUANTIZED_BUF_OFFSET);
    assert(jr_qbuf != 0, "JPEG quantized buf non-null");
    # Emit the first char-row (2 source rows) of the 16-wide image to a buffer.
    var jr_line[1024];
    var jr_pos = emit_halfblock_row_buf(jr_qbuf, 16, 0, &jr_line, 0);
    assert(jr_pos > 16, "JPEG emit produced a real row (> 1 byte/cell)");
    assert_eq(load8(&jr_line + 0), 27, "JPEG emit row starts with ESC (SGR)");
    # It draws all 16 cells, not just escapes. (Until v2.1.0 this looked for a ▀;
    # a one-colour cell is now a space or █.)
    assert_eq(_hb_cells(&jr_line, jr_pos), 16, "JPEG emit row draws 16 cells");

    # v1.5.0 — the same e2e for the two formats chitra 1.0.0 brought in. The
    # point is that decode → downscale → quantize → emit needed NO change to
    # absorb them: both arrive as canonical RGBA8 and take the identical ct6
    # path PNG and JPEG already took. If a future chitra re-pin altered that
    # normalization, these break here rather than in a user's terminal.
    test_group("v1.5.0 — BMP render e2e (gradient.bmp → downscale → quantize → emit)");
    var pstr_br[160];
    assert_eq(kii_decode_image("tests/fixtures/gradient.bmp", &pstr_br), IMG_OK,
      "gradient.bmp → IMG_OK");
    assert_eq(load64(&pstr_br + STRUCT_COLOR_TYPE_OFFSET), 6, "BMP normalized to ct6");
    assert_eq(downscale_to_rgb(&pstr_br, 16, 8), 0, "BMP 16x16 → 16x8 downscale → 0");
    assert_eq(load64(&pstr_br + STRUCT_DOWNSCALED_W_OFFSET), 16, "BMP dst_w = 16");
    assert_eq(quantize_downscaled(&pstr_br), 0, "BMP quantize_downscaled → 0");
    var br_qbuf = load64(&pstr_br + STRUCT_QUANTIZED_BUF_OFFSET);
    assert(br_qbuf != 0, "BMP quantized buf non-null");
    var br_line[1024];
    var br_pos = emit_halfblock_row_buf(br_qbuf, 16, 0, &br_line, 0);
    assert(br_pos > 16, "BMP emit produced a real row (> 1 byte/cell)");
    assert_eq(load8(&br_line + 0), 27, "BMP emit row starts with ESC (SGR)");
    # It draws all 16 cells, not just escapes. (Until v2.1.0 this looked for a ▀;
    # a one-colour cell is now a space or █.)
    assert_eq(_hb_cells(&br_line, br_pos), 16, "BMP emit row draws 16 cells");

    test_group("v1.5.0 — GIF render e2e (color.gif → downscale → quantize → emit)");
    var pstr_gr[160];
    assert_eq(kii_decode_image("tests/fixtures/color.gif", &pstr_gr), IMG_OK,
      "color.gif → IMG_OK");
    assert_eq(load64(&pstr_gr + STRUCT_COLOR_TYPE_OFFSET), 6, "GIF normalized to ct6");
    assert_eq(downscale_to_rgb(&pstr_gr, 16, 8), 0, "GIF 16x16 → 16x8 downscale → 0");
    assert_eq(quantize_downscaled(&pstr_gr), 0, "GIF quantize_downscaled → 0");
    var gr_qbuf = load64(&pstr_gr + STRUCT_QUANTIZED_BUF_OFFSET);
    assert(gr_qbuf != 0, "GIF quantized buf non-null");
    # The fixture's top-left quadrant is pure red and its top-right pure lime,
    # so the quantizer must land on the palette's red and green — a real
    # content check, not just "something rendered". Note these resolve to the
    # NORMAL entries (1 red = 170,0,0 / 2 green = 0,170,0), not the bright
    # ones: nearest-RGB puts pure (255,0,0) at distance 85² from entry 1 but
    # 85²+85² from entry 9 (255,85,85), because the bright entries lift the
    # two OTHER channels off zero. Same arithmetic for lime.
    assert_eq(load32(gr_qbuf + 0),      1, "GIF (0,0) quantizes to red (idx 1)");
    assert_eq(load32(gr_qbuf + 15 * 4), 2, "GIF (15,0) quantizes to green (idx 2)");
    var gr_line[1024];
    var gr_pos = emit_halfblock_row_buf(gr_qbuf, 16, 0, &gr_line, 0);
    assert(gr_pos > 16, "GIF emit produced a real row (> 1 byte/cell)");
    assert_eq(load8(&gr_line + 0), 27, "GIF emit row starts with ESC (SGR)");
    # It draws all 16 cells, not just escapes. (Until v2.1.0 this looked for a ▀;
    # a one-colour cell is now a space or █.)
    assert_eq(_hb_cells(&gr_line, gr_pos), 16, "GIF emit row draws 16 cells");

    # ============================================================
    # ----------------- M5(c) emit_halfblock ---------------------
    # ============================================================
    # ---- P-1 (v1.5.1) hardening regressions ------------------------
    test_group("P-1 (v1.5.1) — downscale_to_rgb refuses an overflowing size");
    # `out_bytes = dst_w * dst_h * 3` is a 64-bit product on caller-supplied
    # geometry. A width above ~2.5e9 WRAPS it to a small positive value, which
    # alloc() accepts (its own guards only catch <= 0 and > ALLOC_MAX) — and
    # the resample loop then writes far past the tiny buffer. Reproduced as a
    # real SIGSEGV before this guard: `kii --width 4611686018427387902` on a
    # 1x1 PNG wrapped to a 12-byte allocation and dumped core on BOTH lanes.
    var pstr_ov[160];
    assert_eq(kii_decode_image("tests/fixtures/gradient.bmp", &pstr_ov), IMG_OK,
      "overflow fixture decodes");
    # 2^62 - 2: (2^62-2)^2 * 3 wraps to exactly 12 mod 2^64.
    assert_eq(downscale_to_rgb(&pstr_ov, 4611686018427387902, 4611686018427387902), 0 - 1,
      "wrapping dst_w*dst_h*3 → -1, not a 12-byte alloc");
    assert_eq(downscale_to_rgb(&pstr_ov, 9223372036854775807, 2), 0 - 1,
      "i64-max width → -1");
    assert_eq(downscale_to_rgb(&pstr_ov, 2, 9223372036854775807), 0 - 1,
      "i64-max height → -1");
    # The guard must not reject anything alloc would have honoured: a real
    # geometry still succeeds.
    assert_eq(downscale_to_rgb(&pstr_ov, 16, 8), 0, "ordinary geometry still succeeds");

    test_group("v1.11.0 — downscale_area_to_rgb: each sample is its span's mean");
    # A 10x1 row, black but for one white pixel at x = `ax_hot`: the thin line
    # the point sampler misses. _ar_row rebuilds it.
    var pstr_ar[160];
    var arbuf[40];
    var az = 0;
    while (az < 160) { store64(&pstr_ar + az, 0); az = az + 8; }
    store64(&pstr_ar + STRUCT_WIDTH_OFFSET, 10);
    store64(&pstr_ar + STRUCT_HEIGHT_OFFSET, 1);
    store64(&pstr_ar + STRUCT_BIT_DEPTH_OFFSET, 8);
    store64(&pstr_ar + STRUCT_COLOR_TYPE_OFFSET, 6);
    store64(&pstr_ar + STRUCT_PIXELS_BUF_OFFSET, &arbuf);
    store64(&pstr_ar + STRUCT_PIXELS_SIZE_OFFSET, 40);
    _ar_row(&arbuf, 3);
    # Point: 10 -> 2 samples pixels 2 and 7, both black.
    assert_eq(downscale_to_rgb(&pstr_ar, 2, 1), 0, "point 10 -> 2 -> 0");
    var ad = load64(&pstr_ar + STRUCT_DOWNSCALED_BUF_OFFSET);
    assert_eq(load8(ad) + load8(ad + 3), 0, "point 10 -> 2: the white pixel is missed");
    # Area, exact (every span at most KII_AREA_TAPS = 4 pixels): 10 -> 3 has
    # spans [0, 3), [3, 7), [7, 10) by pixel centre.
    assert_eq(downscale_area_to_rgb(&pstr_ar, 3, 1), 0, "area 10 -> 3 -> 0");
    ad = load64(&pstr_ar + STRUCT_DOWNSCALED_BUF_OFFSET);
    var al = load64(&pstr_ar + STRUCT_LUMA_PLANE_OFFSET);
    assert_eq(load8(ad) * 1000 + load8(ad + 3) * 10 + load8(ad + 6), 640,
      "area 10 -> 3: 0, then 255 / 4 rounded, then 0");
    assert_eq(load8(al + 1), 63, "area 10 -> 3: the luma plane holds 255 / 4, floored");
    assert_eq(load64(&pstr_ar + STRUCT_ALPHA_MASK_OFFSET), 0, "opaque row: no mask");
    # Area, sampled: a 10-pixel span takes 4 taps, at pixels 1, 3, 6 and 8.
    assert_eq(downscale_area_to_rgb(&pstr_ar, 1, 1), 0, "area 10 -> 1 -> 0");
    ad = load64(&pstr_ar + STRUCT_DOWNSCALED_BUF_OFFSET);
    assert_eq(load8(ad), 64, "area 10 -> 1: the tap on pixel 3 counts, 255 / 4");
    # ...so a one-pixel line can still fall between taps once a span is longer
    # than KII_AREA_TAPS. Pinned so a change to the tap spacing is seen.
    _ar_row(&arbuf, 4);
    downscale_area_to_rgb(&pstr_ar, 1, 1);
    ad = load64(&pstr_ar + STRUCT_DOWNSCALED_BUF_OFFSET);
    assert_eq(load8(ad), 0, "area 10 -> 1: pixel 4 lies between the taps");
    # No reduction on either axis: downscale_to_rgb's bytes, and no plane (emit
    # builds it from the samples).
    var pstr_ai[160];
    var pstr_pi[160];
    _r_make_2x2(&pstr_ai);
    _r_make_2x2(&pstr_pi);
    var ai_ok = 1;
    var aw = 1;
    while (aw <= 4) {
        assert_eq(downscale_area_to_rgb(&pstr_ai, aw * 2, aw * 2), 0, "area 2x2 -> 2k x 2k -> 0");
        downscale_to_rgb(&pstr_pi, aw * 2, aw * 2);
        if (memeq(load64(&pstr_ai + STRUCT_DOWNSCALED_BUF_OFFSET),
                  load64(&pstr_pi + STRUCT_DOWNSCALED_BUF_OFFSET), aw * aw * 12) == 0) { ai_ok = 0; }
        if (load64(&pstr_ai + STRUCT_LUMA_PLANE_OFFSET) != 0) { ai_ok = 0; }
        aw = aw + 1;
    }
    assert_eq(ai_ok, 1, "area == point at the identity and 2x, 3x, 4x upscales");
    # One axis reduced, one not: 2x2 -> 1x2 averages each row's two pixels.
    assert_eq(downscale_area_to_rgb(&pstr_ai, 1, 2), 0, "area 2x2 -> 1x2 -> 0");
    ad = load64(&pstr_ai + STRUCT_DOWNSCALED_BUF_OFFSET);
    al = load64(&pstr_ai + STRUCT_LUMA_PLANE_OFFSET);
    assert_eq(load8(ad) * 1000 + load8(ad + 3), 102112, "area 2x2 -> 1x2: R (100+103)/2, (110+113)/2 rounded");
    assert_eq(load8(al), (54 * 203 + 183 * 205 + 19 * 207) / 512, "area 2x2 -> 1x2: the luma of the row's sums");
    # Transparency. A 4x1 row: white, then three transparent pixels.
    var pstr_at[160];
    var atbuf[16];
    az = 0;
    while (az < 16) { store8(&atbuf + az, 0); az = az + 1; }
    store8(&atbuf, 255); store8(&atbuf + 1, 255); store8(&atbuf + 2, 255); store8(&atbuf + 3, 255);
    az = 0;
    while (az < 160) { store64(&pstr_at + az, 0); az = az + 8; }
    store64(&pstr_at + STRUCT_WIDTH_OFFSET, 4);
    store64(&pstr_at + STRUCT_HEIGHT_OFFSET, 1);
    store64(&pstr_at + STRUCT_BIT_DEPTH_OFFSET, 8);
    store64(&pstr_at + STRUCT_COLOR_TYPE_OFFSET, 6);
    store64(&pstr_at + STRUCT_PIXELS_BUF_OFFSET, &atbuf);
    store64(&pstr_at + STRUCT_PIXELS_SIZE_OFFSET, 16);
    assert_eq(downscale_area_to_rgb(&pstr_at, 1, 1), 0, "area 4 -> 1 with alpha -> 0");
    ad = load64(&pstr_at + STRUCT_DOWNSCALED_BUF_OFFSET);
    al = load64(&pstr_at + STRUCT_LUMA_PLANE_OFFSET);
    assert_eq(load8(ad), 255, "one opaque pixel of four: the colour is that pixel's");
    assert_eq(load8(al), 63, "one opaque pixel of four: luma 255 / 4, floored");
    assert_eq(load64(&pstr_at + STRUCT_ALPHA_MASK_OFFSET), 0, "a span with an opaque pixel is opaque");
    assert_eq(downscale_area_to_rgb(&pstr_at, 2, 1), 0, "area 4 -> 2 with alpha -> 0");
    var am = load64(&pstr_at + STRUCT_ALPHA_MASK_OFFSET);
    al = load64(&pstr_at + STRUCT_LUMA_PLANE_OFFSET);
    assert(am != 0, "an all-transparent span sets the mask");
    assert_eq(load8(am) * 10 + load8(am + 1), 1, "mask: [0, 2) opaque, [2, 4) transparent");
    assert_eq(load8(al) * 1000 + load8(al + 1), 127000, "luma: 255 / 2 floored, then 0");
    store8(&atbuf + 3, 200);
    downscale_area_to_rgb(&pstr_at, 1, 1);
    ad = load64(&pstr_at + STRUCT_DOWNSCALED_BUF_OFFSET);
    assert_eq(load8(ad), 200, "partial alpha composites over black, as downscale_to_rgb");
    # A point downscale after an area one clears the plane the area one left.
    downscale_to_rgb(&pstr_at, 2, 1);
    assert_eq(load64(&pstr_at + STRUCT_LUMA_PLANE_OFFSET), 0, "downscale_to_rgb clears a stale plane");
    assert_eq(downscale_area_to_rgb(&pstr_at, 0, 1), 0 - 1, "dst_w = 0 -> -1");
    assert_eq(downscale_area_to_rgb(&pstr_ov, 4611686018427387902, 4611686018427387902), 0 - 1,
      "area: wrapping dst_w*dst_h*3 -> -1");

    # v2.2.0: --invert. The plane holds each opaque pixel's negative, and
    # partial alpha composites over white. pstr_at is still the 4x1 row: pixel
    # 0 white at alpha 200, pixels 1-3 transparent.
    test_group("v2.2.0 — --invert: dark is ink, and partial alpha sits on white");
    assert_eq(downscale_set_invert(2), 0, "only 1 turns --invert on");
    assert_eq(downscale_set_invert(1), 1, "1 turns it on");
    assert_eq(downscale_invert(), 1, "and it reads back");
    downscale_area_to_rgb(&pstr_at, 1, 1);
    ad = load64(&pstr_at + STRUCT_DOWNSCALED_BUF_OFFSET);
    al = load64(&pstr_at + STRUCT_LUMA_PLANE_OFFSET);
    assert_eq(load8(ad), 255, "white at alpha 200 over white stays white");
    assert_eq(load8(al), 0, "white has no ink when dark is ink");
    store8(&atbuf, 0); store8(&atbuf + 1, 0); store8(&atbuf + 2, 0);
    downscale_area_to_rgb(&pstr_at, 1, 1);
    ad = load64(&pstr_at + STRUCT_DOWNSCALED_BUF_OFFSET);
    al = load64(&pstr_at + STRUCT_LUMA_PLANE_OFFSET);
    assert_eq(load8(ad), 55, "black at alpha 200 over white → 255 - 200");
    assert_eq(load8(al), (65280 - 55 * 256) / 1024, "its ink: the negative's luma, over 4 taps (50)");
    assert_eq(downscale_to_rgb(&pstr_at, 4, 1), 0, "inverted point downscale → 0");
    ad = load64(&pstr_at + STRUCT_DOWNSCALED_BUF_OFFSET);
    assert_eq(load8(ad) * 1000 + load8(ad + 3), 55000, "the point sampler composites over white too");
    store8(&atbuf + 3, 255);
    downscale_area_to_rgb(&pstr_at, 1, 1);
    al = load64(&pstr_at + STRUCT_LUMA_PLANE_OFFSET);
    assert_eq(load8(al), 63, "opaque black: full ink, over 4 taps (255 / 4)");
    downscale_area_to_rgb(&pstr_at, 2, 1);
    am = load64(&pstr_at + STRUCT_ALPHA_MASK_OFFSET);
    assert_eq(load8(am) * 10 + load8(am + 1), 1, "the mask is the same: transparent is no ink either way");
    downscale_area_to_rgb(&pstr_ai, 1, 2);
    ad = load64(&pstr_ai + STRUCT_DOWNSCALED_BUF_OFFSET);
    al = load64(&pstr_ai + STRUCT_LUMA_PLANE_OFFSET);
    assert_eq(load8(ad) * 1000 + load8(ad + 3), 102112, "an opaque image keeps its colours");
    assert_eq(load8(al), (2 * 65280 - (54 * 203 + 183 * 205 + 19 * 207)) / 512,
      "its plane is the negative's sums");
    store8(&atbuf, 255); store8(&atbuf + 1, 255); store8(&atbuf + 2, 255); store8(&atbuf + 3, 200);
    downscale_set_invert(0);
    downscale_area_to_rgb(&pstr_at, 1, 1);
    ad = load64(&pstr_at + STRUCT_DOWNSCALED_BUF_OFFSET);
    assert_eq(load8(ad), 200, "off again: white at alpha 200 over black");

    # v1.6.0: kii's local `_emit_bg_256_buf` is gone; the half-block emit
    # calls darshana's `tty_bg_256_buf` (darshana 1.2.0). The two groups below
    # are the ones that used to test the local twin, retargeted unchanged:
    # they now pin the contract kii relies on from the dependency.
    test_group("P-1 (v1.5.1) — tty_bg_256_buf rejects a negative pos");
    # darshana 0.9.3 added this guard to all seven of its own `_buf` composers
    # after finding that a -1 sentinel fed back in as a position wrote ESC at
    # `buf - 1` and returned a bogus positive length. kii's local BG twin
    # picked it up at v1.5.1; emit_halfblock_row_buf chains fg's result
    # straight into bg's `pos`, so the composer it calls must refuse it.
    var bgn_buf[64];
    assert_eq(tty_bg_256_buf(&bgn_buf, 0 - 1, 7),   0 - 1, "pos = -1 → -1");
    assert_eq(tty_bg_256_buf(&bgn_buf, 0 - 99, 7),  0 - 1, "pos = -99 → -1");
    assert_eq(tty_bg_256_buf(&bgn_buf, 0, 7),            9, "pos = 0 still works (9 bytes)");

    test_group("M5(c) — tty_bg_256_buf encodes CSI 48;5;Nm");
    # 1-digit, 2-digit, 3-digit, and bounds-reject paths.
    # 1-digit n: CSI 48;5;Nm = 9 bytes (ESC + '[' + "48;5;" + 1 + 'm')
    # 2-digit n: 10 bytes; 3-digit n: 11 bytes.
    var bg_buf[64];
    var bg_pos = tty_bg_256_buf(&bg_buf, 0, 7);
    assert_eq(bg_pos, 9, "bg 7 → 9 bytes");
    assert_eq(load8(&bg_buf + 0), 27,  "byte 0 = ESC");
    assert_eq(load8(&bg_buf + 1), 91,  "byte 1 = [");
    assert_eq(load8(&bg_buf + 7), 55,  "byte 7 = '7'");
    assert_eq(load8(&bg_buf + 8), 109, "byte 8 = 'm'");
    var bg_pos2 = tty_bg_256_buf(&bg_buf, 0, 15);
    assert_eq(bg_pos2, 10, "bg 15 → 10 bytes");
    assert_eq(load8(&bg_buf + 7), 49, "byte 7 = '1'");
    assert_eq(load8(&bg_buf + 8), 53, "byte 8 = '5'");
    assert_eq(load8(&bg_buf + 9), 109, "byte 9 = 'm'");
    var bg_pos3 = tty_bg_256_buf(&bg_buf, 0, 255);
    assert_eq(bg_pos3, 11, "bg 255 → 11 bytes");
    assert_eq(tty_bg_256_buf(&bg_buf, 0, 256),   0 - 1, "bg 256 → -1");
    assert_eq(tty_bg_256_buf(&bg_buf, 0, 0 - 1), 0 - 1, "bg -1 → -1");

    test_group("v1.6.0 — tty_bg_256_buf is byte-identical to the retired local twin");
    # Every index, at a fresh position and at a chained one, compared with
    # _ref_bg_256_buf_v152 (the body kii shipped through v1.5.2). darshana's
    # composer writes with wide stores (an 8-byte prefix store, then the
    # index field), so the sweep also checks a canary byte immediately past
    # the returned length: the swap must not write a byte the old composer
    # did not.
    var bx_new[32];
    var bx_ref[32];
    var bx_len_bad = 0;
    var bx_byte_bad = 0;
    var bx_canary_bad = 0;
    var bx_chain_bad = 0;
    var bx_n = 0;
    while (bx_n < 256) {
        var bx_k = 0;
        while (bx_k < 32) { store8(&bx_new + bx_k, 0xAA); store8(&bx_ref + bx_k, 0xAA); bx_k = bx_k + 1; }
        var bx_ln = tty_bg_256_buf(&bx_new, 0, bx_n);
        var bx_lr = _ref_bg_256_buf_v152(&bx_ref, 0, bx_n);
        if (bx_ln != bx_lr) { bx_len_bad = bx_len_bad + 1; }
        bx_k = 0;
        while (bx_k < bx_lr) {
            if (load8(&bx_new + bx_k) != load8(&bx_ref + bx_k)) { bx_byte_bad = bx_byte_bad + 1; }
            bx_k = bx_k + 1;
        }
        if (load8(&bx_new + bx_lr) != 0xAA) { bx_canary_bad = bx_canary_bad + 1; }
        # Chained: start at pos 5, as the half-block row does after the FG escape.
        var bx_cn = tty_bg_256_buf(&bx_new, 5, bx_n);
        var bx_cr = _ref_bg_256_buf_v152(&bx_ref, 5, bx_n);
        if (bx_cn != bx_cr) { bx_chain_bad = bx_chain_bad + 1; }
        bx_k = 5;
        while (bx_k < bx_cr) {
            if (load8(&bx_new + bx_k) != load8(&bx_ref + bx_k)) { bx_chain_bad = bx_chain_bad + 1; }
            bx_k = bx_k + 1;
        }
        bx_n = bx_n + 1;
    }
    assert_eq(bx_len_bad,    0, "all 256 indices: same length as the retired composer");
    assert_eq(bx_byte_bad,   0, "all 256 indices: same bytes as the retired composer");
    assert_eq(bx_canary_bad, 0, "all 256 indices: nothing written past the returned length");
    assert_eq(bx_chain_bad,  0, "all 256 indices at pos 5: same length and bytes");
    # Rejections agree, and a rejection writes nothing.
    store8(&bx_new + 0, 0xAA);
    assert_eq(tty_bg_256_buf(&bx_new, 0, 256), _ref_bg_256_buf_v152(&bx_ref, 0, 256),
      "n = 256: both reject");
    assert_eq(tty_bg_256_buf(&bx_new, 0, 4294967296), 0 - 1, "n = 2^32 → -1 (no truncation to 0)");
    assert_eq(tty_bg_256_buf(&bx_new, 0, 0 - 9223372036854775807), 0 - 1, "n = -(2^63-1) → -1");
    assert_eq(load8(&bx_new + 0), 0xAA, "a rejected index writes nothing");

    # ---- v1.8.0 — the emit rework (ADR 0010) --------------------------
    # Each row is checked whole. Codes are what quantize leaves: a palette
    # index (tiers 8 / 16 / 256), a packed 0xRRGGBB (tc), or KII_COLOR_DEFAULT.
    var q[64];
    var codes[64];        # bytes: room for 8 i64 codes (CLAUDE.md: function-scope arrays are in bytes)
    var line[256];
    var lp = 0;

    test_group("v1.8.0 — tier 16: SGR 30–37 / 40–47, and 90–97 / 100–107 for brights");
    quant_set_tier(16);
    store64(&codes + 0, 1); store64(&codes + 8, 4);
    _put_codes(&q, &codes, 2);
    lp = emit_halfblock_row_buf(&q, 1, 0, &line, 0);
    assert_eq(_row_is(&line, lp, "\x1b[31m\x1b[44m\xe2\x96\x80\x1b[0m\n"), 1, "red over blue → 31 / 44 ▀");
    store64(&codes + 0, 9); store64(&codes + 8, 15);
    _put_codes(&q, &codes, 2);
    lp = emit_halfblock_row_buf(&q, 1, 0, &line, 0);
    assert_eq(_row_is(&line, lp, "\x1b[91m\x1b[107m\xe2\x96\x80\x1b[0m\n"), 1, "bright red over bright white → 91 / 107");

    test_group("v1.8.0 — tier 8: only SGR 30–37 / 40–47");
    quant_set_tier(8);
    store64(&codes + 0, 1); store64(&codes + 8, 4);
    _put_codes(&q, &codes, 2);
    lp = emit_halfblock_row_buf(&q, 1, 0, &line, 0);
    assert_eq(_row_is(&line, lp, "\x1b[31m\x1b[44m\xe2\x96\x80\x1b[0m\n"), 1, "red over blue → 31 / 44");
    store64(&codes + 0, 9);
    _put_codes(&q, &codes, 2);
    assert_eq(emit_halfblock_row_buf(&q, 1, 0, &line, 0), 0 - 1, "a bright index at tier 8 is refused, not sent as 91");

    test_group("v1.8.0 — tier 256: 38;5;N / 48;5;N");
    quant_set_tier(256);
    store64(&codes + 0, 196); store64(&codes + 8, 21);
    _put_codes(&q, &codes, 2);
    lp = emit_halfblock_row_buf(&q, 1, 0, &line, 0);
    assert_eq(_row_is(&line, lp, "\x1b[38;5;196m\x1b[48;5;21m\xe2\x96\x80\x1b[0m\n"), 1, "196 over 21");

    test_group("v1.8.0 — truecolour: 38;2;R;G;B / 48;2;R;G;B");
    quant_set_tier(KII_TIER_TC);
    store64(&codes + 0, 16744448); store64(&codes + 8, 255);      # 0xFF8000, 0x0000FF
    _put_codes(&q, &codes, 2);
    lp = emit_halfblock_row_buf(&q, 1, 0, &line, 0);
    assert_eq(_row_is(&line, lp, "\x1b[38;2;255;128;0m\x1b[48;2;0;0;255m\xe2\x96\x80\x1b[0m\n"), 1,
      "orange over blue → 38;2;255;128;0 / 48;2;0;0;255");

    test_group("v2.2.0 — --color none: the composers refuse every code");
    quant_set_tier(KII_TIER_NONE);
    store8(&line, 85);
    assert_eq(_kii_sgr_fg(&line, 0, 1), 0 - 1, "fg 1 is refused");
    assert_eq(_kii_sgr_fg(&line, 0, KII_COLOR_DEFAULT), 0 - 1, "the default fg (39) is refused too");
    assert_eq(_kii_sgr_bg(&line, 0, 4), 0 - 1, "bg 4 is refused");
    assert_eq(_kii_sgr_bg(&line, 0, KII_COLOR_DEFAULT), 0 - 1, "the default bg (49) is refused too");
    assert_eq(load8(&line), 85, "and nothing is written");
    store64(&codes + 0, 1); store64(&codes + 8, 4);
    _put_codes(&q, &codes, 2);
    assert_eq(emit_halfblock_row_buf(&q, 1, 0, &line, 0), 0 - 1, "a half-block row at tier none is refused");
    quant_set_tier(16);

    test_group("v1.8.0 — elision: an escape is written only when it changes");
    quant_set_tier(16);
    var ci = 0;
    while (ci < 8) { store64(&codes + ci * 8, 4); ci = ci + 1; }
    _put_codes(&q, &codes, 8);
    lp = emit_halfblock_row_buf(&q, 4, 0, &line, 0);
    assert_eq(_row_is(&line, lp, "\x1b[44m    \x1b[0m\n"), 1,
      "four blue cells → one bg escape and four spaces (v2.1.0; 31 bytes as ▀ with fg and bg, 89 before v1.8.0)");
    # Top row 1 1, bottom row 2 3: only the bg changes in the second cell.
    store64(&codes + 0, 1); store64(&codes + 8, 1); store64(&codes + 16, 2); store64(&codes + 24, 3);
    _put_codes(&q, &codes, 4);
    lp = emit_halfblock_row_buf(&q, 2, 0, &line, 0);
    assert_eq(_row_is(&line, lp, "\x1b[31m\x1b[42m\xe2\x96\x80\x1b[43m\xe2\x96\x80\x1b[0m\n"), 1, "only the bg changes → only a bg escape");
    # A checkerboard: top 0 15, bottom 15 0.
    store64(&codes + 0, 0); store64(&codes + 8, 15); store64(&codes + 16, 15); store64(&codes + 24, 0);
    _put_codes(&q, &codes, 4);
    lp = emit_halfblock_row_buf(&q, 2, 0, &line, 0);
    # v2.1.0: the bright half takes the fg in both cells, so the second reuses the
    # first's colours (until v2.1.0, two escapes every cell).
    assert_eq(_row_is(&line, lp, "\x1b[97m\x1b[40m\xe2\x96\x84\xe2\x96\x80\x1b[0m\n"), 1, "checkerboard → ▄ then ▀, one pair of escapes");
    # Every row starts with no state: row 1 of a 1x4 solid buffer repeats row 0's escapes.
    ci = 0;
    while (ci < 4) { store64(&codes + ci * 8, 4); ci = ci + 1; }
    _put_codes(&q, &codes, 4);
    var lp0 = emit_halfblock_row_buf(&q, 1, 0, &line, 0);
    var lp1 = emit_halfblock_row_buf(&q, 1, 1, &line, lp0);
    assert_eq(lp1 - lp0, lp0, "row 1 is self-contained: same bytes as row 0");
    assert_eq(memeq(&line, &line + lp0, lp0), 1, "row 1 sets its own colours again");

    test_group("v1.8.0 — transparency: default colours, and ▀ / ▄ keep the opaque half");
    store64(&codes + 0, KII_COLOR_DEFAULT); store64(&codes + 8, 2);
    _put_codes(&q, &codes, 2);
    lp = emit_halfblock_row_buf(&q, 1, 0, &line, 0);
    assert_eq(_row_is(&line, lp, "\x1b[32m\x1b[49m\xe2\x96\x84\x1b[0m\n"), 1, "transparent top → ▄ in the bottom's colour on 49");
    store64(&codes + 0, 2); store64(&codes + 8, KII_COLOR_DEFAULT);
    _put_codes(&q, &codes, 2);
    lp = emit_halfblock_row_buf(&q, 1, 0, &line, 0);
    assert_eq(_row_is(&line, lp, "\x1b[32m\x1b[49m\xe2\x96\x80\x1b[0m\n"), 1, "transparent bottom → ▀ on 49");
    # Three cells: both transparent, both transparent, both green.
    store64(&codes + 0, KII_COLOR_DEFAULT); store64(&codes + 8, KII_COLOR_DEFAULT); store64(&codes + 16, 2);
    store64(&codes + 24, KII_COLOR_DEFAULT); store64(&codes + 32, KII_COLOR_DEFAULT); store64(&codes + 40, 2);
    _put_codes(&q, &codes, 6);
    lp = emit_halfblock_row_buf(&q, 3, 0, &line, 0);
    assert_eq(_row_is(&line, lp, "\x1b[49m  \x1b[42m \x1b[0m\n"), 1,
      "fully transparent cells are spaces with no fg; one 49 covers both; the green cell is a space too (v2.1.0)");
    quant_set_tier(KII_TIER_TC);
    store64(&codes + 0, KII_COLOR_DEFAULT); store64(&codes + 8, 255);
    _put_codes(&q, &codes, 2);
    lp = emit_halfblock_row_buf(&q, 1, 0, &line, 0);
    assert_eq(_row_is(&line, lp, "\x1b[38;2;0;0;255m\x1b[49m\xe2\x96\x84\x1b[0m\n"), 1, "transparency works the same at truecolour");
    quant_set_tier(16);

    # ---- v2.1.0 — the half-block lane reuses its colour state (ADR 0004) ----
    # Each cell takes the encoding of its two colours that needs fewest escapes:
    # ▀ or ▄ for two colours (a tie keeps ▀), a space or █ for one. At tier 16 a
    # bright colour stays in the fg when it can (the Linux console has no bright
    # backgrounds). ▀ ▄ █ are E2 96 80 / 84 / 88.
    test_group("v2.1.0 — one colour: a space on the bg, or █ when the fg already has it");
    store32(&q + 0, 4); store32(&q + 4, 4);
    lp = emit_halfblock_row_buf(&q, 1, 0, &line, 0);
    assert_eq(_row_is(&line, lp, "\x1b[44m \x1b[0m\n"), 1, "a blue cell → a space on 44, no fg");
    lp = _hb_row2(&q, &line, 1, 1, 2, 1);
    assert_eq(_row_is(&line, lp, "\x1b[31m\x1b[42m\xe2\x96\x80\xe2\x96\x88\x1b[0m\n"), 1, "red after red-on-green → █, no escape");
    lp = _hb_row2(&q, &line, 1, 2, 2, 2);
    assert_eq(_row_is(&line, lp, "\x1b[31m\x1b[42m\xe2\x96\x80 \x1b[0m\n"), 1, "green after red-on-green → a bare space");
    lp = _hb_row2(&q, &line, 1, 3, 2, 3);
    assert_eq(_row_is(&line, lp, "\x1b[31m\x1b[42m\xe2\x96\x80\x1b[43m \x1b[0m\n"), 1, "a new colour → a space after one bg escape");

    test_group("v2.1.0 — two colours: ▀ or ▄, whichever needs fewer escapes");
    lp = _hb_row2(&q, &line, 1, 2, 2, 1);
    assert_eq(_row_is(&line, lp, "\x1b[31m\x1b[42m\xe2\x96\x80\xe2\x96\x84\x1b[0m\n"), 1, "the colours swapped → ▄, no escape");
    lp = _hb_row2(&q, &line, 1, 3, 2, 1);
    assert_eq(_row_is(&line, lp, "\x1b[31m\x1b[42m\xe2\x96\x80\x1b[43m\xe2\x96\x84\x1b[0m\n"), 1, "▄ reuses the fg: one escape, not two");
    lp = _hb_row2(&q, &line, 1, 3, 2, 4);
    assert_eq(_row_is(&line, lp, "\x1b[31m\x1b[42m\xe2\x96\x80\x1b[33m\x1b[44m\xe2\x96\x80\x1b[0m\n"), 1, "two new colours: a tie keeps ▀");
    lp = _hb_row2(&q, &line, 1, 1, 2, 3);
    assert_eq(_row_is(&line, lp, "\x1b[31m\x1b[42m\xe2\x96\x80\x1b[43m\xe2\x96\x80\x1b[0m\n"), 1, "▀ when it needs only the bg");

    test_group("v2.1.0 — tier 16: a bright colour stays in the fg");
    lp = _hb_row2(&q, &line, 9, 12, 12, 12);
    assert_eq(_row_is(&line, lp, "\x1b[91m\x1b[104m\xe2\x96\x80\x1b[94m\xe2\x96\x88\x1b[0m\n"), 1,
      "bright blue alone → █ in 94, though the bg is already 104");
    lp = _hb_row2(&q, &line, 1, 1, 2, 10);
    assert_eq(_row_is(&line, lp, "\x1b[31m\x1b[42m\xe2\x96\x80\x1b[92m\x1b[41m\xe2\x96\x84\x1b[0m\n"), 1,
      "red over bright green → ▄ in 92 on 41, though ▀ needs one escape");
    lp = _hb_row2(&q, &line, 1, 10, 2, 1);
    assert_eq(_row_is(&line, lp, "\x1b[31m\x1b[42m\xe2\x96\x80\x1b[92m\x1b[41m\xe2\x96\x80\x1b[0m\n"), 1,
      "bright green over red → ▀ in 92 on 41, though ▄ needs one escape");
    lp = _hb_row2(&q, &line, 9, 12, 12, 9);
    assert_eq(_row_is(&line, lp, "\x1b[91m\x1b[104m\xe2\x96\x80\xe2\x96\x84\x1b[0m\n"), 1,
      "two brights → fewest escapes, as for two dim colours");
    store32(&q + 0, 7); store32(&q + 4, 7);
    lp = emit_halfblock_row_buf(&q, 1, 0, &line, 0);
    assert_eq(_row_is(&line, lp, "\x1b[47m \x1b[0m\n"), 1, "light grey (7) is not a bright: a space on 47");

    test_group("v2.1.0 — a transparent half is only ever the bg");
    # Cell 2's top (green) is already the bg, so ▄ would need one escape, not two;
    # but ▄ would draw the transparent bottom in the default fg (39), not the bg.
    lp = _hb_row2(&q, &line, 1, 2, 2, KII_COLOR_DEFAULT);
    assert_eq(_row_is(&line, lp, "\x1b[31m\x1b[42m\xe2\x96\x80\x1b[32m\x1b[49m\xe2\x96\x80\x1b[0m\n"), 1,
      "green over transparent after red-on-green → ▀ on 49");
    lp = _hb_row2(&q, &line, 1, KII_COLOR_DEFAULT, 2, 1);
    assert_eq(_row_is(&line, lp, "\x1b[31m\x1b[42m\xe2\x96\x80\x1b[49m\xe2\x96\x84\x1b[0m\n"), 1,
      "transparent over red after red-on-green → ▄ on 49");

    test_group("v2.1.0 — tiers 8, 256 and truecolour take the fewest escapes");
    quant_set_tier(8);
    lp = _hb_row2(&q, &line, 1, 2, 2, 1);
    assert_eq(_row_is(&line, lp, "\x1b[31m\x1b[42m\xe2\x96\x80\xe2\x96\x84\x1b[0m\n"), 1, "tier 8: swapped → ▄");
    lp = _hb_row2(&q, &line, 1, 1, 1, 1);
    assert_eq(_row_is(&line, lp, "\x1b[41m  \x1b[0m\n"), 1, "tier 8: two red cells → one escape, two spaces");
    quant_set_tier(256);
    lp = _hb_row2(&q, &line, 196, 21, 21, 196);
    assert_eq(_row_is(&line, lp, "\x1b[38;5;196m\x1b[48;5;21m\xe2\x96\x80\xe2\x96\x84\x1b[0m\n"), 1, "tier 256: swapped → ▄");
    quant_set_tier(KII_TIER_TC);
    # At truecolour, codes 8–15 are RGB (0,0,8)…(0,0,15), not brights: no bright rule.
    lp = _hb_row2(&q, &line, 1, 1, 2, 10);
    assert_eq(_row_is(&line, lp, "\x1b[38;2;0;0;1m\x1b[48;2;0;0;2m\xe2\x96\x80\x1b[48;2;0;0;10m\xe2\x96\x80\x1b[0m\n"), 1,
      "truecolour (0,0,10) is not a bright: ▀ with one bg escape");
    store32(&q + 0, 9); store32(&q + 4, 9);
    lp = emit_halfblock_row_buf(&q, 1, 0, &line, 0);
    assert_eq(_row_is(&line, lp, "\x1b[48;2;0;0;9m \x1b[0m\n"), 1, "truecolour (0,0,9) alone → a space");
    quant_set_tier(16);

    test_group("M5(c) — emit_halfblock rejects ungated calls");
    # qbuf == 0 → -1 (no quantize_downscaled run yet).
    var pstr_eu[160];
    store64(&pstr_eu + STRUCT_QUANTIZED_BUF_OFFSET, 0);
    assert_eq(emit_halfblock(&pstr_eu), 0 - 1, "ungated emit → -1");
    # Odd sh → -1 (half-block needs paired rows).
    var pstr_eo[160];
    store64(&pstr_eo + STRUCT_QUANTIZED_BUF_OFFSET, 1);  # non-null sentinel
    store64(&pstr_eo + STRUCT_DOWNSCALED_W_OFFSET,  4);
    store64(&pstr_eo + STRUCT_DOWNSCALED_H_OFFSET,  3);  # odd
    assert_eq(emit_halfblock(&pstr_eo), 0 - 1, "odd sh → -1");
    # Zero w → -1.
    var pstr_ez[160];
    store64(&pstr_ez + STRUCT_QUANTIZED_BUF_OFFSET, 1);
    store64(&pstr_ez + STRUCT_DOWNSCALED_W_OFFSET,  0);
    store64(&pstr_ez + STRUCT_DOWNSCALED_H_OFFSET,  4);
    assert_eq(emit_halfblock(&pstr_ez), 0 - 1, "zero w → -1");

    # ============================================================
    # ---- M6(a) _kii_compute_target_geometry --------------------
    # ============================================================
    test_group("M6(a) — geometry: --width override + aspect math");
    var g_w = 0;  var g_sr = 0;
    # 1152x925 (RAMGON) with width_flag=80 → 80 cols, 32 rows
    # (= 64 source rows). dst_rows = (925 × 80) / (1152 × 2) = 32.
    assert_eq(_kii_compute_target_geometry(1152, 925, 80, &g_w, &g_sr), 0,
      "RAMGON 80 → 0");
    assert_eq(g_w,  80, "RAMGON 80 → dst_w = 80");
    assert_eq(g_sr, 64, "RAMGON 80 → dst_src_rows = 64 (32 term rows)");
    # 1152x925 with width_flag=40 → 40 cols, 16 rows (32 src rows).
    assert_eq(_kii_compute_target_geometry(1152, 925, 40, &g_w, &g_sr), 0,
      "RAMGON 40 → 0");
    assert_eq(g_w,  40, "RAMGON 40 → dst_w = 40");
    assert_eq(g_sr, 32, "RAMGON 40 → dst_src_rows = 32");
    # 1152x925 with width_flag=120 → 120 cols, 48 rows (96 src rows).
    assert_eq(_kii_compute_target_geometry(1152, 925, 120, &g_w, &g_sr), 0,
      "RAMGON 120 → 0");
    assert_eq(g_w,  120, "RAMGON 120 → dst_w = 120");
    assert_eq(g_sr, 96,  "RAMGON 120 → dst_src_rows = 96");

    test_group("M6(a) — geometry: width=0 (--width unset) → default 80");
    # No --width override → falls back to EMIT_DEFAULT_COLS = 80.
    assert_eq(_kii_compute_target_geometry(1152, 925, 0, &g_w, &g_sr), 0,
      "width=0 → 0");
    assert_eq(g_w, 80, "width=0 → default dst_w = 80");
    # Same 64 source-row count as the explicit 80 case.
    assert_eq(g_sr, 64, "width=0 → default dst_src_rows = 64");

    test_group("M6(a) — geometry: square / portrait / landscape");
    # Aspect-preserving formula: dst_src_h = (src_h × dst_cols) / src_w.
    # Terminal rows = dst_src_h / 2 (half-block packs 2 source rows
    # per terminal row).
    #
    # Square (100×100) @ width=40:
    #   dst_src_h = (100 × 40) / 100 = 40
    #   dst_rows  = 20 terminal rows
    assert_eq(_kii_compute_target_geometry(100, 100, 40, &g_w, &g_sr), 0,
      "square 100x100 @ 40 → 0");
    assert_eq(g_w,  40, "square 100x100 @ 40 → dst_w = 40");
    assert_eq(g_sr, 40, "square 100x100 @ 40 → dst_src_rows = 40 (20 term rows)");

    # Wide landscape (200×50) @ width=80:
    #   dst_src_h = (50 × 80) / 200 = 20
    #   dst_rows  = 10 terminal rows
    assert_eq(_kii_compute_target_geometry(200, 50, 80, &g_w, &g_sr), 0,
      "landscape 200x50 @ 80 → 0");
    assert_eq(g_w,  80, "landscape 200x50 @ 80 → dst_w = 80");
    assert_eq(g_sr, 20, "landscape 200x50 @ 80 → dst_src_rows = 20 (10 term rows)");

    # Tall portrait (50×200) @ width=80:
    #   dst_src_h = (200 × 80) / 50 = 320
    #   dst_rows  = 160 terminal rows (will overflow most terminals;
    #              M6(b) row-cap will clamp this when geometry is
    #              auto-detected, but explicit --width keeps the
    #              aspect-true rendering for capture-to-file).
    assert_eq(_kii_compute_target_geometry(50, 200, 80, &g_w, &g_sr), 0,
      "portrait 50x200 @ 80 → 0");
    assert_eq(g_w,  80,  "portrait 50x200 @ 80 → dst_w = 80");
    assert_eq(g_sr, 320, "portrait 50x200 @ 80 → dst_src_rows = 320 (160 term rows)");

    test_group("M6(a) — geometry: degenerate inputs");
    # Very narrow: 1-row source at 80 cols → (1×80)/(W×2) = 0 → clamp ≥ 1.
    # Use 800×1 source: dst_src_h = (1×80)/(800×2) = 0 → clamp to 1.
    # dst_src_rows = 2. dst_rows would be 1.
    assert_eq(_kii_compute_target_geometry(800, 1, 80, &g_w, &g_sr), 0,
      "800x1 @ 80 → 0");
    assert_eq(g_w,  80, "800x1 @ 80 → dst_w = 80");
    assert_eq(g_sr, 2,  "800x1 @ 80 → dst_src_rows = 2 (clamped, min 1 terminal row)");
    # Source dims invalid → -1, no writes.
    assert_eq(_kii_compute_target_geometry(0, 100, 80, &g_w, &g_sr), 0 - 1,
      "src_w=0 → -1");
    assert_eq(_kii_compute_target_geometry(100, 0, 80, &g_w, &g_sr), 0 - 1,
      "src_h=0 → -1");
    assert_eq(_kii_compute_target_geometry(0 - 1, 100, 80, &g_w, &g_sr), 0 - 1,
      "src_w<0 → -1");

    # ============================================================
    # ---- M6(b) _kii_compute_fit_geometry -----------------------
    # ============================================================
    test_group("M6(b) — fit: width-binding (image fits in envelope)");
    var f_w = 0;  var f_sr = 0;
    # 1000×100 (very wide) in 120×40 envelope:
    #   dst_src_h_at_120 = (100×120)/1000 = 12 → term rows = 6
    #   6 ≤ 40 so width binds. dst_w = 120, dst_src_rows = 12.
    assert_eq(_kii_compute_fit_geometry(1000, 100, 120, 40, &f_w, &f_sr), 0,
      "1000x100 @ 120x40 → 0");
    assert_eq(f_w,  120, "wide-image width-binding: dst_w = 120");
    assert_eq(f_sr, 12,  "wide-image width-binding: dst_src_rows = 12 (6 term rows)");

    test_group("M6(b) — fit: row-binding (image taller than envelope)");
    # RAMGON 1152×925 in 120×40 envelope: aspect at cols=120 wants 48
    # rows, exceeds 40. Row-binds:
    #   dst_src_rows = 40 × 2 = 80
    #   dst_cols = (80 × 1152) / 925 = 99.66 → 99
    assert_eq(_kii_compute_fit_geometry(1152, 925, 120, 40, &f_w, &f_sr), 0,
      "RAMGON @ 120x40 → 0");
    assert_eq(f_w,  99, "RAMGON row-binding: dst_w = 99");
    assert_eq(f_sr, 80, "RAMGON row-binding: dst_src_rows = 80 (40 term rows)");

    # Square 100×100 in 80×24 envelope: aspect at cols=80 wants
    # dst_src_h = (100×80)/100 = 80, term rows = 40, > 24 → row-bind.
    # dst_src_rows = 48, dst_cols = (48 × 100) / 100 = 48.
    assert_eq(_kii_compute_fit_geometry(100, 100, 80, 24, &f_w, &f_sr), 0,
      "square 100x100 @ 80x24 → 0");
    assert_eq(f_w,  48, "square row-binding: dst_w = 48");
    assert_eq(f_sr, 48, "square row-binding: dst_src_rows = 48 (24 term rows)");

    test_group("M6(b) — fit: zero envelope args use EMIT_DEFAULT_*");
    # max_cols=0, max_rows=0 → falls back to (80, 24).
    # RAMGON 1152×925 in 80×24 envelope: aspect at cols=80 wants
    # 32 term rows, > 24 → row-bind to dst_src_rows = 48, dst_cols =
    # (48 × 1152) / 925 = 59.79 → 59.
    assert_eq(_kii_compute_fit_geometry(1152, 925, 0, 0, &f_w, &f_sr), 0,
      "RAMGON @ 0x0 (defaults) → 0");
    assert_eq(f_w,  59, "non-TTY fallback (80x24): row-binds dst_w = 59");
    assert_eq(f_sr, 48, "non-TTY fallback (80x24): row-binds dst_src_rows = 48");

    test_group("M6(b) — fit: edge cases + invalid input");
    # Single-pixel source. Width-binds (1 src row fits easily).
    assert_eq(_kii_compute_fit_geometry(800, 1, 80, 24, &f_w, &f_sr), 0,
      "800x1 @ 80x24 → 0");
    assert_eq(f_w,  80, "800x1: width binds → dst_w = 80");
    assert_eq(f_sr, 2,  "800x1: width binds → dst_src_rows = 2 (clamped)");
    # Invalid source dims → -1.
    assert_eq(_kii_compute_fit_geometry(0, 100, 80, 24, &f_w, &f_sr), 0 - 1,
      "src_w=0 → -1");
    assert_eq(_kii_compute_fit_geometry(100, 0, 80, 24, &f_w, &f_sr), 0 - 1,
      "src_h=0 → -1");

    # ============================================================
    # ---- v1.6.0 _kii_term_envelope (auto-detect half) ----------
    # ============================================================
    # The `tty_winsize` → envelope rule main.cyr used to compute inline,
    # untested. Envelope 0 = "not measured" (the fit layer substitutes
    # EMIT_DEFAULT_*). See the helper's comment for why kii keeps this
    # per-dimension rule instead of darshana's tty_winsize_or.
    test_group("v1.6.0 — _kii_term_envelope: detection to fit envelope");
    var e_c = 0 - 7;  var e_r = 0 - 7;
    assert_eq(_kii_term_envelope(0 - 1, 50, 200, &e_c, &e_r), 0, "returns 0");
    assert_eq(e_c, 0, "failed detection → cols 0 (default), out slots ignored");
    assert_eq(e_r, 0, "failed detection → rows 0 (default)");
    _kii_term_envelope(0, 24, 80, &e_c, &e_r);
    assert_eq(e_c, 80, "24x80 → 80 cols");
    assert_eq(e_r, 23, "24x80 → 23 rows (one left for the prompt)");
    _kii_term_envelope(0, 0, 0, &e_c, &e_r);
    assert_eq(e_c, 0, "0x0 (size never set) → cols 0 (default)");
    # P(-1) (v1.6.4): a measured TTY that reports 0 rows keeps the prompt row,
    # as a measured 24-row TTY does (it used to get all 24 and scroll).
    assert_eq(e_r, 23, "0x0 (size never set) → rows 23 (default less the prompt row)");
    # A-8 (v1.5.1): a 1-row terminal keeps both its row and its columns.
    _kii_term_envelope(0, 1, 100, &e_c, &e_r);
    assert_eq(e_c, 100, "1x100 → keeps its 100 columns (A-8)");
    assert_eq(e_r, 1,   "1x100 → keeps its single row");
    _kii_term_envelope(0, 2, 100, &e_c, &e_r);
    assert_eq(e_r, 1,   "2x100 → 1 row after the prompt row");
    # Half-set winsize — `stty cols 40` on a line whose size was never set.
    # This is the case tty_winsize_or would collapse to its defaults (80
    # columns, wider than the line); kii keeps the measured dimension.
    _kii_term_envelope(0, 0, 40, &e_c, &e_r);
    assert_eq(e_c, 40, "0x40 → keeps the 40 measured columns");
    assert_eq(e_r, 23, "0x40 → rows 23 (default less the prompt row)");
    _kii_term_envelope(0, 30, 0, &e_c, &e_r);
    assert_eq(e_c, 0,  "30x0 → cols 0 (default)");
    assert_eq(e_r, 29, "30x0 → keeps the measured rows, less the prompt row");
    # End to end with the fit layer: a half-set 0x40 line never gets a frame
    # wider than 40 columns.
    _kii_term_envelope(0, 0, 40, &e_c, &e_r);
    assert_eq(_kii_compute_fit_geometry(1000, 100, e_c, e_r, &f_w, &f_sr), 0,
      "1000x100 in a 0x40 line → 0");
    assert_eq(f_w, 40, "1000x100 in a 0x40 line → 40 columns, not 80");

    return assert_summary();
}

var exit_code = main();
syscall(SYS_EXIT, exit_code);
